@@ -79,6 +79,10 @@ struct macos_panic_header *mac_panic_header = NULL;
 /* Maximum size of panic log excluding headers, in bytes */
 static unsigned int panic_text_len;
 
+/* Blazer's kexec/ADT path may have no iBoot pram node. This fallback is used
+ * only with the explicit blazer_panicdump=1 handoff; a real pram always wins. */
+static uint8_t blazer_panic_region[0x80000] __attribute__((aligned(4096)));
+
 /* Whether a console is standing by for panic logging */
 static boolean_t panic_console_available = FALSE;
 
@@ -93,6 +97,40 @@ void PE_slide_devicetree(vm_offset_t);
 static void
 check_for_panic_log(void)
 {
+	uint32_t blazer_fallback = 0;
+
+	if (PE_parse_boot_argn("blazer_panicdump", &blazer_fallback,
+	    sizeof(blazer_fallback)) && blazer_fallback != 0) {
+		DTEntry pram_entry;
+
+		if (kSuccess != SecureDTLookupEntry(0, "pram", &pram_entry)) {
+			gPanicBase = (vm_offset_t)blazer_panic_region;
+			gPanicSize = sizeof(blazer_panic_region);
+			panic_text_len = gPanicSize - sizeof(struct embedded_panic_header);
+			return;
+		}
+	}
+	{
+		/* R4 laguna chain (ported, 0123): lagunapanicdump defaults ON, and
+		 * the phone/kexec ADT has no iBoot pram node — without a region the
+		 * panic path wedges in SavePanicInfo before any paniclog text
+		 * exists (=0 disables; a real pram node always wins below). The
+		 * region is shared with the blazer fallback above (same 512 KiB
+		 * .bss, same purpose; the two capture paths are never armed
+		 * together). */
+		uint32_t laguna_fallback = 1;
+		DTEntry pram_entry;
+
+		(void)PE_parse_boot_argn("lagunapanicdump", &laguna_fallback,
+		    sizeof(laguna_fallback));
+		if (laguna_fallback != 0 &&
+		    kSuccess != SecureDTLookupEntry(0, "pram", &pram_entry)) {
+			gPanicBase = (vm_offset_t)blazer_panic_region;
+			gPanicSize = sizeof(blazer_panic_region);
+			panic_text_len = gPanicSize - sizeof(struct embedded_panic_header);
+			return;
+		}
+	}
 #ifdef PLATFORM_PANIC_LOG_PADDR
 	gPanicBase = ml_io_map_wcomb(PLATFORM_PANIC_LOG_PADDR, PLATFORM_PANIC_LOG_SIZE);
 	panic_text_len = PLATFORM_PANIC_LOG_SIZE - sizeof(struct embedded_panic_header);
