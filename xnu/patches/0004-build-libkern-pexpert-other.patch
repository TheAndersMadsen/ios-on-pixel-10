index 59e4063..e1a063d 100644
--- a/makedefs/MakeInc.rule
+++ b/makedefs/MakeInc.rule
@@ -435,13 +435,27 @@ P_RULE_4B=
 #
 # Explain how to make the bsd syscall list
 #
+# This master feeds every sysproto/sysent consumer in the tree and is built by
+# more than one make (the bsd/sys header pass and the bsd/conf sysent pass both
+# instantiate this rule). A plain "> $@" truncates the target before unifdef
+# starts writing; under -j, or with a second make sharing the BUILD tree, a
+# reader then observes a 0-byte master, makesyscalls emits a stub sysproto.h,
+# and every syscall consumer fails with "struct xxx_args incomplete" errors.
+# So: generate to a per-pid temp, refuse empty output, then rename atomically.
 $(TARGET)/bsd.syscalls.master: $(SRCROOT)/bsd/kern/syscalls.master $(MAKESYSCALLS)
 	@$(LOG_GENERATE) "$(@F)$(Color0) from $(ColorF)$<$(Color0)"
-	$(_v)$(UNIFDEF) $(SEED_DEFINES) $< > $@;	\
+	$(_v)$(UNIFDEF) $(SEED_DEFINES) $< > $@.$$$$;	\
 	if [ $$? -eq 2 ]; then				\
+		$(RM) $@.$$$$;				\
 		$(ERR) Parse failure for $<;		\
 		exit 1;					\
-	fi
+	fi;						\
+	if [ ! -s $@.$$$$ ]; then			\
+		$(RM) $@.$$$$;				\
+		$(ERR) Truncated generation for $@;	\
+		exit 1;					\
+	fi;						\
+	$(MV) -f $@.$$$$ $@
 
