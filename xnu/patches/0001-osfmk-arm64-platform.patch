+    unsigned int pstat __unused, const char *comm __unused,
+    const char *name __unused)
+{
+}
+
+void
+laguna_stallwatch_note_text(const char *buf __unused, size_t len __unused)
+{
+}
+
+boolean_t
+laguna_stallwatch_enabled(void)
+{
+	return FALSE;
+}
+
+#endif /* LAGUNA */
diff --git a/osfmk/arm64/laguna_panicdump.h b/osfmk/arm64/laguna_panicdump.h
new file mode 100644
index 0000000..f8cab45
--- /dev/null
+++ b/osfmk/arm64/laguna_panicdump.h
@@ -0,0 +1,261 @@
+/*
+ * laguna_panicdump — capture the kernel's panic output into the ramoops
+ * console zone (PA 0x95200000) on the panic path, plus a magic-tagged mirror
+ * record in the pmsg zone (PA 0x95400000).
+ *
+ * Device truth driving this: the teguload v3 ladder ran XNU on the Pixel 10
+ * Pro and the kernel panicked ~119 s in ("Early Kernel PANIC", CDD reason
+ * 0xbab9) with NO backtrace or console captured anywhere — no UART, no fbcon
+ * dump, no RAM dump artifacts. The ramoops reserved-memory zone at
+ * 0x95200000 (4 MiB: console 2 MiB then pmsg 2 MiB, DT node ramoops@95200000)
+ * survives resets and is exposed by Android as /sys/fs/pstore/console-ramoops-0
+ * (ABL console) and /sys/fs/pstore/pmsg-ramoops-0 (the proven marker/diag
+ * readback channel). Writing the panic output there makes the next Android
+ * boot hand us the backtrace.
+ *
+ * Format is Linux fs/pstore/ram_core.c persistent_ram semantics, no ECC (the
+ * DT node carries no ecc-size):
+ *   struct persistent_ram_buffer { u32 sig; u32 start; u32 size; u8 data[]; }
+ *   sig   = 0x43474244 ('DBGC' = PERSISTENT_RAM_SIG ^ per-zone sig(0))
+ *   start = ring offset of the oldest valid byte, start <= buffer_size
+ *   size  = valid byte count, size <= buffer_size
+ *   data  = ring at zone offset 12; buffer_size = zone_size - 12
+ * The console-zone append mirrors persistent_ram_write() exactly so Linux
+ * linearizes our bytes into console-ramoops-0 right after ABL's log.
+ *
+ * Boot args (PE boot args, 0118/0121 gate discipline):
+ *   lagunapanicdump=<0|1>  default ON (1). 0 disables the mapping AND the
+ *                          panic-time writes entirely.
+ *   lagunapanictest=<sec>  default 0 (off). >0 arms a kernel thread that
+ *                          panics after <sec> seconds — the QEMU validation
+ *                          needle.
+ *   lagunalogdump=<0|1>    default ON (1). 0 disables only the additive
+ *                          XNU-MSGBUF v1 mirror and LGLW breadcrumbs; the
+ *                          0123/0124 panic capture remains independent.
+ *
+ * The panic-time writer is minimal and fault-guarded: no allocation, no
+ * locks, no printf, every access bounds-checked against the mapped zone,
+ * data written BEFORE the header (a fault mid-write leaves the header
+ * untouched, i.e. the old consistent state Linux already knows about).
+ */
+#ifndef _ARM64_LAGUNA_PANICDUMP_H_
+#define _ARM64_LAGUNA_PANICDUMP_H_
+
+#include <stddef.h>
+#include <stdint.h>
+#include <sys/cdefs.h>                 /* __unused (stub path) */
+
+#ifndef LAGUNA_PANICDUMP_HOSTTEST
+#include <mach/mach_types.h>           /* vm_size_t (kernel builds) */
+#else
+#include <stdint.h>                    /* host: vm_size_t = uint64_t */
+typedef uint64_t vm_size_t;
+#endif
+
+__BEGIN_DECLS
+
+/*
+ * Late arm_init hook: parse boot args, map the ramoops zone (Device memory —
+ * the physmap window does NOT cover the low bank on either the device, whose
+ * declared-clean bank is 0x8_80000000+, or the 256 MiB QEMU contract that
+ * ends at 0x90000000, so phystokv() must not be used here), validate the
+ * persistent_ram header, and arm the lagunapanictest thread.
+ */
+void laguna_panicdump_init(void);
+
+/* R4 always-on msgbuf mirror. early_init runs immediately after arm_vm_init,
+ * before serial_init; late_init only logs/retries after kprintf is ready. */
+void laguna_logdump_early_init(void);
+void laguna_logdump_late_init(void);
+
+/* Called from log_putc_locked after the source ring accepts a byte. The caller
+ * already holds the BSD log lock; this path allocates and locks nothing. */
+void laguna_logdump_putc(char c, uint32_t bufx);
+
+/* Refresh source metadata and seq. Reason flags are cumulative in the record;
+ * zero is the ordinary startup/periodic refresh. */
+#define LAGUNA_LOGDUMP_FLUSH_PANIC (1u << 1)
+#define LAGUNA_LOGDUMP_FLUSH_HALT  (1u << 2)
+void laguna_logdump_flush(uint32_t reason);
+
+/*
+ * Panic-path hook, called from SavePanicInfo (osfmk/arm/model_dep.c) after
+ * paniclog_flush() — the paniclog text (panic string + all backtraces) is
+ * complete in [paniclog, paniclog + paniclog_len) at that point. Appends the
+ * record into the console zone and writes the pmsg mirror. Safe to call when
+ * init never ran (no-ops).
+ */
+void laguna_panicdump_capture(const char *msg, const char *paniclog,
+    vm_size_t paniclog_len);
+
+/* 0125-class fixed-PA last-words stage writer.  The stage/producer/flag values
+ * and detail ABI are in <arm64/laguna_lastwords.h>.  Returns 0 when disabled,
+ * a positive sequence on commit, or a negative writer error.  Notes must be
+ * static bounded text (or a trusted kernel path), never a panic string. */
+long laguna_panicdump_stage(uint32_t stage, uint32_t producer, uint32_t flags,
+    uint64_t detail0, uint64_t detail1, uint64_t detail2, uint64_t detail3,
+    const char *note);
+
+/*
+ * Late-IOKit hook, called from AppleKeyStore::start (the first laguna IOKit
+ * driver — the earliest fully-threaded point on every delivery path):
+ * spawns the lagunapanictest panic needle (kernel threads are not runnable
+ * during arm_init — spawning there wedges the boot).
+ */
+void laguna_panicdump_bootdone(void);
+
+/*
+ * G29 AUTOCYCLE: arm the boot-arg-gated self-termination timer
+ * (blazer_autocycle=<seconds>, default 0 = off, zero behavioral change).
+ * Called from the pid-1 exec path (kern_exec.c) after the last fail-closed
+ * provisioning gate; a no-op unless the boot arg is set, and armed once
+ * per boot. On expiry the handler commits the evidence channels first
+ * (console-zone AUTOCYCLE-RESET marker, LGLW stage
+ * LW_STAGE_AUTOCYCLE_RESET, msgbuf mirror flush), then enters the same
+ * reset tail the panic path ends in (halt_all_cpus(TRUE) ->, with
+ * blazer_psci_reset=1, psci_smp_diagnostic_reset()'s PSCI SYSTEM_RESET),
+ * which parks the phone in the armed fastboot slot and lets the boot loop
+ * cycle unattended. A boot that panics before expiry never reaches this:
+ * the panic reset is the same call.
+ */
+void laguna_autocycle_arm(void);
+
+/*
+ * G38 STALL-WATCH: locate silent pid-1 hangs. blazer_stallwatch=<seconds>
+ * (default 0 = off, zero behavioral change) arms a re-armable watchdog at
+ * the pid-1 exec point (kern_exec.c, next to the G29 autocycle arm): every
+ * write(2)/write_nocancel from pid 1 observed on the BSD syscall path
+ * postpones it, so expiry means N true seconds of pid-1 write silence.
+ * On expiry the handler prints the last captured write marker (command,
+ * syscall, error, process state, decoded write text) and panics with a
+ * distinctive "STALL-WATCH" string — the proven autonomous park then
+ * holds the full console + mirror and the panic backtrace adds the
+ * kernel-side view. One-shot and idempotent (state 0->1 at arm, 1->2 at
+ * fire); a watchdog that already fired can never be re-armed.
+ *
+ *   laguna_stallwatch_arm()       -- kern_exec.c pid-1 exec site
+ *   laguna_stallwatch_enabled()   -- systemcalls.c probe gate (cheap: one
+ *                                    relaxed load; FALSE when off)
+ *   laguna_stallwatch_activity()  -- systemcalls.c probe on pid-1 writes:
+ *                                    update marker + postpone deadline
+ *   laguna_stallwatch_note_text() -- systemcalls.c systrace_report()
+ *                                    write-text aid: capture the decoded
+ *                                    dying-words text into the marker
+ * Composes with blazer_autocycle as a separate timer: stallwatch fires
+ * first whenever N < autocycle's absolute deadline is reached while pid 1
+ * is silent (see G38 DESIGN.md §5 for the full interaction table).
+ */
+void laguna_stallwatch_arm(void);
+boolean_t laguna_stallwatch_enabled(void);
+void laguna_stallwatch_activity(unsigned short syscode, int error,
+    unsigned int pstat, const char *comm, const char *name);
+void laguna_stallwatch_note_text(const char *buf, size_t len);
+
+/* ---- G15 COREMIRROR (pan2-coremirror) ----
+ *
+ * Userland corefile survival for rw-root boots: kern_core.c tees the
+ * leading bytes of the newest corefile into a static kernel stage buffer
+ * (normal context, claim/observe seam below), and the panic capture mirrors
+ * the staged prefix into the pmsg zone at +0x142040 — the unclaimed tail
+ * above the PAN2 window — so the core survives the post-panic fastboot park
+ * exactly like the PAN2 record does (raw fixed-offset zone placement, its
+ * own CRC, no pmsg-zone header interaction).
+ *
+ * Zero new boot args: armed whenever the panic capture is armed
+ * (lagunapanicdump >= 1); the kern_core.c tee is a no-op branch when the
+ * capture is not armed, so a disabled build is byte-identical.
+ *
+ * Record layout (little-endian, fixed 64-byte header; r2):
+ *   +0  char[16]  "XNU-CORE v1"
+ *   +16 u32       quick-scan tag 'CORE' (0x45524f43), committed LAST
+ *   +20 u32       CRC-32/IEEE over [+24, +64 + payload_len)
+ *   +24 u32       payload_len (bytes of the corefile prefix mirrored)
+ *   +28 u32       flags (LAGUNA_CORE_F_*)
+ *   +32 u64       dumping pid
+ *   +40 u64       per-boot entry nonce (XNUENT1, the PAN2 binding source);
+ *                 a record whose nonce does not match the boot's committed
+ *                 XNUENT1 nonce is a previous warm-reset boot's and must be
+ *                 ignored by readers
+ *   +48 u64       staged extent high-water (honest prefix length)
+ *   +56 u8[8]     p_comm prefix of the dumper (bounded, NUL-padded)
+ *   +64           payload = the corefile's [0, payload_len) prefix at TRUE
+ *                 file offsets (sparse holes zero), i.e. a directly
+ *                 parseable MH_CORE prefix: header + LC_SEGMENT_64 table +
+ *                 LC_THREAD arm64 state (pc/lr/sp/far) for coresym.
+ *
+ * The record occupies pmsg+0x142040 .. pmsg+0x200000 (payload max
+ * 0xBDF80 = 778,112 bytes). Android's /dev/pmsg0 ring writes from the zone
+ * head and only reaches the tail after ~1.29 MiB of accumulated volume per
+ * zap; CRC + nonce + magic2-last commit make an overwritten, stale-boot, or
+ * torn record read as invalid/foreign, never as a wrong one (same
+ * discipline as the PAN2 window above).
+ *
+ * Panic-context placement (OC15 r2): the mirror writer runs at the very END
+ * of a completed panic capture — after the PANIC status record, PAN2/PAN1,
+ * and every console append — plus one gated reclaim in kdp_machine_reboot_type
+ * (the nested-panic bailout's only other stop). An attempt counter is
+ * armed BEFORE any zone work, so a fault in the writer can repeat at most
+ * once (the reclaim) and can never starve the existing channels on nested
+ * panics. Per attempt: <=250 ms (cntvct_el0 deadline), <=500 ms total, then
+ * LAGUNA_CORE_F_MIRROR_TRUNC with whatever prefix landed.
+ */
+#define LAGUNA_CORE_OFF          0x142040ull /* pmsg-relative record base */
+#define LAGUNA_CORE_HDR_SIZE     64u
+#define LAGUNA_CORE_PAYLOAD_MAX  0xBDF80u    /* 778,112 B zone-tail capacity */
+
+/* Record header layout offsets (little-endian). */
+#define LAGUNA_CORE_LEN_OFF      24u
+#define LAGUNA_CORE_FLAGS_OFF    28u
+#define LAGUNA_CORE_PID_OFF      32u
+#define LAGUNA_CORE_NONCE_OFF    40u
+#define LAGUNA_CORE_EXTENT_OFF   48u
+#define LAGUNA_CORE_COMM_OFF     56u
+#define LAGUNA_CORE_COMM_SIZE    8u
+
+/* Record flags. */
+#define LAGUNA_CORE_F_CLAIMED    (1u << 0)
+#define LAGUNA_CORE_F_HEADER     (1u << 1)  /* MH_CORE prefix staged at +0 */
+#define LAGUNA_CORE_F_HDR_TRUNC  (1u << 2)  /* header exceeded the 32 KiB guard */
+#define LAGUNA_CORE_F_INITPROC   (1u << 3)  /* dumper was initproc (pid 1) */
+#define LAGUNA_CORE_F_READFAULT  (1u << 4)  /* a copy faulted; prefix partial */
+#define LAGUNA_CORE_F_STAGE_TRUNC (1u << 5) /* corefile larger than the mirror */
+#define LAGUNA_CORE_F_MIRROR_TRUNC (1u << 6) /* mirror copy hit the time budget */
+
+/* kern_core.c tee seam (normal kernel context). All no-ops unless the
+ * panic capture is armed. `proc` is the coredumping proc_t used as the
+ * claim identity; `uaddr` is the user-space source of the segment bytes;
+ * `foff` is the true corefile offset the bytes were written at. */
+int  laguna_corestage_claim(void *proc, int pid, const char *comm);
+void laguna_corestage_observe_segment(void *proc, uint64_t foff,
+    const void *uaddr, uint64_t len);
+void laguna_corestage_observe_header(void *proc, const void *kbuf,
+    uint64_t hdr_size, uint64_t file_extent);
+
+/* Panic-path mirror reclaim (OC15 r2): bounded last chance for a core
+ * mirror that never ran at a capture end or hit its time budget. Called
+ * from kdp_machine_reboot_type (debug.c) AFTER laguna_logdump_flush(HALT) —
+ * the nested-panic bailout's only other stop. Gated: <=250 ms per attempt,
+ * <=500 ms total, never repeats a faulting copy, no-ops unless a core was
+ * dumped this boot. */
+void laguna_panicdump_core_mirror_reclaim(void);
+
+/* Pure seams (defined in the .c outside the kernel-only guard so host
+ * selftests exercise the exact claim decision, CRC, and record packing the
+ * panic path runs). */
+int      laguna_core_claim_decision(uint32_t cur_pid, uint32_t cur_extent,
+    int pid);
+uint32_t laguna_core_record_crc_init(void);
+uint32_t laguna_core_record_crc_update(uint32_t c, const volatile uint8_t *p,
+    uint32_t n);
+uint32_t laguna_core_record_crc_final(uint32_t c);
+uint32_t laguna_core_record_crc(const volatile uint8_t *p, uint32_t n);
+void     laguna_core_record_pack(uint8_t *out, uint32_t plen, uint32_t flags,
+    uint32_t pid, const uint8_t *comm, uint64_t nonce, uint64_t extent);
+int      laguna_core_record_unpack(const volatile uint8_t *in, uint32_t *plen,
+    uint32_t *flags, uint32_t *pid, uint8_t *comm, uint64_t *nonce,
+    uint64_t *extent, uint32_t *crc);
+int      laguna_core_record_nonce_ok(uint64_t record_nonce, uint64_t boot_nonce);
+
+__END_DECLS
+
+#endif /* _ARM64_LAGUNA_PANICDUMP_H_ */
diff --git a/osfmk/arm64/laguna_render_port.h b/osfmk/arm64/laguna_render_port.h
new file mode 100644
index 0000000..4c298e1
--- /dev/null
+++ b/osfmk/arm64/laguna_render_port.h
@@ -0,0 +1,214 @@
+/*
+ * Laguna display/render handoff and CPM power-sequence contracts.
+ *
+ * Host-testable data-only code: no MMIO, no device access, no XNU headers.
+ * The binary handoff is produced by the display-owning first stage, not by
+ * reading DC9x00 registers in XNU.  All multi-byte fields are little-endian
+ * (both the first stage and XNU are AArch64 little-endian).
+ */
+#ifndef LAGUNA_RENDER_PORT_H
+#define LAGUNA_RENDER_PORT_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define LAGUNA_DISPLAY_HANDOFF_MAGIC UINT64_C(0x313030505344474c) /* "LGDSP001" as little-endian bytes */
+#define LAGUNA_DISPLAY_HANDOFF_VERSION 1u
+#define LAGUNA_DISPLAY_HANDOFF_SIZE 128u
+#define LAGUNA_DISPLAY_HANDOFF_CRC_OFFSET 112u
+
+/* DRM fourcc values whose little-endian memory order is B,G,R,(A/X). */
+#define LAGUNA_PIXEL_ARGB8888 UINT32_C(0x34325241) /* AR24 */
+#define LAGUNA_PIXEL_XRGB8888 UINT32_C(0x34325258) /* XR24 */
+
+enum laguna_display_flags {
+	LAGUNA_DISPLAY_CPU_PA_VALID       = UINT64_C(1) << 0,
+	LAGUNA_DISPLAY_DPU_IOVA_VALID     = UINT64_C(1) << 1,
+	LAGUNA_DISPLAY_LINEAR_32BPP       = UINT64_C(1) << 2,
+	LAGUNA_DISPLAY_PHYS_CONTIGUOUS    = UINT64_C(1) << 3,
+	LAGUNA_DISPLAY_RESERVED           = UINT64_C(1) << 4,
+	LAGUNA_DISPLAY_DPU_CONFIGURED     = UINT64_C(1) << 5,
+	LAGUNA_DISPLAY_POWER_RETAINED     = UINT64_C(1) << 6,
+	LAGUNA_DISPLAY_IOMMU_RETAINED     = UINT64_C(1) << 7,
+	LAGUNA_DISPLAY_SCANOUT_LIVE       = UINT64_C(1) << 8
+};
+
+#define LAGUNA_DISPLAY_KNOWN_FLAGS ( \
+	LAGUNA_DISPLAY_CPU_PA_VALID | LAGUNA_DISPLAY_DPU_IOVA_VALID | \
+	LAGUNA_DISPLAY_LINEAR_32BPP | LAGUNA_DISPLAY_PHYS_CONTIGUOUS | \
+	LAGUNA_DISPLAY_RESERVED | LAGUNA_DISPLAY_DPU_CONFIGURED | \
+	LAGUNA_DISPLAY_POWER_RETAINED | LAGUNA_DISPLAY_IOMMU_RETAINED | \
+	LAGUNA_DISPLAY_SCANOUT_LIVE)
+
+#define LAGUNA_DISPLAY_REQUIRED_FLAGS LAGUNA_DISPLAY_KNOWN_FLAGS
+
+/*
+ * Cold-handoff flag policy (DISPLAY-PRODUCER §3.2, fail-closed): a producer
+ * that has not proven DPU power, configuration, IOMMU mapping and live scanout
+ * must assert exactly the CPU-side facts — CPU_PA_VALID, LINEAR_32BPP,
+ * PHYS_CONTIGUOUS, RESERVED — and nothing more.  Any ownership/liveness bit
+ * (LAGUNA_DISPLAY_LIVE_FLAGS) in a record switches it onto the full
+ * REQUIRED_FLAGS contract instead; a record carrying some but not all of them
+ * is refused outright (a partial ownership claim is never adopted).  A cold
+ * record must also leave DPU_IOVA_VALID unset: with dpu_iova=0 and
+ * mapping_kind NONE there is no DPU mapping to be valid.
+ */
+#define LAGUNA_DISPLAY_COLD_REQUIRED ( \
+	LAGUNA_DISPLAY_CPU_PA_VALID | LAGUNA_DISPLAY_LINEAR_32BPP | \
+	LAGUNA_DISPLAY_PHYS_CONTIGUOUS | LAGUNA_DISPLAY_RESERVED)
+#define LAGUNA_DISPLAY_LIVE_FLAGS ( \
+	LAGUNA_DISPLAY_DPU_CONFIGURED | LAGUNA_DISPLAY_POWER_RETAINED | \
+	LAGUNA_DISPLAY_IOMMU_RETAINED | LAGUNA_DISPLAY_SCANOUT_LIVE)
+#define LAGUNA_DISPLAY_COLD_FORBIDDEN ( \
+	LAGUNA_DISPLAY_DPU_IOVA_VALID | LAGUNA_DISPLAY_LIVE_FLAGS)
+
+enum laguna_display_mapping {
+	LAGUNA_DISPLAY_MAPPING_NONE = 0, /* no DPU mapping claimed (cold handoff) */
+	LAGUNA_DISPLAY_MAPPING_IDENTITY = 1,
+	LAGUNA_DISPLAY_MAPPING_FIRST_STAGE_SMMU = 2
+};
+
+enum laguna_display_cache {
+	LAGUNA_DISPLAY_CACHE_WRITE_COMBINE = 1,
+	LAGUNA_DISPLAY_CACHE_CLEAN_ON_PRESENT = 2
+};
+
+/*
+ * Version-1 wire record, exactly 128 bytes.  Keep fields in this order and do
+ * not insert native pointers.  reserved[] must be zero for forward rejection.
+ */
+struct laguna_display_handoff {
+	uint64_t magic;
+	uint32_t version;
+	uint32_t struct_size;
+	uint64_t flags;
+	uint64_t cpu_pa;
+	uint64_t cpu_size;
+	uint64_t dpu_iova;
+	uint64_t reserve_pa;
+	uint64_t reserve_size;
+	uint32_t width;
+	uint32_t height;
+	uint32_t stride;
+	uint32_t pixel_format;
+	uint32_t refresh_millihz;
+	uint32_t mapping_kind;
+	uint32_t cache_kind;
+	uint32_t commit_generation;
+	uint8_t producer[16];
+	uint32_t crc32;
+	uint32_t reserved[3];
+};
+
+struct laguna_memory_range {
+	uint64_t base;
+	uint64_t size;
+};
+
+struct laguna_boot_video {
+	uint64_t base;
+	uint32_t width;
+	uint32_t height;
+	uint32_t row_bytes;
+	uint32_t depth;
+	uint32_t graphics_mode;
+};
+
+enum laguna_display_error {
+	LAGUNA_DISPLAY_OK = 0,
+	LAGUNA_DISPLAY_BAD_ARGUMENT,
+	LAGUNA_DISPLAY_BAD_MAGIC,
+	LAGUNA_DISPLAY_BAD_VERSION,
+	LAGUNA_DISPLAY_BAD_STRUCT_SIZE,
+	LAGUNA_DISPLAY_BAD_RESERVED,
+	LAGUNA_DISPLAY_BAD_CRC,
+	LAGUNA_DISPLAY_MISSING_FLAGS,
+	LAGUNA_DISPLAY_UNKNOWN_FLAGS,
+	LAGUNA_DISPLAY_BAD_FORMAT,
+	LAGUNA_DISPLAY_BAD_GEOMETRY,
+	LAGUNA_DISPLAY_BAD_STRIDE,
+	LAGUNA_DISPLAY_BAD_CPU_PA,
+	LAGUNA_DISPLAY_BAD_CPU_SIZE,
+	LAGUNA_DISPLAY_BAD_IOVA,
+	LAGUNA_DISPLAY_BAD_MAPPING,
+	LAGUNA_DISPLAY_BAD_RESERVATION,
+	LAGUNA_DISPLAY_BAD_CACHE,
+	LAGUNA_DISPLAY_BAD_PRODUCER,
+	LAGUNA_DISPLAY_BAD_GENERATION,
+	LAGUNA_DISPLAY_RANGE_OVERFLOW,
+	LAGUNA_DISPLAY_RANGE_OVERLAP
+};
+
+/* Set struct_size/version-independent CRC after the producer fills the record. */
+void laguna_display_handoff_seal(struct laguna_display_handoff *handoff);
+
+/* Validate all fields and ensure the reserved framebuffer avoids forbidden RAM. */
+enum laguna_display_error laguna_display_validate(
+	const struct laguna_display_handoff *handoff,
+	const struct laguna_memory_range *forbidden,
+	size_t forbidden_count);
+
+/*
+ * Validate a cold (RAM-console) handoff: identical integrity, geometry,
+ * reservation and forbidden-range rules, but the flag policy is
+ * LAGUNA_DISPLAY_COLD_REQUIRED only and no DPU mapping may be claimed
+ * (dpu_iova == 0, mapping_kind == NONE).  Acceptance proves the buffer is a
+ * reserved CPU-side RAM console — it is never a scanout claim.  The checks are
+ * kept textually parallel to laguna_display_validate so the golden
+ * single-bit-corruption error-code mapping stays stable for both tiers.
+ */
+enum laguna_display_error laguna_display_validate_cold(
+	const struct laguna_display_handoff *handoff,
+	const struct laguna_memory_range *forbidden,
+	size_t forbidden_count);
+
+/* Convert a valid record into the boot_args.video equivalent; never touches MMIO. */
+enum laguna_display_error laguna_display_boot_video(
+	const struct laguna_display_handoff *handoff,
+	const struct laguna_memory_range *forbidden,
+	size_t forbidden_count,
+	struct laguna_boot_video *video);
+
+const char *laguna_display_error_string(enum laguna_display_error error);
+
+/* CPM power-on sequence: data only.  The executor owns polled MBA transport. */
+enum laguna_cpm_step {
+	LAGUNA_CPM_QUEUE_RESET = 0,
+	LAGUNA_CPM_DPU_TOP_ON,
+	LAGUNA_CPM_DSI0_ON,
+	LAGUNA_CPM_FE0_ON,
+	LAGUNA_CPM_FE1_ON
+};
+
+enum laguna_cpm_completion {
+	LAGUNA_CPM_COMPLETION_TX_DONE = 0,
+	LAGUNA_CPM_COMPLETION_LPB_ACK_AND_OPTIONAL_EVENT,
+	LAGUNA_CPM_COMPLETION_LPCM_ACK_ZERO
+};
+
+struct laguna_cpm_frame {
+	enum laguna_cpm_step step;
+	uint32_t sequence;
+	uint32_t token;
+	uint32_t words[4]; /* queue header + three service payload words */
+	enum laguna_cpm_completion completion;
+	uint32_t destination_service;
+};
+
+/* Returns 0 on invalid arguments/insufficient capacity, otherwise frame count. */
+size_t laguna_dpu_power_on_sequence(struct laguna_cpm_frame *frames,
+	size_t capacity, bool include_fe1);
+
+/* Sequence values are 1..13.  0 (initial) and 13 map to 1; other invalid values map to 0. */
+uint32_t laguna_cpm_next_sequence(uint32_t current);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* LAGUNA_RENDER_PORT_H */
diff --git a/osfmk/arm64/loader_return.c b/osfmk/arm64/loader_return.c
new file mode 100644
index 0000000..9dcd99b
--- /dev/null
+++ b/osfmk/arm64/loader_return.c
@@ -0,0 +1,597 @@
+/*
+ * Return-to-loader debug channel.
+ *
+ * On hardware without a serial port there is no way to get the kernel log
+ * out. The XNU loader therefore leaves UEFI intact (no ExitBootServices) and
+ * publishes the physical address of a return stub in /chosen/loader-return.
+ * When the kernel has nothing more to do (panic, halt, timer) it collects its
+ * message buffer, the panic buffer and any kprintf output, maps the stub 1:1
+ * through TTBR0 and jumps to it with that log. The loader then restores the UEFI environment and writes
+ * the log to storage.
+ *
+ * Only valid while the kernel does not drive hardware that UEFI also uses.
+ */
+#include <mach/mach_types.h>
+#include <machine/atomic.h>
+#include <kern/cpu_number.h>
+#include <kern/debug.h>
+#include <kern/startup.h>
+#include <kern/thread_call.h>
+#include <kern/clock.h>
+#include <arm/cpu_internal.h>
+#include <arm/machine_routines.h>
+#include <arm64/psci_smp.h>
+#include <arm64/proc_reg.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/arm64/board_config.h>
+#include <vm/vm_page.h>
+#include <vm/vm_compressor.h>
+
+/*
+ * The console log handed back to the loader. A long session writes more than fits, and both
+ * ends matter: the start of the boot is kept as it is, and of everything after it the most
+ * recent part (a ring); room is left for what is appended on the way out (the kernel message
+ * buffer, a panic's text). loader_log_linearize() puts the pieces in order before returning.
+ */
+#define LOADER_LOG_SIZE (1536 * 1024)
+#define LOADER_LOG_HEAD (256 * 1024)
+#define LOADER_LOG_RING (1024 * 1024)
+
+#if defined(GENERIC_GIC_V3_IRQ)
+extern void gic_v3_irq_quiesce(void);
+extern void gic_v3_irq_cpu_shutdown(void);
+#endif
+
+void loader_log_putc(char c);
+void loader_return(void);
+extern void hakios_adreno_quiesce(void);
+extern void hakios_adreno_stop(void);
+extern void hakios_adreno_minute(void);
+extern void hakios_wifi_stop(void);
+extern void hakios_wifi_quiesce(void);
+extern void hakios_adsp_stop(void);
+extern void hakios_adsp_quiesce(void);
+extern void hakios_mpss_stop(void);
+extern void hakios_mpss_quiesce(void);
+extern void hakios_ddr_quiesce(void);
+extern void hakios_haptic_quiesce(void);
+extern void hakios_torch_quiesce(void);
+extern void hakios_camera_quiesce(void);
+extern void hakios_mic_quiesce(void);
+extern void hakios_ufs_quiesce(void);
+extern void hakios_var_save_on_return(void);   /* bsd/dev/hakios.ufs.c: the data volume into the flash */
+void loader_checkpoint(uint64_t n);
+
+/* Also referenced from the early exception vector in start.s. */
+char     loader_log[LOADER_LOG_SIZE];
+uint32_t loader_log_len;
+static bool     loader_return_entered;
+
+/* One L1 table and one L2 table are enough to map a single 2 MB block. */
+static uint64_t loader_l1[512] __attribute__((aligned(4096)));
+static uint64_t loader_l2[512] __attribute__((aligned(4096)));
+
+static uint32_t loader_log_ring_at;      /* where the next character goes in the ring */
+static bool     loader_log_wrapped;
+static bool     loader_log_linear;       /* the pieces have been put in order: only appending from now on */
+static char     loader_log_scratch[LOADER_LOG_RING];
+
+/*
+ * Characters come from every processor, and from interrupt handlers on top of whatever was
+ * writing one. The lock is of the simplest kind, good from the first line of C code to the
+ * last of a panic; whoever cannot have it for a long while (its holder is gone: a panic
+ * inside this very function) goes ahead without it.
+ */
+static uint32_t loader_log_lock;
+
+static void loader_log_put_locked(char c);
+
+void
+loader_log_putc(char c)
+{
+	uint64_t daif;
+	bool locked = false;
+
+	if (c == '\r') {
+		return;
+	}
+	daif = __builtin_arm_rsr64("DAIF");
+	__builtin_arm_wsr("DAIFSet", DAIFSC_IRQF | DAIFSC_FIQF);
+	for (uint32_t tries = 0; !locked && tries < 10000000; tries++) {
+		locked = os_atomic_cmpxchg(&loader_log_lock, 0, 1, acquire);
+	}
+	loader_log_put_locked(c);
+	if (locked) {
+		os_atomic_store(&loader_log_lock, 0, release);
+	}
+	__builtin_arm_wsr64("DAIF", daif);
+}
+
+/*
+ * A whole line at once, under the lock: lines written from several processors at the same time
+ * (tools/latency.py's "tl:" lines, a frame's on one and a touch's on another) are not mixed up.
+ */
+void loader_log_line(const char *line);
+
+void
+loader_log_line(const char *line)
+{
+	uint64_t daif;
+	bool locked = false;
+
+	daif = __builtin_arm_rsr64("DAIF");
+	__builtin_arm_wsr("DAIFSet", DAIFSC_IRQF | DAIFSC_FIQF);
+	for (uint32_t tries = 0; !locked && tries < 10000000; tries++) {
+		locked = os_atomic_cmpxchg(&loader_log_lock, 0, 1, acquire);
+	}
+	for (; *line != 0; line++) {
+		if (*line != '\r') {
+			loader_log_put_locked(*line);
+		}
+	}
+	if (locked) {
+		os_atomic_store(&loader_log_lock, 0, release);
+	}
+	__builtin_arm_wsr64("DAIF", daif);
+}
+
+static void
+loader_log_put_locked(char c)
+{
+	if (loader_log_linear || loader_log_len < LOADER_LOG_HEAD) {
+		if (loader_log_len < LOADER_LOG_SIZE) {
+			loader_log[loader_log_len++] = c;
+		}
+	} else {
+		loader_log[LOADER_LOG_HEAD + loader_log_ring_at] = c;
+		if (++loader_log_ring_at == LOADER_LOG_RING) {
+			loader_log_ring_at = 0;
+			loader_log_wrapped = true;
+		}
+		if (!loader_log_wrapped) {
+			loader_log_len = LOADER_LOG_HEAD + loader_log_ring_at;
+		}
+	}
+}
+
+/* Oldest first: the head, a note about what was dropped, then the ring from its oldest character. */
+static void
+loader_log_linearize(void)
+{
+	static const char note[] = "\n\n[... the log between the first 256 KB and the last 1 MB was dropped ...]\n\n";
+	uint32_t older = LOADER_LOG_RING - loader_log_ring_at, n = LOADER_LOG_HEAD;
+
+	if (loader_log_linear) {
+		return;
+	}
+	loader_log_linear = true;
+	if (!loader_log_wrapped) {
+		return;
+	}
+	__builtin_memcpy(loader_log_scratch, loader_log + LOADER_LOG_HEAD + loader_log_ring_at, older);
+	__builtin_memcpy(loader_log_scratch + older, loader_log + LOADER_LOG_HEAD, loader_log_ring_at);
+	/* the note takes the place of the oldest characters of the ring */
+	__builtin_memcpy(loader_log + n, note, sizeof(note) - 1);
+	n += sizeof(note) - 1;
+	__builtin_memcpy(loader_log + n, loader_log_scratch + sizeof(note) - 1, LOADER_LOG_RING - (sizeof(note) - 1));
+	loader_log_len = LOADER_LOG_HEAD + LOADER_LOG_RING;
+}
+
+/* Patched by the loader: { magic, PA of its return stub, checkpoint to stop at, PA - VA }. See start.s. */
+extern uint64_t loader_stub_slot[4];
+
+/*
+ * For a loader that watches from another processor core while the kernel runs (it starts the
+ * kernel on a core of its choice and stays on the first one): a sign of life, and where the log
+ * is, so that the log of a kernel that hangs -- or dies before it has said a word through any
+ * other channel -- is not lost with it. The loader finds this by its first word in the kernel
+ * it has loaded. The addresses are the kernel's virtual ones, filled in by the linker and so
+ * valid from the first instruction; the loader knows the distance to the physical ones.
+ */
+struct loader_live {
+	uint64_t magic;                 /* "XNULIVE!" */
+	uint64_t heartbeat;             /* goes up every HV_WDT_PET_SECONDS while the kernel is alive */
+	const char *log;                /* loader_log */
+	const uint32_t *log_len;        /* how much of it is in use */
+	const uint32_t *log_ring_at;    /* where the ring part is being written */
+	const bool *log_wrapped;        /* the ring has gone round */
+	uint64_t log_head, log_ring;    /* sizes of the two parts */
+	const uint64_t *recording;      /* loader_recording: { physical address, length } of a screen recording */
+	volatile uint64_t stop;         /* the loader's to write: the host has asked for the run to end */
+	uint64_t magic2;                /* "XNULIVE2": what follows is there (a loader may meet an older kernel) */
+	const uint64_t *sound;          /* loader_sound: the same for a recording of the sound */
+};
+
+/*
+ * A screen recording (the display driver makes one with boot-arg rec_secs): where it is, for the
+ * loader to hand to the host once the kernel is back. { physical address, bytes, kernel address }.
+ */
+uint64_t loader_recording[3];
+/* ... and of the sound (/dev/hakios-audio makes one with boot-arg rec_sound). */
+uint64_t loader_sound[3];
+
+struct loader_live loader_live = {
+	.magic = 0x214556494c554e58ULL, .log = loader_log, .log_len = &loader_log_len, .log_ring_at = &loader_log_ring_at,
+	.log_wrapped = &loader_log_wrapped, .log_head = LOADER_LOG_HEAD, .log_ring = LOADER_LOG_RING,
+	.recording = loader_recording,
+	.magic2 = 0x324556494c554e58ULL, .sound = loader_sound,
+};
+
+/* Valid from the first instruction of C code: does not depend on gVirtBase/gPhysBase being set up. */
+static inline uint64_t
+static_kvtophys(const void *va)
+{
+	return (uint64_t)va + loader_stub_slot[3];
+}
+
+/*
+ * Jump to the loader's return stub. reason: 0 = orderly end, 2 = checkpoint.
+ * Returns only if no loader is listening.
+ */
+static void
+loader_jump(uint64_t reason, uint64_t code)
+{
+#if ARM_PGSHIFT == 12
+	uint64_t stub = loader_stub_slot[1];
+	uint64_t tcr, t0sz;
+	uint32_t own_core = 0;
+
+	if (stub == 0 || loader_return_entered) {
+		return;
+	}
+
+	tcr = __builtin_arm_rsr64("TCR_EL1");
+	t0sz = tcr & 0x3f;
+	/* The TTBR0 walk must start at L1 (1 GB per entry) and reach the stub. */
+	if (t0sz < 25 || t0sz > 33 || (stub >> (64 - t0sz)) != 0) {
+		return;
+	}
+	loader_return_entered = true;
+#if defined(GENERIC_GIC_V3_IRQ)
+	gic_v3_irq_quiesce();
+	/*
+	 * With a core of its own (bootcpu=) the kernel does not go back into the loader's code on
+	 * this processor: the stub leaves the log where the loader's core finds it and has the
+	 * firmware switch this one off. It must go as the other cores do (psci_smp_cpu_off()), with
+	 * nothing pending: after a panic the "stop" signal and the timer are.
+	 */
+	if (PE_parse_boot_argn("bootcpu", &own_core, sizeof(own_core))) {
+		__builtin_arm_wsr64("CNTV_CTL_EL0", CNTV_CTL_EL0_IMASKED);
+		gic_v3_irq_cpu_shutdown();
+	}
+#endif
+
+	loader_l1[stub >> 30] = static_kvtophys(loader_l2) | ARM_TTE_TYPE_TABLE | ARM_TTE_VALID;
+	loader_l2[(stub >> 21) & 0x1ff] = (stub & ~0x1fffffULL) | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_AP(AP_RWNA) |
+	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITEBACK);
+
+	/*
+	 * The stub turns the MMU off, and on real hardware dirty cache lines do
+	 * not survive that: write the log back to RAM first.
+	 */
+	for (uintptr_t p = (uintptr_t)loader_log & ~63UL; p < (uintptr_t)loader_log + loader_log_len; p += 64) {
+		__asm__ volatile ("dc cvac, %0" : : "r" (p));
+	}
+	/* ... and a screen recording, and the note of where it is */
+	for (uintptr_t p = loader_recording[2] & ~63UL; p < loader_recording[2] + loader_recording[1]; p += 64) {
+		__asm__ volatile ("dc cvac, %0" : : "r" (p));
+	}
+	__asm__ volatile ("dc cvac, %0" : : "r" ((uintptr_t)loader_recording));
+	__asm__ volatile ("dc cvac, %0" : : "r" ((uintptr_t)loader_recording + 16));
+	for (uintptr_t p = loader_sound[2] & ~63UL; p < loader_sound[2] + loader_sound[1]; p += 64) {
+		__asm__ volatile ("dc cvac, %0" : : "r" (p));
+	}
+	__asm__ volatile ("dc cvac, %0" : : "r" ((uintptr_t)loader_sound));
+	__asm__ volatile ("dc cvac, %0" : : "r" ((uintptr_t)loader_sound + 16));
+	__asm__ volatile ("dsb sy");
+
+	register uint64_t r_ttbr0 __asm__("x0") = static_kvtophys(loader_l1);
+	register uint64_t r_log __asm__("x2") = static_kvtophys(loader_log);
+	register uint64_t r_len __asm__("x3") = loader_log_len;
+	register uint64_t r_tcr __asm__("x4") = tcr;
+	register uint64_t r_stub __asm__("x5") = stub;
+	register uint64_t r_reason __asm__("x6") = reason;
+	register uint64_t r_code __asm__("x7") = code;
+
+	__asm__ volatile (
+                "msr DAIFSet, #0xf\n"
+                "bic x4, x4, #0x80\n"           /* TCR_EL1.EPD0: allow TTBR0 walks */
+                "msr TCR_EL1, x4\n"
+                "msr TTBR0_EL1, x0\n"
+                "isb\n"
+                "tlbi vmalle1\n"
+                "dsb sy\n"
+                "isb\n"
+                "mov x0, x2\n"
+                "mov x1, x3\n"
+                "mov x2, x6\n"
+                "mov x3, x7\n"
+                "br x5\n"
+                : : "r" (r_ttbr0), "r" (r_log), "r" (r_len), "r" (r_tcr), "r" (r_stub), "r" (r_reason), "r" (r_code));
+	__builtin_unreachable();
+#else
+	(void)reason; (void)code;
+#endif /* ARM_PGSHIFT == 12 */
+}
+
+extern char *debug_buf_base, *debug_buf_ptr;
+
+/* bsd/sys/msgbuf.h (not includable from osfmk) */
+struct msgbuf {
+	int   msg_magic;
+	int   msg_size;
+	int   msg_bufx;         /* write pointer */
+	int   msg_bufr;         /* read pointer */
+	char *msg_bufc;         /* buffer */
+};
+extern struct msgbuf *msgbufp;
+
+static void
+loader_log_puts(const char *s)
+{
+	for (; *s; s++) {
+		loader_log_putc(*s);
+	}
+}
+
+/*
+ * Everything printf()/IOLog()/os_log wrote ends up in the kernel message
+ * buffer (what dmesg shows), whether or not a console displayed it.
+ */
+static void
+loader_log_append_msgbuf(void)
+{
+	struct msgbuf *mb = msgbufp;
+
+	if (mb == NULL || mb->msg_bufc == NULL || mb->msg_size <= 0 || mb->msg_bufx < 0 || mb->msg_bufx > mb->msg_size) {
+		return;
+	}
+	loader_log_puts("\n--- kernel message buffer ---\n");
+	/* oldest data first: [bufx, size) is only meaningful once the buffer has wrapped */
+	for (int pass = 0; pass < 2; pass++) {
+		int from = pass == 0 ? mb->msg_bufx : 0;
+		int to = pass == 0 ? mb->msg_size : mb->msg_bufx;
+		for (int i = from; i < to; i++) {
+			if (mb->msg_bufc[i] != 0) {
+				loader_log_putc(mb->msg_bufc[i]);
+			}
+		}
+	}
+}
+
+void
+loader_return(void)
+{
+#if defined(GENERIC_PSCI_SMP)
+	/*
+	 * With more than one processor: the others switch themselves off first, and the rest of
+	 * this is done by the boot processor, the one the loader gave us. This call comes back
+	 * on that processor only (on another one it has it call loader_return() in its turn).
+	 */
+	psci_smp_stop_others();
+#endif
+	hakios_ufs_quiesce();          /* this kernel's requests to the storage done, UEFI's list as it was, for the log */
+	hakios_adreno_quiesce();       /* the GPU block, if it was started, has tables in memory that is about to be reused */
+	hakios_wifi_quiesce();         /* the Wi-Fi DSP, if it still runs (a panic), is not left to itself */
+	hakios_adsp_quiesce();         /* nor the audio DSP */
+	hakios_mpss_quiesce();         /* nor the modem */
+	hakios_ddr_quiesce();          /* and the vote for the memory's bandwidth taken away */
+	hakios_haptic_quiesce();       /* the vibration motor's chip back into reset, if it was let out */
+	hakios_torch_quiesce();        /* the flashlight off, if it was lit */
+	hakios_camera_quiesce();       /* the camera powered down, if it was powered up */
+	hakios_mic_quiesce();          /* (what the microphones' path did, said again: it happens in the log's middle) */
+	/*
+	 * A panic's text is first collected in the panic buffer and only later
+	 * flushed to the console; if the console itself is what failed, that
+	 * never happens. Append the buffer so the loader gets it either way.
+	 */
+	loader_log_linearize();
+	if (!loader_return_entered) {
+		loader_log_append_msgbuf();
+	}
+	if (!loader_return_entered && debug_buf_base != NULL && debug_buf_ptr > debug_buf_base &&
+	    (size_t)(debug_buf_ptr - debug_buf_base) < 256 * 1024) {
+		loader_log_puts("\n--- panic buffer ---\n");
+		for (const char *c = debug_buf_base; c < debug_buf_ptr; c++) {
+			loader_log_putc(*c);
+		}
+	}
+	loader_jump(0, 0);
+}
+
+/* Bring-up aid: stop here if the loader asked for checkpoint n. */
+void
+loader_checkpoint(uint64_t n)
+{
+	if (loader_stub_slot[2] == n) {
+		loader_jump(2, n);
+	}
+}
+
+/*
+ * boot-arg loader_return_after=<seconds>: hand control back to the loader
+ * after that long, whatever the kernel is doing. This is how the log gets out
+ * when the kernel does not panic but simply waits (e.g. for a root device).
+ */
+/*
+ * For trying the ways out when there is more than one processor: boot-arg return_cpu=<n> has
+ * that processor make the timed return, from an interrupt handler -- any but the boot processor
+ * has to hand it over (psci_smp_stop_others()) --, and return_panic=1 makes a panic of it.
+ */
+static void
+loader_return_test(void *as_panic)
+{
+	if (as_panic != (void *)1) {
+		panic("return_panic: the panic that was asked for, on cpu %d", cpu_number());
+	}
+	loader_return();
+}
+
+static void
+loader_return_timer(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	static const char banner[] = "\n--- loader_return_after expired ---\n";
+	uint32_t cpu = 0, as_panic = 0;
+
+	for (const char *c = banner; *c; c++) {
+		loader_log_putc(*c);
+	}
+	PE_parse_boot_argn("return_panic", &as_panic, sizeof(as_panic));
+	if (!as_panic) {
+		hakios_var_save_on_return();   /* the data volume kept, while the system is still whole */
+		hakios_adreno_stop();          /* a GPU kept for the system is given back while there is a thread to wait in */
+		hakios_wifi_stop();            /* and the Wi-Fi DSP, if it runs, shut down */
+		hakios_adsp_stop();            /* and the audio DSP */
+		hakios_mpss_stop();            /* and the modem */
+	}
+	if (PE_parse_boot_argn("return_cpu", &cpu, sizeof(cpu)) && cpu <= (uint32_t)ml_get_max_cpu_number() &&
+	    cpu_xcall((int)cpu, loader_return_test, (void *)(uintptr_t)(as_panic ? 2 : 1)) == KERN_SUCCESS) {
+		for (;;) {
+			delay_for_interval(1000, NSEC_PER_MSEC);        /* that processor ends it */
+		}
+	}
+	loader_return_test((void *)(uintptr_t)(as_panic ? 2 : 1));
+}
+
+__startup_func
+static void
+loader_return_timer_init(void)
+{
+	uint32_t seconds = 0;
+	uint64_t deadline;
+
+	if (!PE_parse_boot_argn("loader_return_after", &seconds, sizeof(seconds)) || seconds == 0) {
+		return;
+	}
+	thread_call_t call = thread_call_allocate(loader_return_timer, NULL);
+	clock_interval_to_deadline(seconds, NSEC_PER_SEC, &deadline);
+	thread_call_enter_delayed(call, deadline);
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_LAST, loader_return_timer_init);
+
+/*
+ * A loader that watches from another core also listens to the host, and passes on a request to
+ * end the run ("xl stop") by setting loader_live.stop. Look once a second.
+ */
+static thread_call_t loader_stop_call;
+
+static void
+loader_stop_poll(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	uint64_t deadline;
+
+	if (loader_live.stop) {
+		static const char banner[] = "\n--- the host asked for the end of the run: back to the loader ---\n";
+		for (const char *c = banner; *c; c++) {
+			loader_log_putc(*c);
+		}
+		hakios_var_save_on_return();
+		hakios_adreno_stop();
+		hakios_wifi_stop();
+		hakios_adsp_stop();
+		loader_return();
+	}
+	clock_interval_to_deadline(1, NSEC_PER_SEC, &deadline);
+	thread_call_enter_delayed(loader_stop_call, deadline);
+}
+
+__startup_func
+static void
+loader_stop_poll_init(void)
+{
+	loader_stop_call = thread_call_allocate(loader_stop_poll, NULL);
+	loader_stop_poll(NULL, NULL);
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_LAST, loader_stop_poll_init);
+
+/*
+ * boot-arg hv_wdt_pet=1: the loader has armed the Qualcomm hypervisor's
+ * virtual watchdog (it resets the phone when a kernel hangs, so that test
+ * runs need nobody at the device). Its timeout is at most 65 seconds; feed
+ * it from a timer so that a healthy kernel can run for as long as it likes.
+ */
+#define VIRT_WDT_PET            0x86000007u
+#define HV_WDT_PET_SECONDS      10
+
+static thread_call_t hv_wdt_call;
+static uint32_t hv_wdt_enabled;
+
+#define MEMORY_REPORT_BEATS     6               /* a line about memory every so many heartbeats */
+
+extern unsigned int memorystatus_available_pages, memorystatus_available_pages_critical,
+    memorystatus_available_pages_critical_base;
+extern uint32_t c_segment_pages_compressed;
+extern _Atomic uint64_t ramfs_pages_in_use;
+extern void MiniIOSurfaceUsage(uint32_t *count, uint64_t *bytes);
+
+/*
+ * Where the memory is, in megabytes: for reading a session's log afterwards. "available" is what
+ * the kernel's own count says (free and file-backed): below the first threshold it kills idle
+ * daemons, and once none is left and it is below the second, whatever is next in line -- the
+ * window server included.
+ */
+void hakios_memory_line(char *buf, size_t len);
+
+/* The line itself (also kern.hakios_memory, for a job list to keep: bsd/miscfs/apfs/apfs_vfsops.c) */
+void
+hakios_memory_line(char *buf, size_t len)
+{
+#define MB(pages)       ((unsigned int)(((uint64_t)(pages) * PAGE_SIZE) >> 20))
+	uint32_t surfaces = 0;
+	uint64_t surface_bytes = 0;
+
+	MiniIOSurfaceUsage(&surfaces, &surface_bytes);
+	snprintf(buf, len, "memory: free %u, files %u, programs %u, wired %u (%u surfaces %u, ramfs %u), compressor %u "
+	    "(holding %u) MB; available %u, kills below %u (the idle) and %u (anybody)\n",
+	    MB(vm_page_free_count), MB(vm_page_pageable_external_count), MB(vm_page_pageable_internal_count),
+	    MB(vm_page_wire_count), surfaces, (unsigned int)(surface_bytes >> 20),
+	    MB(os_atomic_load(&ramfs_pages_in_use, relaxed)),
+	    MB(VM_PAGE_COMPRESSOR_COUNT), MB(c_segment_pages_compressed),
+	    MB(memorystatus_available_pages),
+	    MB(memorystatus_available_pages_critical), MB(memorystatus_available_pages_critical_base));
+#undef MB
+}
+
+static void
+memory_report(void)
+{
+	char line[256];
+
+	hakios_memory_line(line, sizeof(line));
+	printf("%s", line);
+	hakios_adreno_minute();                /* (and how warm the GPU is, if it is in use) */
+}
+
+/* Every HV_WDT_PET_SECONDS: feed the watchdog if there is one, and show any watching loader a sign of life. */
+static void
+hv_wdt_pet(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	uint64_t deadline;
+
+	if (hv_wdt_enabled) {
+		register uint64_t x0 __asm__("x0") = VIRT_WDT_PET;
+		register uint64_t x1 __asm__("x1") = 0;
+		register uint64_t x2 __asm__("x2") = 0;
+		register uint64_t x3 __asm__("x3") = 0;
+
+		__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3) : :
+		    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17");
+	}
+	if (++loader_live.heartbeat % MEMORY_REPORT_BEATS == 0) {
+		memory_report();
+	}
+
+	clock_interval_to_deadline(HV_WDT_PET_SECONDS, NSEC_PER_SEC, &deadline);
+	thread_call_enter_delayed(hv_wdt_call, deadline);
+}
+
+__startup_func
+static void
+hv_wdt_pet_init(void)
+{
+	PE_parse_boot_argn("hv_wdt_pet", &hv_wdt_enabled, sizeof(hv_wdt_enabled));
+	hv_wdt_call = thread_call_allocate(hv_wdt_pet, NULL);
+	hv_wdt_pet(NULL, NULL);
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_LAST, hv_wdt_pet_init);
