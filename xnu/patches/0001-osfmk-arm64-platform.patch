diff --git a/osfmk/arm64/laguna_dc9x00.c b/osfmk/arm64/laguna_dc9x00.c
new file mode 100644
index 0000000..47af172
--- /dev/null
+++ b/osfmk/arm64/laguna_dc9x00.c
@@ -0,0 +1,237 @@
+/*
+ * LAGUNA DC9x00 bus layer: MMIO mapping and register accessors.
+ *
+ * Maps the DPU fe-be window (0x0ee00000+0x120000) and the DSI2h0 status
+ * page (0x0efd8000+0x800) once, lazily, through ml_io_map and exposes them
+ * to the pure register logic through the laguna_dc_io backend. Every access
+ * is range-checked against those two windows: any other address is dropped
+ * (reads return 0) instead of faulting — the whitelist is the safety
+ * contract, so a bug in the logic must not turn into a wild MMIO access.
+ *
+ * The pure part (logging backend wrapper) is host-testable; define
+ * LAGUNA_DC9X00_HOSTTEST to compile only that.
+ *
+ * Port note (K6 display-prep, foundation 8796.121.2 blazer tree): the 141
+ * lineage guarded the kernel body with #if defined(LAGUNA); this tree builds
+ * MACHINE_CONFIGS=BCM2837 where LAGUNA is not defined (laguna_panicdump.c
+ * documents the same trap), so the body guard is now __arm64__ with the
+ * explicit host-test opt-out. Behavior is unchanged; the ADT gate + boot
+ * args stay the real safety interlocks.
+ */
+#include <arm64/laguna_dc9x00.h>
+
+#if defined(__arm64__) || defined(LAGUNA_DC9X00_HOSTTEST)
+
+static uint32_t
+laguna_dc_log_read(void *ctx, uint64_t pa)
+{
+	struct laguna_dc_logging_ctx *c = (struct laguna_dc_logging_ctx *)ctx;
+
+	return c->under->read32(c->under->ctx, pa);
+}
+
+static void
+laguna_dc_log_write(void *ctx, uint64_t pa, uint32_t value)
+{
+	struct laguna_dc_logging_ctx *c = (struct laguna_dc_logging_ctx *)ctx;
+	uint32_t old = c->under->read32(c->under->ctx, pa);
+
+	c->under->write32(c->under->ctx, pa, value);
+	if (c->log != NULL && c->log->count < LAGUNA_DC9X00_MAX_LOGGED_WRITES) {
+		c->log->entry[c->log->count].pa = pa;
+		c->log->entry[c->log->count].old_value = old;
+		c->log->entry[c->log->count].new_value = value;
+		c->log->count++;
+	}
+}
+
+void
+laguna_dc_logging_io_init(struct laguna_dc_logging_ctx *ctx,
+    struct laguna_dc_io *io, struct laguna_dc_write_log *log,
+    const struct laguna_dc_io *under)
+{
+	ctx->under = under;
+	ctx->log = log;
+	io->read32 = laguna_dc_log_read;
+	io->write32 = laguna_dc_log_write;
+	io->ctx = ctx;
+}
+
+const char *
+laguna_dc_repoint_status(uint32_t status)
+{
+	switch (status) {
+	case LAGUNA_DC9X00_REPOINT_OK:
+		return "ok";
+	case LAGUNA_DC9X00_REPOINT_NO_SCANOUT:
+		return "scanout not live (outpath0 off or line counter static)";
+	case LAGUNA_DC9X00_REPOINT_NO_LAYER:
+		return "no live DRAM layer found";
+	case LAGUNA_DC9X00_REPOINT_BAD_FB:
+		return "target fb not 256B-aligned bank-0 DRAM";
+	default:
+		return "unknown";
+	}
+}
+
+#if defined(__arm64__) && !defined(LAGUNA_DC9X00_HOSTTEST)
+
+#include <pexpert/pexpert.h>           /* kprintf, PE_parse_boot_argn, PE_state */
+#include <pexpert/device_tree.h>       /* SecureDTFindEntry/GetProperty */
+#include <machine/machine_routines.h>  /* ml_io_map, ml_io_map_wcomb */
+
+static volatile uint8_t *laguna_dc_fe_be_va;
+static volatile uint8_t *laguna_dc_dsi2h_va;
+
+static volatile uint32_t *
+laguna_dc9x00_reg_va(uint64_t pa)
+{
+	if (laguna_dc_fe_be_va != NULL &&
+	    pa >= LAGUNA_DC9X00_FE_BE_PA &&
+	    pa <= (LAGUNA_DC9X00_FE_BE_PA + LAGUNA_DC9X00_FE_BE_SIZE - 4u)) {
+		return (volatile uint32_t *)(void *)
+		    (laguna_dc_fe_be_va + (pa - LAGUNA_DC9X00_FE_BE_PA));
+	}
+	if (laguna_dc_dsi2h_va != NULL &&
+	    pa >= LAGUNA_DC9X00_DSI2H0_PA &&
+	    pa <= (LAGUNA_DC9X00_DSI2H0_PA + LAGUNA_DC9X00_DSI2H0_SIZE - 4u)) {
+		return (volatile uint32_t *)(void *)
+		    (laguna_dc_dsi2h_va + (pa - LAGUNA_DC9X00_DSI2H0_PA));
+	}
+	return NULL;
+}
+
+static uint32_t
+laguna_dc9x00_kernel_read32(void *ctx, uint64_t pa)
+{
+	volatile uint32_t *va = laguna_dc9x00_reg_va(pa);
+
+	(void)ctx;
+	if (va == NULL) {
+		kprintf("LAGUNA DC9x00: read outside mapped windows: 0x%llx\n",
+		    (unsigned long long)pa);
+		return 0;
+	}
+	return *va;
+}
+
+static void
+laguna_dc9x00_kernel_write32(void *ctx, uint64_t pa, uint32_t value)
+{
+	volatile uint32_t *va = laguna_dc9x00_reg_va(pa);
+
+	(void)ctx;
+	if (va == NULL) {
+		kprintf("LAGUNA DC9x00: write outside mapped windows: "
+		    "0x%llx <- 0x%x\n", (unsigned long long)pa, value);
+		return;
+	}
+	*va = value;
+}
+
+static struct laguna_dc_io laguna_dc_kernel_io = {
+	laguna_dc9x00_kernel_read32,
+	laguna_dc9x00_kernel_write32,
+	NULL
+};
+
+struct laguna_dc_io *
+laguna_dc9x00_kernel_io(void)
+{
+	if (laguna_dc_fe_be_va == NULL) {
+		laguna_dc_fe_be_va = (volatile uint8_t *)(void *)
+		    ml_io_map((vm_offset_t)LAGUNA_DC9X00_FE_BE_PA,
+		    (vm_size_t)LAGUNA_DC9X00_FE_BE_SIZE);
+		laguna_dc_dsi2h_va = (volatile uint8_t *)(void *)
+		    ml_io_map((vm_offset_t)LAGUNA_DC9X00_DSI2H0_PA,
+		    (vm_size_t)LAGUNA_DC9X00_DSI2H0_SIZE);
+		kprintf("LAGUNA DC9x00: mapped fe-be 0x%llx+0x%x -> %p, "
+		    "dsi2h0 -> %p\n", (unsigned long long)LAGUNA_DC9X00_FE_BE_PA,
+		    LAGUNA_DC9X00_FE_BE_SIZE, (void *)laguna_dc_fe_be_va,
+		    (void *)laguna_dc_dsi2h_va);
+	}
+	if (laguna_dc_fe_be_va == NULL || laguna_dc_dsi2h_va == NULL) {
+		return NULL;
+	}
+	return &laguna_dc_kernel_io;
+}
+
+uint32_t
+laguna_dc9x00_bootarg(const char *name, uint32_t default_value)
+{
+	uint32_t value = default_value;
+
+	(void)PE_parse_boot_argn(name, &value, (int)sizeof(value));
+	return value;
+}
+
+/*
+ * The display controller only exists where the handoff ADT says so. The node
+ * carries the two MMIO windows as absolute physical addresses,
+ *   reg = <fe-be PA, fe-be size, dsi2h0 PA, dsi2h0 size>  (4 x u64),
+ * emitted by the ADT builder in device mode only (mkadt.py, patch
+ * 0004-mkadt-laguna-dpu). The QEMU ADT deliberately has no such node: QEMU's
+ * virt machine leaves those windows unassigned, an access there takes a
+ * synchronous external abort, and "nothing behind it" is exactly what the
+ * gate must report. A node whose reg disagrees with the constants this
+ * kernel was built with means the ADT and the binary were repointed out of
+ * step (the fb PA convention patches all of them together) — refuse rather
+ * than guess.
+ */
+enum laguna_dc_adt_gate
+laguna_dc9x00_adt_gate(void)
+{
+	DTEntry entry;
+	uint64_t const *reg;
+	unsigned int size;
+
+	if (SecureDTFindEntry("name", LAGUNA_DC9X00_ADT_NODE, &entry) != kSuccess ||
+	    SecureDTGetProperty(entry, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 4 * sizeof(*reg)) {
+		return LAGUNA_DC9X00_ADT_ABSENT;
+	}
+	if (reg[0] != LAGUNA_DC9X00_FE_BE_PA || reg[1] != LAGUNA_DC9X00_FE_BE_SIZE ||
+	    reg[2] != LAGUNA_DC9X00_DSI2H0_PA || reg[3] != LAGUNA_DC9X00_DSI2H0_SIZE) {
+		return LAGUNA_DC9X00_ADT_MISMATCH;
+	}
+	return LAGUNA_DC9X00_ADT_OK;
+}
+
+void
+laguna_dc9x00_pmsg_mark(uint32_t step)
+{
+	/* The ramoops pmsg zone only exists where the platform put it; a
+	 * handoff whose RAM window does not cover it (the 256 MiB QEMU
+	 * contract ends at 0x90000000) must not fault on a diagnostic
+	 * write — skip it, the console log carries the same facts. The RAM
+	 * window comes from the boot args (arm_vm_init carves XNU RAM from
+	 * exactly these fields), the same source the display consumer
+	 * validates against. Port note (K6): the 141 lineage derived the
+	 * kernel VA through phystokv(<arm/pmap.h>); this tree's public
+	 * <arm/pmap.h> does not export phystokv, so the 64-byte mark window
+	 * is mapped once through ml_io_map instead — the same pattern
+	 * hakios.blazer_display.c / hakios.blazer_panicdump.c use for RAM
+	 * windows at this stage. */
+	static volatile uint32_t *marks;
+	boot_args *args = (boot_args *)PE_state.bootArgs;
+
+	if (marks == NULL) {
+		if (args == NULL ||
+		    (uint64_t)LAGUNA_DC9X00_MARK_PA < (uint64_t)args->physBase ||
+		    (uint64_t)LAGUNA_DC9X00_MARK_PA + 64 >
+		    (uint64_t)args->physBase + args->memSize) {
+			return;
+		}
+		marks = (volatile uint32_t *)(void *)
+		    ml_io_map((vm_offset_t)LAGUNA_DC9X00_MARK_PA,
+		    (vm_size_t)64);
+		if (marks == NULL) {
+			return;
+		}
+	}
+	marks[step & 0xfu] = LAGUNA_DC9X00_MARK_MAGIC | (step & 0xfu);
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+#endif /* __arm64__ && !HOSTTEST */
+#endif /* __arm64__ || HOSTTEST */
diff --git a/osfmk/arm64/laguna_dc9x00.h b/osfmk/arm64/laguna_dc9x00.h
new file mode 100644
index 0000000..9d5b858
--- /dev/null
+++ b/osfmk/arm64/laguna_dc9x00.h
@@ -0,0 +1,295 @@
+/*
+ * VeriSilicon DC9x00 display bring-up for Pixel 10 Pro (blazer, Tensor G5).
+ *
+ * Register knowledge: research/dc9x00-display-path.md — offsets resolved
+ * from the unstripped stock vs_drm.ko and cross-checked against the live
+ * FDT (dc9x00@200000 inside the wrapper ranges <0 0 0x0ec00000 0x400000>;
+ * live /proc/iomem "0ee00000-0ef1ffff : ee00000.dc9x00 dpu-fe-be").
+ *
+ * Safety contract of the series:
+ *   - the probe performs MMIO READS only, from a fixed whitelist of plain
+ *     state registers (nothing clear-on-read, no FIFO-pop registers);
+ *   - splash level 1 writes DRAM only (our fixed framebuffer, plus a paint
+ *     into the live ABL scanout buffer); DC register writes happen only at
+ *     splash level 2;
+ *   - nothing here touches gpcsr resets, power domains, clocks, the DSI2h
+ *     host, the CDPHY or the panel; every write path defaults to off.
+ *
+ * The register logic is ordinary C behind the laguna_dc_io backend so the
+ * host test (research/dc9x00-xnu-test/) can replay and assert the exact
+ * sequences; build it there with -DLAGUNA_DC9X00_HOSTTEST.
+ *
+ * Port note (K6 display-prep, foundation 8796.121.2 blazer tree): the 141
+ * lineage guarded the kernel bodies with #if defined(LAGUNA) (its
+ * MASTER.arm64.laguna machine config). This tree builds
+ * MACHINE_CONFIGS=BCM2837, where LAGUNA is not defined, so that guard would
+ * have compiled the inline no-op stubs and silenced the whole series —
+ * the same trap laguna_panicdump.c documents. The guards are now
+ * __arm64__ (these files are only reachable through osfmk/conf/files.arm64,
+ * i.e. arm64 kernel builds) with LAGUNA_DC9X00_HOSTTEST still forcing the
+ * pure-logic-only build for the host test, which runs on arm64 Macs too.
+ */
+#ifndef _ARM64_LAGUNA_DC9X00_H_
+#define _ARM64_LAGUNA_DC9X00_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+/* Kernel entry points, called from arm_init() after the console is up and
+ * the display consumer (hakios_blazer_display_init) has run. Inline no-ops
+ * on every other configuration. */
+#if defined(__arm64__) && !defined(LAGUNA_DC9X00_HOSTTEST)
+void laguna_dc9x00_early_probe(void);
+void laguna_dc9x00_early_splash(void);
+#else
+static inline void laguna_dc9x00_early_probe(void) { }
+static inline void laguna_dc9x00_early_splash(void) { }
+#endif
+
+#if defined(__arm64__) || defined(LAGUNA_DC9X00_HOSTTEST)
+
+/*
+ * MMIO windows (CPU physical addresses, live FDT).
+ * dpu-fe-be: one flat mapping covering FE0/FE1 layers, BE outpaths, WB.
+ */
+#define LAGUNA_DC9X00_FE_BE_PA    0x0ee00000ull
+#define LAGUNA_DC9X00_FE_BE_SIZE  0x00120000ull
+/* DSI2 host 0 (dsi2host@3d8000): status register read only. */
+#define LAGUNA_DC9X00_DSI2H0_PA   0x0efd8000ull
+#define LAGUNA_DC9X00_DSI2H0_SIZE 0x00000800ull
+
+/*
+ * Splash framebuffer: on this tree the fixed-FB fill targets the handoff
+ * record's cpu_pa — the PA hakios_blazer_display_init() validated from the
+ * CRC'd /chosen/laguna-display-handoff record and adopted into
+ * PE_state.video (phone: 0xf0000000, the display-owning first stage's own
+ * linear buffer; DISPLAY-PRODUCER contract — the kernel never guesses a
+ * framebuffer PA). The constant below stays for the host test and as the
+ * documented phone value every producer must agree on. Level-1 fill
+ * geometry is 1280x2856 stride 5120 = the ABL panel mode
+ * (/chosen/display), 256B-aligned as vs_drm.ko requires; the glue paints
+ * the adopted record geometry when it differs.
+ */
+#define LAGUNA_DC9X00_FB_PA      0xf0000000ull /* phone handoff cpu_pa; host-test reference value */
+#define LAGUNA_DC9X00_FB_MAP     0x02000000ull /* 32 MiB mapping/fill cap */
+#define LAGUNA_DC9X00_FB_W       1280u
+#define LAGUNA_DC9X00_FB_H       2856u
+#define LAGUNA_DC9X00_FB_STRIDE  5120u  /* 1280 * 4; ABL panel mode is linear 32bpp, 256B-aligned */
+#define LAGUNA_DC9X00_FB_BYTES   (LAGUNA_DC9X00_FB_W * LAGUNA_DC9X00_FB_H * 4u)
+
+/*
+ * Diagnostic marks: 16 words at pmsg ramoops pmsg zone +0x200. The
+ * marker-patch stub owns +0x100/+0x104 only; pstore headers are untouched.
+ * (+0x200 sits in the low band the fastboot re-entry clobbers AFTER XNU
+ * dies — the marks are best-effort; the console log carries the same facts
+ * and pmsg+0x28000/+0x30000/+0x3F800 are claimed by the evidence chain.)
+ */
+#define LAGUNA_DC9X00_MARK_PA    0x95400200ull
+#define LAGUNA_DC9X00_MARK_MAGIC 0xdc900000u
+
+/*
+ * Boot-arg gates (PE boot args).
+ *   io.display.probe  default 1: read-only MMIO probe + console report.
+ *                     Set 0 to disable even the reads (first-boot paranoia).
+ *   io.display.splash default 0: nothing.
+ *                     1: fill the handoff framebuffer with the pattern and
+ *                        paint the live ABL scanout buffer (DRAM writes only).
+ *                     2: additionally repoint the live layer to the handoff
+ *                        framebuffer (the only DC register writes in the
+ *                        series).
+ */
+#define LAGUNA_DC9X00_ARG_PROBE  "io.display.probe"
+#define LAGUNA_DC9X00_ARG_SPLASH "io.display.splash"
+
+/* Register offsets relative to LAGUNA_DC9X00_FE_BE_PA. */
+#define LAGUNA_DC9X00_REG_OUTPATH0_CTRL  0x0b6000u /* dc_hw_set_output_start: 0xb6000|0xc4 */
+#define LAGUNA_DC9X00_OUTPATH0_EN_MASK   0x000000c4u
+#define LAGUNA_DC9X00_REG_OUTPATH0_LINE  0x0b6068u /* current scanout line, panel type 0 */
+#define LAGUNA_DC9X00_REG_DSI2H0_STATUS  0x20u     /* DSI2h status (field #12 = bit16) */
+#define LAGUNA_DC9X00_DSI2H_CRI_BUSY     0x00010000u
+
+/* Layer (FE plane) blocks: 12 blocks, 0x4000 stride. FE0 ids 0-5 at
+ * 0x18000+, FE1 ids 8-13 at 0x58000+ (FE0 + 0x40000). */
+#define LAGUNA_DC9X00_LAYER_COUNT 12u
+#define LAGUNA_DC9X00_LAYER_NONE  0xffu
+#define LAGUNA_DC9X00_LREG_ADDR_LO 0x060u
+#define LAGUNA_DC9X00_LREG_ADDR_HI 0x064u
+#define LAGUNA_DC9X00_LREG_STRIDE  0x078u
+#define LAGUNA_DC9X00_LREG_CFG     0x084u
+#define LAGUNA_DC9X00_LREG_WIDTH   0x094u
+#define LAGUNA_DC9X00_LREG_HEIGHT  0x098u
+#define LAGUNA_DC9X00_LREG_ENABLE  0x960u /* plane_commit tail: 0x...960 <- 1 */
+#define LAGUNA_DC9X00_LREG_COMMIT  0x96cu /* plane_commit tail: 0x...96c <- 1 */
+
+/* DRAM policy: ABL scanout and splash framebuffer live in bank 0. */
+#define LAGUNA_DC9X00_DRAM_BASE 0x80000000ull
+#define LAGUNA_DC9X00_DRAM_END  0x100000000ull
+
+/* Register access backend. In the kernel this is the ml_io_map aperture;
+ * on the host the test substitutes a byte-array mock. All pure logic below
+ * goes through this struct — never access MMIO directly. */
+struct laguna_dc_io {
+	uint32_t (*read32)(void *ctx, uint64_t pa);
+	void (*write32)(void *ctx, uint64_t pa, uint32_t value);
+	void *ctx;
+};
+
+struct laguna_dc_layer_state {
+	uint64_t fb_pa;  /* addr hi:lo, +0x60/+0x64 */
+	uint32_t stride; /* +0x78, bytes */
+	uint32_t cfg;    /* +0x84, format/tile config (encoding unverified) */
+	uint32_t width;  /* +0x94, candidate */
+	uint32_t height; /* +0x98, candidate */
+	uint32_t enable; /* +0x960, bit0 */
+};
+
+struct laguna_dc_probe_report {
+	uint32_t outpath0_ctrl; /* 0x0b6000 */
+	uint32_t line0;         /* 0x0b6068, first read */
+	uint32_t line1;         /* 0x0b6068, second read */
+	uint32_t dsi2h_status;  /* DSI2h0 reg 0x20 */
+	uint8_t outpath0_enabled;
+	uint8_t line_advancing;
+	uint8_t dsi2h_cri_busy;
+	uint8_t live_layer;     /* LAGUNA_DC9X00_LAYER_NONE if none */
+	struct laguna_dc_layer_state layers[LAGUNA_DC9X00_LAYER_COUNT];
+};
+
+/* Ordered journal of every MMIO write (used by the splash repoint path and
+ * asserted against the documented order by the host test). */
+#define LAGUNA_DC9X00_MAX_LOGGED_WRITES 32u
+struct laguna_dc_write_entry {
+	uint64_t pa;
+	uint32_t old_value;
+	uint32_t new_value;
+};
+struct laguna_dc_write_log {
+	uint32_t count;
+	struct laguna_dc_write_entry entry[LAGUNA_DC9X00_MAX_LOGGED_WRITES];
+};
+struct laguna_dc_logging_ctx {
+	const struct laguna_dc_io *under;
+	struct laguna_dc_write_log *log;
+};
+
+/* laguna_dc_splash_repoint() status codes. */
+#define LAGUNA_DC9X00_REPOINT_OK          0u
+#define LAGUNA_DC9X00_REPOINT_NO_SCANOUT  1u /* outpath0 off / line static */
+#define LAGUNA_DC9X00_REPOINT_NO_LAYER    2u /* no live DRAM layer found   */
+#define LAGUNA_DC9X00_REPOINT_BAD_FB      3u /* target not 256B-aligned DRAM */
+
+/* Offset of layer block i within the fe-be mapping (vs_drm.ko geometry). */
+static inline uint32_t
+laguna_dc_layer_block(uint32_t idx)
+{
+	static const uint32_t blocks[LAGUNA_DC9X00_LAYER_COUNT] = {
+		0x18000u, 0x1c000u, 0x20000u, 0x24000u, 0x28000u, 0x2c000u,
+		0x58000u, 0x5c000u, 0x60000u, 0x64000u, 0x68000u, 0x6c000u,
+	};
+	return blocks[idx];
+}
+
+static inline uint64_t
+laguna_dc_layer_base(uint32_t idx)
+{
+	return LAGUNA_DC9X00_FE_BE_PA + laguna_dc_layer_block(idx);
+}
+
+static inline uint64_t
+laguna_dc_layer_pa(uint32_t idx, uint32_t reg)
+{
+	return laguna_dc_layer_base(idx) + reg;
+}
+
+static inline uint32_t
+laguna_dc_rd(const struct laguna_dc_io *io, uint64_t pa)
+{
+	return io->read32(io->ctx, pa);
+}
+
+static inline void
+laguna_dc_wr(const struct laguna_dc_io *io, uint64_t pa, uint32_t value)
+{
+	io->write32(io->ctx, pa, value);
+}
+
+/*
+ * Read-only identification probe: scans outpath0 state, scanout liveness,
+ * the 12 layer blocks and the DSI2h handoff status bit, in the documented
+ * order, writing nothing. Safe by construction (see file header).
+ */
+uint32_t laguna_dc_probe(const struct laguna_dc_io *io,
+    struct laguna_dc_probe_report *report);
+
+/* Lowest-index layer that looks like the live scanout source: enabled,
+ * 256B-aligned address inside DRAM bank 0. */
+uint32_t laguna_dc_choose_live_layer(const struct laguna_dc_probe_report *report);
+
+/*
+ * Minimal pipeline bring-up: repoint the live layer to fb_pa. Writes, in
+ * this documented order (research/dc9x00-display-path.md, "Bare-metal draw
+ * procedure" + the plane_commit tail pattern):
+ *   1. layer stride      (block+0x078) = LAGUNA_DC9X00_FB_STRIDE
+ *   2. layer fb addr lo  (block+0x060)
+ *   3. layer fb addr hi  (block+0x064)
+ *   4. layer enable      (block+0x960) = 1
+ *   5. layer commit      (block+0x96c) = 1
+ *   6. outpath0 start    (0x0b6000)   |= 0xc4, only if bits missing (RMW)
+ * Refuses to write anything unless scanout is live and a layer was found.
+ * The layer cfg (+0x84) is deliberately never written: its format encoding
+ * is unverified, and the DPU-SMMU identity assumption is documented as THE
+ * assumption this path tests.
+ */
+uint32_t laguna_dc_splash_repoint(const struct laguna_dc_io *io, uint64_t fb_pa,
+    const struct laguna_dc_probe_report *report);
+
+/* Solid ARGB (AARRGGBB) fill; stride in bytes. */
+void laguna_dc_fill_solid(uint32_t *fb, uint32_t w, uint32_t h,
+    uint32_t stride_bytes, uint32_t argb);
+
+/* 8 vertical-band visibility pattern + black diagonal, tuned so that any
+ * stride/format mistake is obvious in a panel photo. */
+void laguna_dc_fill_pattern(uint32_t *fb, uint32_t w, uint32_t h,
+    uint32_t stride_bytes);
+
+/* Wrap another backend, journaling every write (passthrough reads).
+ * ctx is caller-provided storage. */
+void laguna_dc_logging_io_init(struct laguna_dc_logging_ctx *ctx,
+    struct laguna_dc_io *io, struct laguna_dc_write_log *log,
+    const struct laguna_dc_io *under);
+
+const char *laguna_dc_repoint_status(uint32_t status);
+
+/* ADT gate (see laguna_dc9x00_adt_gate in the kernel glue): DC MMIO is only
+ * touched when the handoff ADT describes the display controller AND that
+ * description matches the constants this kernel was built with. The node is
+ * emitted by mkadt.py in device mode only (patch 0004; the QEMU ADT stays
+ * node-less so the gate keeps its refusal there). */
+#define LAGUNA_DC9X00_ADT_NODE "laguna-dpu"
+enum laguna_dc_adt_gate {
+	LAGUNA_DC9X00_ADT_OK = 0,       /* node present, reg matches built-ins */
+	LAGUNA_DC9X00_ADT_ABSENT,       /* no laguna-dpu node (e.g. QEMU handoff:
+	                                 * the DC windows are unmapped there and a
+	                                 * read would take a synchronous external
+	                                 * abort) */
+	LAGUNA_DC9X00_ADT_MISMATCH,     /* node present but repointed vs binary */
+};
+
+#if defined(__arm64__) && !defined(LAGUNA_DC9X00_HOSTTEST)
+/* Kernel-side glue (0001): mapped apertures + helpers. */
+#if defined(__cplusplus)
+extern "C" {
+#endif /* __cplusplus */
+struct laguna_dc_io *laguna_dc9x00_kernel_io(void);
+uint32_t laguna_dc9x00_bootarg(const char *name, uint32_t default_value);
+void laguna_dc9x00_pmsg_mark(uint32_t step);
+enum laguna_dc_adt_gate laguna_dc9x00_adt_gate(void);
+/* 0002: cached probe report (NULL until laguna_dc9x00_early_probe ran). */
+const struct laguna_dc_probe_report *laguna_dc9x00_cached_report(void);
+#if defined(__cplusplus)
+}
+#endif /* __cplusplus */
+#endif /* __arm64__ && !HOSTTEST */
+
+#endif /* __arm64__ || LAGUNA_DC9X00_HOSTTEST */
+#endif /* _ARM64_LAGUNA_DC9X00_H_ */
diff --git a/osfmk/arm64/laguna_dc_probe.c b/osfmk/arm64/laguna_dc_probe.c
new file mode 100644
index 0000000..2d6009e
--- /dev/null
+++ b/osfmk/arm64/laguna_dc_probe.c
@@ -0,0 +1,152 @@
+/*
+ * LAGUNA DC9x00 read-only identification probe (0002).
+ *
+ * Pure logic: scan the documented state registers and fill the report.
+ * Kernel glue: run it once after the console is up (arm_init tail), log a
+ * one-line-per-fact report through kprintf (serial/pmsg mirror), cache the
+ * report for the splash (0003), and leave one diagnostic word in the pmsg
+ * ramoops zone. Reads only — safe by construction.
+ *
+ * No DC9x00 ID/version register offset is proven by the stock-module
+ * analysis, so identification here is functional: scanout liveness
+ * (outpath0 enable + line counter), the 12 layer blocks, and the DSI2h
+ * handoff status bit (reg 0x20 bit 16, field #12 of mipi-dsi2h.ko).
+ *
+ * Port note (K6 display-prep, foundation 8796.121.2 blazer tree): kernel
+ * guard is __arm64__ + host-test opt-out instead of the 141 lineage's
+ * LAGUNA machine config (see laguna_dc9x00.h); logic byte-identical.
+ */
+#include <arm64/laguna_dc9x00.h>
+
+#if defined(__arm64__) || defined(LAGUNA_DC9X00_HOSTTEST)
+
+uint32_t
+laguna_dc_probe(const struct laguna_dc_io *io,
+    struct laguna_dc_probe_report *report)
+{
+	uint32_t i;
+
+	/* Read order is part of the documented procedure and is asserted
+	 * by the host test: outpath0 ctrl, line counter twice, then the
+	 * 12 layer blocks (addr lo/hi, stride, cfg, width, height, enable),
+	 * then the DSI2h status. Nothing else is ever touched. */
+	report->outpath0_ctrl = laguna_dc_rd(io,
+	    LAGUNA_DC9X00_FE_BE_PA + LAGUNA_DC9X00_REG_OUTPATH0_CTRL);
+	report->outpath0_enabled =
+	    (report->outpath0_ctrl & LAGUNA_DC9X00_OUTPATH0_EN_MASK) ==
+	    LAGUNA_DC9X00_OUTPATH0_EN_MASK;
+
+	report->line0 = laguna_dc_rd(io,
+	    LAGUNA_DC9X00_FE_BE_PA + LAGUNA_DC9X00_REG_OUTPATH0_LINE);
+	report->line1 = laguna_dc_rd(io,
+	    LAGUNA_DC9X00_FE_BE_PA + LAGUNA_DC9X00_REG_OUTPATH0_LINE);
+	report->line_advancing = report->line0 != report->line1;
+
+	for (i = 0; i < LAGUNA_DC9X00_LAYER_COUNT; i++) {
+		struct laguna_dc_layer_state *l = &report->layers[i];
+		uint64_t base = laguna_dc_layer_base(i);
+
+		uint32_t hi = laguna_dc_rd(io, base + LAGUNA_DC9X00_LREG_ADDR_HI);
+		uint32_t lo = laguna_dc_rd(io, base + LAGUNA_DC9X00_LREG_ADDR_LO);
+
+		l->fb_pa = ((uint64_t)hi << 32) | lo;
+		l->stride = laguna_dc_rd(io, base + LAGUNA_DC9X00_LREG_STRIDE);
+		l->cfg = laguna_dc_rd(io, base + LAGUNA_DC9X00_LREG_CFG);
+		l->width = laguna_dc_rd(io, base + LAGUNA_DC9X00_LREG_WIDTH);
+		l->height = laguna_dc_rd(io, base + LAGUNA_DC9X00_LREG_HEIGHT);
+		l->enable = laguna_dc_rd(io, base + LAGUNA_DC9X00_LREG_ENABLE);
+	}
+
+	report->dsi2h_status = laguna_dc_rd(io,
+	    LAGUNA_DC9X00_DSI2H0_PA + LAGUNA_DC9X00_REG_DSI2H0_STATUS);
+	report->dsi2h_cri_busy =
+	    (report->dsi2h_status & LAGUNA_DC9X00_DSI2H_CRI_BUSY) != 0;
+
+	report->live_layer = laguna_dc_choose_live_layer(report);
+	return LAGUNA_DC9X00_REPOINT_OK;
+}
+
+uint32_t
+laguna_dc_choose_live_layer(const struct laguna_dc_probe_report *report)
+{
+	uint32_t i;
+
+	for (i = 0; i < LAGUNA_DC9X00_LAYER_COUNT; i++) {
+		const struct laguna_dc_layer_state *l = &report->layers[i];
+
+		if ((l->enable & 1u) == 0) {
+			continue;
+		}
+		if (l->fb_pa < LAGUNA_DC9X00_DRAM_BASE ||
+		    l->fb_pa >= LAGUNA_DC9X00_DRAM_END) {
+			continue;
+		}
+		if ((l->fb_pa & 0xffu) != 0) {
+			continue; /* 256B alignment rule (vs_drm.ko strings) */
+		}
+		return i;
+	}
+	return LAGUNA_DC9X00_LAYER_NONE;
+}
+
+#if defined(__arm64__) && !defined(LAGUNA_DC9X00_HOSTTEST)
+
+#include <pexpert/pexpert.h> /* kprintf */
+
+static struct laguna_dc_probe_report laguna_dc_saved_report;
+static uint32_t laguna_dc_saved_valid;
+
+const struct laguna_dc_probe_report *
+laguna_dc9x00_cached_report(void)
+{
+	return laguna_dc_saved_valid ? &laguna_dc_saved_report : NULL;
+}
+
+void
+laguna_dc9x00_early_probe(void)
+{
+	struct laguna_dc_io *io;
+	struct laguna_dc_probe_report *rep = &laguna_dc_saved_report;
+	uint32_t i;
+	enum laguna_dc_adt_gate gate;
+
+	if (!laguna_dc9x00_bootarg(LAGUNA_DC9X00_ARG_PROBE, 1)) {
+		return;
+	}
+	gate = laguna_dc9x00_adt_gate();
+	if (gate != LAGUNA_DC9X00_ADT_OK) {
+		kprintf("LAGUNA DC9x00 probe: ADT %s %s; MMIO probe skipped\n",
+		    LAGUNA_DC9X00_ADT_NODE,
+		    gate == LAGUNA_DC9X00_ADT_ABSENT ? "node absent" :
+		    "reg mismatch vs built-in windows");
+		return;
+	}
+	io = laguna_dc9x00_kernel_io();
+	if (io == NULL) {
+		kprintf("LAGUNA DC9x00 probe: io mapping failed\n");
+		return;
+	}
+	laguna_dc9x00_pmsg_mark(1);
+	laguna_dc_probe(io, rep);
+	laguna_dc_saved_valid = 1;
+	laguna_dc9x00_pmsg_mark(2);
+
+	kprintf("LAGUNA DC9x00 probe: outpath0 ctrl=0x%x en=%u "
+	    "line=%u->%u advancing=%u\n", rep->outpath0_ctrl,
+	    rep->outpath0_enabled, rep->line0, rep->line1, rep->line_advancing);
+	for (i = 0; i < LAGUNA_DC9X00_LAYER_COUNT; i++) {
+		const struct laguna_dc_layer_state *l = &rep->layers[i];
+
+		kprintf("LAGUNA DC9x00 probe: layer[%u] pa=0x%llx "
+		    "stride=%u cfg=0x%x %ux%u en=0x%x\n", i,
+		    (unsigned long long)l->fb_pa, l->stride, l->cfg,
+		    l->width, l->height, l->enable);
+	}
+	kprintf("LAGUNA DC9x00 probe: dsi2h0 status=0x%x cri_busy=%u "
+	    "live layer=%u%s\n", rep->dsi2h_status, rep->dsi2h_cri_busy,
+	    rep->live_layer,
+	    rep->live_layer == LAGUNA_DC9X00_LAYER_NONE ? " (none)" : "");
+}
+
+#endif /* __arm64__ && !HOSTTEST */
+#endif /* __arm64__ || HOSTTEST */
diff --git a/osfmk/arm64/laguna_dc_splash.c b/osfmk/arm64/laguna_dc_splash.c
new file mode 100644
index 0000000..6acdca1
--- /dev/null
+++ b/osfmk/arm64/laguna_dc_splash.c
@@ -0,0 +1,268 @@
+/*
+ * LAGUNA DC9x00 splash: visible execution evidence (0003).
+ *
+ * Level 1 (io.display.splash=1) never writes a single display register:
+ *   a. fill the handoff framebuffer with the visibility pattern;
+ *   b. paint the same pattern into the live ABL scanout buffer — the address
+ *      is the one the probe read from the layer registers, so the pattern
+ *      appears on the panel through the untouched bootloader pipeline.
+ * Level 2 (=2) additionally performs the only DC register writes of the
+ * series: repoint the live layer at the handoff framebuffer (documented
+ * order in laguna_dc_splash_repoint()).
+ *
+ * Port note (K6 display-prep, foundation 8796.121.2 blazer tree): the 141
+ * lineage filled a fixed PA through a permanent TTBR1 alias owned by its
+ * laguna fbcon (0104). The blazer tree has no laguna fbcon and no alias —
+ * the fixed-FB target is instead the handoff record's cpu_pa, exactly the
+ * PA hakios_blazer_display_init() validated (CRC'd record, fail-closed) and
+ * adopted into PE_state.video earlier in arm_init(). The WCOMB mapping is
+ * scoped to stride*height, flushed with dsb sy, and unmapped after the fill
+ * (the 0104 lesson: big early I/O maps exhaust the window). Nothing is
+ * painted when the consumer left the video headless — the kernel never
+ * invents a framebuffer PA. Kernel guard is __arm64__ + host-test opt-out
+ * (see laguna_dc9x00.h); the pure fill/repoint logic is byte-identical.
+ */
+#include <arm64/laguna_dc9x00.h>
+
+#if defined(__arm64__) || defined(LAGUNA_DC9X00_HOSTTEST)
+
+void
+laguna_dc_fill_solid(uint32_t *fb, uint32_t w, uint32_t h,
+    uint32_t stride_bytes, uint32_t argb)
+{
+	uint32_t stride = stride_bytes / 4u;
+	uint32_t x, y;
+
+	for (y = 0; y < h; y++) {
+		uint32_t *row = fb + (uintptr_t)y * stride;
+
+		for (x = 0; x < w; x++) {
+			row[x] = argb;
+		}
+	}
+}
+
+void
+laguna_dc_fill_pattern(uint32_t *fb, uint32_t w, uint32_t h,
+    uint32_t stride_bytes)
+{
+	static const uint32_t bands[8] = {
+		0xff808080u, /* gray    */
+		0xffffffffu, /* white   */
+		0xff0000ffu, /* red     */
+		0xff00ff00u, /* green   */
+		0xffff0000u, /* blue    */
+		0xff00ffffu, /* yellow  */
+		0xffff00ffu, /* magenta */
+		0xffffff00u, /* cyan    */
+	};
+	uint32_t stride = stride_bytes / 4u;
+	uint32_t x, y;
+
+	for (y = 0; y < h; y++) {
+		uint32_t *row = fb + (uintptr_t)y * stride;
+		uint32_t band = bands[(y * 8u) / h];
+
+		for (x = 0; x < w; x++) {
+			/* black diagonal: stride/format errors show as shear */
+			row[x] = (x == (y & 0x3ffu)) ? 0xff000000u : band;
+		}
+	}
+}
+
+uint32_t
+laguna_dc_splash_repoint(const struct laguna_dc_io *io, uint64_t fb_pa,
+    const struct laguna_dc_probe_report *report)
+{
+	uint32_t live;
+	uint32_t ctrl;
+
+	/* Liveness = the line counter advancing; the outpath0 ctrl bits are
+	 * state to restore (RMW below), not a precondition. */
+	if (report == NULL || !report->line_advancing) {
+		return LAGUNA_DC9X00_REPOINT_NO_SCANOUT;
+	}
+	live = laguna_dc_choose_live_layer(report);
+	if (live == LAGUNA_DC9X00_LAYER_NONE) {
+		return LAGUNA_DC9X00_REPOINT_NO_LAYER;
+	}
+	if (fb_pa == 0 || (fb_pa & 0xffu) != 0 ||
+	    fb_pa < LAGUNA_DC9X00_DRAM_BASE || fb_pa >= LAGUNA_DC9X00_DRAM_END) {
+		return LAGUNA_DC9X00_REPOINT_BAD_FB;
+	}
+
+	laguna_dc_wr(io, laguna_dc_layer_pa(live, LAGUNA_DC9X00_LREG_STRIDE),
+	    LAGUNA_DC9X00_FB_STRIDE);
+	laguna_dc_wr(io, laguna_dc_layer_pa(live, LAGUNA_DC9X00_LREG_ADDR_LO),
+	    (uint32_t)(fb_pa & 0xffffffffull));
+	laguna_dc_wr(io, laguna_dc_layer_pa(live, LAGUNA_DC9X00_LREG_ADDR_HI),
+	    (uint32_t)(fb_pa >> 32));
+	laguna_dc_wr(io, laguna_dc_layer_pa(live, LAGUNA_DC9X00_LREG_ENABLE),
+	    1u);
+	laguna_dc_wr(io, laguna_dc_layer_pa(live, LAGUNA_DC9X00_LREG_COMMIT),
+	    1u);
+
+	/* Outpath0 is normally already running (ABL scanout); touch it only
+	 * if the enable bits are missing. */
+	ctrl = laguna_dc_rd(io,
+	    LAGUNA_DC9X00_FE_BE_PA + LAGUNA_DC9X00_REG_OUTPATH0_CTRL);
+	if ((ctrl & LAGUNA_DC9X00_OUTPATH0_EN_MASK) !=
+	    LAGUNA_DC9X00_OUTPATH0_EN_MASK) {
+		laguna_dc_wr(io,
+		    LAGUNA_DC9X00_FE_BE_PA + LAGUNA_DC9X00_REG_OUTPATH0_CTRL,
+		    ctrl | LAGUNA_DC9X00_OUTPATH0_EN_MASK);
+	}
+	return LAGUNA_DC9X00_REPOINT_OK;
+}
+
+#if defined(__arm64__) && !defined(LAGUNA_DC9X00_HOSTTEST)
+
+#include <pexpert/pexpert.h>           /* kprintf, PE_state */
+#include <machine/machine_routines.h>  /* ml_io_map_wcomb, ml_io_unmap */
+
+static void
+laguna_dc9x00_splash_report(const struct laguna_dc_probe_report **out)
+{
+	static struct laguna_dc_probe_report local;
+
+	/* The local probe reads the DC windows: same ADT gate as 0002, so a
+	 * handoff without a (matching) laguna-dpu node never touches MMIO. */
+	if (*out == NULL && laguna_dc9x00_adt_gate() == LAGUNA_DC9X00_ADT_OK) {
+		struct laguna_dc_io *io = laguna_dc9x00_kernel_io();
+
+		if (io != NULL) {
+			laguna_dc_probe(io, &local);
+			*out = &local;
+		}
+	}
+}
+
+void
+laguna_dc9x00_early_splash(void)
+{
+	uint32_t level = laguna_dc9x00_bootarg(LAGUNA_DC9X00_ARG_SPLASH, 0);
+	const struct laguna_dc_probe_report *rep =
+	    laguna_dc9x00_cached_report();
+	uint64_t fb_pa = (uint64_t)PE_state.video.v_baseAddr;
+	uint32_t fb_w = PE_state.video.v_width;
+	uint32_t fb_h = PE_state.video.v_height;
+	uint32_t fb_stride = PE_state.video.v_rowBytes;
+	uint32_t fb_depth = PE_state.video.v_depth;
+	uint32_t live;
+
+	if (level == 0) {
+		return;
+	}
+	laguna_dc9x00_pmsg_mark(3);
+
+	/* (a) the handoff framebuffer — the cpu_pa the display consumer
+	 * (hakios_blazer_display_init, earlier in arm_init) validated from the
+	 * CRC'd /chosen/laguna-display-handoff record and adopted into
+	 * PE_state.video; on the phone that is 0xf0000000, the display-owning
+	 * first stage's own linear buffer (1280x2856 stride 5120 = the ABL
+	 * panel mode). Headless (video cleared by the fail-closed validator)
+	 * means: never invent a PA. The WCOMB map is scoped to stride*height
+	 * (capped at LAGUNA_DC9X00_FB_MAP) and unmapped after the fill — a
+	 * big early I/O map held forever is exactly what killed the 141
+	 * lineage's fbcon (0104). */
+	if (fb_pa == 0 || fb_w == 0 || fb_h == 0 || fb_depth != 32 ||
+	    fb_stride < fb_w * 4u || (fb_stride % 4u) != 0 ||
+	    (uint64_t)fb_stride * fb_h > LAGUNA_DC9X00_FB_MAP) {
+		kprintf("LAGUNA DC9x00 splash: no usable handoff framebuffer "
+		    "(PA=0x%llx %ux%u stride=%u depth=%u); fixed-FB fill "
+		    "skipped\n", (unsigned long long)fb_pa, fb_w, fb_h,
+		    fb_stride, fb_depth);
+	} else {
+		vm_offset_t fb_va = ml_io_map_wcomb((vm_offset_t)fb_pa,
+		    (vm_size_t)((uint64_t)fb_stride * fb_h));
+
+		if (fb_va == 0) {
+			kprintf("LAGUNA DC9x00 splash: fb mapping failed "
+			    "(PA=0x%llx, %u bytes)\n",
+			    (unsigned long long)fb_pa, fb_stride * fb_h);
+		} else {
+			kprintf("LAGUNA DC9x00 splash: fb = WCOMB map %p "
+			    "(PA=0x%llx, %ux%u stride %u, %u bytes)\n",
+			    (void *)fb_va, (unsigned long long)fb_pa,
+			    fb_w, fb_h, fb_stride, fb_stride * fb_h);
+			laguna_dc_fill_pattern((uint32_t *)(void *)fb_va,
+			    fb_w, fb_h, fb_stride);
+			__asm__ volatile("dsb sy" ::: "memory");
+			ml_io_unmap(fb_va,
+			    (vm_size_t)((uint64_t)fb_stride * fb_h));
+			laguna_dc9x00_pmsg_mark(4);
+		}
+	}
+
+	laguna_dc9x00_splash_report(&rep);
+	if (rep == NULL) {
+		kprintf("LAGUNA DC9x00 splash: no probe report (ADT %s %s); "
+		    "ABL scanout untouched\n", LAGUNA_DC9X00_ADT_NODE,
+		    laguna_dc9x00_adt_gate() == LAGUNA_DC9X00_ADT_OK ?
+		    "probe failed" : "absent or mismatched");
+		return;
+	}
+	live = laguna_dc_choose_live_layer(rep);
+
+	/* (b) paint the live scanout buffer: DRAM writes only, the DPU is
+	 * left exactly as ABL left it. Only when the reported stride is
+	 * consistent with our 1280-wide 32bpp pattern. */
+	if (level >= 1 && live != LAGUNA_DC9X00_LAYER_NONE &&
+	    rep->line_advancing && rep->layers[live].stride >= LAGUNA_DC9X00_FB_STRIDE) {
+		uint64_t pa = rep->layers[live].fb_pa;
+		uint32_t stride = rep->layers[live].stride;
+		vm_offset_t lva = ml_io_map_wcomb((vm_offset_t)pa,
+		    (vm_size_t)(stride * LAGUNA_DC9X00_FB_H));
+
+		if (lva != 0) {
+			laguna_dc_fill_pattern((uint32_t *)(void *)lva,
+			    LAGUNA_DC9X00_FB_W, LAGUNA_DC9X00_FB_H, stride);
+			__asm__ volatile("dsb sy" ::: "memory");
+			kprintf("LAGUNA DC9x00 splash: painted live buffer "
+			    "layer[%u] PA=0x%llx stride=%u\n", live,
+			    (unsigned long long)pa, stride);
+			laguna_dc9x00_pmsg_mark(5);
+		} else {
+			kprintf("LAGUNA DC9x00 splash: live buffer mapping "
+			    "failed (layer[%u] PA=0x%llx)\n", live,
+			    (unsigned long long)pa);
+		}
+	} else {
+		kprintf("LAGUNA DC9x00 splash: live buffer not painted "
+		    "(live layer=%u, line advancing=%u)\n", live,
+		    rep->line_advancing);
+	}
+
+	/* (c) level 2: the only DC register writes in the series. The repoint
+	 * target is the same adopted handoff framebuffer as (a) — never the
+	 * compiled-in constant, so ADT/kernel/record can never disagree about
+	 * where the pipe points. */
+	if (level >= 2) {
+		struct laguna_dc_write_log log;
+		struct laguna_dc_logging_ctx lctx;
+		struct laguna_dc_io lio;
+		struct laguna_dc_io *io = laguna_dc9x00_kernel_io();
+		uint32_t status, i;
+
+		if (io == NULL) {
+			kprintf("LAGUNA DC9x00 splash: io mapping failed\n");
+			return;
+		}
+		log.count = 0;
+		laguna_dc_logging_io_init(&lctx, &lio, &log, io);
+		status = laguna_dc_splash_repoint(&lio, fb_pa, rep);
+		for (i = 0; i < log.count; i++) {
+			kprintf("LAGUNA DC9x00 splash: DC write 0x%llx: "
+			    "0x%x -> 0x%x\n",
+			    (unsigned long long)log.entry[i].pa,
+			    log.entry[i].old_value, log.entry[i].new_value);
+		}
+		kprintf("LAGUNA DC9x00 splash: repoint status=%u (%s), "
+		    "%u register writes\n", status,
+		    laguna_dc_repoint_status(status), log.count);
+		laguna_dc9x00_pmsg_mark(status == LAGUNA_DC9X00_REPOINT_OK ? 6 : 7);
+	}
+}
+
+#endif /* __arm64__ && !HOSTTEST */
+#endif /* __arm64__ || HOSTTEST */
diff --git a/osfmk/arm64/laguna_display_handoff.c b/osfmk/arm64/laguna_display_handoff.c
new file mode 100644
index 0000000..c8c08ff
--- /dev/null
+++ b/osfmk/arm64/laguna_display_handoff.c
@@ -0,0 +1,321 @@
+/* Data-only display handoff validation.  No hardware access. */
+#include "laguna_render_port.h"
+
+#include <string.h>
+
+_Static_assert(sizeof(struct laguna_display_handoff) == LAGUNA_DISPLAY_HANDOFF_SIZE,
+	"laguna_display_handoff wire size changed");
+_Static_assert(offsetof(struct laguna_display_handoff, crc32) ==
+	LAGUNA_DISPLAY_HANDOFF_CRC_OFFSET, "laguna_display_handoff CRC offset changed");
+
+static uint32_t
+crc32_update(uint32_t crc, const uint8_t *data, size_t size)
+{
+	crc = ~crc;
+	for (size_t i = 0; i < size; i++) {
+		crc ^= data[i];
+		for (unsigned bit = 0; bit < 8; bit++) {
+			uint32_t mask = (uint32_t)-(int32_t)(crc & 1u);
+			crc = (crc >> 1) ^ (UINT32_C(0xedb88320) & mask);
+		}
+	}
+	return ~crc;
+}
+
+static bool
+producer_has_nul(const uint8_t *producer, size_t size)
+{
+	for (size_t i = 0; i < size; i++) {
+		if (producer[i] == 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static uint32_t
+handoff_crc(const struct laguna_display_handoff *handoff)
+{
+	struct laguna_display_handoff copy = *handoff;
+	copy.crc32 = 0;
+	return crc32_update(0, (const uint8_t *)&copy, sizeof(copy));
+}
+
+void
+laguna_display_handoff_seal(struct laguna_display_handoff *handoff)
+{
+	if (handoff == NULL) {
+		return;
+	}
+	handoff->magic = LAGUNA_DISPLAY_HANDOFF_MAGIC;
+	handoff->version = LAGUNA_DISPLAY_HANDOFF_VERSION;
+	handoff->struct_size = LAGUNA_DISPLAY_HANDOFF_SIZE;
+	handoff->reserved[0] = 0;
+	handoff->reserved[1] = 0;
+	handoff->reserved[2] = 0;
+	handoff->crc32 = 0;
+	handoff->crc32 = handoff_crc(handoff);
+}
+
+static bool
+range_end(const struct laguna_memory_range *range, uint64_t *end)
+{
+	if (range->size == 0 || range->base + range->size < range->base) {
+		return false;
+	}
+	*end = range->base + range->size;
+	return true;
+}
+
+static bool
+ranges_overlap(uint64_t a_base, uint64_t a_end, uint64_t b_base, uint64_t b_end)
+{
+	return a_base < b_end && b_base < a_end;
+}
+
+static enum laguna_display_error
+validate_forbidden(const struct laguna_display_handoff *handoff,
+	const struct laguna_memory_range *forbidden, size_t forbidden_count)
+{
+	uint64_t fb_end;
+	struct laguna_memory_range fb = {
+		.base = handoff->cpu_pa,
+		.size = handoff->cpu_size
+	};
+
+	if (!range_end(&fb, &fb_end)) {
+		return LAGUNA_DISPLAY_RANGE_OVERFLOW;
+	}
+	for (size_t i = 0; i < forbidden_count; i++) {
+		uint64_t other_end;
+		if (!range_end(&forbidden[i], &other_end)) {
+			return LAGUNA_DISPLAY_RANGE_OVERFLOW;
+		}
+		if (ranges_overlap(fb.base, fb_end, forbidden[i].base, other_end)) {
+			return LAGUNA_DISPLAY_RANGE_OVERLAP;
+		}
+	}
+	return LAGUNA_DISPLAY_OK;
+}
+
+enum laguna_display_error
+laguna_display_validate(const struct laguna_display_handoff *handoff,
+	const struct laguna_memory_range *forbidden, size_t forbidden_count)
+{
+	uint64_t needed, end;
+
+	if (handoff == NULL || (forbidden_count != 0 && forbidden == NULL)) {
+		return LAGUNA_DISPLAY_BAD_ARGUMENT;
+	}
+	if (handoff->magic != LAGUNA_DISPLAY_HANDOFF_MAGIC) {
+		return LAGUNA_DISPLAY_BAD_MAGIC;
+	}
+	if (handoff->version != LAGUNA_DISPLAY_HANDOFF_VERSION) {
+		return LAGUNA_DISPLAY_BAD_VERSION;
+	}
+	if (handoff->struct_size != LAGUNA_DISPLAY_HANDOFF_SIZE) {
+		return LAGUNA_DISPLAY_BAD_STRUCT_SIZE;
+	}
+	if (handoff->reserved[0] != 0 || handoff->reserved[1] != 0 || handoff->reserved[2] != 0) {
+		return LAGUNA_DISPLAY_BAD_RESERVED;
+	}
+	if (handoff->crc32 != handoff_crc(handoff)) {
+		return LAGUNA_DISPLAY_BAD_CRC;
+	}
+	if ((handoff->flags & LAGUNA_DISPLAY_REQUIRED_FLAGS) != LAGUNA_DISPLAY_REQUIRED_FLAGS) {
+		return LAGUNA_DISPLAY_MISSING_FLAGS;
+	}
+	if ((handoff->flags & ~LAGUNA_DISPLAY_KNOWN_FLAGS) != 0) {
+		return LAGUNA_DISPLAY_UNKNOWN_FLAGS;
+	}
+	if (handoff->pixel_format != LAGUNA_PIXEL_ARGB8888 &&
+	    handoff->pixel_format != LAGUNA_PIXEL_XRGB8888) {
+		return LAGUNA_DISPLAY_BAD_FORMAT;
+	}
+	if (handoff->width == 0 || handoff->height == 0 ||
+	    handoff->width > 8192 || handoff->height > 8192 ||
+	    handoff->refresh_millihz < 1000 || handoff->refresh_millihz > 240000) {
+		return LAGUNA_DISPLAY_BAD_GEOMETRY;
+	}
+	if ((uint64_t)handoff->stride < (uint64_t)handoff->width * 4 ||
+	    (handoff->stride & 0xffu) != 0) {
+		return LAGUNA_DISPLAY_BAD_STRIDE;
+	}
+	needed = (uint64_t)handoff->stride * handoff->height;
+	if (handoff->cpu_size < needed || (handoff->cpu_size & 0xfffu) != 0) {
+		return LAGUNA_DISPLAY_BAD_CPU_SIZE;
+	}
+	if (handoff->cpu_pa < UINT64_C(0x80000000) ||
+	    handoff->cpu_pa >= (UINT64_C(1) << 40) || (handoff->cpu_pa & 0xffu) != 0 ||
+	    handoff->cpu_pa + handoff->cpu_size < handoff->cpu_pa) {
+		return LAGUNA_DISPLAY_BAD_CPU_PA;
+	}
+	end = handoff->cpu_pa + handoff->cpu_size;
+	if (end > (UINT64_C(1) << 40)) {
+		return LAGUNA_DISPLAY_BAD_CPU_PA;
+	}
+	if ((handoff->dpu_iova & 0xffu) != 0 ||
+	    handoff->dpu_iova + handoff->cpu_size < handoff->dpu_iova) {
+		return LAGUNA_DISPLAY_BAD_IOVA;
+	}
+	if (handoff->reserve_pa != handoff->cpu_pa || handoff->reserve_size != handoff->cpu_size) {
+		return LAGUNA_DISPLAY_BAD_RESERVATION;
+	}
+	if (handoff->mapping_kind == LAGUNA_DISPLAY_MAPPING_IDENTITY) {
+		if (handoff->dpu_iova != handoff->cpu_pa) {
+			return LAGUNA_DISPLAY_BAD_MAPPING;
+		}
+	} else if (handoff->mapping_kind != LAGUNA_DISPLAY_MAPPING_FIRST_STAGE_SMMU) {
+		return LAGUNA_DISPLAY_BAD_MAPPING;
+	}
+	if (handoff->cache_kind != LAGUNA_DISPLAY_CACHE_WRITE_COMBINE &&
+	    handoff->cache_kind != LAGUNA_DISPLAY_CACHE_CLEAN_ON_PRESENT) {
+		return LAGUNA_DISPLAY_BAD_CACHE;
+	}
+	if (handoff->producer[0] < 33 || handoff->producer[0] > 126 ||
+	    !producer_has_nul(handoff->producer, sizeof(handoff->producer))) {
+		return LAGUNA_DISPLAY_BAD_PRODUCER;
+	}
+	if (handoff->commit_generation == 0) {
+		return LAGUNA_DISPLAY_BAD_GENERATION;
+	}
+	return validate_forbidden(handoff, forbidden, forbidden_count);
+}
+
+/*
+ * Cold-handoff validator (DISPLAY-PRODUCER §3.2).  Same integrity, geometry,
+ * reservation, cache, producer, generation and forbidden-range rules as
+ * laguna_display_validate(); different flag and mapping policy:
+ *   - flags must carry COLD_REQUIRED and no COLD_FORBIDDEN bit;
+ *   - refresh_millihz may be the honest zero (no measured refresh on the cold
+ *     path — vsync there is a software beat, USERLAND-PATH M7);
+ *   - dpu_iova must be 0 and mapping_kind must be NONE.
+ * Acceptance never implies scanout: it proves a reserved linear RAM buffer.
+ */
+enum laguna_display_error
+laguna_display_validate_cold(const struct laguna_display_handoff *handoff,
+	const struct laguna_memory_range *forbidden, size_t forbidden_count)
+{
+	uint64_t needed, end;
+
+	if (handoff == NULL || (forbidden_count != 0 && forbidden == NULL)) {
+		return LAGUNA_DISPLAY_BAD_ARGUMENT;
+	}
+	if ((handoff->flags & LAGUNA_DISPLAY_COLD_REQUIRED) != LAGUNA_DISPLAY_COLD_REQUIRED) {
+		return LAGUNA_DISPLAY_MISSING_FLAGS;
+	}
+	/* Any ownership/liveness/IOVA bit turns this into a full-contract record;
+	 * it must then satisfy laguna_display_validate() or be refused. */
+	if ((handoff->flags & LAGUNA_DISPLAY_COLD_FORBIDDEN) != 0) {
+		return LAGUNA_DISPLAY_UNKNOWN_FLAGS;
+	}
+	if (handoff->magic != LAGUNA_DISPLAY_HANDOFF_MAGIC) {
+		return LAGUNA_DISPLAY_BAD_MAGIC;
+	}
+	if (handoff->version != LAGUNA_DISPLAY_HANDOFF_VERSION) {
+		return LAGUNA_DISPLAY_BAD_VERSION;
+	}
+	if (handoff->struct_size != LAGUNA_DISPLAY_HANDOFF_SIZE) {
+		return LAGUNA_DISPLAY_BAD_STRUCT_SIZE;
+	}
+	if (handoff->reserved[0] != 0 || handoff->reserved[1] != 0 || handoff->reserved[2] != 0) {
+		return LAGUNA_DISPLAY_BAD_RESERVED;
+	}
+	if (handoff->crc32 != handoff_crc(handoff)) {
+		return LAGUNA_DISPLAY_BAD_CRC;
+	}
+	if ((handoff->flags & ~LAGUNA_DISPLAY_KNOWN_FLAGS) != 0) {
+		return LAGUNA_DISPLAY_UNKNOWN_FLAGS;
+	}
+	if (handoff->pixel_format != LAGUNA_PIXEL_ARGB8888 &&
+	    handoff->pixel_format != LAGUNA_PIXEL_XRGB8888) {
+		return LAGUNA_DISPLAY_BAD_FORMAT;
+	}
+	/* Honest zero allowed here in addition to the measured-range values the
+	 * full contract requires; the cold consumer treats both as "no panel
+	 * claim" — vsync is a software beat until live scanout exists. */
+	if (handoff->width == 0 || handoff->height == 0 ||
+	    handoff->width > 8192 || handoff->height > 8192 ||
+	    (handoff->refresh_millihz != 0 &&
+	    (handoff->refresh_millihz < 1000 || handoff->refresh_millihz > 240000))) {
+		return LAGUNA_DISPLAY_BAD_GEOMETRY;
+	}
+	if ((uint64_t)handoff->stride < (uint64_t)handoff->width * 4 ||
+	    (handoff->stride & 0xffu) != 0) {
+		return LAGUNA_DISPLAY_BAD_STRIDE;
+	}
+	needed = (uint64_t)handoff->stride * handoff->height;
+	if (handoff->cpu_size < needed || (handoff->cpu_size & 0xfffu) != 0) {
+		return LAGUNA_DISPLAY_BAD_CPU_SIZE;
+	}
+	if (handoff->cpu_pa < UINT64_C(0x80000000) ||
+	    handoff->cpu_pa >= (UINT64_C(1) << 40) || (handoff->cpu_pa & 0xffu) != 0 ||
+	    handoff->cpu_pa + handoff->cpu_size < handoff->cpu_pa) {
+		return LAGUNA_DISPLAY_BAD_CPU_PA;
+	}
+	end = handoff->cpu_pa + handoff->cpu_size;
+	if (end > (UINT64_C(1) << 40)) {
+		return LAGUNA_DISPLAY_BAD_CPU_PA;
+	}
+	if (handoff->dpu_iova != 0) {
+		return LAGUNA_DISPLAY_BAD_IOVA;
+	}
+	if (handoff->reserve_pa != handoff->cpu_pa || handoff->reserve_size != handoff->cpu_size) {
+		return LAGUNA_DISPLAY_BAD_RESERVATION;
+	}
+	if (handoff->mapping_kind != LAGUNA_DISPLAY_MAPPING_NONE) {
+		return LAGUNA_DISPLAY_BAD_MAPPING;
+	}
+	if (handoff->cache_kind != LAGUNA_DISPLAY_CACHE_WRITE_COMBINE &&
+	    handoff->cache_kind != LAGUNA_DISPLAY_CACHE_CLEAN_ON_PRESENT) {
+		return LAGUNA_DISPLAY_BAD_CACHE;
+	}
+	if (handoff->producer[0] < 33 || handoff->producer[0] > 126 ||
+	    !producer_has_nul(handoff->producer, sizeof(handoff->producer))) {
+		return LAGUNA_DISPLAY_BAD_PRODUCER;
+	}
+	if (handoff->commit_generation == 0) {
+		return LAGUNA_DISPLAY_BAD_GENERATION;
+	}
+	return validate_forbidden(handoff, forbidden, forbidden_count);
+}
+
+enum laguna_display_error
+laguna_display_boot_video(const struct laguna_display_handoff *handoff,
+	const struct laguna_memory_range *forbidden, size_t forbidden_count,
+	struct laguna_boot_video *video)
+{
+	enum laguna_display_error error;
+
+	if (video == NULL) {
+		return LAGUNA_DISPLAY_BAD_ARGUMENT;
+	}
+	error = laguna_display_validate(handoff, forbidden, forbidden_count);
+	if (error != LAGUNA_DISPLAY_OK) {
+		return error;
+	}
+	video->base = handoff->cpu_pa;
+	video->width = handoff->width;
+	video->height = handoff->height;
+	video->row_bytes = handoff->stride;
+	video->depth = 32;
+	video->graphics_mode = 1;
+	return LAGUNA_DISPLAY_OK;
+}
+
+const char *
+laguna_display_error_string(enum laguna_display_error error)
+{
+	static const char *const names[] = {
+		"ok", "bad argument", "bad magic", "bad version", "bad struct size",
+		"bad reserved field", "bad CRC", "missing flags", "unknown flags",
+		"bad pixel format", "bad geometry", "bad stride", "bad CPU physical address",
+		"bad CPU size", "bad DPU IOVA", "bad mapping", "bad reservation",
+		"bad cache policy", "bad producer", "bad commit generation",
+		"range overflow", "forbidden range overlap"
+	};
+	if ((unsigned)error >= sizeof(names) / sizeof(names[0])) {
+		return "unknown error";
+	}
+	return names[error];
+}
diff --git a/osfmk/arm64/laguna_entry_lastwords.s b/osfmk/arm64/laguna_entry_lastwords.s
new file mode 100644
index 0000000..ebb8fbf
--- /dev/null
+++ b/osfmk/arm64/laguna_entry_lastwords.s
@@ -0,0 +1,289 @@
+/* R4 gated XNU_ENTRY LGLW writer — position-independent AArch64.
+ *
+ * Called by start_first_cpu after patch-xnu-marker.py has performed the XNH0
+ * handoff, but before MMU/caches are enabled. x0 is final boot_args PA (or the
+ * original direct-shim value). The old marker supplies the true incoming x0.
+ *
+ * lagunalogdump defaults ON. A complete, token-bound lagunalogdump=0 argument
+ * suppresses this record; C-side mirror/stages use the same gate. The command
+ * line scan is bounded to boot_args.CommandLine[608] at offset 108.
+ *
+ * Record ABI is exactly research/laguna-ramdump/producer/STAMPS.md: alternating
+ * 128-byte LGLW slots, CRC-32/IEEE over [0,120), DONE committed last. Physical
+ * stores + DSB SY make the record visible to a warm-reset raw RAM dump.
+ * Clobbers x9..x17 and flags; x0 is restored to final boot_args, x1..x8/lr
+ * are preserved. No stack, MMU, caches, C runtime, or external data is used.
+ */
+#include <arm64/asm.h>
+
+.equ LW_SLOT0,        0x95401100
+.equ LW_SLOT1,        0x95401180
+.equ MARKER_SLOT,     0x95400100
+.equ MARKER_MAGIC,    0x5a5a5a5a
+/* XNU-MSGBUF v2: the compact trail moved out of the empirically hostile low
+ * pmsg region (TEE fastboot-re-entry log + handoff page + probe log cover
+ * +0x000..~0x5C80 on every retrieved dump). pmsg+0x28000 is remnant-quiet.
+ * The CRC/DONE LGLW slots stay at the frozen R3-shared ABI (0x95401100/80). */
+.equ COMPACT_SLOT,    0x95428000
+.equ COMPACT_WORDS,   12
+/* XNU-MSGBUF v2 freshness extension (0131). The original 64-byte stream
+ * header is unchanged; the full header is now 128 bytes. XNUENT1 at +0x40
+ * commits {boot_nonce, entry_cntvct, mirror_init_cntvct, cntfrq, flags,
+ * shim_handoff_cntvct}. The nonce and handoff timestamp are copied from S1's
+ * existing TSHIMST2 handoff record, so no shim-side change or new boot-arg is
+ * required. Mirror init fills +0x58 later without erasing this prologue. */
+.equ LOGDUMP_HDR,      0x9543f800
+.equ LOGDUMP_HDR_SIZE, 128
+.equ SHIM_STAMP_HDR,   0x95430000
+.equ SHIM_NONCE_OFF,   0x08
+.equ SHIM_TLAST_OFF,   0x30
+.equ LD_ENTRY_VALID,   0x01
+.equ LD_INIT_VALID,    0x02
+.equ LD_NONCE_TSHIMST2,0x04
+.equ LGLW_MAGIC,      0x574c474c
+.equ LW_COMMIT,       0x454e4f44
+.equ LW_VERSION_SIZE, 0x00800001       /* version=1, bytes=128 */
+.equ LW_STAGE,        6                /* XNU_ENTRY */
+.equ LW_PRODUCER,     4                /* XNU_STUB */
+.equ BA_COMMANDLINE,  108
+.equ BOOT_LINE_LENGTH,608
+.equ DISABLE_LEN,     15               /* "lagunalogdump=0" */
+
+.text
+.balign 8
+.globl EXT(laguna_logdump_entry)
+LEXT(laguna_logdump_entry)
+	mov     x13, x0                   /* final boot_args PA */
+
+	/* Recover the true incoming x0 from the already-executed old marker. */
+	movz    x17, #(MARKER_SLOT & 0xffff)
+	movk    x17, #((MARKER_SLOT >> 16) & 0xffff), lsl #16
+	ldr     w16, [x17]
+	movz    w15, #(MARKER_MAGIC & 0xffff)
+	movk    w15, #((MARKER_MAGIC >> 16) & 0xffff), lsl #16
+	cmp     w16, w15
+	b.ne    1f
+	ldr     x14, [x17, #8]
+	b       2f
+1:
+	mov     x14, x13                  /* unpatched/direct entry: same x0 */
+2:
+
+	/* Clear only the 48-byte compact trail at its v2 location, preserving
+	 * M1/boot/DIAG counters (and the relocated v2 counters, which persist
+	 * across boots). Disabled boots therefore cannot leak a prior boot's
+	 * compact stage. */
+	movz    x15, #(COMPACT_SLOT & 0xffff)
+	movk    x15, #((COMPACT_SLOT >> 16) & 0xffff), lsl #16
+	mov     w16, #(COMPACT_WORDS / 2)
+Llaguna_ld_clear_compact:
+	str     xzr, [x15], #8
+	subs    w16, w16, #1
+	b.ne    Llaguna_ld_clear_compact
+
+	/* Invalidate any prior mirror/prologue on EVERY entry, including an
+	 * opt-out boot. Otherwise lagunalogdump=0 could leak the previous boot's
+	 * freshness key and text into this boot's dump. */
+	movz    x15, #(LOGDUMP_HDR & 0xffff)
+	movk    x15, #((LOGDUMP_HDR >> 16) & 0xffff), lsl #16
+	mov     w16, #(LOGDUMP_HDR_SIZE / 8)
+Llaguna_ld_clear_logdump:
+	str     xzr, [x15], #8
+	subs    w16, w16, #1
+	b.ne    Llaguna_ld_clear_logdump
+	dsb     sy
+
+	/* Gate the earliest stamp. No boot_args means the default (ON). */
+	cbz     x13, Llaguna_ld_gate_done
+	add     x9, x13, #BA_COMMANDLINE
+	mov     x17, x9                   /* command-line base */
+	add     x10, x9, #(BOOT_LINE_LENGTH - DISABLE_LEN)
+Llaguna_ld_find_disable:
+	ldrb    w11, [x9]
+	cmp     w11, #'l'
+	b.ne    Llaguna_ld_next
+	cmp     x9, x17
+	b.eq    Llaguna_ld_candidate
+	ldrb    w11, [x9, #-1]
+	cmp     w11, #' '
+	b.ne    Llaguna_ld_next
+Llaguna_ld_candidate:
+	mov     x12, x9
+	adr     x15, Llaguna_ld_disable_token
+Llaguna_ld_compare:
+	ldrb    w16, [x15], #1
+	cbz     w16, Llaguna_ld_token_tail
+	ldrb    w11, [x12], #1
+	cmp     w11, w16
+	b.ne    Llaguna_ld_next
+	b       Llaguna_ld_compare
+Llaguna_ld_token_tail:
+	/* Require a token boundary without reading past CommandLine[608]. */
+	add     x16, x17, #BOOT_LINE_LENGTH
+	cmp     x12, x16
+	b.eq    Llaguna_ld_disabled
+	ldrb    w16, [x12]
+	cbz     w16, Llaguna_ld_disabled
+	cmp     w16, #' '
+	b.eq    Llaguna_ld_disabled
+Llaguna_ld_next:
+	add     x9, x9, #1
+	cmp     x9, x10
+	b.ls    Llaguna_ld_find_disable
+Llaguna_ld_gate_done:
+
+	/* Dated XNU_ENTRY prologue. Read the shared virtual counter before any
+	 * MMU/C runtime setup and pair it with S1's nonce + terminal handoff time.
+	 * If the stamp magic is absent, nonce/handoff stay zero and the reader
+	 * cannot claim TSHIMST continuity (legacy non-shim dumps remain readable). */
+	mrs     x10, cntvct_el0
+	mrs     x15, cntfrq_el0
+	mov     x11, xzr                   /* boot nonce, unless TSHIMST2 is live */
+	mov     x12, xzr                   /* shim handoff cntvct */
+	movz    x16, #(SHIM_STAMP_HDR & 0xffff)
+	movk    x16, #((SHIM_STAMP_HDR >> 16) & 0xffff), lsl #16
+	ldr     x17, [x16]
+	ldr     x11, [x16, #SHIM_NONCE_OFF]
+	ldr     x12, [x16, #SHIM_TLAST_OFF]
+	adr     x16, Llaguna_ld_shim_magic
+	ldr     x16, [x16]
+	cmp     x17, x16
+	b.ne    3f
+	mov     w16, #(LD_ENTRY_VALID | LD_NONCE_TSHIMST2)
+	b       4f
+3:
+	mov     x11, xzr
+	mov     x12, xzr
+	mov     w16, #LD_ENTRY_VALID
+4:
+	movz    x9, #(LOGDUMP_HDR & 0xffff)
+	movk    x9, #((LOGDUMP_HDR >> 16) & 0xffff), lsl #16
+	str     x11, [x9, #0x48]           /* boot_nonce */
+	str     x10, [x9, #0x50]           /* entry_cntvct */
+	str     xzr, [x9, #0x58]           /* mirror_init_cntvct: not yet armed */
+	str     x15, [x9, #0x60]           /* cntfrq */
+	str     w16, [x9, #0x68]           /* ENTRY + optional TSHIMST2 source */
+	str     wzr, [x9, #0x6c]
+	str     x12, [x9, #0x70]           /* captured shim tlast */
+	str     xzr, [x9, #0x78]
+	adr     x17, Llaguna_ld_msgbuf_magic
+	ldr     x15, [x17]
+	ldr     x16, [x17, #8]
+	str     x15, [x9]
+	str     x16, [x9, #8]              /* base magic; stream geometry still 0 */
+	dsb     sy
+	adr     x17, Llaguna_ld_entry_magic
+	ldr     x15, [x17]
+	str     x15, [x9, #0x40]           /* XNUENT1 commits the prologue last */
+	dsb     sy
+
+	movz    x9, #(LW_SLOT0 & 0xffff)
+	movk    x9, #((LW_SLOT0 >> 16) & 0xffff), lsl #16
+
+	/* Sanitize both seq words: [0,0xfffffffd] only. */
+	ldr     w10, [x9, #8]
+	ldr     w11, [x9, #0x88]
+	movn    w15, #1                   /* 0xfffffffe */
+	cmp     w10, w15
+	csel    w10, wzr, w10, hs
+	cmp     w11, w15
+	csel    w11, wzr, w11, hs
+	cmp     w10, w11
+	csel    w12, w10, w11, hi
+
+	movn    w15, #2                   /* 0xfffffffd = sequence limit */
+	cmp     w12, w15
+	b.eq    Llaguna_ld_generation_reset
+	add     w12, w12, #1
+	mov     x10, x9                   /* odd next -> slot 0 */
+	tbz     w12, #0, Llaguna_ld_select_slot1
+	b       Llaguna_ld_slot_selected
+Llaguna_ld_select_slot1:
+	add     x10, x9, #(LW_SLOT1 - LW_SLOT0)
+	b       Llaguna_ld_slot_selected
+
+Llaguna_ld_generation_reset:
+	str     wzr, [x9, #0x7c]
+	str     wzr, [x9, #0xfc]
+	dsb     sy
+	mov     w12, #1
+	mov     x10, x9
+
+Llaguna_ld_slot_selected:
+	/* Invalidate first; the other slot survives any torn update. */
+	str     wzr, [x10, #0x7c]
+	dsb     sy
+	mov     x15, x10
+	mov     w16, #16
+Llaguna_ld_zero_record:
+	str     xzr, [x15], #8
+	subs    w16, w16, #1
+	b.ne    Llaguna_ld_zero_record
+
+	movz    w15, #(LGLW_MAGIC & 0xffff)
+	movk    w15, #((LGLW_MAGIC >> 16) & 0xffff), lsl #16
+	str     w15, [x10, #0x00]
+	movz    w15, #(LW_VERSION_SIZE & 0xffff)
+	movk    w15, #((LW_VERSION_SIZE >> 16) & 0xffff), lsl #16
+	str     w15, [x10, #0x04]
+	str     w12, [x10, #0x08]
+	mov     w15, #LW_STAGE
+	str     w15, [x10, #0x0c]
+	mov     w15, #LW_PRODUCER
+	str     w15, [x10, #0x10]
+	str     x14, [x10, #0x18]         /* incoming x0 */
+	str     x13, [x10, #0x20]         /* final boot_args PA */
+
+	/* CRC-32/IEEE bytes [0,120), two table-driven nibbles per byte. */
+	movn    w12, #0
+	adr     x15, Llaguna_ld_crc_nibble_table
+	mov     x16, x10
+	add     x17, x10, #120
+Llaguna_ld_crc_loop:
+	ldrb    w11, [x16], #1
+	eor     w12, w12, w11
+	and     w11, w12, #0xf
+	ldr     w11, [x15, w11, uxtw #2]
+	eor     w12, w11, w12, lsr #4
+	and     w11, w12, #0xf
+	ldr     w11, [x15, w11, uxtw #2]
+	eor     w12, w11, w12, lsr #4
+	cmp     x16, x17
+	b.ne    Llaguna_ld_crc_loop
+	mvn     w12, w12
+	str     w12, [x10, #0x78]
+	dsb     sy
+
+	movz    w15, #(LW_COMMIT & 0xffff)
+	movk    w15, #((LW_COMMIT >> 16) & 0xffff), lsl #16
+	str     w15, [x10, #0x7c]
+	dsb     sy
+
+	/* Independent compact breadcrumb at pmsg+0x28000, R3 stage XNU_ENTRY. */
+	movz    x15, #(COMPACT_SLOT & 0xffff)
+	movk    x15, #((COMPACT_SLOT >> 16) & 0xffff), lsl #16
+	mov     w16, #LW_STAGE
+	str     w16, [x15]
+	dsb     sy
+Llaguna_ld_disabled:
+	mov     x0, x13                   /* preserve final boot_args for start.s */
+	ret
+
+.balign 8
+Llaguna_ld_msgbuf_magic:
+	.ascii  "XNU-MSGBUF v2\0\0\0"     /* exactly 16 bytes */
+Llaguna_ld_entry_magic:
+	.asciz  "XNUENT1"                    /* exactly 8 bytes */
+Llaguna_ld_shim_magic:
+	.ascii  "TSHIMST2"                    /* exactly 8 bytes */
+
+.balign 4
+Llaguna_ld_disable_token:
+	.asciz  "lagunalogdump=0"
+
+.balign 8
+Llaguna_ld_crc_nibble_table:
+	.word   0x00000000, 0x1db71064, 0x3b6e20c8, 0x26d930ac
+	.word   0x76dc4190, 0x6b6b51f4, 0x4db26158, 0x5005713c
+	.word   0xedb88320, 0xf00f9344, 0xd6d6a3e8, 0xcb61b38c
+	.word   0x9b64c2b0, 0x86d3d2d4, 0xa00ae278, 0xbdbdf21c
diff --git a/osfmk/arm64/laguna_lastwords.h b/osfmk/arm64/laguna_lastwords.h
new file mode 100644
index 0000000..5d3b4db
--- /dev/null
+++ b/osfmk/arm64/laguna_lastwords.h
@@ -0,0 +1,272 @@
+/* LAGUNA LAST WORDS v1 — fixed-PA, crash-consistent boot-stage records.
+ *
+ * Canonical producer/reader contract: research/laguna-ramdump/producer/STAMPS.md.
+ * Freestanding-safe: stdint.h only, no allocation, no locks, no libc calls.
+ * All stored fields are little-endian (laguna and the host tests are LE).
+ *
+ * Physical layout in the reserved ramoops pmsg aperture:
+ *   slot 0  PA 0x95401100, slot 1  PA 0x95401180, 128 bytes each.
+ * This pmsg+0x1100..0x11ff window is after MARKER-SCRATCH (+0x1000),
+ * its boot counter (+0x1040), and DIAG's wrap counter (+0x1080), and before
+ * DIAG's records (+0x2000).  It never touches the persistent_ram header.
+ *
+ * The writer alternates slots.  It invalidates the target's commit word,
+ * writes data + CRC with commit=0, cleans to the PoC, then commits the final
+ * word last.  The other slot remains the last complete record after a torn
+ * update.  Sequence numbers do not wrap: implausible/erased values are
+ * ignored, and exhaustion invalidates both slots before restarting at 1.
+ */
+#ifndef LAGUNA_LASTWORDS_H
+#define LAGUNA_LASTWORDS_H
+
+#include <stdint.h>
+
+#define LW_PMSG_BASE       0x95400000ULL
+#define LW_RECORDS_PA      0x95401100ULL
+#define LW_RECORD_SIZE     128u
+#define LW_SLOT_COUNT      2u
+#define LW_WINDOW_SIZE     (LW_RECORD_SIZE * LW_SLOT_COUNT)
+#define LW_SLOT_STRIDE     LW_RECORD_SIZE
+#define LW_SLOT_PA(slot)   (LW_RECORDS_PA + (uint64_t)(slot) * LW_SLOT_STRIDE)
+
+#define LW_MAGIC           0x574c474cu /* bytes "LGLW" */
+#define LW_COMMIT          0x454e4f44u /* bytes "DONE"; written last */
+#define LW_VERSION         1u
+#define LW_SEQ_MAX         0xfffffffdu /* 0 and 0xfffffffe/ffffffff are erased */
+#define LW_CRC_LEN         120u        /* bytes [0,120): excludes crc+commit */
+#define LW_NOTE_SIZE       64u
+
+/* Stage values are durable ABI.  ABL_SEEN is reserved for an earlier-stage
+ * producer; this Linux/XNU ladder does not emit it retroactively. */
+#define LW_STAGE_ABL_SEEN          1u
+#define LW_STAGE_KERNEL_UP         2u
+#define LW_STAGE_PROBE_START       3u
+#define LW_STAGE_ROOT_STAGED       4u
+#define LW_STAGE_KEXEC_DONE        5u
+#define LW_STAGE_XNU_ENTRY         6u
+#define LW_STAGE_XNU_INIT          7u
+#define LW_STAGE_ROOT_MOUNTED      8u
+#define LW_STAGE_LAUNCHD_EXEC      9u
+#define LW_STAGE_DYLD_STAGE       10u
+#define LW_STAGE_DYLD_SHARED_REGION 11u
+#define LW_STAGE_PANIC            12u
+/* G29 AUTOCYCLE (durable ABI): the blazer_autocycle=<sec> self-reset
+ * commits this stage immediately before halt_all_cpus(TRUE). A deliberate
+ * reset, not a failure: flags 0, detail0=configured seconds, detail1=boot
+ * counter, detail2=committed entry nonce, note "AUTOCYCLE-RESET". Older
+ * readers keep decoding unknown stages numerically (STAMPS.md contract);
+ * register the row there when this patch lands. */
+#define LW_STAGE_AUTOCYCLE_RESET  13u
+
+#define LW_PRODUCER_ABL            1u /* reserved; not emitted by this lane */
+#define LW_PRODUCER_LINUX_PROBE    2u
+#define LW_PRODUCER_KEXEC_LOADER   3u
+#define LW_PRODUCER_XNU_STUB       4u
+#define LW_PRODUCER_XNU_KERNEL     5u
+#define LW_PRODUCER_XNU_PANIC      6u
+
+#define LW_FLAG_ATTEMPT            (1u << 0) /* entered, not completed */
+#define LW_FLAG_FAILURE            (1u << 1) /* failure/panic context */
+
+struct lw_record {
+	uint32_t magic;          /* +0x00 LW_MAGIC */
+	uint16_t version;        /* +0x04 LW_VERSION */
+	uint16_t bytes;          /* +0x06 LW_RECORD_SIZE */
+	uint32_t seq;            /* +0x08 1-based, non-wrapping */
+	uint32_t stage;          /* +0x0c LW_STAGE_* */
+	uint32_t producer;       /* +0x10 LW_PRODUCER_* */
+	uint32_t flags;          /* +0x14 LW_FLAG_* */
+	uint64_t detail[4];      /* +0x18 stage-specific, zero when unused */
+	char note[LW_NOTE_SIZE]; /* +0x38 NUL-padded ASCII; may be empty */
+	uint32_t crc;            /* +0x78 CRC-32/IEEE of bytes [0,120) */
+	uint32_t commit;         /* +0x7c LW_COMMIT, committed last */
+};
+
+_Static_assert(sizeof(struct lw_record) == LW_RECORD_SIZE,
+	       "LGLW record must be exactly 128 bytes");
+_Static_assert(__builtin_offsetof(struct lw_record, detail) == 0x18,
+	       "LGLW detail ABI");
+_Static_assert(__builtin_offsetof(struct lw_record, note) == 0x38,
+	       "LGLW note ABI");
+_Static_assert(__builtin_offsetof(struct lw_record, crc) == LW_CRC_LEN,
+	       "LGLW CRC ABI");
+_Static_assert(LW_RECORDS_PA >= LW_PMSG_BASE + 0x1084 &&
+	       LW_RECORDS_PA + LW_WINDOW_SIZE <= LW_PMSG_BASE + 0x2000,
+	       "LGLW window must be clear of scratch/counters and DIAG records");
+_Static_assert(LW_RECORDS_PA + LW_WINDOW_SIZE <= LW_PMSG_BASE + 0x200000,
+	       "LGLW window must remain inside pmsg");
+
+/* Memory backend.  read/write return 0 on success, negative on failure.
+ * clean(pa,len) must make the written range visible at the Point of
+ * Coherency and execute the required completion barrier before returning.
+ * Linux uses DC CVAC + DSB SY on its /dev/mem mapping; XNU's Device-memory
+ * mapping needs only DSB SY.  The host mock records this ordering. */
+struct lw_mem {
+	void *ctx;
+	long (*read)(void *ctx, uint64_t pa, void *buf, uint32_t len);
+	long (*write)(void *ctx, uint64_t pa, const void *buf, uint32_t len);
+	long (*clean)(void *ctx, uint64_t pa, uint32_t len);
+};
+
+struct lw_event {
+	uint32_t stage;
+	uint32_t producer;
+	uint32_t flags;
+	uint64_t detail[4];
+	const char *note; /* optional; bounded to 63 chars + NUL */
+};
+
+static inline uint32_t
+lw_crc32(const uint8_t *p, uint32_t n)
+{
+	uint32_t c = 0xffffffffu;
+	uint32_t i;
+	int b;
+
+	for (i = 0; i < n; i++) {
+		c ^= p[i];
+		for (b = 0; b < 8; b++)
+			c = (c >> 1) ^ (0xedb88320u & (0u - (c & 1u)));
+	}
+	return ~c;
+}
+
+static inline int
+lw_valid(const struct lw_record *r)
+{
+	if (!r || r->magic != LW_MAGIC || r->version != LW_VERSION ||
+	    r->bytes != LW_RECORD_SIZE || r->seq == 0 ||
+	    r->seq > LW_SEQ_MAX || r->stage == 0 || r->producer == 0 ||
+	    r->commit != LW_COMMIT)
+		return 0;
+	return r->crc == lw_crc32((const uint8_t *)r, LW_CRC_LEN);
+}
+
+static inline uint32_t
+lw_sanitize_seq(uint32_t seq)
+{
+	return seq == 0 || seq > LW_SEQ_MAX ? 0 : seq;
+}
+
+static inline void
+lw_encode(struct lw_record *r, uint32_t seq, const struct lw_event *event)
+{
+	uint32_t i, j;
+
+	for (i = 0; i < LW_RECORD_SIZE; i++)
+		((uint8_t *)r)[i] = 0;
+	r->magic = LW_MAGIC;
+	r->version = LW_VERSION;
+	r->bytes = LW_RECORD_SIZE;
+	r->seq = seq;
+	r->stage = event->stage;
+	r->producer = event->producer;
+	r->flags = event->flags;
+	for (i = 0; i < 4; i++)
+		r->detail[i] = event->detail[i];
+	if (event->note) {
+		/* Keep the final byte NUL.  Notes are static producer text or a
+		 * trusted kernel path, never an unchecked panic pointer. */
+		for (i = 0; i + 1 < LW_NOTE_SIZE && event->note[i]; i++)
+			r->note[i] = event->note[i];
+	}
+	/* Make padding deterministic even if a future compiler/store path
+	 * changes note handling. */
+	for (j = i; j < LW_NOTE_SIZE; j++)
+		r->note[j] = 0;
+	r->crc = lw_crc32((const uint8_t *)r, LW_CRC_LEN);
+	r->commit = 0;
+}
+
+/* Commit one event.  Error returns are negative and no success is logged by
+ * this layer.  A failed update can invalidate the selected older slot, but
+ * never the other slot (except the practically unreachable seq-exhaustion
+ * reset, which deliberately invalidates both). */
+static inline long
+lw_write(const struct lw_mem *mem, const struct lw_event *event)
+{
+	struct lw_record rec;
+	uint32_t seq[LW_SLOT_COUNT] = {0, 0};
+	uint32_t newest = 0, next, slot, zero = 0, commit = LW_COMMIT;
+	uint64_t pa;
+	long rc;
+
+	if (!mem || !mem->read || !mem->write || !mem->clean || !event)
+		return -1;
+	if (!event->stage || !event->producer)
+		return -2;
+	for (slot = 0; slot < LW_SLOT_COUNT; slot++) {
+		rc = mem->read(mem->ctx, LW_SLOT_PA(slot) +
+		    __builtin_offsetof(struct lw_record, seq), &seq[slot], 4);
+		if (rc < 0)
+			return -3;
+		seq[slot] = lw_sanitize_seq(seq[slot]);
+		if (seq[slot] > newest)
+			newest = seq[slot];
+	}
+	next = newest == LW_SEQ_MAX ? 1 : newest + 1;
+	slot = (next - 1) % LW_SLOT_COUNT;
+
+	/* Exhaustion is a deliberate generation reset, not a wrapped sequence. */
+	if (newest == LW_SEQ_MAX) {
+		uint32_t i;
+		for (i = 0; i < LW_SLOT_COUNT; i++) {
+			pa = LW_SLOT_PA(i) + __builtin_offsetof(struct lw_record, commit);
+			if (mem->write(mem->ctx, pa, &zero, 4) < 0)
+				return -4;
+			if (mem->clean(mem->ctx, pa, 4) < 0)
+				return -5;
+		}
+	}
+
+	pa = LW_SLOT_PA(slot) + __builtin_offsetof(struct lw_record, commit);
+	if (mem->write(mem->ctx, pa, &zero, 4) < 0)
+		return -6;
+	if (mem->clean(mem->ctx, pa, 4) < 0)
+		return -7;
+
+	lw_encode(&rec, next, event);
+	pa = LW_SLOT_PA(slot);
+	if (mem->write(mem->ctx, pa, &rec, LW_RECORD_SIZE) < 0)
+		return -8;
+	if (mem->clean(mem->ctx, pa, LW_RECORD_SIZE) < 0)
+		return -9;
+
+	pa += __builtin_offsetof(struct lw_record, commit);
+	if (mem->write(mem->ctx, pa, &commit, 4) < 0)
+		return -10;
+	if (mem->clean(mem->ctx, pa, 4) < 0)
+		return -11;
+	return (long)next;
+}
+
+/* Reference read-side primitive for host tests and small producers.  Returns
+ * 1 with the highest valid sequence, 0 when neither slot is valid, or a
+ * negative error only when neither slot could be read.  Invalid/CRC-bad
+ * records are never selected.  R2 owns the full RAM-dump scanner/decoder. */
+static inline long
+lw_read_latest(const struct lw_mem *mem, struct lw_record *out)
+{
+	struct lw_record candidate;
+	uint32_t slot;
+	int have = 0, read_errors = 0;
+
+	if (!mem || !mem->read || !out)
+		return -1;
+	for (slot = 0; slot < LW_SLOT_COUNT; slot++) {
+		if (mem->read(mem->ctx, LW_SLOT_PA(slot), &candidate,
+		    LW_RECORD_SIZE) < 0) {
+			read_errors++;
+			continue;
+		}
+		if (lw_valid(&candidate) && (!have || candidate.seq > out->seq)) {
+			*out = candidate;
+			have = 1;
+		}
+	}
+	if (have)
+		return 1;
+	return read_errors == LW_SLOT_COUNT ? -2 : 0;
+}
+
+#endif /* LAGUNA_LASTWORDS_H */
diff --git a/osfmk/arm64/laguna_panicdump.c b/osfmk/arm64/laguna_panicdump.c
new file mode 100644
index 0000000..1e336c6
--- /dev/null
+++ b/osfmk/arm64/laguna_panicdump.c
@@ -0,0 +1,2659 @@
+/*
+ * laguna_panicdump — panic-path capture into the ramoops console zone.
+ * See laguna_panicdump.h for the contract (device truth, format, boot args).
+ *
+ * Linux-side semantics this file must stay byte-compatible with
+ * (linux-next fs/pstore/ram_core.c, no ECC — the DT ramoops@95200000 node
+ * carries no ecc-size):
+ *   struct persistent_ram_buffer { u32 sig; u32 start; u32 size; u8 data[]; }
+ *   PERSISTENT_RAM_SIG = 0x43474244; both the console and the pmsg zone are
+ *   created with per-zone sig 0, so the stored sig is 0x43474244 for both.
+ *   buffer_size = zone_size - sizeof(buffer) = zone_size - 12.
+ *   Zap (old content discarded) happens on Linux's next init when the stored
+ *   sig mismatches or start/size violate start <= size <= buffer_size.
+ *   console-ramoops-0 / pmsg-ramoops-0 file content = data[start..start+size)
+ *   wrap-linearized, oldest first — appended bytes show up at the file tail.
+ *
+ * The append mirrors persistent_ram_write() ring arithmetic exactly; the
+ * pmsg mirror is a raw fixed-offset record the same way the kexec marker
+ * (pmsg+0x100) and the MARKER-SCRATCH/diag-ring pages (pmsg+0x1000..0x12000)
+ * are raw placements — none of those touch the zone header, and neither does
+ * the mirror. XNU-MSGBUF v2 keeps all XNU-owned evidence out of the hostile
+ * low region (<+0x6000, see the v2 addendum in docs/XNU-MSGBUF-v1.md);
+ * research/check-pmsg-contract.py guards all of the offsets.
+ */
+#include <arm64/laguna_panicdump.h>
+#include <arm64/laguna_lastwords.h>
+
+/* ---- G15 COREMIRROR pure seams (compiled in kernel AND host/stub builds
+ * so the host selftest exercises this exact code) ---- */
+
+/*
+ * Claim decision. cur_pid: 0 = stage unclaimed this boot. cur_extent: the
+ * current claimant's staged-byte count (clamped). Returns:
+ *   0  refuse this claimant
+ *   1  claim (the stage was unclaimed)
+ *   2  evict-and-reclaim: initproc (pid 1 — the boot-killer, the one core
+ *      that names the init-chain wall) evicts a lesser claimant that is
+ *      still IDLE (no bytes staged), so no staged data is ever torn.
+ * A same-pid re-claim is refused: that proc's first dump owns the stage.
+ */
+int
+laguna_core_claim_decision(uint32_t cur_pid, uint32_t cur_extent, int pid)
+{
+	if (pid <= 0) {
+		return 0;
+	}
+	if (cur_pid == 0) {
+		return 1;
+	}
+	if (cur_pid == (uint32_t)pid) {
+		return 0;
+	}
+	if (pid == 1 && cur_extent == 0) {
+		return 2;
+	}
+	return 0;
+}
+
+/* CRC-32/IEEE, table-free (same polynomial as laguna_pd_crc32 below; kept
+ * separate so the core record is self-contained for host-side readers).
+ * r2: incremental init/update/final so the panic path CRCs the in-RAM
+ * copies (packed header tail + staged payload) without reading back the
+ * uncached mirror. */
+uint32_t
+laguna_core_record_crc_init(void)
+{
+	return 0xffffffffu;
+}
+
+uint32_t
+laguna_core_record_crc_update(uint32_t c, const volatile uint8_t *p,
+    uint32_t n)
+{
+	uint32_t i;
+	int b;
+
+	for (i = 0; i < n; i++) {
+		c ^= p[i];
+		for (b = 0; b < 8; b++) {
+			c = (c >> 1) ^ (0xedb88320u & (0u - (c & 1u)));
+		}
+	}
+	return c;
+}
+
+uint32_t
+laguna_core_record_crc_final(uint32_t c)
+{
+	return ~c;
+}
+
+uint32_t
+laguna_core_record_crc(const volatile uint8_t *p, uint32_t n)
+{
+	return laguna_core_record_crc_final(
+	    laguna_core_record_crc_update(laguna_core_record_crc_init(),
+	    p, n));
+}
+
+/* Reader-side nonce check: a committed record is this boot's only when its
+ * +40 nonce equals the boot's committed XNUENT1 nonce (logdump header
+ * +0x48) and is nonzero. Everything else — a stale warm-reset boot,
+ * unbound, torn — reads as foreign. */
+int
+laguna_core_record_nonce_ok(uint64_t record_nonce, uint64_t boot_nonce)
+{
+	return record_nonce != 0 && record_nonce == boot_nonce;
+}
+
+/* Fixed 64-byte little-endian record header. out holds
+ * LAGUNA_CORE_HDR_SIZE bytes; the CRC slot (+20) is left zero — the
+ * panic-path writer computes it from the committed zone bytes. */
+void
+laguna_core_record_pack(uint8_t *out, uint32_t plen, uint32_t flags,
+    uint32_t pid, const uint8_t *comm, uint64_t nonce, uint64_t extent)
+{
+	static const char magic[16] = "XNU-CORE v1";
+	uint32_t i;
+
+	for (i = 0; i < 16; i++) {
+		out[i] = (uint8_t)magic[i];
+	}
+	/* Quick-scan tag 'CORE' little-endian; committed last on the device. */
+	out[16] = 0x43u; out[17] = 0x4fu; out[18] = 0x52u; out[19] = 0x45u;
+	out[20] = 0; out[21] = 0; out[22] = 0; out[23] = 0;
+	out[LAGUNA_CORE_LEN_OFF + 0] = (uint8_t)(plen);
+	out[LAGUNA_CORE_LEN_OFF + 1] = (uint8_t)(plen >> 8);
+	out[LAGUNA_CORE_LEN_OFF + 2] = (uint8_t)(plen >> 16);
+	out[LAGUNA_CORE_LEN_OFF + 3] = (uint8_t)(plen >> 24);
+	out[LAGUNA_CORE_FLAGS_OFF + 0] = (uint8_t)(flags);
+	out[LAGUNA_CORE_FLAGS_OFF + 1] = (uint8_t)(flags >> 8);
+	out[LAGUNA_CORE_FLAGS_OFF + 2] = (uint8_t)(flags >> 16);
+	out[LAGUNA_CORE_FLAGS_OFF + 3] = (uint8_t)(flags >> 24);
+	for (i = 0; i < 8; i++) {
+		out[LAGUNA_CORE_PID_OFF + i] = (uint8_t)((uint64_t)pid >> (8u * i));
+	}
+	for (i = 0; i < 8; i++) {
+		out[LAGUNA_CORE_NONCE_OFF + i] = (uint8_t)(nonce >> (8u * i));
+	}
+	{
+		uint32_t done = 0;
+
+		for (i = 0; i < LAGUNA_CORE_COMM_SIZE; i++) {
+			uint8_t c = 0;
+
+			if (comm != NULL && !done && comm[i] != 0) {
+				c = comm[i];
+			} else {
+				done = 1;   /* stop reading the source */
+			}
+			out[LAGUNA_CORE_COMM_OFF + i] = c;
+		}
+	}
+	for (i = 0; i < 8; i++) {
+		out[LAGUNA_CORE_EXTENT_OFF + i] =
+		    (uint8_t)(extent >> (8u * i));
+	}
+}
+
+/* Inverse of laguna_core_record_pack (host/decode-tool reader seam).
+ * Returns 0 on success, -1 on a null buffer. */
+int
+laguna_core_record_unpack(const volatile uint8_t *in, uint32_t *plen,
+    uint32_t *flags, uint32_t *pid, uint8_t *comm, uint64_t *nonce,
+    uint64_t *extent, uint32_t *crc)
+{
+	uint32_t i;
+
+	if (in == NULL) {
+		return -1;
+	}
+	if (plen) {
+		*plen = (uint32_t)in[LAGUNA_CORE_LEN_OFF] |
+		    ((uint32_t)in[LAGUNA_CORE_LEN_OFF + 1] << 8) |
+		    ((uint32_t)in[LAGUNA_CORE_LEN_OFF + 2] << 16) |
+		    ((uint32_t)in[LAGUNA_CORE_LEN_OFF + 3] << 24);
+	}
+	if (flags) {
+		*flags = (uint32_t)in[LAGUNA_CORE_FLAGS_OFF] |
+		    ((uint32_t)in[LAGUNA_CORE_FLAGS_OFF + 1] << 8) |
+		    ((uint32_t)in[LAGUNA_CORE_FLAGS_OFF + 2] << 16) |
+		    ((uint32_t)in[LAGUNA_CORE_FLAGS_OFF + 3] << 24);
+	}
+	if (pid) {
+		*pid = (uint32_t)in[LAGUNA_CORE_PID_OFF] |
+		    ((uint32_t)in[LAGUNA_CORE_PID_OFF + 1] << 8) |
+		    ((uint32_t)in[LAGUNA_CORE_PID_OFF + 2] << 16) |
+		    ((uint32_t)in[LAGUNA_CORE_PID_OFF + 3] << 24);
+	}
+	if (nonce) {
+		uint64_t v = 0;
+		for (i = 0; i < 8; i++) {
+			v |= (uint64_t)in[LAGUNA_CORE_NONCE_OFF + i] << (8u * i);
+		}
+		*nonce = v;
+	}
+	if (comm) {
+		for (i = 0; i < LAGUNA_CORE_COMM_SIZE; i++) {
+			comm[i] = in[LAGUNA_CORE_COMM_OFF + i];
+		}
+	}
+	if (extent) {
+		uint64_t v = 0;
+		for (i = 0; i < 8; i++) {
+			v |= (uint64_t)in[LAGUNA_CORE_EXTENT_OFF + i] << (8u * i);
+		}
+		*extent = v;
+	}
+	if (crc) {
+		*crc = (uint32_t)in[20] | ((uint32_t)in[21] << 8) |
+		    ((uint32_t)in[22] << 16) | ((uint32_t)in[23] << 24);
+	}
+	return 0;
+}
