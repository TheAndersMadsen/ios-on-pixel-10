+/* ---- CRC-32/IEEE, table-free (same polynomial as the diag ring) ---- */
+
+static uint32_t
+laguna_pd_crc32(const volatile uint8_t *p, uint32_t n)
+{
+	uint32_t c = 0xffffffffu;
+	uint32_t i;
+	int b;
+
+	for (i = 0; i < n; i++) {
+		c ^= p[i];
+		for (b = 0; b < 8; b++) {
+			c = (c >> 1) ^ (0xedb88320u & (0u - (c & 1u)));
+		}
+	}
+	return ~c;
+}
+
+static void laguna_panicdump_test_thread(void *arg, int wait_result);
+
+/* ---- raw zone access (Device memory: aligned volatile word ops) ---- */
+
+static inline uint32_t
+laguna_pd_rd32(uint64_t zone_off)
+{
+	return *(const volatile uint32_t *)(const void *)laguna_pd_cat(zone_off);
+}
+
+static inline void
+laguna_pd_wr32(uint64_t zone_off, uint32_t v)
+{
+	*(volatile uint32_t *)(void *)laguna_pd_at(zone_off) = v;
+}
+
+static inline void
+laguna_pd_wr64(uint64_t zone_off, uint64_t v)
+{
+	*(volatile uint64_t *)(void *)laguna_pd_at(zone_off) = v;
+}
+
+static inline uint64_t
+laguna_pd_rd64(uint64_t zone_off)
+{
+	return *(const volatile uint64_t *)(const void *)laguna_pd_cat(zone_off);
+}
+
+static inline uint64_t
+laguna_pd_cntvct(void)
+{
+	uint64_t now;
+	__asm__ volatile("mrs %0, cntvct_el0" : "=r"(now));
+	return now;
+}
+
+/* ---- R4 always-on XNU-MSGBUF v2 mirror ---- */
+
+static int
+laguna_pd_map(void)
+{
+	if (laguna_pd_va == NULL) {
+		/* One shared mapping for panic capture, LGLW and the log mirror.
+		 * The physmap does not cover this low bank, and a second early
+		 * ml_io_map would exhaust the bootstrap I/O page-table window. */
+		laguna_pd_va = (volatile uint8_t *)(uintptr_t)ml_io_map(
+		    (vm_offset_t)LAGUNA_RAMOOPS_BASE,
+		    (vm_size_t)LAGUNA_RAMOOPS_SIZE);
+	}
+	return laguna_pd_va != NULL;
+}
+
+static void
+laguna_logdump_append(char c, uint32_t bufx)
+{
+	const uint64_t hbase = LAGUNA_PMSG_OFF + LAGUNA_LOGDUMP_HDR_OFF;
+	const uint64_t rbase = LAGUNA_PMSG_OFF + LAGUNA_LOGDUMP_OFF;
+	uint64_t total, next;
+	uint32_t active, tail_len, tail_off;
+
+	if (!laguna_ld_enabled || laguna_pd_va == NULL) {
+		return;
+	}
+	active = laguna_ld_active_size;
+	if (active == 0 || active > LAGUNA_LOGDUMP_RING_SIZE) {
+		return;
+	}
+	total = laguna_ld_total;
+	*laguna_pd_at(rbase + (total % active)) = (uint8_t)c;
+	next = total + 1;
+	laguna_ld_total = next;
+
+	/* Data first, then the live stream metadata. tail_len never leads the
+	 * corresponding byte, so even a reset between these stores cannot make
+	 * the reader consume a not-yet-written byte as current log data. R2's
+	 * geometry is exact: bufx == total % live_size and the retained tail
+	 * starts at (total - tail_len) % live_size. */
+	if (laguna_ld_tail_len < active) {
+		laguna_ld_tail_len++;
+	}
+	tail_len = laguna_ld_tail_len;
+	tail_off = (uint32_t)((next - tail_len) % active);
+	laguna_pd_wr64(hbase + LAGUNA_LD_TOTAL_OFF, next);
+	laguna_pd_wr32(hbase + LAGUNA_LD_TAIL_LEN_OFF, tail_len);
+	laguna_pd_wr32(hbase + LAGUNA_LD_TAIL_OFF_OFF, tail_off);
+	laguna_pd_wr32(hbase + LAGUNA_LD_BUFX_OFF, bufx);
+	if (next > active && total <= active) {
+		laguna_ld_flags |= LAGUNA_LD_FLAG_WRAPPED;
+		laguna_pd_wr32(hbase + LAGUNA_LD_FLAGS_OFF, laguna_ld_flags);
+	}
+}
+
+void
+laguna_logdump_putc(char c, uint32_t bufx)
+{
+	laguna_logdump_append(c, bufx);
+}
+
+static int
+laguna_logdump_source_snapshot(uint32_t reason, uint64_t *mbva,
+    uint64_t *bcva, uint32_t *size, uint32_t *bufx)
+{
+	struct msgbuf *mb = msgbufp;
+	char *bufc;
+	int magic, ssize, sbufx, sbufr;
+
+	if (mb == NULL) {
+		return 0;
+	}
+	if ((reason & (LAGUNA_LOGDUMP_FLUSH_PANIC |
+	    LAGUNA_LOGDUMP_FLUSH_HALT)) &&
+	    !panic_validate_ptr(mb, (vm_size_t)sizeof(*mb), "msgbufp")) {
+		return 0;
+	}
+
+	/* Do not dereference msg_bufc here. The fixed mirror is authoritative;
+	 * these fields only let R2 cross-check the live source when a full RAM
+	 * dump is available. Panic/halt still validates that source span using
+	 * the exact 0124 nofault discipline before publishing its metadata. */
+	magic = mb->msg_magic;
+	ssize = mb->msg_size;
+	sbufx = mb->msg_bufx;
+	sbufr = mb->msg_bufr;
+	bufc = mb->msg_bufc;
+	if (magic != MSG_MAGIC || ssize <= 0 || ssize > MAX_MSG_BSIZE ||
+	    sbufx < 0 || sbufx > ssize || sbufr < 0 || sbufr > ssize) {
+		return 0;
+	}
+	if ((reason & (LAGUNA_LOGDUMP_FLUSH_PANIC |
+	    LAGUNA_LOGDUMP_FLUSH_HALT)) &&
+	    !ml_validate_nofault((vm_offset_t)bufc, (vm_size_t)ssize)) {
+		return 0;
+	}
+
+	*mbva = (uint64_t)(uintptr_t)mb;
+	*bcva = (uint64_t)(uintptr_t)bufc;
+	*size = (uint32_t)ssize;
+	*bufx = (uint32_t)sbufx;
+	return 1;
+}
+
+void
+laguna_logdump_flush(uint32_t reason)
+{
+	const uint64_t hbase = LAGUNA_PMSG_OFF + LAGUNA_LOGDUMP_HDR_OFF;
+	uint64_t mbva, bcva;
+	uint32_t size, bufx, flags, seq, diag;
+
+	if (!laguna_ld_enabled || laguna_pd_va == NULL) {
+		return;
+	}
+	/* A failed source inspection must not make the authoritative fixed ring
+	 * unreadable. Retain the last valid source metadata and mark the fault. */
+	mbva = laguna_pd_rd64(hbase + LAGUNA_LD_MSGBUFP_OFF);
+	bcva = laguna_pd_rd64(hbase + LAGUNA_LD_BUFC_OFF);
+	size = laguna_pd_rd32(hbase + LAGUNA_LD_SIZE_OFF);
+	bufx = laguna_pd_rd32(hbase + LAGUNA_LD_BUFX_OFF);
+	flags = laguna_ld_flags;
+	if (laguna_logdump_source_snapshot(reason, &mbva, &bcva,
+	    &size, &bufx)) {
+		flags &= ~LAGUNA_LD_FLAG_SOURCE_INVALID;
+	} else {
+		flags |= LAGUNA_LD_FLAG_SOURCE_INVALID;
+	}
+	flags |= reason & (LAGUNA_LOGDUMP_FLUSH_PANIC |
+	    LAGUNA_LOGDUMP_FLUSH_HALT);
+	laguna_ld_flags = flags;
+
+	laguna_pd_wr64(hbase + LAGUNA_LD_MSGBUFP_OFF, mbva);
+	laguna_pd_wr64(hbase + LAGUNA_LD_BUFC_OFF, bcva);
+	laguna_pd_wr32(hbase + LAGUNA_LD_SIZE_OFF, size);
+
+	/* total/tail/bufx belong exclusively to append/replay. A periodic flush
+	 * must never combine a pre-append source index with a post-append total. */
+	laguna_pd_wr32(hbase + LAGUNA_LD_FLAGS_OFF, flags);
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	/* V2 diag counter: one increment per completed flush event. A nonzero,
+	 * advancing counter proves the mirror machinery (periodic thread,
+	 * startup hook, panic/halt rungs) executed after init, independent of
+	 * the per-byte stream. Sanitized so zone garbage cannot truncate it. */
+	diag = laguna_pd_rd32(LAGUNA_PMSG_OFF + LAGUNA_DIAGCTR_OFF);
+	diag = (diag == 0 || diag >= LAGUNA_V2_CTR_MAX) ? 1u : diag + 1u;
+	laguna_pd_wr32(LAGUNA_PMSG_OFF + LAGUNA_DIAGCTR_OFF, diag);
+
+	seq = laguna_ld_seq + 1;
+	if (seq == 0 || seq > 0xfffffffdu) {
+		seq = 1;
+	}
+	laguna_ld_seq = seq;
+	laguna_pd_wr32(hbase + LAGUNA_LD_SEQ_OFF, seq);
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+laguna_logdump_replay(void)
+{
+	const uint64_t hbase = LAGUNA_PMSG_OFF + LAGUNA_LOGDUMP_HDR_OFF;
+	struct msgbuf *mb = msgbufp;
+
+	laguna_ld_total = 0;
+	laguna_ld_tail_len = 0;
+	laguna_ld_flags &= ~LAGUNA_LD_FLAG_WRAPPED;
+	if (mb == NULL || mb->msg_magic != MSG_MAGIC ||
+	    mb->msg_size <= 0 || mb->msg_size > MAX_MSG_BSIZE ||
+	    mb->msg_bufc == NULL) {
+		laguna_ld_active_size = 0;
+		laguna_pd_wr32(hbase + LAGUNA_LD_SIZE_OFF, 0);
+		laguna_pd_wr64(hbase + LAGUNA_LD_TOTAL_OFF, 0);
+		laguna_pd_wr32(hbase + LAGUNA_LD_TAIL_LEN_OFF, 0);
+		laguna_pd_wr32(hbase + LAGUNA_LD_TAIL_OFF_OFF, 0);
+		laguna_pd_wr32(hbase + LAGUNA_LD_BUFX_OFF, 0);
+		return;
+	}
+
+	{
+		uint32_t size = (uint32_t)mb->msg_size;
+		uint32_t bx = (uint32_t)mb->msg_bufx;
+		uint32_t br = (uint32_t)mb->msg_bufr;
+		uint32_t used, start;
+
+		laguna_ld_active_size = size;
+		if (bx > size || br > size) {
+			laguna_ld_active_size = 0;
+			laguna_pd_wr32(hbase + LAGUNA_LD_SIZE_OFF, 0);
+			laguna_pd_wr64(hbase + LAGUNA_LD_TOTAL_OFF, 0);
+			laguna_pd_wr32(hbase + LAGUNA_LD_TAIL_LEN_OFF, 0);
+			laguna_pd_wr32(hbase + LAGUNA_LD_TAIL_OFF_OFF, 0);
+			laguna_pd_wr32(hbase + LAGUNA_LD_BUFX_OFF, 0);
+			return;
+		}
+		used = bx >= br ? bx - br : size - br + bx;
+		if (used == 0) {
+			for (uint32_t i = 0; i < size; i++) {
+				if (mb->msg_bufc[i] != '\0') {
+					used = size;
+					break;
+				}
+			}
+		}
+		if (used > bx) {
+			used = size; /* wrapped/read-pointer ambiguity: replay full ring */
+		}
+
+		/* Seed stream geometry so the replay ends with total % size == bx.
+		 * A full ring has one absolute wrap plus bx; a partial ring retains
+		 * exactly used bytes beginning at (bx-used) == br. */
+		laguna_ld_total = used == size ? bx : bx - used;
+		laguna_pd_wr32(hbase + LAGUNA_LD_SIZE_OFF, size);
+		laguna_pd_wr64(hbase + LAGUNA_LD_TOTAL_OFF, laguna_ld_total);
+		laguna_pd_wr32(hbase + LAGUNA_LD_TAIL_LEN_OFF, 0);
+		laguna_pd_wr32(hbase + LAGUNA_LD_TAIL_OFF_OFF, 0);
+		laguna_pd_wr32(hbase + LAGUNA_LD_BUFX_OFF, bx);
+		laguna_pd_wr32(hbase + LAGUNA_LD_FLAGS_OFF, laguna_ld_flags);
+		start = (bx + size - used) % size;
+		for (uint32_t i = 0; i < used; i++) {
+			laguna_logdump_append(mb->msg_bufc[(start + i) % size], bx);
+		}
+	}
+}
+
+void
+laguna_logdump_early_init(void)
+{
+	static const char magic[LAGUNA_LOGDUMP_BASE_HEADER_SIZE] = "XNU-MSGBUF v2";
+	static const char entry_magic[8] = "XNUENT1";
+	const uint64_t hbase = LAGUNA_PMSG_OFF + LAGUNA_LOGDUMP_HDR_OFF;
+	uint32_t arg = 1;
+
+	if (laguna_ld_enabled || laguna_ld_disabled) {
+		return;
+	}
+	(void)PE_parse_boot_argn("lagunalogdump", &arg, (int)sizeof(arg));
+	if (!arg) {
+		laguna_ld_disabled = 1;
+		return;
+	}
+	if (!laguna_pd_map()) {
+		return; /* late_init may retry after the existing panic init */
+	}
+
+	/* Reset only the original stream header. The pre-MMU XNUENT1 extension
+	 * at +0x40 is this boot's entry key and must survive mirror init. */
+	for (uint32_t i = 0; i < LAGUNA_LOGDUMP_BASE_HEADER_SIZE; i++) {
+		*laguna_pd_at(hbase + i) = 0;
+	}
+	for (uint32_t i = 0; i < sizeof(magic); i++) {
+		*laguna_pd_at(hbase + i) = (uint8_t)magic[i];
+	}
+	{
+		int entry_present = 1;
+		for (uint32_t i = 0; i < sizeof(entry_magic); i++) {
+			if (*laguna_pd_cat(hbase + LAGUNA_LD_ENTRY_MAGIC_OFF + i) !=
+			    (uint8_t)entry_magic[i]) {
+				entry_present = 0;
+				break;
+			}
+		}
+		if (entry_present) {
+			laguna_pd_wr64(hbase + LAGUNA_LD_INIT_CNTVCT_OFF,
+			    laguna_pd_cntvct());
+			laguna_pd_wr32(hbase + LAGUNA_LD_ENTRY_FLAGS_OFF,
+			    laguna_pd_rd32(hbase + LAGUNA_LD_ENTRY_FLAGS_OFF) |
+			    LAGUNA_LD_ENTRY_F_INIT);
+			__asm__ volatile("dsb sy" ::: "memory");
+		}
+	}
+	laguna_ld_total = 0;
+	laguna_ld_tail_len = 0;
+	laguna_ld_seq = 0;
+	laguna_ld_flags = 0;
+
+	/* V2 boot counter: persists across boots (never cleared). Sanitized so
+	 * stale-zone garbage or an exhausted word restarts at 1. */
+	{
+		uint32_t boots = laguna_pd_rd32(LAGUNA_PMSG_OFF + LAGUNA_BOOTCTR_OFF);
+		boots = (boots == 0 || boots >= LAGUNA_V2_CTR_MAX) ? 1u : boots + 1u;
+		laguna_pd_wr32(LAGUNA_PMSG_OFF + LAGUNA_BOOTCTR_OFF, boots);
+	}
+
+	laguna_ld_enabled = 1;
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	/* start.s already cleared the compact trail and, when enabled, wrote
+	 * XNU_ENTRY. Recover its append position without erasing that evidence. */
+	laguna_ld_stage_compact_count = 0;
+	while (laguna_ld_stage_compact_count < LAGUNA_STAGE_COMPACT_WORDS &&
+	    laguna_pd_rd32(LAGUNA_PMSG_OFF + LAGUNA_STAGE_COMPACT_OFF +
+	    laguna_ld_stage_compact_count * 4u) != 0) {
+		laguna_ld_stage_compact_count++;
+	}
+
+	/* msgbuf is statically initialized before this point. Replay its current
+	 * stream in source-ring geometry before accepting new bytes directly. */
+	laguna_logdump_replay();
+	laguna_ld_flags |= LAGUNA_LD_FLAG_EARLY_REPLAY;
+	laguna_logdump_flush(0);
+}
+
+void
+laguna_logdump_late_init(void)
+{
+	if (!laguna_ld_enabled && !laguna_ld_disabled) {
+		laguna_logdump_early_init();
+	}
+	if (laguna_ld_disabled) {
+		kprintf("LAGUNA LOGDUMP: disabled by lagunalogdump=0\n");
+		return;
+	}
+	if (!laguna_ld_enabled) {
+		kprintf("LAGUNA LOGDUMP: ramoops map unavailable\n");
+		return;
+	}
+	kprintf("LAGUNA LOGDUMP: armed (XNU-MSGBUF v2 hdr @pmsg+0x%x, "
+	    "ring @pmsg+0x%x, %u KiB, bc/dr+0x%x/+0x%x)\n",
+	    (uint32_t)LAGUNA_LOGDUMP_HDR_OFF, (uint32_t)LAGUNA_LOGDUMP_OFF,
+	    LAGUNA_LOGDUMP_RING_SIZE / 1024, (uint32_t)LAGUNA_BOOTCTR_OFF,
+	    (uint32_t)LAGUNA_DIAGCTR_OFF);
+	laguna_logdump_flush(0);
+}
+
+__startup_func
+static void
+laguna_logdump_oslog_ready(void)
+{
+	/* oslog_init_msgbuf is RANK_SECOND. Its optional msgbuf=n resize has
+	 * completed. Rebase the active ring into the new source geometry instead
+	 * of appending with a new modulus over incompatible old positions. */
+	laguna_logdump_replay();
+	laguna_logdump_flush(0);
+}
+STARTUP(OSLOG, STARTUP_RANK_THIRD, laguna_logdump_oslog_ready);
+
+static void
+laguna_logdump_thread(void *arg __unused, int wait_result __unused)
+{
+	thread_set_thread_name(current_thread(), "laguna-logdump");
+	for (;;) {
+		delay_for_interval(1, NSEC_PER_SEC);
+		laguna_logdump_flush(0);
+	}
+}
+
+static void
+laguna_logdump_start(void)
+{
+	thread_t thrd = THREAD_NULL;
+
+	if (!laguna_ld_enabled || laguna_ld_thread_started) {
+		return;
+	}
+	laguna_ld_thread_started = 1;
+	if (kernel_thread_start_priority(laguna_logdump_thread, NULL, -1,
+	    &thrd) == KERN_SUCCESS) {
+		thread_deallocate(thrd);
+	} else {
+		laguna_ld_thread_started = 0;
+		kprintf("LAGUNA LOGDUMP: periodic thread start failed; direct mirror remains live\n");
+	}
+}
+
+/* ---- persistent_ram ring append (mirror of persistent_ram_write) ---- */
+static void
+laguna_pd_console_append(const char *s, uint32_t n)
+{
+	const uint64_t cbase = LAGUNA_CONSOLE_OFF;
+	const uint32_t bufsz = (uint32_t)(LAGUNA_CONSOLE_SIZE - LAGUNA_PRZ_HDR);
+	uint32_t start, size, c, pos, rem;
+
+	if (!laguna_pd_console_live || laguna_pd_va == NULL || n == 0) {
+		return;
+	}
+
+	/* Linux clamps to the buffer size and keeps the TAIL of the input. */
+	c = n;
+	if (c > bufsz) {
+		s += c - bufsz;
+		c = bufsz;
+	}
+
+	start = laguna_pd_rd32(cbase + 4u);
+	size = laguna_pd_rd32(cbase + 8u);
+	if (start > bufsz || size > bufsz) {
+		laguna_pd_console_live = 0;   /* Linux would zap anyway */
+		return;
+	}
+
+	/* data first: a fault here leaves the header in the old state. */
+	pos = start;
+	rem = bufsz - pos;
+	if (rem > c) {
+		rem = c;
+	}
+	for (uint32_t i = 0; i < rem; i++) {
+		*laguna_pd_at(cbase + LAGUNA_PRZ_HDR + pos + i) = (uint8_t)s[i];
+	}
+	if (rem < c) {
+		const uint32_t rest = c - rem;
+		for (uint32_t i = 0; i < rest; i++) {
+			*laguna_pd_at(cbase + LAGUNA_PRZ_HDR + i) = (uint8_t)s[rem + i];
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	/* header second: size grows first, then start wraps (the exact
+	 * persistent_ram_write update order; final state identical). */
+	if (size != bufsz) {
+		uint32_t new_size = size + c;
+		if (new_size > bufsz) {
+			new_size = bufsz;
+		}
+		laguna_pd_wr32(cbase + 8u, new_size);
+	}
+	uint32_t new_start = start + c;
+	while (new_start >= bufsz) {
+		new_start -= bufsz;
+	}
+	laguna_pd_wr32(cbase + 4u, new_start);
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+laguna_pd_console_str(const char *s)
+{
+	uint32_t n = 0;
+
+	if (s == NULL) {
+		return;
+	}
+	while (s[n] != '\0' && n < 128u) {
+		n++;
+	}
+	laguna_pd_console_append(s, n);
+}
+
+/* ---- GEN boot-marker helpers (no libc on this path; hand-rolled digits) ----
+ *
+ * The marker is the FIRST ring content after the boot-time reseed:
+ *   ----- XNU-CONSOLE-GEN boot=<ctr> nonce=<n> -----
+ * <ctr> is the persistent boot counter (pmsg+0x28040, already incremented by
+ * laguna_logdump_early_init, which runs earlier at arm_init.c:550) and <n> is
+ * the committed pre-MMU XNUENT1 nonce (logdump header +0x48; 16 zero hex
+ * digits when absent).  The reader cuts the recovered console window at the
+ * newest GEN marker whose nonce matches --expect-nonce, so ABL's unclamped
+ * size-over-start drift can never lead a captured window with prior-boot
+ * bytes.  Read-only on pmsg; touches nothing there. */
+
+static uint32_t
+laguna_pd_dec_u32(uint32_t v, char *out)
+{
+	char tmp[10];
+	uint32_t n = 0, k = 0;
+
+	do {
+		tmp[n++] = (char)('0' + (v % 10u));
+		v /= 10u;
+	} while (v != 0);
+	while (k < n) {
+		out[k] = tmp[n - 1u - k];
+		k++;
+	}
+	return n;
+}
+
+static uint32_t
+laguna_pd_hex_u64(uint64_t v, char *out)
+{
+	uint32_t k;
+
+	for (k = 0; k < 16u; k++) {
+		out[15u - k] = "0123456789abcdef"[v & 0xfu];
+		v >>= 4;
+	}
+	return 16u;
+}
+
+/* ---- pmsg mirror record (fixed offset, own CRC; newest wins) ---- */
+
+static void
+laguna_pd_mirror_write(const char *msg, const char *paniclog, uint32_t plen)
+{
+	static const char magic[16] = "XNU-PANIC v1";
+	const uint64_t rbase = LAGUNA_PMSG_OFF + LAGUNA_MIRROR_OFF;
+	uint32_t seq = 1;
+	uint32_t mlen = 0;
+	uint32_t pl = plen;
+	uint32_t crc;
+	uint32_t i;
+
+	if (laguna_pd_va == NULL) {
+		return;
+	}
+
+	/* Seq = previous valid record's seq + 1, sanitized on garbage. */
+	if (laguna_pd_rd32(rbase + LAGUNA_MMR_MAGIC2_OFF) == LAGUNA_MIRROR_MAGIC2) {
+		uint32_t prev = laguna_pd_rd32(rbase + LAGUNA_MMR_SEQ_OFF);
+		if (prev != 0xffffffffu && prev < 0xfffffffeu) {
+			seq = prev + 1u;
+		}
+	}
+
+	/* Assemble the payload directly in the zone, then CRC it from there.
+	 * Every store stays inside [rbase, rbase + LAGUNA_MIRROR_SIZE). */
+	if (msg != NULL) {
+		for (i = 0; msg[i] != '\0' && mlen < LAGUNA_MIRROR_PAYLOAD_MAX - 2u; i++) {
+			*laguna_pd_at(rbase + LAGUNA_MMR_DATA_OFF + mlen++) = (uint8_t)msg[i];
+		}
+	}
+	if (plen > 0 && paniclog != NULL && mlen < LAGUNA_MIRROR_PAYLOAD_MAX - 2u) {
+		*laguna_pd_at(rbase + LAGUNA_MMR_DATA_OFF + mlen++) = '\n';
+		if (pl > LAGUNA_MIRROR_PAYLOAD_MAX - mlen - 1u) {
+			pl = LAGUNA_MIRROR_PAYLOAD_MAX - mlen - 1u;
+		}
+		for (i = 0; i < pl; i++) {
+			*laguna_pd_at(rbase + LAGUNA_MMR_DATA_OFF + mlen++) = (uint8_t)paniclog[i];
+		}
+	}
+	/* Zero the stale tail of the payload window (previous records may have
+	 * been longer) so old bytes never read as data. */
+	for (i = mlen; i < LAGUNA_MIRROR_PAYLOAD_MAX; i++) {
+		*laguna_pd_at(rbase + LAGUNA_MMR_DATA_OFF + i) = 0;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	crc = laguna_pd_crc32(laguna_pd_cat(rbase + LAGUNA_MMR_DATA_OFF), mlen);
+
+	/* magic, then metadata — the quick-scan tag goes last for
+	 * crash-consistency (a torn write leaves the old record invalid or
+	 * the new one absent, never a half-valid new one). */
+	for (i = 0; i < sizeof(magic); i++) {
+		*laguna_pd_at(rbase + i) = (uint8_t)magic[i];
+	}
+	laguna_pd_wr32(rbase + LAGUNA_MMR_CRC_OFF, crc);
+	laguna_pd_wr32(rbase + LAGUNA_MMR_LEN_OFF, mlen);
+	laguna_pd_wr32(rbase + LAGUNA_MMR_SEQ_OFF, seq);
+	laguna_pd_wr32(rbase + LAGUNA_MMR_MAGIC2_OFF, LAGUNA_MIRROR_MAGIC2);
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+laguna_pd_pan2_write(const char *msg, const char *paniclog, uint32_t plen)
+{
+	static const char magic[16] = "XNU-PANIC v2";
+	const uint64_t rbase = LAGUNA_PMSG_OFF + LAGUNA_PAN2_OFF;
+	uint32_t seq = 1;
+	uint32_t mlen = 0;
+	uint32_t pl = plen;
+	uint32_t crc;
+	uint32_t i;
+
+	if (laguna_pd_va == NULL) {
+		return;
+	}
+
+	/* Bind only to the committed pre-MMU entry; invalid binding never
+	 * falls back to the legacy PAN1 window that overlaps TSHIMST2. */
+	const uint64_t hbase = LAGUNA_PMSG_OFF + LAGUNA_LOGDUMP_HDR_OFF;
+	uint64_t nonce, handoff, entry, capture;
+	if (laguna_pd_rd64(hbase + 0x40) != 0x0031544e45554e58ull ||
+	    (laguna_pd_rd32(hbase + 0x68) & 5u) != 5u) return;
+	nonce = laguna_pd_rd64(hbase + 0x48);
+	entry = laguna_pd_rd64(hbase + 0x50);
+	handoff = laguna_pd_rd64(hbase + 0x70);
+	__asm__ volatile("mrs %0, cntvct_el0" : "=r" (capture));
+	if (!nonce || !handoff || handoff > entry || entry > capture ||
+	    capture - handoff == 0 || capture - handoff >= (1ull << 63)) return;
+	laguna_pd_wr32(rbase + LAGUNA_MMR_MAGIC2_OFF, 0);
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	/* Assemble the payload directly in the zone, then CRC it from there.
+	 * Every store stays inside [rbase, rbase + LAGUNA_MIRROR_SIZE). */
+	if (msg != NULL) {
+		for (i = 0; msg[i] != '\0' && mlen < LAGUNA_MIRROR_PAYLOAD_MAX - 2u; i++) {
+			*laguna_pd_at(rbase + 64u + mlen++) = (uint8_t)msg[i];
+		}
+	}
+	if (plen > 0 && paniclog != NULL && mlen < LAGUNA_MIRROR_PAYLOAD_MAX - 2u) {
+		*laguna_pd_at(rbase + 64u + mlen++) = '\n';
+		if (pl > LAGUNA_MIRROR_PAYLOAD_MAX - mlen - 1u) {
+			pl = LAGUNA_MIRROR_PAYLOAD_MAX - mlen - 1u;
+		}
+		for (i = 0; i < pl; i++) {
+			*laguna_pd_at(rbase + 64u + mlen++) = (uint8_t)paniclog[i];
+		}
+	}
+	/* Zero the stale tail of the payload window (previous records may have
+	 * been longer) so old bytes never read as data. */
+	for (i = mlen; i < LAGUNA_MIRROR_PAYLOAD_MAX; i++) {
+		*laguna_pd_at(rbase + 64u + i) = 0;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	laguna_pd_wr32(rbase + LAGUNA_MMR_LEN_OFF, mlen);
+	laguna_pd_wr32(rbase + LAGUNA_MMR_SEQ_OFF, seq);
+	laguna_pd_wr64(rbase + 32, nonce);
+	laguna_pd_wr64(rbase + 40, handoff);
+	laguna_pd_wr64(rbase + 48, entry);
+	laguna_pd_wr64(rbase + 56, capture);
+	crc = laguna_pd_crc32(laguna_pd_cat(rbase + 24), 40u + mlen);
+
+	/* magic, then metadata — the quick-scan tag goes last for
+	 * crash-consistency (a torn write leaves the old record invalid or
+	 * the new one absent, never a half-valid new one). */
+	for (i = 0; i < sizeof(magic); i++) {
+		*laguna_pd_at(rbase + i) = (uint8_t)magic[i];
+	}
+	laguna_pd_wr32(rbase + LAGUNA_MMR_CRC_OFF, crc);
+	laguna_pd_wr32(rbase + LAGUNA_MMR_LEN_OFF, mlen);
+	laguna_pd_wr32(rbase + LAGUNA_MMR_SEQ_OFF, seq);
+	__asm__ volatile("dsb sy" ::: "memory");
+	laguna_pd_wr32(rbase + LAGUNA_MMR_MAGIC2_OFF, 0x50414e32u);
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/* ---- G15 COREMIRROR: corefile stage (kern_core.c tee, normal context) ----
+ *
+ * A static kernel buffer modeling corefile offsets [0,
+ * LAGUNA_CORE_PAYLOAD_MAX). Segment bytes land at their TRUE file offsets
+ * (segments always begin at round_page(header_size) >= header_size, so they
+ * never collide with the MH_CORE prefix staged last at offset 0), sparse
+ * holes stay zero exactly like the file's sparse holes, and the staged
+ * prefix is byte-identical to corefile[0, extent) — i.e. the mirrored
+ * payload is a directly parseable MH_CORE prefix for coresym with zero
+ * reader-side changes.
+ *
+ * The claim is serialized with os_atomic CAS (normal context); the
+ * panic-path mirror reader below never takes it — a panic quiesces every
+ * CPU, so the stage is frozen and lock-free reads are exact.
+ */
+
+/* Reserved for the MH_CORE prefix staged by observe_header. Segments begin
+ * at round_page(header_size); a header larger than this guard truncates
+ * (LAGUNA_CORE_F_HDR_TRUNC) instead of colliding with segment bytes. */
+#define LAGUNA_CORE_HDR_GUARD   0x8000u
+/* Copy chunk: one arm64 page per copyin attempt; a fault stops the walk. */
+#define LAGUNA_CORE_STAGE_CHUNK 0x4000u
+
+static uint8_t laguna_core_stage[LAGUNA_CORE_PAYLOAD_MAX];
+static void *volatile laguna_core_owner;   /* claimant proc identity */
+static volatile uint32_t laguna_core_pid;  /* 0 = nothing staged this boot */
+static volatile uint32_t laguna_core_flags;
+static volatile uint64_t laguna_core_extent; /* staged-prefix high-water */
+static uint8_t laguna_core_comm[LAGUNA_CORE_COMM_SIZE];
+
+/* Minimal Mach-O constants (mach-o/loader.h + mach/machine.h values, kept
+ * local so this file stays osfmk-only). */
+#define LAGUNA_MH_MAGIC_64          0xfeedfacfu
+#define LAGUNA_LC_SEGMENT_64        0x19u
+#define LAGUNA_LC_THREAD            0x04u
+#define LAGUNA_ARM_THREAD_STATE64   6u
+#define LAGUNA_ARM_EXCEPTION_STATE64 7u
+/* arm_thread_state64_t byte offsets: x0..x28, fp, lr, sp, pc, cpsr. */
+#define LAGUNA_ARM64_STATE_FP_OFF   232u
+#define LAGUNA_ARM64_STATE_SP_OFF   248u
+
+/* Chunked user->stage copy at stage offset soff. Fault stops the walk and
+ * sets LAGUNA_CORE_F_READFAULT; returns the byte count staged. */
+static uint64_t
+laguna_core_stage_copy(uint64_t soff, const void *uaddr, uint64_t len)
+{
+	const char *ua = (const char *)uaddr;
+	uint64_t off;
+
+	for (off = 0; off < len; off += LAGUNA_CORE_STAGE_CHUNK) {
+		uint64_t chunk = len - off;
+
+		if (chunk > LAGUNA_CORE_STAGE_CHUNK) {
+			chunk = LAGUNA_CORE_STAGE_CHUNK;
+		}
+		if (copyin((const user_addr_t)(uintptr_t)(ua + off),
+		    (void *)&laguna_core_stage[soff + off],
+		    (size_t)chunk) != 0) {
+			laguna_core_flags |= LAGUNA_CORE_F_READFAULT;
+			break;
+		}
+	}
+	return off;
+}
+
+int
+laguna_corestage_claim(void *proc, int pid, const char *comm)
+{
+	uint32_t cur, extent32, decision, i;
+
+	if (proc == NULL || comm == NULL || pid <= 0 ||
+	    !laguna_pd_enabled || laguna_pd_va == NULL) {
+		return 0;
+	}
+	cur = os_atomic_load(&laguna_core_pid, relaxed);
+	extent32 = laguna_core_extent > 0xffffffffull ? 0xffffffffu :
+	    (uint32_t)laguna_core_extent;
+	decision = laguna_core_claim_decision(cur, extent32, pid);
+	if (decision == 0) {
+		return 0;
+	}
+	if (decision == 2) {
+		/* initproc evicting an idle lesser claimant: CAS-guard the
+		 * takeover so a racing claim cannot tear the reset. */
+		if (!os_atomic_cmpxchgv(&laguna_core_pid, cur, (uint32_t)pid,
+		    &cur, relaxed)) {
+			return 0;
+		}
+	} else {
+		if (!os_atomic_cmpxchgv(&laguna_core_pid, 0u, (uint32_t)pid,
+		    &cur, relaxed)) {
+			return 0;   /* lost a racing claim */
+		}
+	}
+	/* Owner of a fresh (or freshly reset) stage. Observers key on the
+	 * owner identity, so bytes an evicted dumper races in past this point
+	 * are simply dropped; the extent high-water governs the payload. */
+	memset(laguna_core_stage, 0, sizeof(laguna_core_stage));
+	laguna_core_extent = 0;
+	laguna_core_flags = 0;
+	laguna_core_owner = proc;
+	for (i = 0; i < LAGUNA_CORE_COMM_SIZE; i++) {
+		laguna_core_comm[i] = comm[i] ? (uint8_t)comm[i] : 0;
+	}
+	return 1;
+}
+
+void
+laguna_corestage_observe_segment(void *proc, uint64_t foff, const void *uaddr,
+    uint64_t len)
+{
+	uint64_t got, end;
+
+	if (!laguna_pd_enabled || proc == NULL || uaddr == NULL || len == 0) {
+		return;
+	}
+	if (laguna_core_pid == 0 || laguna_core_owner != proc) {
+		return;
+	}
+
+	/* Offsets below the header guard belong to the MH_CORE prefix (staged
+	 * by observe_header); skip a segment's head below the guard. */
+	if (foff < LAGUNA_CORE_HDR_GUARD) {
+		uint64_t skip = LAGUNA_CORE_HDR_GUARD - foff;
+
+		if (skip >= len) {
+			return;
+		}
+		uaddr = (const char *)uaddr + skip;
+		len -= skip;
+		foff = LAGUNA_CORE_HDR_GUARD;
+	}
+	if (foff >= LAGUNA_CORE_PAYLOAD_MAX) {
+		return;
+	}
+	if (len > LAGUNA_CORE_PAYLOAD_MAX - foff) {
+		len = LAGUNA_CORE_PAYLOAD_MAX - foff;
+		laguna_core_flags |= LAGUNA_CORE_F_STAGE_TRUNC;
+	}
+
+	got = laguna_core_stage_copy(foff, uaddr, len);
+	end = foff + got;
+	if (end > laguna_core_extent) {
+		laguna_core_extent = end;
+	}
+}
+
+void
+laguna_corestage_observe_header(void *proc, const void *kbuf,
+    uint64_t hdr_size, uint64_t file_extent)
+{
+	const uint8_t *h;
+	uint64_t walk, got, end;
+	uint32_t ncmds, off, idx, have_walk;
+
+	if (!laguna_pd_enabled || proc == NULL || kbuf == NULL) {
+		return;
+	}
+	if (laguna_core_pid == 0 || laguna_core_owner != proc) {
+		return;
+	}
+
+	if (file_extent > LAGUNA_CORE_PAYLOAD_MAX) {
+		/* The real corefile continued past the mirror capacity. */
+		laguna_core_flags |= LAGUNA_CORE_F_STAGE_TRUNC;
+	}
+	if (hdr_size > LAGUNA_CORE_HDR_GUARD) {
+		hdr_size = LAGUNA_CORE_HDR_GUARD;
+		laguna_core_flags |= LAGUNA_CORE_F_HDR_TRUNC;
+	}
+	memcpy(&laguna_core_stage[0], kbuf, (size_t)hdr_size);
+	laguna_core_flags |= LAGUNA_CORE_F_HEADER;
+	if (hdr_size > laguna_core_extent) {
+		laguna_core_extent = hdr_size;
+	}
+
+	/*
+	 * Stack-target pass. The crashing thread's stack usually sits at the
+	 * TOP of the address space, far beyond the mirror capacity, so the
+	 * fp-walk window would be lost with the segments alone. The now
+	 * complete LC table names the stack segment's fileoff; when the
+	 * window around the thread's fp happens to fit the mirror capacity
+	 * (small maps), stage it at its true offsets too. Large maps skip
+	 * honestly: the payload stays a byte-identical prefix and the record
+	 * flags say the corefile was larger.
+	 */
+	h = &laguna_core_stage[0];
+	walk = 0;
+	have_walk = 0;
+	if (hdr_size >= 32u &&
+	    h[0] == 0xcfu && h[1] == 0xfau && h[2] == 0xedu && h[3] == 0xfeu) {
+		ncmds = (uint32_t)h[16] | ((uint32_t)h[17] << 8) |
+		    ((uint32_t)h[18] << 16) | ((uint32_t)h[19] << 24);
+		for (idx = 0, off = 32;
+		    idx < ncmds && off + 8u <= hdr_size;
+		    idx++, off += (uint32_t)h[off + 4] |
+		    ((uint32_t)h[off + 5] << 8) | ((uint32_t)h[off + 6] << 16) |
+		    ((uint32_t)h[off + 7] << 24)) {
+			uint32_t cmd = (uint32_t)h[off] |
+			    ((uint32_t)h[off + 1] << 8) |
+			    ((uint32_t)h[off + 2] << 16) |
+			    ((uint32_t)h[off + 3] << 24);
+			uint32_t cmdsize = (uint32_t)h[off + 4] |
+			    ((uint32_t)h[off + 5] << 8) |
+			    ((uint32_t)h[off + 6] << 16) |
+			    ((uint32_t)h[off + 7] << 24);
+			uint32_t p, pend;
+
+			if (cmdsize < 8u || off + cmdsize > hdr_size) {
+				break;
+			}
+			if (cmd != LAGUNA_LC_THREAD) {
+				continue;
+			}
+			pend = off + cmdsize;
+			for (p = off + 8u;
+			    p + 8u <= pend && p + 8u <= hdr_size; ) {
+				uint32_t flv = (uint32_t)h[p] |
+				    ((uint32_t)h[p + 1] << 8) |
+				    ((uint32_t)h[p + 2] << 16) |
+				    ((uint32_t)h[p + 3] << 24);
+				uint32_t cnt = (uint32_t)h[p + 4] |
+				    ((uint32_t)h[p + 5] << 8) |
+				    ((uint32_t)h[p + 6] << 16) |
+				    ((uint32_t)h[p + 7] << 24);
+				uint32_t stsz = cnt * 4u;
+				uint64_t fp, sp;
+
+				if (stsz > pend - (p + 8u) ||
+				    p + 8u + stsz > hdr_size) {
+					break;
+				}
+				if (flv == LAGUNA_ARM_THREAD_STATE64 &&
+				    cnt >= 34u) {
+					fp = 0;
+					sp = 0;
+					memcpy(&fp, &h[p + 8u +
+					    LAGUNA_ARM64_STATE_FP_OFF], 8);
+					memcpy(&sp, &h[p + 8u +
+					    LAGUNA_ARM64_STATE_SP_OFF], 8);
+					if (fp != 0 || sp != 0) {
+						walk = fp ? fp : sp;
+						have_walk = 1;
+					}
+				}
+				p += 8u + stsz;
+			}
+		}
+	}
+	if (!have_walk || walk == 0) {
+		return;
+	}
+	/* Find the LC_SEGMENT_64 containing the walk address; mirror the
+	 * 64 KiB around it only when the whole window fits the capacity. */
+	for (idx = 0, off = 32;
+	    idx < ncmds && off + 8u <= hdr_size;
+	    idx++, off += (uint32_t)h[off + 4] |
+	    ((uint32_t)h[off + 5] << 8) | ((uint32_t)h[off + 6] << 16) |
+	    ((uint32_t)h[off + 7] << 24)) {
+		uint32_t cmd = (uint32_t)h[off] |
+		    ((uint32_t)h[off + 1] << 8) |
+		    ((uint32_t)h[off + 2] << 16) |
+		    ((uint32_t)h[off + 3] << 24);
+		uint32_t cmdsize = (uint32_t)h[off + 4] |
+		    ((uint32_t)h[off + 5] << 8) |
+		    ((uint32_t)h[off + 6] << 16) |
+		    ((uint32_t)h[off + 7] << 24);
+		uint64_t vmaddr, vmsize, fileoff, filesize, into, wstart, wlen;
+		const char *suaddr;
+
+		if (cmdsize < 8u || off + cmdsize > hdr_size) {
+			break;
+		}
+		if (cmd != LAGUNA_LC_SEGMENT_64 || off + 72u > hdr_size) {
+			continue;
+		}
+		memcpy(&vmaddr, &h[off + 40], 8);
+		memcpy(&vmsize, &h[off + 48], 8);
+		memcpy(&fileoff, &h[off + 56], 8);
+		memcpy(&filesize, &h[off + 64], 8);
+		if (vmsize == 0 || filesize == 0 || walk < vmaddr ||
+		    walk - vmaddr >= vmsize) {
+			continue;
+		}
+		into = walk - vmaddr;
+		wstart = into > 0x8000ull ? into - 0x8000ull : 0;
+		wlen = 0x10000ull;
+		if (wstart + wlen > filesize) {
+			wlen = filesize - wstart;
+		}
+		if (fileoff + wstart >= LAGUNA_CORE_PAYLOAD_MAX) {
+			break;   /* stack window beyond the prefix capacity */
+		}
+		if (fileoff + wstart < LAGUNA_CORE_HDR_GUARD) {
+			break;   /* never touch the header prefix */
+		}
+		if (fileoff + wstart + wlen > LAGUNA_CORE_PAYLOAD_MAX) {
+			wlen = LAGUNA_CORE_PAYLOAD_MAX - (fileoff + wstart);
+			laguna_core_flags |= LAGUNA_CORE_F_STAGE_TRUNC;
+		}
+		suaddr = (const char *)(uintptr_t)(vmaddr + wstart);
+		got = laguna_core_stage_copy(fileoff + wstart, suaddr, wlen);
+		end = fileoff + wstart + got;
+		if (end > laguna_core_extent) {
+			laguna_core_extent = end;
+		}
+		break;
+	}
+}
+
+/* ---- Panic-path mirror writer (r2, OC15 ordering review) ----
+ *
+ * Placement: the very END of a completed panic capture (after the PANIC
+ * status record, PAN2/PAN1, and every console append) plus ONE gated
+ * reclaim in kdp_machine_reboot_type — the only other point the
+ * nested-panic bailout reaches (debug.c:765-769 -> :1169). An attempt
+ * counter is armed BEFORE any zone work, so a fault in this writer repeats
+ * at most once (the reclaim) and can never starve the existing channels on
+ * the <=5 nested-panic re-entries.
+ *
+ * Environment (OC15 §2): interrupts off, preemption off, one CPU, storage
+ * closed by loader_return, debugger lock held. Therefore: no locks, no
+ * allocation, no VFS; the stage is frozen (all CPUs quiesced) so lock-free
+ * reads are exact; payload goes out in 8-byte Device stores; the CRC is
+ * computed from the in-RAM copies (packed header tail + staged payload),
+ * never by reading the uncached mirror back; the copy is deadline-guarded
+ * from cntvct_el0 (<=250 ms per attempt, <=500 ms total) and stops with
+ * LAGUNA_CORE_F_MIRROR_TRUNC when the budget expires.
+ *
+ * Nonce binding: exactly PAN2's committed-XNUENT1 gate. The record is
+ * cleared at init and bound to this boot's nonce; a CRC-valid record from a
+ * previous warm-reset boot reads as foreign, never as this boot's.
+ */
+static volatile uint32_t laguna_pd_core_mirrored;   /* bytes in the zone */
+static volatile uint32_t laguna_pd_core_attempted;  /* attempts begun */
+static volatile uint32_t laguna_pd_core_done;       /* fully mirrored */
+static volatile uint32_t laguna_pd_core_inprog;     /* copy loop active */
+static volatile uint64_t laguna_pd_core_spent;      /* ticks spent */
+static volatile uint32_t laguna_pd_core_clen;       /* committed len */
+static volatile uint32_t laguna_pd_core_cflags;     /* committed flags */
+
+#define LAGUNA_CORE_MIRROR_BUDGET_MS 250u  /* per attempt */
+#define LAGUNA_CORE_MIRROR_TOTAL_MS  500u  /* across attempts */
+/* deadline re-read cadence in the copy loop */
+#define LAGUNA_CORE_TIME_CHECK_BYTES 0x8000u
+
+static void
+laguna_pd_core_commit(uint32_t plen, uint32_t flags, uint32_t pid,
+    uint64_t nonce)
+{
+	const uint64_t rbase = LAGUNA_PMSG_OFF + LAGUNA_CORE_OFF;
+	uint8_t hdr[LAGUNA_CORE_HDR_SIZE];
+	uint32_t crc_c, crc, i;
+
+	if (plen == laguna_pd_core_clen && flags == laguna_pd_core_cflags) {
+		return;   /* nothing changed since the last commit */
+	}
+	laguna_core_record_pack(hdr, plen, flags, pid, laguna_core_comm,
+	    nonce, laguna_core_extent);
+
+	/* CRC from the in-RAM copies: the exact bytes the zone is about to
+	 * receive (packed header tail + staged payload) — no uncached
+	 * readback. */
+	crc_c = laguna_core_record_crc_init();
+	crc_c = laguna_core_record_crc_update(crc_c,
+	    (const volatile uint8_t *)(const void *)&hdr[LAGUNA_CORE_LEN_OFF],
+	    40u);
+	if (plen > 0) {
+		crc_c = laguna_core_record_crc_update(crc_c,
+		    laguna_core_stage, plen);
+	}
+	crc = laguna_core_record_crc_final(crc_c);
+
+	/* PAN2 commit discipline: invalidate the quick-scan tag first, write
+	 * payload + fixed fields, then commit magic/crc/tag last so a torn
+	 * write reads as the old record, never a half-valid new one. */
+	laguna_pd_wr32(rbase + 16u, 0);
+	__asm__ volatile("dsb sy" ::: "memory");
+	for (i = LAGUNA_CORE_LEN_OFF; i < LAGUNA_CORE_HDR_SIZE; i++) {
+		*laguna_pd_at(rbase + i) = hdr[i];
+	}
+	for (i = 0; i < 16u; i++) {
+		*laguna_pd_at(rbase + i) = hdr[i];
+	}
+	laguna_pd_wr32(rbase + 20u, crc);
+	__asm__ volatile("dsb sy" ::: "memory");
+	laguna_pd_wr32(rbase + 16u, 0x45524f43u /* 'CORE' */);
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	laguna_pd_core_clen = plen;
+	laguna_pd_core_cflags = flags;
+}
+
+/* reclaim == 0: primary placement (capture end) — runs once.
+ * reclaim == 1: kdp_machine_reboot_type reclaim — may run a never-started
+ * attempt, commit a faulted-mid-copy record header-only, or extend a
+ * time-truncated copy, all within the 500 ms total budget. */
+static void
+laguna_pd_core_attempt(int reclaim)
+{
+	const uint64_t rbase = LAGUNA_PMSG_OFF + LAGUNA_CORE_OFF;
+	const uint64_t dbase = rbase + LAGUNA_CORE_HDR_SIZE;
+	const volatile uint8_t *dst;
+	uint64_t hbase, nonce, handoff, entry, capture, freq, start, now;
+	uint64_t budget_ticks, deadline;
+	uint32_t target, copied, flags, pid, chunk_bytes, i;
+	int copy_more;
+
+	if (laguna_pd_va == NULL || !laguna_pd_enabled) {
+		return;
+	}
+	if (laguna_pd_core_done || laguna_pd_core_attempted >= 2u) {
+		return;
+	}
+	if (laguna_pd_core_attempted != 0 && !reclaim) {
+		return;   /* the primary placement never repeats */
+	}
+	pid = laguna_core_pid;
+	if (pid == 0) {
+		return;   /* no staged core this boot: zone stays untouched */
+	}
+
+	/* Nonce-bind exactly like PAN2: an invalid binding never writes. */
+	hbase = LAGUNA_PMSG_OFF + LAGUNA_LOGDUMP_HDR_OFF;
+	if (laguna_pd_rd64(hbase + 0x40) != 0x0031544e45554e58ull ||
+	    (laguna_pd_rd32(hbase + 0x68) & 5u) != 5u) {
+		return;
+	}
+	nonce = laguna_pd_rd64(hbase + 0x48);
+	entry = laguna_pd_rd64(hbase + 0x50);
+	handoff = laguna_pd_rd64(hbase + 0x70);
+	__asm__ volatile("mrs %0, cntvct_el0" : "=r" (capture));
+	if (!nonce || !handoff || handoff > entry || entry > capture ||
+	    capture - handoff == 0 || capture - handoff >= (1ull << 63)) {
+		return;
+	}
+
+	/* Attempt marker BEFORE any zone work: a fault below burns exactly
+	 * one attempt slot and cannot starve the existing evidence. */
+	laguna_pd_core_attempted++;
+
+	flags = laguna_core_flags | LAGUNA_CORE_F_CLAIMED;
+	if (pid == 1) {
+		flags |= LAGUNA_CORE_F_INITPROC;
+	}
+
+	/* Budget: 250 ms this attempt, 500 ms total (cntfrq==0 -> the copy
+	 * stays capacity-bounded; that register is architecturally >=1 on
+	 * arm64 and provided by QEMU's generic timer). */
+	freq = 0;
+	__asm__ volatile("mrs %0, cntfrq_el0" : "=r" (freq));
+	start = capture;
+	if (freq == 0) {
+		/* No clock: keep the copy capacity-bounded. 2^62 ticks does
+		 * not wrap against any realistic boot-time cntvct. */
+		budget_ticks = (1ull << 62);
+	} else {
+		uint64_t left_ms = LAGUNA_CORE_MIRROR_TOTAL_MS;
+
+		if (laguna_pd_core_spent != 0) {
+			uint64_t spent_ms = laguna_pd_core_spent * 1000ull / freq;
+
+			left_ms = spent_ms >= LAGUNA_CORE_MIRROR_TOTAL_MS ?
+			    0 : LAGUNA_CORE_MIRROR_TOTAL_MS - spent_ms;
+		}
+		{
+			uint64_t cap_ms = left_ms < LAGUNA_CORE_MIRROR_BUDGET_MS ?
+			    left_ms : LAGUNA_CORE_MIRROR_BUDGET_MS;
+			budget_ticks = cap_ms * freq / 1000ull;
+		}
+	}
+	deadline = start + budget_ticks;
+
+	/* Decide how much this attempt may copy. */
+	copy_more = 1;
+	if (laguna_pd_core_attempted == 1) {
+		/* fresh attempt: mirror the whole staged prefix */
+		target = laguna_core_extent > LAGUNA_CORE_PAYLOAD_MAX ?
+		    LAGUNA_CORE_PAYLOAD_MAX : (uint32_t)laguna_core_extent;
+	} else if (laguna_pd_core_inprog) {
+		/* reclaim after a fault mid-copy: do NOT repeat the faulting
+		 * code — commit what already landed. */
+		copy_more = 0;
+		target = laguna_pd_core_mirrored;
+		flags |= LAGUNA_CORE_F_MIRROR_TRUNC;
+	} else {
+		/* reclaim of a clean but time-truncated attempt: extend */
+		target = laguna_core_extent > LAGUNA_CORE_PAYLOAD_MAX ?
+		    LAGUNA_CORE_PAYLOAD_MAX : (uint32_t)laguna_core_extent;
+		if (target <= laguna_pd_core_mirrored) {
+			copy_more = 0;   /* complete already */
+		}
+	}
+
+	/* Extend-only copy, 8-byte Device stores, deadline-guarded. */
+	copied = laguna_pd_core_mirrored;
+	if (copied > target) {
+		copied = target;
+	}
+	if (copy_more) {
+		laguna_pd_core_inprog = 1;
+		__asm__ volatile("dsb sy" ::: "memory");
+
+		i = copied;
+		/* head: byte stores until the zone destination is 8-aligned */
+		while (i < target && ((dbase + i) & 7u) != 0) {
+			*laguna_pd_at(dbase + i) = laguna_core_stage[i];
+			i++;
+		}
+		/* main: 8-byte stores from the in-RAM stage (cached reads),
+		 * deadline re-checked every LAGUNA_CORE_TIME_CHECK_BYTES */
+		chunk_bytes = 0;
+		while (i + 8u <= target) {
+			uint64_t v;
+
+			if (chunk_bytes >= LAGUNA_CORE_TIME_CHECK_BYTES) {
+				__asm__ volatile("mrs %0, cntvct_el0"
+				    : "=r" (now));
+				if (now >= deadline) {
+					break;
+				}
+				chunk_bytes = 0;
+			}
+			memcpy(&v, &laguna_core_stage[i], 8u);
+			dst = (const volatile uint8_t *)(const void *)
+			    (uintptr_t)(dbase + i);
+			*(volatile uint64_t *)(const void *)dst = v;
+			i += 8u;
+			chunk_bytes += 8u;
+		}
+		/* tail */
+		while (i < target) {
+			*laguna_pd_at(dbase + i) = laguna_core_stage[i];
+			i++;
+		}
+		copied = i;
+		laguna_pd_core_inprog = 0;
+	}
+	if (copied > laguna_pd_core_mirrored) {
+		laguna_pd_core_mirrored = copied;
+	}
+	if (copied < target) {
+		flags |= LAGUNA_CORE_F_MIRROR_TRUNC;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	/* spend accounting */
+	__asm__ volatile("mrs %0, cntvct_el0" : "=r" (now));
+	if (freq != 0 && now >= start) {
+		laguna_pd_core_spent = laguna_pd_core_spent + (now - start);
+	}
+
+	laguna_pd_core_commit(copied, flags, pid, nonce);
+	if (copied >= target && !(flags & LAGUNA_CORE_F_MIRROR_TRUNC)) {
+		laguna_pd_core_done = 1;
+	}
+}
+
+/* Primary placement: END of a completed panic capture. */
+static void
+laguna_pd_core_write(void)
+{
+	laguna_pd_core_attempt(0);
+}
+
+/* Gated reclaim (kdp_machine_reboot_type, after laguna_logdump_flush(HALT)):
+ * the nested-panic bailout's only other stop. */
+void
+laguna_panicdump_core_mirror_reclaim(void)
+{
+	laguna_pd_core_attempt(1);
+}
+
+/* ---- init ---- */
+
+void
+laguna_panicdump_init(void)
+{
+	uint32_t dump_arg = 1;   /* default ON */
+	uint32_t test_arg = 0;   /* default off */
+
+	(void)PE_parse_boot_argn("lagunapanicdump", &dump_arg,
+	    (int)sizeof(dump_arg));
+	if (!dump_arg) {
+		kprintf("LAGUNA PANICDUMP: disabled by lagunapanicdump=0\n");
+		return;
+	}
+
+	/* The physmap does not cover the low bank (device: declared-clean
+	 * RAM is 0x8_80000000+; QEMU contract: 0x80000000+256 MiB ends at
+	 * 0x90000000). Reuse the one early Device mapping if R4 already made it. */
+	if (!laguna_pd_map()) {
+		kprintf("LAGUNA PANICDUMP: ml_io_map of ramoops failed — capture unavailable\n");
+		return;
+	}
+
+	/* G17 console-wrap fix: UNCONDITIONAL reseed to a fresh empty window,
+	 * then commit the in-band GEN boot marker as the first ring content.
+	 *
+	 * Why: the console zone accumulates across warm-reset boots.  ABL/DBL
+	 * (proprietary) appends its own ~37 KiB boot log per cycle at data[start]
+	 * and advances `start` by n but `size` by ~2n WITHOUT clamping to the
+	 * buffer size, so `size` creeps ~39 KiB past `start` every cycle and
+	 * crossed capacity (0x1ffff4) at v15 (observed start=0x13fc90
+	 * size=0x202939).  Since then both the reader and this validation treated
+	 * the zone as invalid ("pmsg mirror only") and the XNU console record was
+	 * off.  (Our own laguna_pd_console_append uses correct capped Linux
+	 * arithmetic and is exonerated.)
+	 *
+	 * Reseeding start/size to 0 every boot bounds each cycle to this boot's
+	 * own append volume (kernel record ~33 KiB + ABL ~76 KiB, well under one
+	 * buffer), which also keeps the ring clear of the embedded panic region
+	 * (PRAM/KNUF 0x95300000, inside the ring's upper half) for the whole
+	 * campaign.  Intermediate states are crash-safe: every store leaves a
+	 * valid header or one Linux would zap anyway.
+	 *
+	 * Tradeoff (accepted): cross-boot console accumulation is gone — earlier
+	 * boots' text no longer leads the stream. Prior-boot evidence is already
+	 * captured per boot (the full window is dumped from the fastboot park
+	 * before the next warm reset), ABL's text is captured independently as
+	 * abl.log/abl_last.log, and the always-on channels (XNU-MSGBUF v2 mirror,
+	 * PAN1/PAN2, TSHIMST2 stamps) keep their own history.
+	 *
+	 * Risk surface: touches ONLY console bytes 0..11 plus the GEN line via
+	 * the existing append path. No pmsg offset is written (LGLW, compact
+	 * trail/counters, TSHIMST2, logdump header are only read for the marker).
+	 * Runs after the shared laguna_pd_map() and only when
+	 * lagunapanicdump != 0. Idempotent: reseeding an already-fresh header is
+	 * a no-op modulo the diagnostic print. The blazer twin
+	 * (hakios.blazer_panicdump.c, blazer_panicdump=1, default off, separate
+	 * build config) is deliberately left unchanged in this patch; mirror this
+	 * edit there before ever arming both in one image. */
+	{
+		uint32_t sig = laguna_pd_rd32(LAGUNA_CONSOLE_OFF);
+		uint32_t start = laguna_pd_rd32(LAGUNA_CONSOLE_OFF + 4u);
+		uint32_t size = laguna_pd_rd32(LAGUNA_CONSOLE_OFF + 8u);
+		uint32_t bufsz = (uint32_t)(LAGUNA_CONSOLE_SIZE - LAGUNA_PRZ_HDR);
+		uint32_t boots = laguna_pd_rd32(LAGUNA_PMSG_OFF + LAGUNA_BOOTCTR_OFF);
+		uint64_t nonce = laguna_pd_rd64(LAGUNA_PMSG_OFF +
+		    LAGUNA_LOGDUMP_HDR_OFF + LAGUNA_LD_ENTRY_NONCE_OFF);
+		static const char gen_hdr[] = "----- XNU-CONSOLE-GEN boot=";
+		static const char gen_mid[] = " nonce=0x";
+		static const char gen_end[] = " -----\n";
+		char gen[96];
+		uint32_t gn = 0, i;
+
+		laguna_pd_console_live = 0;
+
+		/* Forensics: record the pre-clear state (including the ABL-overflow
+		 * signature-intact form) before reseeding. Informational only — the
+		 * reseed is unconditional and the console channel stays live. */
+		kprintf("LAGUNA PANICDUMP: console zone reseeded for a fresh window (was sig=%08x start=%u size=%u of %u)\n",
+		    sig, start, size, bufsz);
+
+		/* start=0, size=0, then the signature as the commit word. */
+		laguna_pd_wr32(LAGUNA_CONSOLE_OFF + 4u, 0);
+		laguna_pd_wr32(LAGUNA_CONSOLE_OFF + 8u, 0);
+		laguna_pd_wr32(LAGUNA_CONSOLE_OFF, LAGUNA_PRZ_SIG);
+		__asm__ volatile("dsb sy" ::: "memory");
+		laguna_pd_console_live = 1;
+
+		/* GEN line as the first ring content; bounds this boot's window to
+		 * its own bytes and lets the reader cut at the expected nonce. */
+		for (i = 0; i < sizeof(gen_hdr) - 1u; i++) {
+			gen[gn++] = gen_hdr[i];
+		}
+		gn += laguna_pd_dec_u32(boots, gen + gn);
+		for (i = 0; i < sizeof(gen_mid) - 1u; i++) {
+			gen[gn++] = gen_mid[i];
+		}
+		gn += laguna_pd_hex_u64(nonce, gen + gn);
+		for (i = 0; i < sizeof(gen_end) - 1u; i++) {
+			gen[gn++] = gen_end[i];
+		}
+		laguna_pd_console_append(gen, gn);
+	}
+
+	laguna_pd_pan2 = (dump_arg == 2);
+	if (laguna_pd_pan2) {
+		/* Only opt-in boots invalidate the new record, never PAN1/stamps. */
+		laguna_pd_wr32(LAGUNA_PMSG_OFF + LAGUNA_PAN2_OFF + 16u, 0);
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	/* G15 COREMIRROR r2: invalidate any previous boot's CORE record so a
+	 * CRC-valid warm-reset stale record can never read as this boot's
+	 * (the panic-path writer additionally nonce-binds to the committed
+	 * XNUENT1 entry; both gates together are the reader's defense). */
+	laguna_pd_wr32(LAGUNA_PMSG_OFF + LAGUNA_CORE_OFF + 16u, 0);
+	__asm__ volatile("dsb sy" ::: "memory");
+	laguna_pd_enabled = 1;
+	{
+		long lwrc = laguna_panicdump_stage(LW_STAGE_XNU_INIT,
+		    LW_PRODUCER_XNU_KERNEL, 0, LAGUNA_RAMOOPS_BASE,
+		    LAGUNA_RAMOOPS_SIZE, 0, 0, "laguna_panicdump_init armed");
+		if (lwrc < 0) {
+			kprintf("LAGUNA LASTWORDS: XNU_INIT write failed rc=%ld\n", lwrc);
+		}
+	}
+	kprintf("LAGUNA PANICDUMP: armed (console=%s mirror@pmsg+0x%x)\n",
+	    laguna_pd_console_live ? "live" : "off",
+	    (uint32_t)(laguna_pd_pan2 ? LAGUNA_PAN2_OFF : LAGUNA_MIRROR_OFF));
+
+	(void)PE_parse_boot_argn("lagunapanictest", &test_arg,
+	    (int)sizeof(test_arg));
+	laguna_pd_test_secs = test_arg;
+	if (test_arg > 0) {
+		kprintf("LAGUNA PANICTEST: %u s (armed at bsdinit_task, before load_init_program)\n",
+		    test_arg);
+	}
+}
+
+/*
+ * Called from the first laguna IOKit driver start (AppleKeyStore::start,
+ * iokit/Kernel/arm/LagunaKeyStore.cpp): the earliest fully-threaded hook on
+ * every delivery path. Spawns the lagunapanictest panic needle; idempotent
+ * (first caller wins).
+ */
+void
+laguna_panicdump_bootdone(void)
+{
+	thread_t thrd = THREAD_NULL;
+	uint32_t secs = laguna_pd_test_secs;
+
+	/* The periodic source-metadata thread is independent of the panic test
+	 * and of lagunapanicdump; direct per-byte mirroring is already live. */
+	laguna_logdump_start();
+	if (!laguna_pd_enabled || secs == 0) {
+		return;
+	}
+	laguna_pd_test_secs = 0;
+	if (kernel_thread_start_priority(laguna_panicdump_test_thread,
+	    (void *)(uintptr_t)secs, -1, &thrd) == KERN_SUCCESS) {
+		thread_deallocate(thrd);
+		kprintf("LAGUNA PANICTEST: armed, panicking in %u s\n", secs);
+	} else {
+		kprintf("LAGUNA PANICTEST: kernel_thread_start_priority failed — no forced panic\n");
+	}
+}
+
+/* ---- panic capture (called from SavePanicInfo, panic context) ---- */
+
+void
+laguna_panicdump_capture(const char *msg, const char *paniclog,
+    vm_size_t paniclog_len)
+{
+	uint32_t plen;
+
+	/* R4: BOTH rungs refresh the independent msgbuf mirror before the 0123
+	 * enable check and before the capture-size dedup. This also covers the
+	 * lagunapanicdump=0 + lagunalogdump=1 configuration. */
+	laguna_logdump_flush(LAGUNA_LOGDUMP_FLUSH_PANIC);
+	if (!laguna_pd_enabled) {
+		return;
+	}
+	plen = (uint32_t)paniclog_len;
+	if (paniclog == NULL) {
+		plen = 0;
+	} else if (plen > LAGUNA_CAP_PANICLOG_MAX) {
+		plen = LAGUNA_CAP_PANICLOG_MAX;
+	}
+
+	/*
+	 * Capture ladder: rung 1 (debugger_collect_diagnostics) fires with
+	 * just the panic string, rung 2 (SavePanicInfo, after
+	 * print_all_backtraces) fires with the full paniclog. A later rung
+	 * re-captures only when it has MORE text — the panic output can only
+	 * grow between the two sites, so this is exactly "replace the stub
+	 * with the full record". If the fuller rung aborts before its
+	 * capture, the earlier rung's record stands.
+	 */
+	if (laguna_pd_captured && plen <= laguna_pd_captured_len) {
+		return;
+	}
+	/* Commit PANIC before source validation, msgbuf staging, or either long
+	 * text writer.  A nested abort therefore still leaves the exact stage;
+	 * PAN1/console remain the authoritative panic-text channels. */
+	(void)laguna_panicdump_stage(LW_STAGE_PANIC, LW_PRODUCER_XNU_PANIC,
+	    LW_FLAG_FAILURE, plen, 0, 0, 0, "panic capture rung");
+	laguna_pd_captured = 1;
+	laguna_pd_captured_len = plen;
+
+	/*
+	 * 0124: validate the copy SOURCES before any consumer runs. The msg
+	 * pointer and the paniclog span are kernel-managed (and the paniclog
+	 * was written through before we got here), but the capture must never
+	 * be the first dereference of a bad translation: a fault here tears
+	 * the record mid-write. panic_validate_ptr/ml_validate_nofault are the
+	 * sanctioned panic-path guards (panic_validate_ptr uses exactly this).
+	 */
+	if (msg != NULL &&
+	    !ml_validate_nofault((vm_offset_t)msg, 1)) {
+		msg = NULL;
+	}
+	if (paniclog != NULL &&
+	    !ml_validate_nofault((vm_offset_t)paniclog, plen)) {
+		plen = 0;   /* record continues; mirror/console get message only */
+	}
+
+	/* pmsg mirror first: the guaranteed-survival channel (console zone
+	 * content is subject to ABL's own pstore erase policy). */
+	if (laguna_pd_pan2)
+		laguna_pd_pan2_write(msg, paniclog, plen);
+	else
+		laguna_pd_mirror_write(msg, paniclog, plen);
+
+	/* console stream: native persistent_ram append — shows up in
+	 * console-ramoops-0 right after ABL's log. */
+	laguna_pd_console_str("\n\n----- XNU-PANIC-BEGIN (laguna141 xnu-8796.141.3) -----\n");
+	laguna_pd_console_str("panic message: ");
+	laguna_pd_console_str(msg != NULL ? msg : "(null)");
+	laguna_pd_console_str("\n");
+	if (plen > 0) {
+		laguna_pd_console_append(paniclog, plen);
+		laguna_pd_console_str("\n");
+	}
+
+	/*
+	 * kernel msgbuf tail (the pre-panic console log): the newest bytes of
+	 * the BSD ring. 0124 hardening — every pointer is
+	 * panic_validate_ptr'd BEFORE dereference and the ring itself is
+	 * staged with ml_nofault_copy (stops cleanly at an unmapped page,
+	 * returns the byte count), so a bad/relocated msg_bufc can no longer
+	 * abort the capture mid-record (the QEMU evidence showed exactly that
+	 * nested abort, frames attributed to this function). A short copy is
+	 * appended with an explicit note; the record always reaches END.
+	 */
+	{
+		if (msgbufp != NULL &&
+		    panic_validate_ptr(msgbufp,
+		    (vm_size_t)sizeof(struct msgbuf), "msgbufp") &&
+		    msgbufp->msg_magic == 0x063061 &&
+		    msgbufp->msg_size > 0 && msgbufp->msg_size <= (int)0x100000 &&
+		    panic_validate_ptr(msgbufp->msg_bufc,
+		    (vm_size_t)msgbufp->msg_size, "msgbuf ring")) {
+			uint32_t bufsz = (uint32_t)msgbufp->msg_size;
+			uint32_t bufx = (uint32_t)msgbufp->msg_bufx;
+			uint32_t n = LAGUNA_CAP_MSGBUF_MAX;
+
+			if (bufx > bufsz) {
+				bufx = bufsz;   /* torn index: clamp, don't fault */
+			}
+			if (n > bufsz) {
+				n = bufsz;
+			}
+			{
+				char hdr[96];
+				uint32_t hn = 0;
+				static const char tag[] =
+				    "\n----- msgbuf tail (last ";
+				static const char tail[] = " bytes) -----\n";
+				char num[12];
+				int v = (int)n, k = 0;
+
+				while (tag[hn] != '\0') {
+					hdr[hn] = tag[hn];
+					hn++;
+				}
+				while (v > 0) {
+					num[k++] = (char)('0' + (v % 10));
+					v /= 10;
+				}
+				while (k > 0) {
+					hdr[hn++] = num[--k];
+				}
+				for (uint32_t j = 0; tail[j] != '\0'; j++) {
+					hdr[hn++] = tail[j];
+				}
+				laguna_pd_console_append(hdr, hn);
+			}
+
+			/* 0124: stage the ring tail with ml_nofault_copy —
+			 * the copy stops at an unmapped page and returns how
+			 * far it got; nothing here can take an abort. The two
+			 * spans (tail-of-ring then wrap-to-front) are staged
+			 * in capture order so the append stays ring-aware. */
+			uint32_t from = (bufx + bufsz - n) % bufsz;
+			uint32_t lead = bufsz - from;
+			vm_size_t got = 0;
+
+			if (lead > n) {
+				lead = n;
+			}
+			got = ml_nofault_copy(
+			    (vm_offset_t)(msgbufp->msg_bufc + from),
+			    (vm_offset_t)laguna_pd_mb_stage, lead);
+			if (got < lead) {
+				lead = (uint32_t)got;
+				n = lead;   /* first span already short: stop */
+			} else if (lead < n) {
+				vm_size_t got2 = ml_nofault_copy(
+				    (vm_offset_t)msgbufp->msg_bufc,
+				    (vm_offset_t)(laguna_pd_mb_stage + lead),
+				    n - lead);
+				n = lead + (uint32_t)got2;
+			}
+			if (n > 0) {
+				laguna_pd_console_append(
+				    (const char *)laguna_pd_mb_stage, n);
+			}
+			if (n < LAGUNA_CAP_MSGBUF_MAX && n != bufsz) {
+				/* staged less than requested: say so, in-band,
+				 * instead of leaving the tail silently short */
+				static const char shortmsg[] =
+				    "\n----- msgbuf staged short (source "
+				    "validated out; record continues) -----\n";
+				laguna_pd_console_str(shortmsg);
+			}
+		} else {
+			laguna_pd_console_str(
+			    "----- msgbuf unavailable (validated out) -----\n");
+		}
+	}
+
+	laguna_pd_console_str("----- XNU-PANIC-END -----\n");
+
+	/* G15 COREMIRROR r2 (OC15 ordering review): mirror the staged corefile
+	 * prefix at the very END of a completed capture — after the PANIC
+	 * status record, PAN2/PAN1, and every console append — so a fault in
+	 * this writer can never starve existing evidence on the nested-panic
+	 * re-entries. The attempt counter inside arms before any zone work:
+	 * this runs once per boot; the kdp_machine_reboot_type reclaim is the
+	 * only bounded second chance. */
+	laguna_pd_core_write();
+}
+
+/* ---- test needle ---- */
+
+static void
+laguna_panicdump_test_thread(void *arg, int wait_result __unused)
+{
+	uint32_t secs = (uint32_t)(uintptr_t)arg;
+
+	thread_set_thread_name(current_thread(), "laguna-panicdump-test");
+	kprintf("LAGUNA PANICTEST: panicking in %u s\n", secs);
+	delay_for_interval(secs, NSEC_PER_SEC);
+	panic("lagunapanictest: forced panic for panic-capture validation");
+	/* not reached */
+}
+
+/* ---- G29 AUTOCYCLE: self-terminating boots for the unattended loop ----
+ *
+ * Problem: a boot that never panics (dark userspace, no console access)
+ * never re-enters the armed fastboot park, so the boot loop stalls until a
+ * human long-presses. blazer_autocycle=<seconds> (default 0 = off, zero
+ * behavioral change) arms a one-shot delayed thread_call at the pid-1 exec
+ * point. On expiry the handler commits every evidence channel FIRST, then
+ * enters the very reset tail the panic path ends in: halt_all_cpus(TRUE)
+ * (the same callable the reboot(2) path uses, machine.c host_reboot) runs
+ * the mirror flush, PEHaltRestart, adreno stop and loader_return, and --
+ * with blazer_psci_reset=1 -- falls through to
+ * psci_smp_diagnostic_reset()'s PSCI SYSTEM_RESET, the proven fastboot
+ * park. A boot that panics before expiry never fires the timer: the panic
+ * reset is the same call, the timer state dies with the warm reset, and
+ * the next boot re-arms from zero.
+ *
+ * Handler context: thread_call_setup defaults to THREAD_CALL_PRIORITY_HIGH
+ * (thread_call.c:999: such calls run in handler threads, i.e. process
+ * context with interrupts enabled -- NOT interrupt context), so kprintf
+ * and the lock-free, allocation-free Device-memory writers below are safe.
+ * The handler allocates nothing, takes no lock of its own, and is
+ * one-shot: arm() transitions the state 0->1, fire 1->2, both via
+ * os_atomic_cmpxchg. If the firmware reset returns or blazer_psci_reset
+ * was never enabled, the handler spins in WFI after the tail (halt_all_cpus
+ * itself never returns): the boot is terminated either way and can never
+ * re-enter dark userspace. */
+
+static TUNABLE(uint32_t, laguna_autocycle_secs, "blazer_autocycle", 0);
+static uint32_t laguna_autocycle_state; /* 0=disarmed 1=pending 2=fired */
+static thread_call_data_t laguna_autocycle_call;
+
+/* Console-zone twin of the boot GEN marker (same fields, same readers):
+ * "----- AUTOCYCLE-RESET boot=<ctr> nonce=0x<n> -----" appended to the
+ * persistent_ram console ring, so the harvest attributes this no-panic
+ * window by boot counter and entry nonce exactly like a panic window. */
+static void
+laguna_pd_autocycle_marker(uint32_t boots, uint64_t nonce)
+{
+	static const char m_hdr[] = "----- AUTOCYCLE-RESET boot=";
+	static const char m_mid[] = " nonce=0x";
+	static const char m_end[] = " -----\n";
+	char buf[96];
+	uint32_t bn = 0, i;
+
+	if (laguna_pd_va == NULL || !laguna_pd_console_live) {
+		return;
+	}
+	for (i = 0; i < sizeof(m_hdr) - 1u; i++) {
+		buf[bn++] = m_hdr[i];
+	}
+	bn += laguna_pd_dec_u32(boots, buf + bn);
+	for (i = 0; i < sizeof(m_mid) - 1u; i++) {
+		buf[bn++] = m_mid[i];
+	}
+	bn += laguna_pd_hex_u64(nonce, buf + bn);
+	for (i = 0; i < sizeof(m_end) - 1u; i++) {
+		buf[bn++] = m_end[i];
+	}
+	laguna_pd_console_append(buf, bn);
+}
+
+static void
+laguna_autocycle_fire(thread_call_param_t param0 __unused,
+    thread_call_param_t param1 __unused)
+{
+	uint32_t boots = 0;
+	uint64_t nonce = 0;
+
+	/* one-shot invariant: arm() did 0->1; fire takes 1->2. A second
+	 * entry (never produced by a single pending call) does nothing. */
+	if (!os_atomic_cmpxchg(&laguna_autocycle_state, 1, 2, acq_rel)) {
+		return;
+	}
+
+	/* The same two fields the GEN marker printed at boot: they bind the
+	 * window to this boot. Guarded: the zone mapping exists only when
+	 * the panicdump mapping succeeded. */
+	if (laguna_pd_va != NULL) {
+		boots = laguna_pd_rd32(LAGUNA_PMSG_OFF + LAGUNA_BOOTCTR_OFF);
+		nonce = laguna_pd_rd64(LAGUNA_PMSG_OFF + LAGUNA_LOGDUMP_HDR_OFF +
+		    LAGUNA_LD_ENTRY_NONCE_OFF);
+	}
+
+	/* (a) evidence FIRST. kprintf feeds the msgbuf ring and the per-byte
+	 * mirror (conslog_putc -> log_putc -> laguna_logdump_putc); the LGLW
+	 * stage record is the PAN2-style commit; the console-zone marker
+	 * terminates this boot's console window; the flush commits the
+	 * mirror metadata (HALT flag) before any reset machinery runs. */
+	kprintf("AUTOCYCLE-RESET boot=%u nonce=0x%016llx delay=%us\n",
+	    boots, nonce, laguna_autocycle_secs);
+	(void)laguna_panicdump_stage(LW_STAGE_AUTOCYCLE_RESET,
+	    LW_PRODUCER_XNU_KERNEL, 0, laguna_autocycle_secs, boots, nonce,
+	    0, "AUTOCYCLE-RESET");
+	laguna_pd_autocycle_marker(boots, nonce);
+	laguna_logdump_flush(LAGUNA_LOGDUMP_FLUSH_HALT);
+
+	/* (b) then the SAME reset the panic path ends in
+	 * (kdp_machine_reboot_type -> halt_all_cpus(TRUE), debug.c) and the
+	 * reboot(2) syscall uses (machine.c host_reboot). With
+	 * blazer_psci_reset=1 it lands in psci_smp_diagnostic_reset()'s PSCI
+	 * SYSTEM_RESET -- the proven park. A panic that started concurrently
+	 * owns the reset instead: stand down and wait for it. */
+	if (!panic_active()) {
+		kprintf("AUTOCYCLE-RESET: entering halt_all_cpus(TRUE)\n");
+		halt_all_cpus(TRUE);
+	}
+	for (;;) {
+		__builtin_arm_wfi();    /* reset returned, or a panic owns the tail */
+	}
+}
+
+void
+laguna_autocycle_arm(void)
+{
+	uint64_t deadline;
+
+	if (laguna_autocycle_secs == 0) {
+		return;                 /* default OFF: zero behavioral change */
+	}
+	/* once per boot; the pid-1 exec site may re-enter on init retries */
+	if (!os_atomic_cmpxchg(&laguna_autocycle_state, 0, 1, acq_rel)) {
+		return;
+	}
+	thread_call_setup(&laguna_autocycle_call, laguna_autocycle_fire, NULL);
+	clock_interval_to_deadline(laguna_autocycle_secs, NSEC_PER_SEC, &deadline);
+	thread_call_enter_delayed(&laguna_autocycle_call, deadline);
+	kprintf("blazer-autocycle: armed, reset in %us\n", laguna_autocycle_secs);
+}
+
+/* ---- G38 STALL-WATCH: turn silent pid-1 hangs into located panic parks ----
+ *
+ * Problem: the boot stalls SILENTLY after dyld's initializer phase
+ * (M11.initializers): pid 1 stops writing, the kernel stays alive, and
+ * nothing names where userspace is stuck (composite-v20: pid 1 silent for
+ * 7.5 hours with no marker anywhere). blazer_stallwatch=<seconds>
+ * (default 0 = off, zero behavioral change) arms a one-shot delayed
+ * thread_call at the pid-1 exec point (kern_exec.c, next to the G29
+ * autocycle arm). EVERY write(2)/write_nocancel from pid 1 observed on
+ * the BSD syscall path re-arms it (thread_call_enter_delayed cancels the
+ * pending invocation in favor of the new deadline,
+ * kern/thread_call.h:116-127), so the deadline always means "N seconds
+ * since pid 1's LAST write". On true silence the handler prints the last
+ * captured systrace marker (command, syscall, error, process state and —
+ * when the systrace write-text aid decoded it — the write text itself)
+ * and takes the DELIBERATE panic path: panic("STALL-WATCH: ...") runs the
+ * proven autonomous capture (full console + mirror + fastboot park), and
+ * the panic backtrace adds the kernel-side view of the exact hang. Every
+ * silent hang becomes a located, parked evidence site instead of a
+ * 7.5-hour mystery.
+ *
+ * Handler context: same as G29 (thread_call_setup defaults to
+ * THREAD_CALL_PRIORITY_HIGH — handler threads, process context,
+ * interrupts enabled), so kprintf and panic() are safe. The handler
+ * allocates nothing (all marker storage is static), takes no lock, and
+ * is one-shot: arm() 0->1, fire 1->2, both os_atomic_cmpxchg; re-arm is
+ * refused once state != 1, so the watchdog can never resurrect after
+ * firing. The panic string and the boot-arg string are compile-time
+ * constants; the marker strings are bounded kernel-owned copies (never
+ * user pointers). Interaction with blazer_autocycle: two SEPARATE
+ * timers. If blazer_stallwatch=N < blazer_autocycle=M, the first N-long
+ * pid-1 silence panics and parks first (autocycle dies with the reset);
+ * autocycle's absolute-from-boot deadline still cycles boots whose pid 1
+ * keeps writing but never reaches the park. If M < N on a silent boot,
+ * autocycle resets first and stallwatch never fires (see DESIGN.md §5).
+ */
+
+static TUNABLE(uint32_t, laguna_stallwatch_secs, "blazer_stallwatch", 0);
+static uint32_t laguna_stallwatch_state; /* 0=off 1=armed(pending) 2=fired */
+static thread_call_data_t laguna_stallwatch_call;
+static uint64_t laguna_sw_last_act;  /* mach_absolute_time of last pid-1 write */
+static uint32_t laguna_sw_gen;       /* marker generation (torn-read check) */
+
+#define LAGUNA_SW_TEXT_MAX 96u
+#define LAGUNA_SW_COMM_MAX 17u   /* MAXCOMLEN + 1 (bsd/sys/param.h:95) */
+#define LAGUNA_SW_NAME_MAX 24u
+
+/* The last pid-1 write captured on the BSD syscall path (bsd/dev/arm/
+ * systemcalls.c, G38 probe after the systrace_report block). All fields
+ * are bounded kernel-owned copies; "text" is the systrace write-text aid's
+ * dying-words capture when that path ran. */
+struct laguna_sw_marker {
+	uint32_t pstat;                     /* proc p_stat at last write */
+	int32_t  error;                     /* write(2) error at last write */
+	uint16_t syscode;                   /* SYS_write or SYS_write_nocancel */
+	char     comm[LAGUNA_SW_COMM_MAX];  /* p_comm at last write */
+	char     name[LAGUNA_SW_NAME_MAX];  /* syscall name */
+	char     text[LAGUNA_SW_TEXT_MAX];  /* write-text prefix, sanitized */
+};
+static struct laguna_sw_marker laguna_sw_marker;
+
+/* S* process states mirrored from bsd/sys/proc.h:160-164 (frozen ABI;
+ * this osfmk TU deliberately does not include bsd kernel-private
+ * headers). */
+#define LAGUNA_SW_SIDL   1u
+#define LAGUNA_SW_SRUN   2u
+#define LAGUNA_SW_SSLEEP 3u
+#define LAGUNA_SW_SSTOP  4u
+#define LAGUNA_SW_SZOMB  5u
+
+static const char *
+laguna_sw_pstat_str(uint32_t st)
+{
+	switch (st) {
+	case LAGUNA_SW_SIDL:   return "SIDL";
+	case LAGUNA_SW_SRUN:   return "SRUN";
+	case LAGUNA_SW_SSLEEP: return "SSLEEP";
+	case LAGUNA_SW_SSTOP:  return "SSTOP";
+	case LAGUNA_SW_SZOMB:  return "SZOMB";
+	default:               return "S?";
+	}
+}
+
+/* bounded kernel-string copy (src is kernel memory: p_comm or
+ * syscallnames[] rodata; no user pointer reaches this TU) */
+static void
+laguna_sw_strcpy(char *dst, size_t dmax, const char *src)
+{
+	size_t i;
+
+	if (dst == NULL || dmax == 0 || src == NULL) {
+		return;
+	}
+	for (i = 0; i + 1 < dmax && src[i] != '\0'; i++) {
+		dst[i] = src[i];
+	}
+	dst[i] = '\0';
+}
+
+/* sanitize a write-text prefix into the marker: printable ASCII kept,
+ * newline escaped, anything else dotted (no user-controlled bytes are
+ * ever interpreted) */
+static void
+laguna_sw_note_text(const char *buf, size_t len)
+{
+	size_t used = 0, i;
+	char tmp[LAGUNA_SW_TEXT_MAX];
+
+	if (buf == NULL) {
+		return;
+	}
+	if (len >= sizeof(tmp)) {
+		len = sizeof(tmp) - 1;
+	}
+	for (i = 0; i < len && used + 2 < sizeof(tmp); i++) {
+		unsigned char c = (unsigned char)buf[i];
+
+		if (c == '\n') {
+			tmp[used++] = '\\';
+			tmp[used++] = 'n';
+		} else if (c >= 0x20 && c < 0x7f) {
+			tmp[used++] = (char)c;
+		} else {
+			tmp[used++] = '.';
+		}
+	}
+	tmp[used] = '\0';
+	laguna_sw_strcpy(laguna_sw_marker.text, sizeof(laguna_sw_marker.text), tmp);
+	os_atomic_store(&laguna_sw_gen, os_atomic_load(&laguna_sw_gen, relaxed) + 1, relaxed);
+}
+
+/* exported entry (systemcalls.c systrace_report dying-words aid): gated
+ * on the armed state so a blazer_stallwatch=0 boot never touches the
+ * marker. */
+void
+laguna_stallwatch_note_text(const char *buf, size_t len)
+{
+	if (laguna_stallwatch_secs == 0 ||
+	    os_atomic_load(&laguna_stallwatch_state, relaxed) != 1u) {
+		return;
+	}
+	laguna_sw_note_text(buf, len);
+}
+
+/* postpone: enter_delayed cancels the pending invocation in favor of the
+ * new deadline (kern/thread_call.h:116-127) — activity == new full
+ * window. Safe from any thread; the thread_call layer serializes. */
+static void
+laguna_stallwatch_rearm(void)
+{
+	uint64_t deadline;
+
+	os_atomic_store(&laguna_sw_last_act, mach_absolute_time(), relaxed);
+	clock_interval_to_deadline(laguna_stallwatch_secs, NSEC_PER_SEC, &deadline);
+	thread_call_enter_delayed(&laguna_stallwatch_call, deadline);
+}
+
+/* G38 probe entry, called from the BSD syscall return path for pid-1
+ * write(2)/write_nocancel only (systemcalls.c does the pid/syscode
+ * filtering — it owns struct proc). Updates the marker, then postpones
+ * the deadline. No allocation, no locks; bounded kernel copies only. */
+void
+laguna_stallwatch_activity(unsigned short syscode, int error,
+    unsigned int pstat, const char *comm, const char *name)
+{
+	laguna_sw_marker.syscode = syscode;
+	laguna_sw_marker.error = error;
+	laguna_sw_marker.pstat = pstat;
+	laguna_sw_strcpy(laguna_sw_marker.comm, sizeof(laguna_sw_marker.comm), comm);
+	laguna_sw_strcpy(laguna_sw_marker.name, sizeof(laguna_sw_marker.name), name);
+	os_atomic_store(&laguna_sw_gen, os_atomic_load(&laguna_sw_gen, relaxed) + 1, relaxed);
+
+	laguna_stallwatch_rearm();
+}
+
+boolean_t
+laguna_stallwatch_enabled(void)
+{
+	return os_atomic_load(&laguna_stallwatch_state, relaxed) == 1u;
+}
+
+static void
+laguna_stallwatch_fire(thread_call_param_t param0 __unused,
+    thread_call_param_t param1 __unused)
+{
+	struct laguna_sw_marker m;
+	uint32_t g1, g2;
+	uint64_t now, delta_ns = 0, boots = 0, nonce = 0;
+
+	/* one-shot invariant: arm() did 0->1; fire takes 1->2. A late
+	 * re-arm racing this entry cannot resurrect the timer: re-arm is
+	 * gated on state == 1. */
+	if (!os_atomic_cmpxchg(&laguna_stallwatch_state, 1, 2, acq_rel)) {
+		return;
+	}
+
+	/* marker torn-read check: after N seconds of silence no writer
+	 * can be in flight; the double-generation check is belt-and-
+	 * braces for the panic-interleaving corner only. */
+	g1 = os_atomic_load(&laguna_sw_gen, relaxed);
+	m = laguna_sw_marker;
+	g2 = os_atomic_load(&laguna_sw_gen, relaxed);
+	if (g1 != g2) {
+		kprintf("STALL-WATCH: marker changed during capture (gen %u->%u), showing latest\n",
+		    g1, g2);
+		m = laguna_sw_marker;
+	}
+
+	now = mach_absolute_time();
+	{
+		uint64_t last = os_atomic_load(&laguna_sw_last_act, relaxed);
+
+		/* a re-arm racing this fire (state==2 already, so the extra
+		 * deadline no-ops) could make last > now: clamp, report 0 */
+		delta_ns = (now > last) ? (now - last) : 0ull;
+		absolutetime_to_nanoseconds(delta_ns, &delta_ns);
+	}
+
+	/* the same two fields the boot GEN marker printed (G29 fire twin):
+	 * they bind this panic window to this boot for the harvest cut. */
+	if (laguna_pd_va != NULL) {
+		boots = laguna_pd_rd32(LAGUNA_PMSG_OFF + LAGUNA_BOOTCTR_OFF);
+		nonce = laguna_pd_rd64(LAGUNA_PMSG_OFF + LAGUNA_LOGDUMP_HDR_OFF +
+		    LAGUNA_LD_ENTRY_NONCE_OFF);
+	}
+
+	kprintf("STALL-WATCH: pid 1 silent >=%ums (blazer_stallwatch=%us) boot=%u nonce=0x%016llx\n",
+	    (unsigned)(delta_ns / 1000000ull), laguna_stallwatch_secs, boots, nonce);
+	kprintf("STALL-WATCH: last pid-1 write: %s[%u] %s(%u) = %d, pstat %s%s%s%s\n",
+	    m.comm, m.syscode, m.name, m.syscode, m.error,
+	    laguna_sw_pstat_str(m.pstat),
+	    m.text[0] ? " text \"" : "", m.text, m.text[0] ? "\"" : "");
+
+	/* the DELIBERATE panic: proven autonomous capture (full console +
+	 * mirror + fastboot park) plus the kernel-side backtrace of the
+	 * firing moment. Distinctive "STALL-WATCH" string for the ledger
+	 * grep. If a panic already owns the machine, stand down (G29
+	 * tail discipline). */
+	if (!panic_active()) {
+		panic("STALL-WATCH: pid 1 silent %ums, last write %s[%u] %s = %d, pstat %s (blazer_stallwatch=%us)",
+		    (unsigned)(delta_ns / 1000000ull), m.comm, m.syscode, m.name,
+		    m.error, laguna_sw_pstat_str(m.pstat), laguna_stallwatch_secs);
+	}
+	for (;;) {
+		__builtin_arm_wfi();    /* a concurrent panic owns the tail */
+	}
+}
+
+void
+laguna_stallwatch_arm(void)
+{
+	uint64_t deadline;
+
+	if (laguna_stallwatch_secs == 0) {
+		return;                 /* default OFF: zero behavioral change */
+	}
+	/* once per boot; the pid-1 exec site may re-enter on init retries */
+	if (!os_atomic_cmpxchg(&laguna_stallwatch_state, 0, 1, acq_rel)) {
+		return;
+	}
+	os_atomic_store(&laguna_sw_last_act, mach_absolute_time(), relaxed);
+	thread_call_setup(&laguna_stallwatch_call, laguna_stallwatch_fire, NULL);
+	clock_interval_to_deadline(laguna_stallwatch_secs, NSEC_PER_SEC, &deadline);
+	thread_call_enter_delayed(&laguna_stallwatch_call, deadline);
+	kprintf("STALL-WATCH: armed, panic after %us without a pid-1 write\n",
+	    laguna_stallwatch_secs);
+}
