+static void
+mc_aes_encrypt_block(const struct mc_aes_key *k, const uint8_t *in, uint8_t *out)
+{
+	uint8_t s[16], t[16];
+
+	for (int i = 0; i < 16; i++) {
+		s[i] = in[i] ^ k->rk[i];
+	}
+	for (uint32_t r = 1; r <= k->rounds; r++) {
+		/* SubBytes + ShiftRows (state is column-major: s[4*col + row]) */
+		for (int c = 0; c < 4; c++) {
+			for (int row = 0; row < 4; row++) {
+				t[4 * c + row] = aes_sbox[s[4 * ((c + row) & 3) + row]];
+			}
+		}
+		if (r != k->rounds) {
+			for (int c = 0; c < 4; c++) {
+				uint8_t *p = t + 4 * c;
+				uint8_t a0 = p[0], a1 = p[1], a2 = p[2], a3 = p[3];
+				p[0] = (uint8_t)(xtime(a0) ^ xtime(a1) ^ a1 ^ a2 ^ a3);
+				p[1] = (uint8_t)(a0 ^ xtime(a1) ^ xtime(a2) ^ a2 ^ a3);
+				p[2] = (uint8_t)(a0 ^ a1 ^ xtime(a2) ^ xtime(a3) ^ a3);
+				p[3] = (uint8_t)(xtime(a0) ^ a0 ^ a1 ^ a2 ^ xtime(a3));
+			}
+		}
+		for (int i = 0; i < 16; i++) {
+			s[i] = t[i] ^ k->rk[16 * r + i];
+		}
+	}
+	memcpy(out, s, 16);
+}
