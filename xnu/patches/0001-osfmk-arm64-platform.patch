+struct mc_aes_key {
+	uint32_t rounds;
+	uint8_t  rk[240];           /* (rounds + 1) round keys of 16 bytes */
+};
+
+static inline uint8_t
+xtime(uint8_t x)
+{
+	return (uint8_t)((x << 1) ^ ((x >> 7) * 0x1b));
+}
+
+static inline uint8_t
+gmul(uint8_t a, uint8_t b)
+{
+	uint8_t p = 0;
+	while (b) {
+		if (b & 1) {
+			p ^= a;
+		}
+		a = xtime(a);
+		b >>= 1;
+	}
+	return p;
+}
+
+static int
+mc_aes_setkey(struct mc_aes_key *k, size_t key_len, const uint8_t *key)
+{
+	uint32_t nk = (uint32_t)key_len / 4;
+	uint8_t rcon = 1;
+
+	if (key_len != 16 && key_len != 24 && key_len != 32) {
+		return -1;
+	}
+	k->rounds = nk + 6;
+	memcpy(k->rk, key, key_len);
+	for (uint32_t i = nk; i < 4 * (k->rounds + 1); i++) {
+		uint8_t t[4];
+		memcpy(t, k->rk + 4 * (i - 1), 4);
+		if (i % nk == 0) {
+			uint8_t first = t[0];
+			t[0] = aes_sbox[t[1]] ^ rcon;
+			t[1] = aes_sbox[t[2]];
+			t[2] = aes_sbox[t[3]];
+			t[3] = aes_sbox[first];
+			rcon = xtime(rcon);
+		} else if (nk > 6 && i % nk == 4) {
+			for (int j = 0; j < 4; j++) {
+				t[j] = aes_sbox[t[j]];
+			}
+		}
+		for (int j = 0; j < 4; j++) {
+			k->rk[4 * i + j] = k->rk[4 * (i - nk) + j] ^ t[j];
+		}
+	}
+	return 0;
+}
