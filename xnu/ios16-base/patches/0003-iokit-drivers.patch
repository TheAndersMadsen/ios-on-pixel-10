+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+IOExternalTrap *
+IOSurfaceRootUserClient::getTargetAndTrapForIndex(IOService ** targetP, UInt32 index)
+{
+	if (index >= kSurfaceTrapCount) {
+		return NULL;
+	}
+	*targetP = this;
+	return &fTraps[index];
+}
+
+IOReturn
+IOSurfaceRootUserClient::useCountCommon(uint32_t sid, uint32_t category, int delta)
+{
+	struct minisurf_client_ref * ref;
+	IOReturn ret = kIOReturnNotFound;
+
+	if (category > 1) {
+		return kIOReturnBadArgument;
+	}
+	IOLockLock(gSurfaceLock);
+	ref = findRef(sid, false);
+	if (ref != NULL) {
+		MiniIOSurface * s = ref->surface;
+
+		if (delta > 0 || ref->use[category] != 0) {
+			ref->use[category] += delta;
+			s->useCount[category] += delta;
+			s->shared()->useCount = (uint64_t) s->useCount[1] << 32 | s->useCount[0];
+		}
+		ret = kIOReturnSuccess;
+	}
+	IOLockUnlock(gSurfaceLock);
+	return ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapIncrementUseCount(void * p1, void * p2, void * p3, void * p4, void * p5, void * p6)
+{
+	return useCountCommon((uint32_t) (uintptr_t) p1, (uint32_t) (uintptr_t) p2, 1);
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapDecrementUseCount(void * p1, void * p2, void * p3, void * p4, void * p5, void * p6)
+{
+	return useCountCommon((uint32_t) (uintptr_t) p1, (uint32_t) (uintptr_t) p2, -1);
+}
+
+/*
+ * Lock and unlock do not exclude anybody: the memory is shared and always mapped.
+ * What matters is the seed, which tells readers that the pixels may have changed.
+ */
+IOReturn
+IOSurfaceRootUserClient::lockCommon(uint32_t sid, uint32_t options, user_addr_t seedOut)
+{
+	struct minisurf_client_ref * ref;
+	uint32_t seed = 0;
+
+	IOLockLock(gSurfaceLock);
+	ref = findRef(sid, false);
+	if (ref != NULL) {
+		struct minisurf_shared * sh = ref->surface->shared();
+
+		if (!(options & kSurfaceLockReadOnly)) {
+			sh->seed++;
+		}
+		seed = sh->seed;
+	}
+	IOLockUnlock(gSurfaceLock);
+	if (ref == NULL) {
+		return kIOReturnNotFound;
+	}
+	if (seedOut != 0) {
+		copyout(&seed, seedOut, sizeof(seed));
+	}
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapLock(void * p1, void * p2, void * p3, void * p4, void * p5, void * p6)
+{
+	return lockCommon((uint32_t) (uintptr_t) p1, (uint32_t) (uintptr_t) p2, (user_addr_t) (uintptr_t) p3);
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapUnlock(void * p1, void * p2, void * p3, void * p4, void * p5, void * p6)
+{
+	return lockCommon((uint32_t) (uintptr_t) p1, (uint32_t) (uintptr_t) p2, (user_addr_t) (uintptr_t) p3);
+}
+
+/*
+ * A client drops a surface in two steps: "detach" while it still holds its own lock, and
+ * "release" after it. A lookup of the same surface in between must make a fresh view.
+ */
+IOReturn
+IOSurfaceRootUserClient::trapDetach(void * p1, void * p2, void * p3, void * p4, void * p5, void * p6)
+{
+	struct minisurf_client_ref * ref;
+
+	IOLockLock(gSurfaceLock);
+	ref = findRef((uint32_t) (uintptr_t) p1, false);
+	if (ref != NULL) {
+		ref->detached = true;
+	}
+	IOLockUnlock(gSurfaceLock);
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapRelease(void * p1, void * p2, void * p3, void * p4, void * p5, void * p6)
+{
+	struct minisurf_client_ref * ref;
+	uint32_t sid = (uint32_t) (uintptr_t) p1;
+
+	IOLockLock(gSurfaceLock);
+	ref = findRef(sid, true);
+	if (ref == NULL) {
+		ref = findRef(sid, false);
+	}
+	if (ref != NULL) {
+		dropRef(ref);
+	}
+	IOLockUnlock(gSurfaceLock);
+	return ref ? kIOReturnSuccess : kIOReturnNotFound;
+}
diff --git a/iokit/Kernel/MiniIOSurface.h b/iokit/Kernel/MiniIOSurface.h
new file mode 100644
index 0000000..feccca0
--- /dev/null
+++ b/iokit/Kernel/MiniIOSurface.h
@@ -0,0 +1,174 @@
+/*
+ * MiniIOSurface: a stand-in for Apple's closed IOSurface.kext, enough of it for the iOS
+ * window server and its clients to share pixel buffers on a machine without Apple hardware.
+ *
+ * The protocol (user client selectors, traps and the layout of the structures the kernel
+ * hands to IOSurface.framework) was worked out from the user-space side of iOS 16.5.
+ */
+#ifndef _IOKIT_MINIIOSURFACE_H
+#define _IOKIT_MINIIOSURFACE_H
+
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+
+#include "MiniDrivers.h"
+
+#define MINISURF_MAX_PLANES     4
+#define MINISURF_RESULT_MAX     0xa68           /* what IOSurface.framework reserves for a result */
+
+/* One plane, as IOSurface.framework reads it (0x80 bytes). */
+struct minisurf_plane {
+	uint32_t width;                         /* 0x00 */
+	uint32_t height;                        /* 0x04 */
+	uint32_t reserved08;
+	uint32_t offset;                        /* 0x0c from the base address */
+	uint32_t bytesPerRow;                   /* 0x10 */
+	uint32_t size;                          /* 0x14 */
+	uint16_t bytesPerElement;               /* 0x18 */
+	uint8_t  elementWidth;                  /* 0x1a */
+	uint8_t  elementHeight;                 /* 0x1b */
+	uint8_t  componentCount;                /* 0x1c */
+	uint8_t  addressFormat;                 /* 0x1d */
+	uint8_t  reserved1e[2];
+	uint8_t  componentBitDepth[4];          /* 0x20 */
+	uint8_t  componentBitOffset[4];         /* 0x24 */
+	uint8_t  componentName[4];              /* 0x28 */
+	uint8_t  componentType[4];              /* 0x2c */
+	uint8_t  componentRange[4];             /* 0x30 */
+	uint8_t  reserved34[0x20];
+	uint8_t  compression;                   /* 0x54: 1 = compressed, then there is no base address */
+	uint8_t  reserved55[0x1b];
+	uint32_t extendedPixels[4];             /* 0x70 */
+};
+
+/* What "create" and the lookups return: this header, then the planes (at least one). */
+struct minisurf_result {
+	uint64_t base;                          /* 0x00 where the memory is mapped in the client */
+	uint64_t shared;                        /* 0x08 struct minisurf_shared, mapped in the client */
+	uint64_t aux;                           /* 0x10 struct minisurf_aux, mapped in the client */
+	uint32_t sid;                           /* 0x18 */
+	uint32_t allocSize;                     /* 0x1c */
+	uint32_t width;                         /* 0x20 */
+	uint32_t height;                        /* 0x24 */
+	uint32_t bytesPerRow;                   /* 0x28 */
+	uint32_t offset;                        /* 0x2c */
+	uint32_t pixelFormat;                   /* 0x30 */
+	uint32_t reserved34;
+	uint32_t planeCount;                    /* 0x38 */
+	uint32_t reserved3c;
+	uint16_t bytesPerElement;               /* 0x40 */
+	uint8_t  elementWidth;                  /* 0x42 */
+	uint8_t  elementHeight;                 /* 0x43 */
+	uint32_t cacheMode;                     /* 0x44 */
+	uint32_t lockSeed;                      /* 0x48 the client keeps the seed of its last lock here */
+	uint8_t  subsampling;                   /* 0x4c */
+	uint8_t  prohibitUseCount;              /* 0x4d */
+	uint16_t reserved4e;
+	uint32_t parentID;                      /* 0x50 */
+	uint32_t sliceCount;                    /* 0x54 */
+	uint64_t traceID;                       /* 0x58 */
+	uint64_t protectionOptions;             /* 0x60 */
+};
+
+/* State that every client reads straight from memory shared with the kernel. */
+struct minisurf_shared {
+	uint64_t registryID;                    /* 0x00 */
+	uint16_t accelID;                       /* 0x08 */
+	uint16_t accelSubID;                    /* 0x0a */
+	uint32_t seed;                          /* 0x0c changes when somebody has written the pixels */
+	uint32_t reserved10;
+	uint8_t  tiled;                         /* 0x14 */
+	uint8_t  reserved15[3];
+	uint64_t useCount;                      /* 0x18 two 32-bit counters, one per category */
+	uint32_t valuesSeed;                    /* 0x20 */
+	uint32_t ycbcrMatrix;                   /* 0x24 */
+	uint32_t valuesSize;                    /* 0x28 room needed to fetch the values; 0 = none */
+	uint8_t  pixelSizeCasting;              /* 0x2c */
+	uint8_t  displayable;                   /* 0x2d */
+	uint8_t  sysMemOnly;                    /* 0x2e */
+	uint8_t  reserved2f;
+	uint8_t  attachments[0x70];             /* 0x30 the "bulk attachments" */
+};
+
+struct minisurf_aux {
+	uint64_t timestamps[4];
+	uint64_t detachModeCode;
+};
+
+#define MINISURF_AUX_OFFSET     0x400           /* of the aux structure inside the shared page */
+
+class MiniIOSurface : public OSObject
+{
+	OSDeclareDefaultStructors(MiniIOSurface);
+
+public:
+	uint32_t                        sid;
+	uint32_t                        holders;        /* clients, send rights, kernel users */
+	IOBufferMemoryDescriptor *      memory;         /* one page of shared state, then the pixels */
+	uint8_t *                       kbase;          /* the same, in the kernel */
+	/*
+	 * ... unless the surface was made around memory its maker has already (IOSurfaceAddress):
+	 * then the pixels are that memory, held in place and seen from the kernel as well, and
+	 * `memory` is the page of shared state alone.
+	 */
+	IOMemoryDescriptor *            client;
+	IOMemoryMap *                   clientMap;
+	task_t                          clientTask;     /* whose memory it is (not held: only compared) */
+	mach_vm_address_t               clientAddress;  /* ... and where it is there */
+	uint8_t *                       kpixels;        /* where the pixel memory starts in the kernel, either way */
+	uint32_t                        drawn;          /* the GPU's last submission that names the pixels (0: none; hakios.gpu.cpp) */
+	struct minisurf_result          info;           /* addresses not filled in */
+	struct minisurf_plane           planes[MINISURF_MAX_PLANES];
+	OSDictionary *                  values;
+	uint32_t                        useCount[2];
+	uint32_t                        purgeable;
+	bool                            traced;         /* made by a program of boot-arg surftrace_of: its ports are said too */
+
+	virtual bool
+	init(void) APPLE_KEXT_OVERRIDE
+	{
+		return OSObject::init();
+	}
+	virtual void free(void) APPLE_KEXT_OVERRIDE;
+
+	struct minisurf_shared *
+	shared(void) const
+	{
+		return (struct minisurf_shared *) kbase;
+	}
+	struct minisurf_aux *
+	aux(void) const
+	{
+		return (struct minisurf_aux *) (kbase + MINISURF_AUX_OFFSET);
+	}
+	/* The first byte of the pixels (the "base address" clients see). */
+	uint8_t *
+	pixels(void) const
+	{
+		return kpixels + info.offset;
+	}
+	void updateValuesState(void);
+};
+
+/*
+ * For other parts of the kernel (the framebuffer).
+ * A surface found or made here is held until MiniIOSurfaceDrop().
+ */
+MiniIOSurface * MiniIOSurfaceCopy(uint32_t sid);
+/*
+ * What making and freeing surfaces has cost since this was last asked: how many, microseconds
+ * each; how many got memory that was kept from one before.
+ */
+void            MiniIOSurfaceCost(uint32_t * made, uint64_t * making, uint32_t * freed, uint64_t * freeing, uint32_t * again);
+/* Clear the memory that is kept of surfaces that are gone, for the next ones: when the caller has a moment. */
+void            MiniIOSurfaceClearKept(void);
+/* Wait, for so many milliseconds at most, until the GPU is done with a surface's pixels (hakios.gpu.cpp). */
+bool            MiniIOSurfaceDrawn(MiniIOSurface * surface, uint64_t milliseconds);
+MiniIOSurface * MiniIOSurfaceCreateSimple(uint32_t width, uint32_t height, uint32_t pixelFormat);
+void            MiniIOSurfaceDrop(MiniIOSurface * surface);
+/* A Mach send right for the surface in the task (what IOSurfaceCreateMachPort gives); 0 on failure. */
+mach_port_name_t MiniIOSurfaceMakeSendRight(task_t task, MiniIOSurface * surface);
+
+
+#endif /* _IOKIT_MINIIOSURFACE_H */
diff --git a/iokit/Kernel/hakios.battery.cpp b/iokit/Kernel/hakios.battery.cpp
new file mode 100644
index 0000000..eb98e6a
--- /dev/null
+++ b/iokit/Kernel/hakios.battery.cpp
@@ -0,0 +1,230 @@
+/*
+ * HakiosBattery: the phone's battery as iOS looks for it, an IOPMPowerSource.
+ *
+ * powerd finds every service of the class IOPMPowerSource (it calls the first "InternalBattery-0"),
+ * listens for its kIOPMMessageBatteryStatusHasChanged and then reads its properties: whether a
+ * battery is installed, CurrentCapacity and MaxCapacity (without both it gives up on the battery),
+ * whether a charger is connected and charging, voltage, current, cycles, the charger's details.
+ * From them it makes the power sources list (IOPSCopyPowerSourcesInfo) and posts its notifications,
+ * and everything else follows from that: the status bar's battery, the lock screen's "Charging",
+ * the Batteries widget, Settings > Battery.
+ *
+ * What the values are comes from the audio DSP's battery manager (bsd/dev/hakios.adsp.c,
+ * with adsp=1, unless battmgr=0), by way of bsd/dev/hakios.battery.c, which calls
+ * HakiosBatteryReport() with every reading; the first one makes the service. Nothing here asks
+ * the charger anything or tells it anything.
+ *
+ * As on Apple's newer batteries, CurrentCapacity is the percentage that the fuel gauge shows (and
+ * MaxCapacity 100); the charges in mAh are AppleRawCurrentCapacity, AppleRawMaxCapacity (what the
+ * gauge has learnt a full charge to be), NominalChargeCapacity and DesignCapacity.
+ */
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/pwr_mgt/IOPM.h>
+#include <IOKit/pwr_mgt/IOPMPowerSource.h>
+#include <libkern/c++/OSBoolean.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSSymbol.h>
+
+/* The same as struct hakios_battery_state in bsd/sys/hakios.input.h, which is not seen from here. */
+struct hakios_battery_state {
+	uint32_t size;
+	int32_t percent_hundredths;
+	int32_t voltage_uv;
+	int32_t current_ua;             /* more than 0 while the battery takes charge */
+	int32_t temperature_hundredths;
+	int32_t present, external, status;
+	int32_t charge_uah, full_uah, design_uah, cycles;
+	int32_t usb_type;
+	int32_t usb_voltage_uv, usb_current_ua;
+};
+
+extern "C" void HakiosBatteryReport(const void * state, unsigned size);
+
+class HakiosBattery : public IOPMPowerSource
+{
+	OSDeclareDefaultStructors(HakiosBattery);
+
+public:
+	void report(const struct hakios_battery_state * b);
+
+private:
+	void number(const char * key, long long value);
+	void flag(const char * key, bool value);
+	void object(const char * key, OSObject * value);
+};
+
+OSDefineMetaClassAndStructors(HakiosBattery, IOPMPowerSource);
+
+static HakiosBattery * battery;
+
+void
+HakiosBattery::number(const char * key, long long value)
+{
+	const OSSymbol * symbol = OSSymbol::withCString(key);
+	OSNumber * n = OSNumber::withNumber((unsigned long long) value, 32);
+
+	if (symbol != NULL && n != NULL) {
+		setPSProperty(symbol, n);
+	}
+	OSSafeReleaseNULL(n);
+	OSSafeReleaseNULL(symbol);
+}
+
+void
+HakiosBattery::flag(const char * key, bool value)
+{
+	const OSSymbol * symbol = OSSymbol::withCString(key);
+
+	if (symbol != NULL) {
+		setPSProperty(symbol, value ? kOSBooleanTrue : kOSBooleanFalse);
+	}
+	OSSafeReleaseNULL(symbol);
+}
+
+void
+HakiosBattery::object(const char * key, OSObject * value)
+{
+	const OSSymbol * symbol = OSSymbol::withCString(key);
+
+	if (symbol != NULL && value != NULL) {
+		setPSProperty(symbol, value);
+	}
+	OSSafeReleaseNULL(symbol);
+}
+
+/*
+ * What iOS calls the charger by (IOPSKeysPrivate.h's kIOPSFamilyCode*, iokit_family_err(sub_iokit_usb, n)),
+ * from Linux's POWER_SUPPLY_USB_TYPE_*, as the DSP gives it.
+ */
+static unsigned
+family_code(int usb_type)
+{
+	switch (usb_type) {
+	case 1: return 0xe0004000;      /* SDP, a computer's port: kIOPSFamilyCodeUSBHost */
+	case 2: return 0xe0004004;      /* DCP, a charger: kIOPSFamilyCodeUSBChargingPortDedicated */
+	case 3: return 0xe0004005;      /* CDP, a computer's charging port: kIOPSFamilyCodeUSBChargingPortDownstream */
+	case 5: return 0xe0004009;      /* USB-C: kIOPSFamilyCodeUSBCTypeC */
+	case 6: case 7: case 8: return 0xe000400a;      /* USB Power Delivery: kIOPSFamilyCodeUSBCPD */
+	default: return 0xe0004007;     /* kIOPSFamilyCodeUSBUnknown */
+	}
+}
+
+void
+HakiosBattery::report(const struct hakios_battery_state * b)
+{
+	int percent = (b->percent_hundredths + 50) / 100;
+	bool charging = b->external && b->status == 1;          /* POWER_SUPPLY_STATUS_CHARGING */
+
+	percent = percent < 0 ? 0 : percent > 100 ? 100 : percent;
+	setBatteryInstalled(b->present != 0);
+	setExternalConnected(b->external != 0);
+	setExternalChargeCapable(b->external != 0);
+	setIsCharging(charging);
+	flag("FullyCharged", b->external && (b->status == 4 || percent == 100));    /* POWER_SUPPLY_STATUS_FULL */
+	flag("AppleRawExternalConnected", b->external != 0);
+	setCurrentCapacity((unsigned) percent);
+	setMaxCapacity(100);
+	setVoltage((unsigned) (b->voltage_uv / 1000));
+	setAmperage(b->current_ua / 1000);
+	number("InstantAmperage", b->current_ua / 1000);
+	number("Temperature", b->temperature_hundredths);
+	if (b->charge_uah > 0) {
+		number("AppleRawCurrentCapacity", b->charge_uah / 1000);
+	}
+	if (b->full_uah > 0) {
+		number("AppleRawMaxCapacity", b->full_uah / 1000);
+		number("NominalChargeCapacity", b->full_uah / 1000);
+	}
+	if (b->design_uah > 0) {
+		number("DesignCapacity", b->design_uah / 1000);
+	}
+	if (b->cycles > 0) {
+		setCycleCount((unsigned) b->cycles);
+	}
+
+	if (b->external) {
+		OSDictionary * adapter = OSDictionary::withCapacity(6);
+		long long mv = b->usb_voltage_uv / 1000, ma = b->usb_current_ua / 1000;
+		OSNumber * n;
+
+		if (adapter != NULL) {
+			if ((n = OSNumber::withNumber((unsigned long long) ((mv * ma + 500000) / 1000000), 32)) != NULL) {
+				adapter->setObject(kIOPMPSAdapterDetailsWattsKey, n);
+				n->release();
+			}
+			if ((n = OSNumber::withNumber((unsigned long long) ma, 32)) != NULL) {
+				adapter->setObject(kIOPMPSAdapterDetailsAmperageKey, n);
+				n->release();
+			}
+			if ((n = OSNumber::withNumber((unsigned long long) mv, 32)) != NULL) {
+				adapter->setObject(kIOPMPSAdapterDetailsVoltage, n);
+				n->release();
+			}
+			if ((n = OSNumber::withNumber((unsigned long long) family_code(b->usb_type), 32)) != NULL) {
+				adapter->setObject(kIOPMPSAdapterDetailsFamilyKey, n);
+				n->release();
+			}
+			adapter->setObject("IsWireless", kOSBooleanFalse);
+			object(kIOPMPSAdapterDetailsKey, adapter);
+			adapter->release();
+		}
+	} else {
+		OSDictionary * none = OSDictionary::withCapacity(1);
+		OSNumber * n = OSNumber::withNumber(0ULL, 32);    /* kIOPSFamilyCodeDisconnected */
+
+		if (none != NULL && n != NULL) {
+			none->setObject(kIOPMPSAdapterDetailsFamilyKey, n);
+			object(kIOPMPSAdapterDetailsKey, none);
+		}
+		OSSafeReleaseNULL(n);
+		OSSafeReleaseNULL(none);
+	}
+	updateStatus();
+}
+
+/* With every reading of the battery (bsd/dev/hakios.battery.c); the first one makes the service. One caller at a time. */
+void
+HakiosBatteryReport(const void * state, unsigned size)
+{
+	const struct hakios_battery_state * b = (const struct hakios_battery_state *) state;
+	IOService * platform;
+
+	if (size != sizeof(struct hakios_battery_state) || b->size != sizeof(struct hakios_battery_state)) {
+		static bool said;
+
+		if (!said) {
+			said = true;
+			IOLog("HakiosBattery: the battery's state is %u bytes, not %lu: bsd/sys/hakios.input.h and this file disagree\n",
+			    size, sizeof(struct hakios_battery_state));
+		}
+		return;
+	}
+	if (battery == NULL) {
+		HakiosBattery * made = OSTypeAlloc(HakiosBattery);
+
+		if ((platform = IOService::getPlatform()) == NULL || made == NULL || !made->init()) {
+			OSSafeReleaseNULL(made);
+			return;
+		}
+		made->report(b);        /* (the properties are there before anybody finds the service) */
+		if (!made->attach(platform)) {
+			made->release();
+			return;
+		}
+		made->setName("HakiosBattery");
+		if (!made->start(platform)) {
+			made->detach(platform);
+			made->release();
+			return;
+		}
+		made->registerService();
+		battery = made;
+		IOLog("HakiosBattery: the battery's power source is up: %d%%, %s\n", (b->percent_hundredths + 50) / 100,
+		    b->external ? (b->status == 1 ? "charging" : "on a charger, not charging") : "not on a charger");
+		return;
+	}
+	battery->report(b);
+}
diff --git a/iokit/Kernel/hakios.gpu.cpp b/iokit/Kernel/hakios.gpu.cpp
new file mode 100644
index 0000000..26e8e97
--- /dev/null
+++ b/iokit/Kernel/hakios.gpu.cpp
@@ -0,0 +1,1192 @@
+/*
+ * HakiosGPU: the phone's Adreno for programs to draw with.
+ *
+ * bsd/dev/hakios.adreno.c wakes the GPU and, with boot-arg adreno_keep=1, keeps it on and
+ * starts this service. A program that opens it speaks the interface of Linux's msm DRM driver,
+ * the one Mesa's freedreno knows: every request of that interface is a call of the user client
+ * with the request's number as the selector and the request's structure passed in and back
+ * (userland: tools/mesa/hakios-drm, which stands in for libdrm inside Mesa). What Linux does
+ * with mmap() on the device is the client memory of the type that is the buffer's handle.
+ *
+ * What there is of the interface is what freedreno uses to draw: parameters, buffers (made,
+ * told their address in the GPU's address space, mapped, given back), submission of command
+ * buffers, and waiting for one to be done. A buffer is wired kernel memory entered into the 3D
+ * core's SMMU context; it is zero when made, and write-combined: what the program writes goes to
+ * memory, where the GPU reads it, and not into this processor's cache (as Linux maps them for
+ * freedreno; boot-arg gpu_cached=1 makes them ordinary memory, pushed out of the cache whenever
+ * the GPU is given something to do: see submit()).
+ *
+ * One request is not Linux's: a buffer that is the memory of an IOSurface (surfaceBuffer()), for
+ * drawing into what the display shows and for reading pictures where other programs have drawn
+ * them. Linux hands such memory around as file descriptors; here it has a name already. That
+ * memory is ordinary, cached memory, which everybody else reads and writes as such.
+ *
+ * Not here yet: interrupts (waiting is asking again five times a millisecond), more than one
+ * program's worth of care (every client's buffers are in the one address space; a client that
+ * goes takes its own away), recovery of a GPU that has stopped answering (it is reported, see
+ * hakios_gpu_report(), and stays stopped), fences and buffers as file descriptors.
+ */
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOPlatformExpert.h>
