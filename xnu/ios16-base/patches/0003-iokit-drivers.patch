+OSDefineMetaClassAndStructors(IOSurfaceSendRight, OSObject);
+
+void
+IOSurfaceSendRight::free(void)
+{
+	MiniIOSurfaceDrop(surface);
+	surface = NULL;
+	OSObject::free();
+}
