+/* A line about a traced surface: to the loader's log too, where it outlives the kernel's own, short log. */
+static void
+traceLine(const char * format, ...)
+{
+	char line[256];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
