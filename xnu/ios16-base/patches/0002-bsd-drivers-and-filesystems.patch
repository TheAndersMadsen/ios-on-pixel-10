diff --git a/bsd/pthread/pthread_kext_static.c b/bsd/pthread/pthread_kext_static.c
new file mode 100644
index 0000000..0200bd0
--- /dev/null
+++ b/bsd/pthread/pthread_kext_static.c
@@ -0,0 +1,26 @@
+/*
+ * Starts the pthread kernel extension when it is linked statically into the
+ * kernel image.
+ *
+ * com.apple.kec.pthread (open source, libpthread/kern) normally arrives as a
+ * prelinked kext whose start routine registers its function table with
+ * pthread_shims.c. This configuration has no kext loading at all, so the kext
+ * is built as libpthread_kext.a, linked in, and started from here before
+ * bsd_init() needs it.
+ */
+#include <mach/kmod.h>
+#include <kern/startup.h>
+#include <kern/debug.h>
+
+extern kern_return_t pthread_start(kmod_info_t *ki, void *d);
+
+__startup_func
+static void
+pthread_kext_static_start(void)
+{
+	kern_return_t kr = pthread_start(NULL, NULL);
+	if (kr != KERN_SUCCESS) {
+		panic("static pthread kext failed to start: %d", kr);
+	}
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_LAST, pthread_kext_static_start);
diff --git a/bsd/sys/Makefile b/bsd/sys/Makefile
index 3d349c1..1632579 100644
--- a/bsd/sys/Makefile
+++ b/bsd/sys/Makefile
@@ -296,12 +296,24 @@ INSTALL_KF_MI_GEN_LIST =
 
 MAKESYSCALLS = $(SRCROOT)/bsd/kern/makesyscalls.sh
 
+# Serialize the generated syscall family under parallel make: the master must
+# be complete before any makesyscalls mode runs, and the modes run one at a
+# time, so a truncated master can never be consumed by a sibling job (see
+# devices/blazer/docs/BUILD.md, "Parallel-build safety").
+.NOTPARALLEL: $(TARGET)/bsd.syscalls.master syscall.h sysproto.h $(OBJROOT)/syscall.codes
+
 $(OBJROOT)/cscope.genhdrs:
 	$(_v)mkdir -p $(OBJROOT)/cscope.genhdrs
 
 $(OBJROOT)/syscall.codes: $(TARGET)/bsd.syscalls.master
 	@$(LOG_GENERATE) "$(ColorLF)$@$(Color0) from $(ColorF)$(<F)$(Color0)"
-	$(_v)$(MAKESYSCALLS) $< trace > $@
+	$(_v)$(MAKESYSCALLS) $< trace > $@.$$$$;	\
+	if [ ! -s $@.$$$$ ]; then			\
+		$(RM) $@.$$$$;				\
+		$(ERR) Truncated generation for $@;	\
+		exit 1;					\
+	fi;						\
+	$(MV) -f $@.$$$$ $@
 
 
 $(OBJROOT)/trace.codes: $(SRCROOT)/bsd/kern/trace_codes $(OBJROOT)/syscall.codes
