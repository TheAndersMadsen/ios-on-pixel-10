+ * Hot File interface functions.
+ */
+int  hfs_hotfilesync (struct hfsmount *, vfs_context_t ctx);
+
+int  hfs_recording_init(struct hfsmount *);
+int  hfs_recording_suspend (struct hfsmount *);
