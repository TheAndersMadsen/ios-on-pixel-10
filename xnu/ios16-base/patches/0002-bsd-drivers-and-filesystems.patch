+	uint64_t total_bytes_read;
+} __attribute__((aligned(8), packed));
+
+struct apfs_j_xattr_dstream {
+	uint64_t xattr_obj_id;
+	struct apfs_j_dstream dstream;
+};
+
+struct apfs_j_dstream_id_val {
+	uint32_t refcnt;
+} __attribute__((packed));
