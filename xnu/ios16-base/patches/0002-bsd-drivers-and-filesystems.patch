+
+/*
+ *   GCC and clang
+ */
+#if defined(__GNUC__) && ( defined(__APPLE_CPP__) || defined(__APPLE_CC__) || defined(__MACOS_CLASSIC__) )
+    #if defined(__ppc__)
+        #define TARGET_CPU_PPC          1
+    #elif defined(__ppc64__)
