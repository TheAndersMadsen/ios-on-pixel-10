diff --git a/bsd/conf/Makefile.template b/bsd/conf/Makefile.template
index 4b83160..c41619f 100644
--- a/bsd/conf/Makefile.template
+++ b/bsd/conf/Makefile.template
@@ -44,6 +44,21 @@ CFLAGS+= -include meta_features.h -DDRIVER_PRIVATE \
         -Warray-bounds-pointer-arithmetic
 SFLAGS+= -include meta_features.h
 
+#
+# Apple OSS HFS built in (bsd/laguna_hfs): compiled like the kext, see
+# laguna_hfs_compat.h. The compat header must come after the kernel's -D
+# options, hence _CFLAGS_ADD. Ported from the laguna141 bridge tree's
+# Makefile.template (there gated on CURRENT_MACHINE_CONFIG == LAGUNA; this
+# tree enables laguna_hfs via conf/files + options LAGUNA_HFS for its only
+# machine config, so the block is unconditional).
+#
+LAGUNA_HFS_ROOT = $(SRCROOT)/bsd/laguna_hfs
+LAGUNA_HFS_OBJS = BTree.o BTreeAllocate.o BTreeMiscOps.o BTreeNodeOps.o BTreeScanner.o BTreeTreeOps.o BTreeWrapper.o CatalogUtilities.o FileExtentMapping.o FileIDsServices.o MacOSStubs.o UnicodeWrappers.o VolumeAllocation.o hfs_attrlist.o hfs_btreeio.o hfs_catalog.o hfs_chash.o hfs_cnode.o hfs_cprotect.o hfs_endian.o hfs_extents.o hfs_fsinfo.o hfs_hotfiles.o hfs_journal.o hfs_link.o hfs_lookup.o hfs_notification.o hfs_quota.o hfs_readwrite.o hfs_resize.o hfs_search.o hfs_vfsops.o hfs_vfsutils.o hfs_vnops.o hfs_xattr.o rangelist.o hfs_encodinghint.o hfs_encodings.o laguna_hfs_iokit.o
+$(foreach o,$(LAGUNA_HFS_OBJS),$(eval $(o)_CFLAGS_ADD += -include $(LAGUNA_HFS_ROOT)/laguna_hfs_compat.h -I$(LAGUNA_HFS_ROOT) -I$(LAGUNA_HFS_ROOT)/core))
+# HFSEncodings is a separate kext on Apple with its own allocation counter.
+hfs_encodings.o_CFLAGS_ADD += -Dhfs_allocated=hfs_encodings_allocated
+hfs_encodinghint.o_CFLAGS_ADD += -Dhfs_allocated=hfs_encodings_allocated
+
 #
 # Directories for mig generated files
 #
@@ -562,6 +577,13 @@ $(COMPONENT).libfilelist: $(LIBOBJS)
 
 MAKESYSCALLS = $(SRCROOT)/bsd/kern/makesyscalls.sh
 
+# Serialize the generated sysent family under parallel make: each mode reads
+# the master and rewrites its output file, so the four generations run one at
+# a time and can never interleave with a concurrent regeneration (see
+# devices/blazer/docs/BUILD.md, "Parallel-build safety"). Only these four
+# targets are serialized; the object compiles below stay parallel.
+.NOTPARALLEL: init_sysent.c syscalls.c audit_kevents.c systrace_args.c
+
 init_sysent.c: $(TARGET)/bsd.syscalls.master
 	@$(LOG_GENERATE) "$@$(Color0) from $(ColorF)$(<F)$(Color0)"
 	$(_v)$(MAKESYSCALLS) $< table > /dev/null
