+/*
+ * The touch screen of the POCO X5 Pro (redwood): either a Goodix GT9916 ("Berlin-D") or a
+ * FocalTech FT3680 on the SPI bus of the SoC's serial engine 13, as a source of touches for
+ * /dev/hakios-touch (sys/hakios.input.h). Only with boot-arg touchscreen=1: every address
+ * below belongs to this phone.
+ *
+ * There is no clock, pin, regulator or SPI framework in this kernel, so the driver does all of
+ * it itself, in the order the vendor's Linux drivers do:
+ *   power    the chip's I/O supply is LDO2 of the PM8350C, switched through RPMh (one request
+ *            written into the "always on" processor's command slots); the analog supply is
+ *            behind a GPIO
+ *   clocks   the serial engine's three clocks, by vote in the global clock controller
+ *   pins     four GPIOs to the serial engine, plus reset, interrupt and the analog supply switch
+ *   SPI      the serial engine ("GENI") in FIFO mode, polled; or, if the engine cannot be used,
+ *            the same four pins driven by hand
+ *   panel    GPIO96=1 and GPIO68=0 identify the FocalTech variant; everything else is Goodix,
+ *            the same discriminator the vendor sm8350-kernel-OKX uses
+ *   chip     Goodix: find where it keeps the touch report, then read it when the IRQ line signals;
+ *            FocalTech: read the report at register 0x01 with FTS 5.x SPI framing (cmd 0xC1 for
+ *            read, 0xC0 for write, two-byte CRC-16/Kermit)
+ * No interrupt is used: a thread looks at the interrupt line 125 times a second (boot-arg
+ * touch_poll_us=N: every N microseconds instead of 8000). With touch_lat=1 a line for every report
+ * read ("tl: c before US seen US read US": the look before, the look that found the line low, the
+ * report read), for measuring how long a touch takes to show (tools/latency.py).
+ *
+ * Register layouts: Linux drivers/spi/spi-geni-qcom.c, drivers/soc/qcom/{qcom-geni-se,rpmh-rsc,
+ * cmd-db}.c, drivers/clk/qcom/gcc-sc7280.c, drivers/pinctrl/qcom/pinctrl-sc7280.c,
+ * drivers/input/touchscreen/{goodix_berlin_*,focaltech_touch/focaltech_core}.c, and the phone's
+ * own device tree.
+ */
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/hakios.input.h>
+#include <sys/systm.h>
+
+extern void hakios_tl(const char *format, ...) __printflike(1, 2);
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern vm_offset_t ml_io_map_wcomb(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t thread_terminate(thread_t thread);
+
+static vm_offset_t tlmm, gcc, se, rsc, cmd_db;
+
+static inline uint32_t
+rd(vm_offset_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+static inline void
+wr(vm_offset_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+}
+
+static void
+sleep_us(uint32_t us)
+{
+	delay_for_interval(us, NSEC_PER_USEC);
+}
+
+static void
+sleep_ms(uint32_t ms)
+{
+	delay_for_interval(ms, NSEC_PER_MSEC);
+}
+
+/* ---- pins (TLMM) ------------------------------------------------------------------------------- */
+
+#define TLMM_PHYS               0x0f100000UL
+#define TLMM_SIZE               0x100000UL
+#define GPIO_CFG(n)             (tlmm + 0x1000UL * (n))         /* [1:0] pull, [5:2] function, [8:6] drive, [9] output */
+#define GPIO_IO(n)              (tlmm + 0x1000UL * (n) + 4)     /* bit 0 in, bit 1 out */
+#define PULL_NONE               0
+#define PULL_UP                 3
+
+#define PIN_MISO                52
+#define PIN_MOSI                53
+#define PIN_CLK                 54
+#define PIN_CS                  55
+#define PIN_INT                 81      /* low = the chip has a report */
+#define PIN_RESET               105     /* low = in reset */
+#define PIN_AVDD                107     /* high = analog supply on */
+#define PIN_FOCALTECH_ID        68      /* FocalTech if this reads 0 ... */
+#define PIN_GOODIX_ID           96      /* ... and this reads 1 (sm8350-kernel-OKX convention) */
+#define PIN_FUNCTION_SPI        1       /* "qup15" */
+
+static void
+gpio_configure(unsigned pin, unsigned function, unsigned pull, unsigned ma, bool output)
+{
+	wr(GPIO_CFG(pin), pull | function << 2 | (ma / 2 - 1) << 6 | (output ? 1u << 9 : 0));
+}
+
+static void
+gpio_set(unsigned pin, bool high)
+{
+	wr(GPIO_IO(pin), high ? 2 : 0);
+}
+
+static bool
+gpio_get(unsigned pin)
+{
+	return rd(GPIO_IO(pin)) & 1;
+}
+
+static void
+gpio_output(unsigned pin, bool high, unsigned pull, unsigned ma)
+{
+	gpio_set(pin, high);            /* the level first, so that the pin never drives the wrong one */
+	gpio_configure(pin, 0, pull, ma, true);
+}
+
+/* ---- the I/O supply (RPMh) ----------------------------------------------------------------------- */
+
+#define CMD_DB_PHYS             0x80860000UL
+#define CMD_DB_SIZE             0x20000UL
+#define RSC_PHYS                0x18220000UL    /* the application processor's "DRV 2" */
+#define RSC_SIZE                0x10000UL
+#define TCS(reg)                (rsc + 0xd00 + (reg))           /* command slot set 0, an "active" one */
+#define TCS_IRQ_ENABLE          0x00
+#define TCS_IRQ_STATUS          0x04
+#define TCS_IRQ_CLEAR           0x08
+#define TCS_WAIT_FOR_COMPLETION 0x10
+#define TCS_CONTROL             0x14
+#define TCS_CONTROL_ENABLE      (1u << 16)
+#define TCS_CONTROL_TRIGGER     (1u << 24)
+#define TCS_STATUS              0x18            /* 0 while busy */
+#define TCS_CMD_ENABLE          0x1c
+#define TCS_CMD_MSGID(n)        (0x30 + 20 * (n))
+#define TCS_CMD_ADDR(n)         (0x34 + 20 * (n))
+#define TCS_CMD_DATA(n)         (0x38 + 20 * (n))
+#define MSGID_WRITE_4_BYTES     0x10008
+#define MSGID_RESPONSE          0x100
+
+#define VRM_VOLTAGE             0               /* a regulator's registers, from its address: millivolts */
+#define VRM_ENABLE              4
+#define VRM_MODE                8
+#define VRM_MODE_LDO_HPM        7
+
+struct cmd_db_slave {
+	uint16_t id, header_offset, data_offset, count, version, reserved[3];
+};
+struct cmd_db_header {
+	uint32_t version;
+	uint8_t magic[4];
+	struct cmd_db_slave slave[8];
+	uint32_t checksum, reserved;
+	uint8_t data[];
+};
+struct cmd_db_entry {
+	char id[8];
+	uint32_t priority[2];
+	uint32_t address;
+	uint16_t length, offset;
+};
+
+/* The RPMh address of a resource by its name in the command database the boot loader left; 0 = none. */
+static uint32_t
+rpmh_address(const char *name)
+{
+	const struct cmd_db_header *db = (const struct cmd_db_header *)cmd_db;
+	char id[8] = { 0 };
+
+	if (db->magic[0] != 0xdb || db->magic[1] != 0x30 || db->magic[2] != 0x03 || db->magic[3] != 0x0c) {
+		printf("goodix: no command database (magic %02x %02x %02x %02x)\n", db->magic[0], db->magic[1], db->magic[2],
+		    db->magic[3]);
+		return 0;
+	}
+	strlcpy(id, name, sizeof(id));
+	for (unsigned s = 0; s < 8; s++) {
+		const struct cmd_db_slave *slave = &db->slave[s];
+		const struct cmd_db_entry *entry = (const struct cmd_db_entry *)(db->data + slave->header_offset);
+
+		if (slave->id == 0 || slave->header_offset >= CMD_DB_SIZE - 0x1000 || slave->count > 512) {
+			continue;
+		}
+		for (unsigned i = 0; i < slave->count; i++) {
+			if (memcmp(entry[i].id, id, sizeof(id)) == 0) {
+				return entry[i].address;
+			}
+		}
+	}
+	return 0;
+}
+
+static bool
+rpmh_wait(uint32_t reg, uint32_t mask, uint32_t value, const char *what)
+{
+	for (int i = 0; i < 2000; i++) {
+		if ((rd(TCS(reg)) & mask) == value) {
+			return true;
+		}
+		sleep_us(100);
+	}
+	printf("goodix: RPMh: timeout waiting for %s (register %#x = %#x)\n", what, reg, rd(TCS(reg)));
+	return false;
+}
+
+/* Send up to three register writes to RPMh and wait until they are done. */
+static bool
+rpmh_write(const uint32_t *address, const uint32_t *data, unsigned count)
+{
+	uint32_t irq_enable = rd(TCS(TCS_IRQ_ENABLE));
+	bool done;
+
+	/* the slot set must be idle, and switched off the way the hardware wants it: trigger, then enable */
+	for (int i = 0; rd(TCS(TCS_STATUS)) == 0; i++) {
+		if (i > 2000) {
+			printf("goodix: RPMh: the command slots stay busy\n");
+			return false;
+		}
+		sleep_us(100);
+	}
+	wr(TCS(TCS_CONTROL), rd(TCS(TCS_CONTROL)) & ~TCS_CONTROL_TRIGGER);
+	wr(TCS(TCS_CONTROL), rd(TCS(TCS_CONTROL)) & ~TCS_CONTROL_ENABLE);
+	wr(TCS(TCS_IRQ_CLEAR), 1);
+	for (unsigned i = 0; i < count; i++) {
+		wr(TCS(TCS_CMD_MSGID(i)), MSGID_WRITE_4_BYTES | MSGID_RESPONSE);
+		wr(TCS(TCS_CMD_ADDR(i)), address[i]);
+		wr(TCS(TCS_CMD_DATA(i)), data[i]);
+	}
+	wr(TCS(TCS_WAIT_FOR_COMPLETION), (1u << count) - 1);
+	wr(TCS(TCS_CMD_ENABLE), (1u << count) - 1);
+	wr(TCS(TCS_IRQ_ENABLE), irq_enable | 1);        /* the status bit follows the enable; the interrupt itself stays masked */
+	wr(TCS(TCS_CONTROL), TCS_CONTROL_ENABLE);
+	wr(TCS(TCS_CONTROL), TCS_CONTROL_ENABLE | TCS_CONTROL_TRIGGER);
+
+	done = rpmh_wait(TCS_IRQ_STATUS, 1, 1, "the request");
+	wr(TCS(TCS_CONTROL), rd(TCS(TCS_CONTROL)) & ~TCS_CONTROL_TRIGGER);
+	wr(TCS(TCS_CONTROL), rd(TCS(TCS_CONTROL)) & ~TCS_CONTROL_ENABLE);
+	wr(TCS(TCS_CMD_ENABLE), 0);
+	wr(TCS(TCS_WAIT_FOR_COMPLETION), 0);
+	wr(TCS(TCS_IRQ_CLEAR), 1);
+	wr(TCS(TCS_IRQ_ENABLE), irq_enable);
+	return done;
+}
+
+/* The chip's I/O supply: 1.8 V from LDO2 of the PM8350C ("ldoc2"). Nothing else is connected to it. */
+static bool
+io_supply_on(void)
+{
+	uint32_t base = rpmh_address("ldoc2");
+	uint32_t address[3] = { base + VRM_VOLTAGE, base + VRM_ENABLE, base + VRM_MODE };
+	uint32_t data[3] = { 1800, 1, VRM_MODE_LDO_HPM };
+
+	/* addresses of regulators ("VRM") have 4 in bits 19:16; anything else is not what we are looking for */
+	if (base == 0 || (base >> 16 & 0xf) != 4) {
+		printf("goodix: RPMh: no regulator \"ldoc2\" (address %#x)\n", base);
+		return false;
+	}
+	printf("goodix: RPMh: ldoc2 is at %#x; slot status %#x, control %#x, irq enable %#x status %#x\n", base,
+	    rd(TCS(TCS_STATUS)), rd(TCS(TCS_CONTROL)), rd(TCS(TCS_IRQ_ENABLE)), rd(TCS(TCS_IRQ_STATUS)));
+	if (!rpmh_write(address, data, 3)) {
+		return false;
+	}
+	printf("goodix: I/O supply on (1.8 V)\n");
+	return true;
+}
+
+/* ---- clocks (GCC) -------------------------------------------------------------------------------- */
+
+#define GCC_PHYS                0x00100000UL
+#define GCC_SIZE                0x60000UL
+#define GCC_VOTE                (gcc + 0x52008)         /* the application processor's votes */
+#define VOTE_QUP1_CORE_2X       (1u << 18)
+#define VOTE_QUP1_CORE          (1u << 19)
+#define VOTE_QUP1_M_AHB         (1u << 20)
+#define VOTE_QUP1_S_AHB         (1u << 21)
+#define VOTE_QUP1_SE5           (1u << 27)             /* serial engine 13 is the 6th of the second group */
+#define GCC_QUP1_M_AHB_CBCR     (gcc + 0x18004)         /* bit 31: the clock is off */
+#define GCC_QUP1_S_AHB_CBCR     (gcc + 0x18008)
+#define GCC_QUP1_SE5_CBCR       (gcc + 0x185fc)
+#define GCC_QUP1_SE5_CMD        (gcc + 0x18600)         /* bit 0: take the new configuration */
+#define GCC_QUP1_SE5_CFG        (gcc + 0x18604)         /* [4:0] 2*divider-1, [10:8] source, [13:12] mode */
+#define GCC_QUP1_SE5_DFSR       (gcc + 0x18614)         /* bit 0: the engine chooses among preset rates itself */
+#define GCC_QUP1_SE5_PERF_CFG(l) (gcc + 0x1861c + 4 * (l))
+#define GCC_QUP1_SE5_PERF_M(l)  (gcc + 0x1865c + 4 * (l))
+#define GCC_QUP1_SE5_PERF_N(l)  (gcc + 0x1869c + 4 * (l))
+#define CLOCK_OFF               (1u << 31)
+#define XO_HZ                   19200000
+
+static uint32_t se_source_hz, se_clock_select;
+
+static uint32_t
+rcg_rate(uint32_t cfg, uint32_t m, uint32_t not_n_minus_m)
+{
+	static const uint32_t parent[8] = { XO_HZ, 600000000, 0, 0, 0, 0, 300000000, 0 };
+	uint64_t hz = parent[cfg >> 8 & 7];
+	uint32_t divider = cfg & 0x1f, mode = cfg >> 12 & 3;
+
+	if (divider) {
+		hz = hz * 2 / (divider + 1);
+	}
+	if (mode) {
+		uint32_t n = (~not_n_minus_m & 0xffff) + (m & 0xffff);
+
+		if (n) {
+			hz = hz * (m & 0xffff) / n;
+		}
+	}
+	return (uint32_t)hz;
+}
+
+static bool
+clocks_on(void)
+{
+	wr(GCC_VOTE, rd(GCC_VOTE) | VOTE_QUP1_CORE_2X | VOTE_QUP1_CORE | VOTE_QUP1_M_AHB | VOTE_QUP1_S_AHB);
+	if (rd(GCC_QUP1_SE5_DFSR) & 1) {
+		/* preset rates: the lowest that is at least 4 MHz */
+		for (uint32_t level = 0; level < 8; level++) {
+			uint32_t hz = rcg_rate(rd(GCC_QUP1_SE5_PERF_CFG(level)), rd(GCC_QUP1_SE5_PERF_M(level)),
+			    rd(GCC_QUP1_SE5_PERF_N(level)));
+
+			if (hz >= 4000000 && (se_source_hz == 0 || hz < se_source_hz)) {
+				se_source_hz = hz;
+				se_clock_select = level;
+			}
+		}
+		if (se_source_hz == 0) {
+			printf("goodix: no usable preset clock rate\n");
+			return false;
+		}
+	} else {
+		/* the crystal, undivided: nothing else has to be running */
+		wr(GCC_QUP1_SE5_CFG, (rd(GCC_QUP1_SE5_CFG) & ~0x371fu) | 1);
+		wr(GCC_QUP1_SE5_CMD, rd(GCC_QUP1_SE5_CMD) | 1);
+		for (int i = 0; i < 500 && (rd(GCC_QUP1_SE5_CMD) & 1); i++) {
+			sleep_us(10);
+		}
+		if (rd(GCC_QUP1_SE5_CMD) & 1) {
+			printf("goodix: the serial engine's clock does not take its configuration (%#x)\n", rd(GCC_QUP1_SE5_CMD));
+			return false;
+		}
+		se_source_hz = XO_HZ;
+		se_clock_select = 0;
+	}
+	wr(GCC_VOTE, rd(GCC_VOTE) | VOTE_QUP1_SE5);
+	for (int i = 0; i < 1000; i++) {
+		if (!((rd(GCC_QUP1_M_AHB_CBCR) | rd(GCC_QUP1_S_AHB_CBCR) | rd(GCC_QUP1_SE5_CBCR)) & CLOCK_OFF)) {
+			return true;
+		}
+		sleep_us(10);
+	}
+	printf("goodix: clocks stay off: %#x %#x %#x\n", rd(GCC_QUP1_M_AHB_CBCR), rd(GCC_QUP1_S_AHB_CBCR),
+	    rd(GCC_QUP1_SE5_CBCR));
+	return false;
+}
+
+/* ---- SPI through the serial engine (GENI) ---------------------------------------------------------- */
+
+#define SE_PHYS                 0x00a94000UL
+#define SE_SIZE                 0x4000UL
+#define GENI_FORCE_DEFAULT      (se + 0x020)
+#define GENI_OUTPUT_CTRL        (se + 0x024)
+#define GENI_CGC_CTRL           (se + 0x028)
+#define GENI_STATUS             (se + 0x040)    /* bit 0: a command is running */
+#define GENI_SER_M_CLK_CFG      (se + 0x048)    /* bit 0 enable, [15:4] divider */
+#define GENI_IF_DISABLE_RO      (se + 0x064)    /* bit 0: no FIFO interface */
+#define GENI_FW_REVISION_RO     (se + 0x068)    /* [15:8] protocol: 1 = SPI */
+#define GENI_CLK_SEL            (se + 0x07c)
+#define SPI_CPHA                (se + 0x224)
+#define SPI_LOOPBACK            (se + 0x22c)
+#define SPI_CPOL                (se + 0x230)
+#define SPI_DEMUX_OUTPUT_INV    (se + 0x24c)
+#define SPI_DEMUX_SEL           (se + 0x250)
+#define GENI_BYTE_GRAN          (se + 0x254)
+#define GENI_DMA_MODE_EN        (se + 0x258)
+#define SPI_TRANS_CFG           (se + 0x25c)
+#define GENI_TX_PACKING_CFG0    (se + 0x260)
+#define GENI_TX_PACKING_CFG1    (se + 0x264)
+#define SPI_WORD_LEN            (se + 0x268)
+#define SPI_TX_TRANS_LEN        (se + 0x26c)
+#define SPI_RX_TRANS_LEN        (se + 0x270)
+#define SPI_DELAY_COUNTERS      (se + 0x278)
+#define GENI_RX_PACKING_CFG0    (se + 0x284)
+#define GENI_RX_PACKING_CFG1    (se + 0x288)
+#define GENI_M_CMD0             (se + 0x600)    /* [31:27] operation */
+#define GENI_M_CMD_CTRL         (se + 0x604)    /* bit 2 cancel, bit 1 abort */
+#define GENI_M_IRQ_STATUS       (se + 0x610)
+#define GENI_M_IRQ_EN           (se + 0x614)
+#define GENI_M_IRQ_CLEAR        (se + 0x618)
+#define GENI_S_IRQ_CLEAR        (se + 0x648)
+#define GENI_TX_FIFO            (se + 0x700)
+#define GENI_RX_FIFO            (se + 0x780)
+#define GENI_TX_FIFO_STATUS     (se + 0x800)    /* [27:0] words */
+#define GENI_RX_FIFO_STATUS     (se + 0x804)    /* bit 31 last, [30:28] bytes of the last word, [24:0] words */
+#define GENI_TX_WATERMARK       (se + 0x80c)
+#define GENI_RX_WATERMARK       (se + 0x810)
+#define GENI_RX_RFR_WATERMARK   (se + 0x814)
+#define SE_DMA_TX_IRQ_CLR       (se + 0xc44)
+#define SE_DMA_RX_IRQ_CLR       (se + 0xd44)
+#define SE_GSI_EVENT_EN         (se + 0xe18)
+#define SE_IRQ_EN               (se + 0xe1c)
+#define SE_HW_PARAM_0           (se + 0xe24)    /* [21:16] FIFO depth in words */
+#define SE_DMA_GENERAL_CFG      (se + 0xe30)
+
+#define M_CMD_DONE              (1u << 0)
+#define M_CMD_CANCEL            (1u << 4)
+#define M_CMD_ABORT             (1u << 5)
+#define M_ERRORS                ((1u << 1) | (1u << 2) | (1u << 3) | (1u << 24) | (1u << 25) | (1u << 28) | (1u << 29))
+#define SPI_FULL_DUPLEX         (3u << 27)
+
+static uint32_t fifo_depth;
+
+/* 0 = ready; otherwise why the engine cannot be used */
+static const char *
+geni_spi_init(uint32_t hz)
+{
+	uint32_t divider;
+
+	if ((rd(GENI_FW_REVISION_RO) >> 8 & 0xff) != 1) {
+		return "the serial engine has no SPI firmware";
+	}
+	if (rd(GENI_IF_DISABLE_RO) & 1) {
+		return "the serial engine's FIFO interface is disabled";
+	}
+	fifo_depth = rd(SE_HW_PARAM_0) >> 16 & 0x3f;
+	if (fifo_depth < 4) {
+		return "the serial engine reports no FIFO";
+	}
+	wr(SE_GSI_EVENT_EN, 0);
+	wr(GENI_M_IRQ_CLEAR, 0xffffffff);
+	wr(GENI_S_IRQ_CLEAR, 0xffffffff);
+	wr(SE_DMA_TX_IRQ_CLR, 0xffffffff);
+	wr(SE_DMA_RX_IRQ_CLR, 0xffffffff);
+	wr(GENI_CGC_CTRL, rd(GENI_CGC_CTRL) | 0x7f);
+	wr(SE_DMA_GENERAL_CFG, rd(SE_DMA_GENERAL_CFG) | 0xf);
+	wr(GENI_OUTPUT_CTRL, 0x7f);
+	wr(GENI_FORCE_DEFAULT, 1);
+	wr(GENI_DMA_MODE_EN, rd(GENI_DMA_MODE_EN) & ~1u);
+	wr(GENI_RX_WATERMARK, fifo_depth - 3);
+	wr(GENI_RX_RFR_WATERMARK, fifo_depth - 2);
+	wr(GENI_TX_WATERMARK, 0);
+	/* the status bits we poll follow these enables; the interrupt itself stays masked at the GIC */
+	wr(SE_IRQ_EN, rd(SE_IRQ_EN) | 0xf);
+	wr(GENI_M_IRQ_EN, rd(GENI_M_IRQ_EN) | 0x7fc0007f);
+
+	/* mode 0, chip select 0, 8 bits, most significant first, four bytes in a FIFO word */
+	wr(SPI_LOOPBACK, 0);
+	wr(SPI_DEMUX_SEL, 0);
+	wr(SPI_CPHA, 0);
+	wr(SPI_CPOL, 0);
+	wr(SPI_DEMUX_OUTPUT_INV, 0);
+	wr(SPI_TRANS_CFG, rd(SPI_TRANS_CFG) & ~2u);
+	wr(SPI_DELAY_COUNTERS, 0);
+	wr(GENI_TX_PACKING_CFG0, 0x0007f8fe);
+	wr(GENI_TX_PACKING_CFG1, 0x000ffefe);
+	wr(GENI_RX_PACKING_CFG0, 0x0007f8fe);
+	wr(GENI_RX_PACKING_CFG1, 0x000ffefe);
+	wr(GENI_BYTE_GRAN, 0);
+	wr(SPI_WORD_LEN, 8 - 4);
+
+	divider = (se_source_hz + hz - 1) / hz;
+	wr(GENI_CLK_SEL, se_clock_select & 7);
+	wr(GENI_SER_M_CLK_CFG, (divider ? divider : 1) << 4 | 1);
+	return NULL;
+}
+
+static void
+geni_drain(uint8_t *rx, uint32_t length, uint32_t *received)
+{
+	uint32_t status = rd(GENI_RX_FIFO_STATUS), words = status & 0x01ffffff, bytes = words * 4;
+
+	if (status & 0x80000000u) {
+		uint32_t valid = status >> 28 & 7;
+
+		if (valid && valid < 4) {
+			bytes -= 4 - valid;
+		}
+	}
+	for (uint32_t i = 0; i < words; i++) {
+		uint32_t word = rd(GENI_RX_FIFO);
+
+		for (int j = 0; j < 4 && bytes; j++, bytes--) {
+			if (*received < length) {
+				if (rx) {
+					rx[*received] = (uint8_t)(word >> (8 * j));
+				}
+				(*received)++;
+			}
+		}
+	}
+}
+
+static void
+geni_recover(void)
+{
+	wr(GENI_M_CMD_CTRL, 1u << 2);
+	for (int i = 0; i < 2000 && !(rd(GENI_M_IRQ_STATUS) & M_CMD_CANCEL); i++) {
+		sleep_us(100);
+	}
+	if (!(rd(GENI_M_IRQ_STATUS) & M_CMD_CANCEL)) {
+		wr(GENI_M_CMD_CTRL, 1u << 1);
+		for (int i = 0; i < 2000 && !(rd(GENI_M_IRQ_STATUS) & M_CMD_ABORT); i++) {
+			sleep_us(100);
+		}
+	}
+	for (int i = 0; i < 64 && (rd(GENI_RX_FIFO_STATUS) & 0x01ffffff); i++) {
+		(void)rd(GENI_RX_FIFO);
+	}
+	wr(GENI_M_IRQ_CLEAR, 0xffffffff);
+}
+
+/* One transfer with the chip selected throughout: `length` bytes out (zeros without tx) and as many in. */
+static bool
+geni_transfer(const uint8_t *tx, uint8_t *rx, uint32_t length)
+{
+	static unsigned complaints;
+	uint32_t sent = 0, received = 0, status = 0;
+	uint64_t deadline;
+
+	for (int i = 0; rd(GENI_STATUS) & 1; i++) {
+		if (i > 2000) {
+			geni_recover();
+			break;
+		}
+		sleep_us(100);
+	}
+	wr(GENI_M_IRQ_CLEAR, 0xffffffff);
+	wr(SPI_TX_TRANS_LEN, length);
+	wr(SPI_RX_TRANS_LEN, length);
+	wr(GENI_M_CMD0, SPI_FULL_DUPLEX);
+	clock_interval_to_deadline(200, NSEC_PER_MSEC, &deadline);
+	while (mach_absolute_time() < deadline) {
+		while (sent < length && (rd(GENI_TX_FIFO_STATUS) & 0x0fffffff) + 1 < fifo_depth) {
+			uint32_t word = 0;
+
+			for (int j = 0; j < 4 && sent < length; j++, sent++) {
+				word |= (uint32_t)(tx ? tx[sent] : 0) << (8 * j);
+			}
+			wr(GENI_TX_FIFO, word);
+		}
+		status = rd(GENI_M_IRQ_STATUS);
+		geni_drain(rx, length, &received);
+		if (status & M_ERRORS) {
+			break;
+		}
+		if (status & M_CMD_DONE) {
+			geni_drain(rx, length, &received);
+			wr(GENI_M_IRQ_CLEAR, status);
+			if (received == length) {
+				return true;
+			}
+			break;
+		}
+	}
+	if (complaints++ < 8) {
+		printf("goodix: SPI transfer of %u bytes failed: status %#x, sent %u, received %u\n", length, status, sent,
+		    received);
+	}
+	geni_recover();
+	return false;
+}
+
+/* ---- SPI by hand, on the same pins ----------------------------------------------------------------- */
+
+static unsigned bitbang_in = PIN_MISO, bitbang_out = PIN_MOSI;
+
+static void
+bitbang_init(void)
+{
+	gpio_output(PIN_CS, true, PULL_NONE, 6);
+	gpio_output(PIN_CLK, false, PULL_NONE, 6);
+	gpio_output(bitbang_out, false, PULL_NONE, 6);
+	gpio_configure(bitbang_in, 0, PULL_NONE, 2, false);
+}
+
+static bool
+bitbang_transfer(const uint8_t *tx, uint8_t *rx, uint32_t length)
+{
+	gpio_set(PIN_CS, false);
+	for (uint32_t i = 0; i < length; i++) {
+		uint8_t out = tx ? tx[i] : 0, in = 0;
+
+		for (int bit = 7; bit >= 0; bit--) {
+			gpio_set(bitbang_out, out >> bit & 1);
+			gpio_set(PIN_CLK, true);
+			in = (uint8_t)(in << 1 | gpio_get(bitbang_in));
+			gpio_set(PIN_CLK, false);
+		}
+		if (rx) {
+			rx[i] = in;
+		}
+	}
+	gpio_set(PIN_CS, true);
+	return true;
+}
+
+static bool (*spi_transfer)(const uint8_t *tx, uint8_t *rx, uint32_t length);
+
+/* ---- the Goodix chip ------------------------------------------------------------------------------- */
+
+#define GOODIX_FW_VERSION       0x10014         /* 28 bytes */
+#define GOODIX_IC_INFO          0x10070         /* a 16-bit length, then that many bytes */
+#define GOODIX_MAX_READ         1024
+#define GOODIX_MAX_TOUCHES      10
+#define GOODIX_STATUS_TOUCH     0x80
+#define GOODIX_STATUS_REQUEST   0x40
+#define GOODIX_REQUEST_RESET    3
+
+static uint8_t spi_tx[8 + GOODIX_MAX_READ], spi_rx[8 + GOODIX_MAX_READ];
+static uint32_t touch_address, command_address;
+static const char *report_rate = "240";        /* what the status line says (touch_rate=480) */
+static uint32_t max_x = 10800, max_y = 24000;   /* the device tree's; the chip may say otherwise */
+
+static bool
+goodix_read(uint32_t address, uint8_t *data, uint32_t length)
+{
+	if (length > GOODIX_MAX_READ) {
+		return false;
+	}
+	spi_tx[0] = 0xf1;
+	spi_tx[1] = (uint8_t)(address >> 24);
+	spi_tx[2] = (uint8_t)(address >> 16);
+	spi_tx[3] = (uint8_t)(address >> 8);
+	spi_tx[4] = (uint8_t)address;
+	spi_tx[5] = spi_tx[6] = spi_tx[7] = 0xff;
+	memset(spi_tx + 8, 0, length);
+	if (!spi_transfer(spi_tx, spi_rx, 8 + length)) {
+		return false;
+	}
+	memcpy(data, spi_rx + 8, length);
+	return true;
+}
+
+static bool
+goodix_write(uint32_t address, const uint8_t *data, uint32_t length)
+{
+	if (length > GOODIX_MAX_READ) {
+		return false;
+	}
+	spi_tx[0] = 0xf0;
+	spi_tx[1] = (uint8_t)(address >> 24);
+	spi_tx[2] = (uint8_t)(address >> 16);
+	spi_tx[3] = (uint8_t)(address >> 8);
+	spi_tx[4] = (uint8_t)address;
+	memcpy(spi_tx + 5, data, length);
+	return spi_transfer(spi_tx, NULL, 5 + length);
+}
+
+/* The chip's blocks end in the 16-bit sum of their bytes; all zeros or all ones is no answer at all. */
+static bool
+goodix_checksum_ok(const uint8_t *data, uint32_t length)
+{
+	uint32_t sum = 0;
+	bool blank = true;
+
+	if (length < 2) {
+		return false;
+	}
+	for (uint32_t i = 0; i < length - 2; i++) {
+		sum += data[i];
+		blank &= data[i] == 0 || data[i] == 0xff;
+	}
+	return !blank && (uint16_t)sum == (uint16_t)(data[length - 2] | data[length - 1] << 8);
+}
+
+static uint16_t
+le16(const uint8_t *p)
+{
+	return (uint16_t)(p[0] | p[1] << 8);
+}
+
+static uint32_t
+le32(const uint8_t *p)
+{
+	return p[0] | p[1] << 8 | p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static void
+touch_reset(void)
+{
+	gpio_set(PIN_RESET, false);
+	sleep_ms(2);
+	gpio_set(PIN_RESET, true);
+	sleep_ms(100);
+}
+
+/* Is the chip there and running its firmware? Finds where it keeps the touch report. */
+static bool
+goodix_probe(bool verbose)
+{
+	static uint8_t info[GOODIX_MAX_READ];
+	uint8_t version[28];
+	uint32_t length, offset;
+
+	if (!goodix_read(GOODIX_FW_VERSION, version, sizeof(version))) {
+		return false;
+	}
+	if (!goodix_checksum_ok(version, sizeof(version))) {
+		if (verbose) {
+			printf("goodix: no valid firmware version: %02x %02x %02x %02x %02x %02x %02x %02x ... %02x %02x\n",
+			    version[0], version[1], version[2], version[3], version[4], version[5], version[6], version[7],
+			    version[26], version[27]);
+		}
+		return false;
+	}
+	printf("goodix: chip \"%.6s\", firmware \"%.8s\" %02x.%02x.%02x.%02x, sensor %u\n", (const char *)version,
+	    (const char *)version + 10, version[18], version[19], version[20], version[21], version[23]);
+
+	if (!goodix_read(GOODIX_IC_INFO, info, 2)) {
+		return false;
+	}
+	length = le16(info);
+	if (length < 40 || length >= GOODIX_MAX_READ || !goodix_read(GOODIX_IC_INFO, info, length) ||
+	    !goodix_checksum_ok(info, length)) {
+		printf("goodix: bad chip description (length %u)\n", length);
+		return false;
+	}
+	/* the length, the version (16 bytes), the features (10), four counts, then five lists of 16-bit numbers */
+	offset = 2 + 16 + 10 + 4;
+	for (int i = 0; i < 5; i++) {
+		if (offset >= length) {
+			return false;
+		}
+		offset += 1 + 2u * info[offset];
+	}
+	if (offset + 48 + 2 > length) {
+		printf("goodix: chip description too short (%u, lists end at %u)\n", length, offset);
+		return false;
+	}
+	touch_address = le32(info + offset + 44);
+	command_address = le32(info + offset + 0);      /* (the "misc" part: the command buffer comes first) */
+	if (offset + 122 + 20 + 2 <= length) {
+		uint16_t x = le16(info + offset + 122 + 16), y = le16(info + offset + 122 + 18);
+
+		if (x && y) {
+			max_x = x;
+			max_y = y;
+		}
+	}
+	printf("goodix: touch report at %#x, coordinates up to %u x %u\n", touch_address, max_x, max_y);
+	return touch_address != 0;
+}
+
+/*
+ * A command to the chip (Android's brl_send_cmd(): goodix_brl_hw.c of the phone's kernel): sixteen
+ * bytes at the command address -- state, acknowledgement, length, command, its data, and the sum of
+ * the bytes from the length on -- then the acknowledgement looked for, 0x80 when done.
+ */
+#define GOODIX_CMD_HIGH_RATE    0xc0            /* data 1: report 480 times a second instead of 240 (Xiaomi's game mode) */
+#define GOODIX_ACK_OK           0x80
+#define GOODIX_ACK_BUSY         0x02
+
+static bool
+goodix_command(uint8_t command, uint8_t data)
+{
+	uint8_t buffer[16], answer[16];
+	uint32_t sum;
+
+	if (command_address == 0) {
+		return false;
+	}
+	memset(buffer, 0, sizeof(buffer));
+	buffer[2] = 5;
+	buffer[3] = command;
+	buffer[4] = data;
+	sum = buffer[2] + buffer[3] + buffer[4];
+	buffer[5] = (uint8_t)sum;
+	buffer[6] = (uint8_t)(sum >> 8);
+	for (int attempt = 0; attempt < 6; attempt++) {
+		if (!goodix_write(command_address, buffer, sizeof(buffer))) {
+			return false;
+		}
+		for (int look = 0; look < 6; look++) {
+			if (!goodix_read(command_address, answer, sizeof(answer))) {
+				return false;
+			}
+			if (answer[1] == GOODIX_ACK_OK) {
+				return true;
+			}
+			sleep_ms(1);
+			if (answer[1] != GOODIX_ACK_BUSY && answer[1] != 0) {
+				break;
+			}
+		}
+	}
+	return false;
+}
+
+/* What has been seen so far: said once a minute, so that the end of the log always tells. */
+static struct {
+	uint32_t polls, reports, touches, bad, last_x, last_y;
+} seen;
+
+/* Which fingers were down in the last report, and where. */
+static struct {
+	bool down, seen;
+	uint32_t x, y;
+} contact[GOODIX_MAX_TOUCHES];
+static uint32_t flip;           /* boot-arg touch_flip: 1 = mirror left-right, 2 = mirror top-bottom */
+
+static void
+goodix_report(const uint8_t *touches, uint32_t count)
+{
+	static unsigned shown;
+
+	for (int i = 0; i < GOODIX_MAX_TOUCHES; i++) {
+		contact[i].seen = false;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		const uint8_t *t = touches + 8 * i;
+		uint32_t id = t[0] >> 4, kind = t[0] & 0xf;
+		uint32_t x = le16(t + 2), y = le16(t + 4);
+
+		if (id >= GOODIX_MAX_TOUCHES || kind == 1 || kind == 3) {       /* 1 and 3: a stylus */
+			continue;
+		}
+		if (shown < 40) {
+			shown++;
+			printf("goodix: finger %u at %u, %u (of %u x %u)\n", id, x, y, max_x, max_y);
+		}
+		seen.touches++;
+		seen.last_x = x;
+		seen.last_y = y;
+		x = x >= max_x ? 65535 : x * 65535 / max_x;
+		y = y >= max_y ? 65535 : y * 65535 / max_y;
+		if (flip & 1) {
+			x = 65535 - x;
+		}
+		if (flip & 2) {
+			y = 65535 - y;
+		}
+		contact[id].seen = true;
+		if (!contact[id].down) {
+			hakios_touch_post(HAKIOS_TOUCH_DOWN, id, x, y);
+		} else if (contact[id].x != x || contact[id].y != y) {
+			hakios_touch_post(HAKIOS_TOUCH_MOVE, id, x, y);
+		}
+		contact[id].down = true;
+		contact[id].x = x;
+		contact[id].y = y;
+	}
+	/* a finger that is no longer in the report has lifted */
+	for (uint32_t id = 0; id < GOODIX_MAX_TOUCHES; id++) {
+		if (contact[id].down && !contact[id].seen) {
+			contact[id].down = false;
+			hakios_touch_post(HAKIOS_TOUCH_UP, id, contact[id].x, contact[id].y);
+		}
+	}
+}
+
+/* Read the report if there is one, and tell the chip it has been read. */
+static void
+goodix_poll(void)
+{
+	static uint8_t report[8 + 8 * GOODIX_MAX_TOUCHES + 2];
+	static unsigned bad;
+	const uint8_t zero = 0;
+	const uint32_t first = 8 + 8 * 2 + 2;           /* the header and two fingers: all there is, most of the time */
+	uint32_t count;
+
+	seen.polls++;
+	if (!goodix_read(touch_address, report, first) || report[0] == 0) {
+		return;
+	}
+	seen.reports++;
+	count = report[2] & 0xf;
+	if ((report[0] & GOODIX_STATUS_TOUCH) && count > 2 && count <= GOODIX_MAX_TOUCHES &&
+	    !goodix_read(touch_address + 8, report + 8, 8 * count + 2)) {
+		return;
+	}
+	goodix_write(touch_address, &zero, 1);
+	if (!goodix_checksum_ok(report, 8)) {
+		seen.bad++;
+		if (bad++ < 8) {
+			printf("goodix: bad report header: %02x %02x %02x %02x %02x %02x %02x %02x\n", report[0], report[1],
+			    report[2], report[3], report[4], report[5], report[6], report[7]);
+		}
+		return;
+	}
+	if (report[0] & GOODIX_STATUS_REQUEST) {
+		if ((report[2] & 0xf) == GOODIX_REQUEST_RESET || report[2] == GOODIX_REQUEST_RESET) {
+			printf("goodix: the chip asks to be reset\n");
+			touch_reset();
+		}
+		return;
+	}
+	if (!(report[0] & GOODIX_STATUS_TOUCH)) {
+		return;
+	}
+	if (count > GOODIX_MAX_TOUCHES || (count && !goodix_checksum_ok(report + 8, count * 8 + 2))) {
+		seen.bad++;
+		if (bad++ < 8) {
+			printf("goodix: bad report (%u touches)\n", count);
+		}
+		return;
+	}
+	goodix_report(report + 8, count);
+}
+
+/* ---- the FocalTech FT3680 chip --------------------------------------------------------------------- */
+
+/*
+ * FTS 5.x SPI framing from sm8350-kernel-OKX drivers/input/touchscreen/focaltech_3680/
+ * focaltech_spi.c (verbatim):
+ *   TX[0] = register address (writebuf[0] / cmd[0])
+ *   TX[1] = FOCALTECH_READ_CTRL (0xA0 = READ_CMD, CRC_EN set) or FOCALTECH_WRITE_CTRL (0x00)
+ *   TX[2..3] = data length BE (for read: datalen; for write: writelen - 1)
+ *   TX[4..6] = three dummy bytes (SPI_DUMMY_BYTE)
+ *   TX[7..7+len-1] = write data (empty on read; chip drives MISO here)
+ *   TX[last-1..last] = CRC-16/Kermit of the data bytes, little-endian (only when READ_CMD or
+ *                     when a vendor WRITE op needs CRC; vendor WRITE_CMD = 0x00 has no CRC)
+ * SPI_HEADER_LENGTH = 4 + SPI_DUMMY_BYTE = 7.
+ */
+#define FOCALTECH_READ_CTRL         0xa0		/* READ_CMD = 0x80 | DATA_CRC_EN(0x20) */
+#define FOCALTECH_WRITE_CTRL        0x00		/* WRITE_CMD, no CRC on TX */
+#define FOCALTECH_CHIP_ID_H         0xa3
+#define FOCALTECH_CHIP_ID_L         0x9f
+#define FOCALTECH_TOUCH_DATA        0x01		/* the touch report lives at this address */
+#define FOCALTECH_MAX_TOUCHES       10
+#define FOCALTECH_TOUCH_REPORT_LEN  (2 + 6 * FOCALTECH_MAX_TOUCHES)
+#define FOCALTECH_MAX_TRANSFER      (7 + FOCALTECH_TOUCH_REPORT_LEN + 2)
+
+static uint8_t focaltech_tx[FOCALTECH_MAX_TRANSFER], focaltech_rx[FOCALTECH_MAX_TRANSFER];
+
+/* CRC-16/Kermit (polynomial 0x8408 reflected, initial 0xffff) -- same as vendor rckit_crc16(). */
+static uint16_t
+focaltech_crc(const uint8_t *data, uint32_t length)
+{
+	uint16_t crc = 0xffff;
+
+	for (uint32_t i = 0; i < length; i++) {
+		crc ^= data[i];
+		for (int bit = 0; bit < 8; bit++) {
+			crc = (crc & 1) ? (uint16_t)((crc >> 1) ^ 0x8408) : (uint16_t)(crc >> 1);
+		}
+	}
+	return crc;
+}
+
+static bool
+focaltech_read(uint8_t address, uint8_t *data, uint32_t length)
+{
+	const uint32_t data_offset = 7;
+	uint32_t transfer_length = data_offset + length + 2;
+
+	if (length == 0 || transfer_length > sizeof(focaltech_tx)) {
+		return false;
+	}
+	for (int attempt = 0; attempt < 3; attempt++) {
+		memset(focaltech_tx, 0, transfer_length);
+		memset(focaltech_rx, 0, transfer_length);
+		focaltech_tx[0] = address;		/* vendor: TX[0] = cmd[0] = reg address */
+		focaltech_tx[1] = FOCALTECH_READ_CTRL;	/* vendor: TX[1] = ctrl = 0xA0 */
+		focaltech_tx[2] = (uint8_t)(length >> 8);
+		focaltech_tx[3] = (uint8_t)length;
+		if (!spi_transfer(focaltech_tx, focaltech_rx, transfer_length)) {
+			sleep_us(150);
+			continue;
+		}
+		/* vendor: bit 7 of status (rx[3]) is BUSY, bit 5 is CRC error */
+		if (!(focaltech_rx[3] & 0xa0)) {
+			uint16_t expected = focaltech_crc(focaltech_rx + data_offset, length);
+			uint16_t received = (uint16_t)(focaltech_rx[data_offset + length] |
+			    focaltech_rx[data_offset + length + 1] << 8);
+			if (expected == received) {
+				memcpy(data, focaltech_rx + data_offset, length);
+				sleep_us(150);		/* minimum CS-high time in the vendor driver */
+				return true;
+			}
+		}
+		sleep_us(150);
+	}
+	return false;
+}
+
+/*
+ * Vendor fts_write: no CRC on TX. For a 1-byte "command" (length == 0) the frame is just the
+ * four header bytes { addr, 0x00, 0x00, 0x00 } with no dummy and no data. For length > 0 the
+ * three dummy bytes precede the data: { addr, 0x00, lenH, lenL, 0, 0, 0, data... }. The chip
+ * drives the "status" byte on rx[3] -- bits 7 and 5 set mean busy or CRC error (vendor retries
+ * SPI_RETRY_NUMBER = 3 times on failure before giving up).
+ */
+static bool
+focaltech_write(uint8_t address, const uint8_t *data, uint32_t length)
+{
+	uint32_t transfer_length;
+
+	if (length == 0) {
+		transfer_length = 4;
+	} else {
+		transfer_length = 7 + length;
+	}
+	if (transfer_length > sizeof(focaltech_tx)) {
+		return false;
+	}
+	memset(focaltech_tx, 0, transfer_length);
+	focaltech_tx[0] = address;
+	focaltech_tx[1] = FOCALTECH_WRITE_CTRL;
+	focaltech_tx[2] = (uint8_t)(length >> 8);
+	focaltech_tx[3] = (uint8_t)length;
+	if (data && length > 0) {
+		memcpy(focaltech_tx + 7, data, length);
+	}
+	for (int attempt = 0; attempt < 3; attempt++) {
+		if (spi_transfer(focaltech_tx, focaltech_rx, transfer_length) &&
+		    !(focaltech_rx[3] & 0xa0)) {
+			sleep_us(150);
+			return true;
+		}
+		sleep_us(150);
+	}
+	return false;
+}
+
+/*
+ * Vendor fts_fwupg_get_boot_state() reads the chip's "boot ID" via the FT boot-ROM protocol:
+ *   TX = { 0x55, 0xAA }                 (FTS_CMD_START1, FTS_CMD_START2 -- enter boot)
+ *   wait FTS_CMD_START_DELAY = 12 ms
+ *   TX = { 0x90 }, RX = 2 bytes         (FTS_CMD_READ_ID, incell cmd length)
+ * If the two RX bytes are the chip's boot ID (0x56 0x62 for FT3680), firmware is present and
+ * valid in flash but has not yet been started; the host must issue FTS_CMD_FIRMWARE_START
+ * (0x08) to make the boot ROM jump to it.
+ */
+#define FTS_CMD_START1              0x55
+#define FTS_CMD_START2              0xaa
+#define FTS_CMD_START_DELAY         12		/* ms, between enter-boot and first command */
+#define FTS_CMD_READ_BOOT_ID        0x90
+
+/* Boot-ROM commands for firmware (pramboot) upload, from focaltech_3658u/focaltech_flash.h. */
+#define FTS_ROMBOOT_CMD_SET_PRAM_ADDR   0xad
+#define FTS_ROMBOOT_CMD_WRITE           0xae
+#define FTS_ROMBOOT_CMD_START_APP       0x08
+#define FTS_FLASH_PACKET_LENGTH         32		/* bytes per PRAM write */
+
+#include "hakios.focaltech_fw.h"
+
+/*
+ * Vendor fts_read_bootid(): send { 0x55, 0xAA } as a 2-byte framed write (treated as a write of
+ * one data byte 0xAA to register 0x55), wait 12 ms, then do a framed read of 2 bytes at
+ * register 0x90. The chip answers with its ROM ID (0x56 0x62 for FT3680) if it is sitting in
+ * the boot ROM waiting for a firmware download.
+ */
+static bool
+focaltech_read_boot_id(uint8_t *high, uint8_t *low)
+{
+	uint8_t aa = FTS_CMD_START2;
+	uint8_t out[2] = { 0 };
+	bool ok;
+
+	if (!focaltech_write(FTS_CMD_START1, &aa, 1)) {
+		return false;
+	}
+	sleep_ms(12);			/* FTS_CMD_START_DELAY */
+	ok = focaltech_read(FTS_CMD_READ_BOOT_ID, out, 2);
+	*high = out[0];
+	*low  = out[1];
+	return ok;
+}
+
+/* Vendor fts_wait_tp_to_valid: poll chip ID for up to TIMEOUT_READ_REG (1 s) at 200 ms steps. */
+static bool
+focaltech_wait_valid(uint8_t *high, uint8_t *low)
+{
+	for (int attempt = 0; attempt < 5; attempt++) {
+		if (focaltech_read(FOCALTECH_CHIP_ID_H, high, 1) &&
+		    focaltech_read(FOCALTECH_CHIP_ID_L, low, 1) &&
+		    *high == 0x56 && *low == 0x62) {
+			printf("focaltech: FT3680 runtime ID valid after %d attempt(s)\n", attempt + 1);
+			return true;
+		}
+		sleep_ms(200);			/* vendor INTERVAL_READ_REG */
+	}
+	return false;
+}
+
+/*
+ * Reset the chip and send 0x55/0xAA to put it in boot ROM, as vendor fts_get_ic_information
+ * does. Try up to 3 times with escalating settle delays (12, 20, 28 ms). Returns true if the
+ * chip is sitting in its boot ROM, with { 0x56, 0x62 } read back from the boot-ID register.
+ */
+static bool
+focaltech_enter_boot_rom(void)
+{
+	uint8_t boot_high = 0, boot_low = 0;
+
+	for (int cnt = 0; cnt < 3; cnt++) {
+		gpio_set(PIN_RESET, false);
+		sleep_ms(1);
+		gpio_set(PIN_RESET, true);
+		sleep_ms(FTS_CMD_START_DELAY + cnt * 8);
+		if (focaltech_read_boot_id(&boot_high, &boot_low) &&
+		    boot_high == 0x56 && boot_low == 0x62) {
+			printf("focaltech: in boot ROM after reset %d\n", cnt);
+			return true;
+		}
+		printf("focaltech: boot ID attempt %d: %02x %02x (not 56 62)\n", cnt, boot_high, boot_low);
+	}
+	return false;
+}
+
+/*
+ * Download the embedded firmware (pramboot + application) into the chip's PRAM via the boot
+ * ROM's SPI_V2 upload protocol. Each 32-byte packet is sent as two framed writes: first set
+ * the PRAM destination address (SET_PRAM_ADDR + 3 BE address bytes), then WRITE + data bytes.
+ */
+static bool
+focaltech_write_pram(const uint8_t *buf, uint32_t len)
+{
+	uint8_t addr_bytes[3];
+
+	for (uint32_t offset = 0; offset < len; offset += FTS_FLASH_PACKET_LENGTH) {
+		uint32_t chunk = FTS_FLASH_PACKET_LENGTH;
+		if (offset + chunk > len) {
+			chunk = len - offset;
+		}
+		addr_bytes[0] = (uint8_t)(offset >> 16);
+		addr_bytes[1] = (uint8_t)(offset >> 8);
+		addr_bytes[2] = (uint8_t)offset;
+		if (!focaltech_write(FTS_ROMBOOT_CMD_SET_PRAM_ADDR, addr_bytes, 3)) {
+			printf("focaltech: PRAM address write failed at offset %u\n", offset);
+			return false;
+		}
+		if (!focaltech_write(FTS_ROMBOOT_CMD_WRITE, buf + offset, chunk)) {
+			printf("focaltech: PRAM data write failed at offset %u\n", offset);
+			return false;
+		}
+	}
+	return true;
+}
+
+static bool
+focaltech_start_app(void)
+{
+	uint8_t cmd = FTS_ROMBOOT_CMD_START_APP;
+
+	return focaltech_write(cmd, NULL, 0);
+}
+
+/*
+ * Full chip bring-up: look for an already-running firmware; if none, reset to boot ROM and
+ * download the embedded firmware into PRAM; then start it and wait for runtime to come up.
+ */
+static bool
+focaltech_probe(bool verbose)
+{
+	uint8_t high = 0, low = 0;
+
+	/* Maybe firmware is already running (previous session, warm boot). */
+	if (focaltech_wait_valid(&high, &low)) {
+		return true;
+	}
+
+	if (!focaltech_enter_boot_rom()) {
+		if (verbose) {
+			printf("focaltech: chip not in boot ROM; last read runtime %02x %02x\n", high, low);
+		}
+		return false;
+	}
+
+	printf("focaltech: downloading %u bytes of firmware to PRAM...\n", FOCALTECH_FW_LENGTH);
+	if (!focaltech_write_pram(focaltech_fw, FOCALTECH_FW_LENGTH)) {
+		printf("focaltech: PRAM download failed\n");
+		return false;
+	}
+	printf("focaltech: PRAM download complete; starting application\n");
+	if (!focaltech_start_app()) {
+		printf("focaltech: start-app command failed\n");
+		return false;
+	}
+	sleep_ms(300);			/* firmware needs time to initialize all peripherals */
+
+	if (focaltech_wait_valid(&high, &low)) {
+		return true;
+	}
+	if (verbose) {
+		printf("focaltech: firmware did not come up (last runtime read %02x %02x)\n", high, low);
+	}
+	return false;
+}
+
+/* ---- FocalTech touch reports --------------------------------------------------------------------- */
+
+/*
+ * Per-chip report layout for FT3680 (vendor focaltech_core.c, FTS_TOUCH_OFF_* offsets):
+ *   report[0] = gesture (0 outside gesture mode)
+ *   report[1] = (chip_type << 4) | finger_count
+ *   report[2 + 6*i + 0] = E_XH:  bits 7..6 = event (0 = down, 1 = up, 2 = contact)
+ *                                bits 3..0 = x bits 14..11
+ *   report[2 + 6*i + 1] = XL:    x bits 10..3
+ *   report[2 + 6*i + 2] = ID_YH: bits 7..4 = finger id, bits 3..0 = y bits 14..11
+ *   report[2 + 6*i + 3] = YL:    y bits 10..3
+ *   report[2 + 6*i + 4] = PRE:   bits 7..5 = x bits 2..0, bits 4..2 = y bits 2..0
+ *                                (also the pressure byte -- the lowest bits of each 15-bit axis
+ *                                 are packed in with it)
+ *   report[2 + 6*i + 5] = AREA:  touch area / major
+ * Coordinates are 15-bit "super-high resolution" sub-pixel values; the touch panel's actual
+ * extent is reported through the device tree as x_max/y_max (10800 x 24000 for redwood).
+ */
+#define FOCALTECH_EVENT_DOWN        0
+#define FOCALTECH_EVENT_UP          1
+#define FOCALTECH_EVENT_CONTACT     2
+
+static struct {
+	bool down, seen;
+	uint32_t x, y;
+} focaltech_contact[FOCALTECH_MAX_TOUCHES];
+
+static void
+focaltech_contact_update(uint32_t id, uint32_t event, uint32_t x, uint32_t y,
+    uint32_t max_report_x, uint32_t max_report_y)
+{
+	static unsigned shown;
+
+	if (id >= FOCALTECH_MAX_TOUCHES || max_report_x == 0 || max_report_y == 0) {
+		return;
+	}
+	if (event == FOCALTECH_EVENT_UP) {
+		focaltech_contact[id].seen = true;
+		if (focaltech_contact[id].down) {
+			focaltech_contact[id].down = false;
+			hakios_touch_post(HAKIOS_TOUCH_UP, id, focaltech_contact[id].x, focaltech_contact[id].y);
+		}
+		return;
+	}
+	seen.touches++;
+	switch (flip) {
+	case 1: x = max_report_x - 1 - x; break;
+	case 2: y = max_report_y - 1 - y; break;
+	case 3: x = max_report_x - 1 - x; y = max_report_y - 1 - y; break;
+	}
+	x = (uint32_t)(((uint64_t)x * 65535) / (max_report_x - 1));
+	y = (uint32_t)(((uint64_t)y * 65535) / (max_report_y - 1));
+	seen.last_x = x;
+	seen.last_y = y;
+	focaltech_contact[id].seen = true;
+	if (!focaltech_contact[id].down) {
+		focaltech_contact[id].down = true;
+		hakios_touch_post(HAKIOS_TOUCH_DOWN, id, x, y);
+	} else if (focaltech_contact[id].x != x || focaltech_contact[id].y != y) {
+		hakios_touch_post(HAKIOS_TOUCH_MOVE, id, x, y);
+	}
+	focaltech_contact[id].x = x;
+	focaltech_contact[id].y = y;
+	if (shown++ < 8) {
+		printf("focaltech: finger %u %s at %u, %u\n", id,
+		    event == FOCALTECH_EVENT_DOWN ? "down" : "move", x, y);
+	}
+}
+
+/* Panel size in the FT3680 super-high-resolution reports (device tree x_max/y_max on redwood). */
+static uint32_t focaltech_max_x = 10800, focaltech_max_y = 24000;
+
+static void
+focaltech_report(const uint8_t *report)
+{
+	uint32_t count = report[1] & 0x0f;
+
+	for (uint32_t i = 0; i < FOCALTECH_MAX_TOUCHES; i++) {
+		focaltech_contact[i].seen = false;
+	}
+	for (uint32_t i = 0; i < FOCALTECH_MAX_TOUCHES; i++) {
+		const uint8_t *touch = report + 2 + 6 * i;
+		uint32_t id = (touch[2] >> 4) & 0x0f;
+		uint32_t event, x, y;
+
+		if (id >= FOCALTECH_MAX_TOUCHES) {
+			break;			/* no more valid slots in this report */
+		}
+		event = (touch[0] >> 6) & 0x3;
+		x = ((uint32_t)(touch[0] & 0x0f) << 11) | ((uint32_t)touch[1] << 3) |
+		    ((uint32_t)touch[4] >> 5);
+		y = ((uint32_t)(touch[2] & 0x0f) << 11) | ((uint32_t)touch[3] << 3) |
+		    (((uint32_t)touch[4] & 0x1c) >> 2);
+		focaltech_contact_update(id, event, x, y, focaltech_max_x, focaltech_max_y);
+	}
+	(void)count;
+	/* Fingers not in this report are up (vendor driver uses a bitmap; we remember explicitly). */
+	for (uint32_t i = 0; i < FOCALTECH_MAX_TOUCHES; i++) {
+		if (!focaltech_contact[i].seen && focaltech_contact[i].down) {
+			focaltech_contact[i].down = false;
+			hakios_touch_post(HAKIOS_TOUCH_UP, i, focaltech_contact[i].x, focaltech_contact[i].y);
+		}
+	}
+}
+
+static void
+focaltech_poll(void)
+{
+	static uint8_t report[FOCALTECH_TOUCH_REPORT_LEN];
+	static unsigned bad;
+
+	seen.polls++;
+	if (!focaltech_read(FOCALTECH_TOUCH_DATA, report, sizeof(report))) {
+		seen.bad++;
+		if (bad++ < 8) {
+			printf("focaltech: SPI read failed for touch report\n");
+		}
+		return;
+	}
+	seen.reports++;
+	focaltech_report(report);
+}
+
+/* Which touch chip is on this board. */
+enum touch_chip { TOUCH_GOODIX, TOUCH_FOCALTECH };
+static enum touch_chip touch_chip;
+
+static enum touch_chip
+touch_chip_detect(void)
+{
+	gpio_configure(PIN_FOCALTECH_ID, 0, PULL_NONE, 2, false);
+	gpio_configure(PIN_GOODIX_ID, 0, PULL_NONE, 2, false);
+	if (gpio_get(PIN_GOODIX_ID) && !gpio_get(PIN_FOCALTECH_ID)) {
+		return TOUCH_FOCALTECH;
+	}
+	return TOUCH_GOODIX;
+}
+
+static bool
+chip_probe(bool verbose)
+{
+	if (touch_chip == TOUCH_FOCALTECH) {
+		return focaltech_probe(verbose);
+	}
+	touch_reset();
+	return goodix_probe(verbose);
+}
+
+static void
+chip_poll(void)
+{
+	if (touch_chip == TOUCH_FOCALTECH) {
+		focaltech_poll();
+	} else {
+		goodix_poll();
+	}
+}
+
+/* ---- all of it together ---------------------------------------------------------------------------- */
+
+static void
+show_state(const char *when)
+{
+	printf("goodix: %s: votes %#x, clocks %#x %#x %#x, rate cfg %#x dfs %#x; pins cs/clk/mosi/miso cfg %#x %#x %#x %#x,"
+	    " reset %#x/%u, int %#x/%u, avdd %#x/%u, straps %u %u\n", when, rd(GCC_VOTE), rd(GCC_QUP1_M_AHB_CBCR),
+	    rd(GCC_QUP1_S_AHB_CBCR), rd(GCC_QUP1_SE5_CBCR), rd(GCC_QUP1_SE5_CFG), rd(GCC_QUP1_SE5_DFSR), rd(GPIO_CFG(PIN_CS)),
+	    rd(GPIO_CFG(PIN_CLK)), rd(GPIO_CFG(PIN_MOSI)), rd(GPIO_CFG(PIN_MISO)), rd(GPIO_CFG(PIN_RESET)),
+	    rd(GPIO_IO(PIN_RESET)), rd(GPIO_CFG(PIN_INT)), rd(GPIO_IO(PIN_INT)), rd(GPIO_CFG(PIN_AVDD)), rd(GPIO_IO(PIN_AVDD)),
+	    gpio_get(68), gpio_get(96));
+}
+
+/* Power the chip up from nothing, in the vendor driver's order. */
+static void
+power_on(void)
+{
+	gpio_output(PIN_RESET, false, PULL_UP, 8);
+	gpio_configure(PIN_INT, 0, PULL_UP, 8, false);
+	io_supply_on();
+	sleep_ms(3);
+	gpio_output(PIN_AVDD, true, PULL_NONE, 2);
+	sleep_ms(15);
+}
+
+static void
+use_engine_pins(void)
+{
+	gpio_configure(PIN_MISO, PIN_FUNCTION_SPI, PULL_NONE, 6, false);
+	gpio_configure(PIN_MOSI, PIN_FUNCTION_SPI, PULL_NONE, 6, false);
+	gpio_configure(PIN_CLK, PIN_FUNCTION_SPI, PULL_NONE, 6, false);
+	gpio_configure(PIN_CS, PIN_FUNCTION_SPI, PULL_NONE, 6, false);
+}
+
+static const char *
+chip_name(void)
+{
+	return touch_chip == TOUCH_FOCALTECH ? "focaltech" : "goodix";
+}
+
+static bool
+bring_up(void)
+{
+	const char *problem = "its clocks cannot be turned on";
+
+	show_state("as found");
+	touch_chip = touch_chip_detect();
+	printf("goodix: ID gpio96=%u gpio68=%u: selected %s\n", gpio_get(PIN_GOODIX_ID),
+	    gpio_get(PIN_FOCALTECH_ID), chip_name());
+	power_on();
+
+	if (clocks_on()) {
+		printf("goodix: serial engine: firmware %#x, interface %#x, parameters %#x, source clock %u Hz (select %u)\n",
+		    rd(GENI_FW_REVISION_RO), rd(GENI_IF_DISABLE_RO), rd(SE_HW_PARAM_0), se_source_hz, se_clock_select);
+		uint32_t spi_hz = 1000000;
+
+		/* boot-arg touch_spi_hz=N: the bus at N Hz (Android's device tree gives the chip 5 MHz) */
+		PE_parse_boot_argn("touch_spi_hz", &spi_hz, sizeof(spi_hz));
+		if (spi_hz < 100000 || spi_hz > 10000000) {
+			spi_hz = 1000000;
+		}
+		printf("goodix: the bus at %u Hz\n", spi_hz);
+		problem = geni_spi_init(spi_hz);
+	}
+	if (problem == NULL) {
+		use_engine_pins();
+		spi_transfer = geni_transfer;
+		show_state("powered, on the serial engine");
+		if (chip_probe(true)) {
+			return true;
+		}
+		printf("goodix: %s did not answer through the serial engine; trying the pins by hand\n", chip_name());
+	} else {
+		printf("goodix: %s; driving the pins by hand\n", problem);
+	}
+
+	/* by hand; which of the two data pins is the input is not written down anywhere, so try both */
+	spi_transfer = bitbang_transfer;
+	for (int attempt = 0; attempt < 2; attempt++) {
+		bitbang_in = attempt == 0 ? PIN_MISO : PIN_MOSI;
+		bitbang_out = attempt == 0 ? PIN_MOSI : PIN_MISO;
+		bitbang_init();
+		if (chip_probe(true)) {
+			printf("goodix: %s answers on pins driven by hand (data in on gpio%u)\n", chip_name(), bitbang_in);
+			return true;
+		}
+	}
+	show_state("no answer");
+	return false;
+}
+
+static uint64_t
+micros_now(void)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000;
+}
+
+static void
+goodix_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	unsigned idle = 0, idle_looks;
+	uint32_t poll_us = 8000, latency = 0, reads = 0;
+	uint64_t before = 0, reading = 0;
+
+	PE_parse_boot_argn("touch_poll_us", &poll_us, sizeof(poll_us));
+	PE_parse_boot_argn("touch_lat", &latency, sizeof(latency));
+	if (poll_us < 250 || poll_us > 100000) {
+		poll_us = 8000;
+	}
+	idle_looks = 80000 / poll_us;   /* a report read every 80 ms even with the line high, in case it is missed */
+
+	tlmm = ml_io_map(TLMM_PHYS, TLMM_SIZE);
+	gcc = ml_io_map(GCC_PHYS, GCC_SIZE);
+	se = ml_io_map(SE_PHYS, SE_SIZE);
+	rsc = ml_io_map(RSC_PHYS, RSC_SIZE);
+	cmd_db = ml_io_map_wcomb(CMD_DB_PHYS, CMD_DB_SIZE);      /* memory, not registers: no alignment rules */
+
+	if (!bring_up()) {
+		printf("goodix: no %s touch screen\n", chip_name());
+		thread_terminate(current_thread());
+		return;
+	}
+	printf("goodix: %s touch screen ready; the interrupt line is looked at every %u us\n", chip_name(), poll_us);
+	{
+		uint32_t rate = 0;
+
+		/* boot-arg touch_rate=480: the chip reports twice as often (Xiaomi's game mode; 240 otherwise) */
+		if (PE_parse_boot_argn("touch_rate", &rate, sizeof(rate)) && rate == 480 && touch_chip == TOUCH_GOODIX) {
+			bool done = goodix_command(GOODIX_CMD_HIGH_RATE, 1);
+
+			report_rate = done ? "480 (acknowledged)" : "240 (480 NOT ACKNOWLEDGED)";
+			printf("goodix: reports 480 times a second (command %#x at %#x): %s\n", GOODIX_CMD_HIGH_RATE, command_address,
+			    done ? "acknowledged" : "NOT ACKNOWLEDGED");
+		}
+	}
+	for (unsigned tick = 1;; tick++) {
+		uint64_t looked = micros_now(), read_at;
+
+		/* the interrupt line is low while a report waits; look anyway every 80 ms in case it is missed */
+		if (!gpio_get(PIN_INT)) {
+			idle = 0;
+			chip_poll();
+			read_at = micros_now();
+			reads++;
+			reading += read_at - looked;
+			if (latency) {
+				hakios_tl("tl: c before %llu seen %llu read %llu\n", before, looked, read_at);
+			}
+		} else if (++idle >= idle_looks) {
+			idle = 0;
+			chip_poll();
+			reads++;
+			reading += micros_now() - looked;
+		}
+		before = looked;
+		if (tick % (60 * (1000000 / poll_us)) == 0) {
+			printf("%s: so far %u reports in %u looks (%u bad), %u finger positions, the last at %u, %u; "
+			    "interrupt line %s; a report takes %llu us to read; the line looked at every %u us, reports %s a second\n",
+			    chip_name(), seen.reports, seen.polls, seen.bad, seen.touches, seen.last_x, seen.last_y,
+			    gpio_get(PIN_INT) ? "high" : "low", reads ? reading / reads : 0, poll_us, report_rate);
+		}
+		sleep_us(poll_us);
+	}
+}
+
+void
+hakios_goodix_init(void)
+{
+	uint32_t enabled = 0;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("touchscreen", &enabled, sizeof(enabled)) || !enabled) {
+		return;
+	}
+	PE_parse_boot_argn("touch_flip", &flip, sizeof(flip));
+	if (kernel_thread_start(goodix_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
diff --git a/bsd/dev/hakios.guard.c b/bsd/dev/hakios.guard.c
new file mode 100644
index 0000000..2082712
--- /dev/null
+++ b/bsd/dev/hakios.guard.c
@@ -0,0 +1,315 @@
+/*
+ * The speakers' guard: what the samples go through on their way to the phone's two amplifiers
+ * (bsd/dev/hakios.sound.c's feeder), in place of the protection Android has in the audio DSP.
+ *
+ * Under Android the DSP runs Awinic's algorithm (SKTune, "aw882xx_rx_switch") with each
+ * speaker's calibration: it keeps the cone's excursion and the voice coil's temperature in
+ * bounds, measuring both through the amplifiers' current and voltage feedback. None of that runs
+ * here, and nothing here knows the speakers' parameters (Android's files that can be read have
+ * none: the amplifiers' register profile, the battery tables of its "monitor", and in the device
+ * tree a range of 4 to 9 ohms for the calibrated resistance). So the guard holds what reaches the
+ * speakers to levels that are safe for small phone speakers whatever they are exactly, measured
+ * the only way there is without feedback -- from the samples and the amplifiers' level -- and
+ * kept well under what the speakers can take at Android's level:
+ *
+ *   high-pass  a second-order Butterworth filter at 200 Hz: a phone's speaker gives out next to
+ *              nothing below its resonance (several hundred Hz), and what it is given there only
+ *              moves the cone further and heats the coil
+ *   power      the power that would reach a speaker, averaged three ways -- over 0.2 s (the
+ *              cone and coil at once), 3 s (the voice coil's warming) and 60 s (the magnet and
+ *              the frame) -- and the level turned down so that none of the three averages goes
+ *              over its limit: 3, 6 and 9 dB under the power of a full-scale sine at Android's
+ *              level. Sound of ordinary loudness never comes near them; a sustained full-scale
+ *              tone is turned down at once to the first, after seconds to the second and over a
+ *              minute to the third, and the level comes back up as the averages fall, as a
+ *              speaker cools. The averages go on falling while the amplifiers are off.
+ *   peaks      no sample above 3 dB under full scale at Android's level: a limiter that turns
+ *              the level down at the sample that would go over (so none does) and lets it come
+ *              back with a time constant of 43 ms
+ *   monitor    a further reduction that the amplifiers' watch asks for (hakios.speaker.c:
+ *              Android's table for a cold amplifier, and a low battery)
+ *
+ * Before all that, a gain (sound_gain, at most 12 dB): iOS's own processing for the iPhone X's
+ * speaker keeps even a full-scale tone at its top volume 12.6 to 14.3 dB under full scale, so
+ * without it iOS at the top would stay that much under Android at the top. What it lifts over
+ * full scale is held to full scale by the peak limiter (or to its lower limit), never clipped.
+ *
+ * All the limits are in terms of the speakers: a signal at full scale with the amplifiers at
+ * Android's level (the loudest they are ever set to) is 0 dB. With the amplifiers turned down
+ * (sound_below) the same samples are that much quieter at the speakers, and the guard holds them
+ * back only that much later. Everything is integer arithmetic (the kernel's threads do no
+ * floating point); fractions are in Q30 unless said otherwise.
+ *
+ * One caller at a time (the feeder); hakios_guard_attenuation() and hakios_guard_monitor() may
+ * be called from another thread.
+ */
+#include <stdbool.h>
+#include <stdint.h>
+#include <sys/hakios.audio.h>
+
+#define ONE                     (1ll << 30)
+#define FULL_SCALE              32768
+
+/* The limits, in eighths of a dB under full scale at Android's level (powers: under a full-scale square wave's) */
+#define PEAK_LIMIT              (3 * 8)
+#define RMS_LIMIT               (6 * 8)         /* a full-scale sine is 3 dB under a square wave: these are 3, 6, 9 dB under it */
+#define FAST_LIMIT              (9 * 8)
+#define SLOW_LIMIT              (12 * 8)
+/* ... and the averages' time constants, in frames (48 kHz) */
+#define RMS_FRAMES              9600            /* 0.2 s */
+#define FAST_FRAMES             144000          /* 3 s */
+#define SLOW_FRAMES             2880000         /* 60 s */
+#define RELEASE_SHIFT           11              /* the peak limiter lets go with a time constant of 2048 frames, 43 ms */
+#define MAX_FRAMES              1024            /* the most frames processed at once (the feeder's period: 960) */
+
+/* 10^(-n/160), n = 0..47, in Q30: an attenuation of n eighths of a dB, as a factor of amplitude */
+static const uint32_t eighths[48] = {
+	1073741824, 1058400094, 1043277569, 1028371116, 1013677647, 999194121, 984917536, 970844937, 956973408, 943300077,
+	929822112, 916536722, 903441154, 890532697, 877808678, 865266461, 852903448, 840717079, 828704830, 816864213,
+	805192776, 793688102, 782347808, 771169545, 760150998, 749289885, 738583957, 728030996, 717628817, 707375265,
+	697268218, 687305580, 677485290, 667805313, 658263644, 648858308, 639587356, 630448869, 621440953, 612561743,
+	603809400, 595182112, 586678091, 578295576, 570032831, 561888146, 553859832, 545946228,
+};
+#define SIX_DB                  538145694       /* 10^(-6/20) in Q30 */
+
+/* the high-pass filter, 200 Hz at 48 kHz, Q = 1/sqrt(2): b0, b1, b2, a1, a2 in Q30 (RBJ's cookbook) */
+static const int64_t hpf_b0 = 1054047540, hpf_b1 = -2108095079, hpf_b2 = 1054047540;
+static const int64_t hpf_a1 = -2107733822, hpf_a2 = 1034714513;
+
+static struct {
+	bool hpf;
+	uint64_t gain;                          /* the gain before everything, Q30 (1 to 4) */
+	volatile uint32_t attenuation;          /* the amplifiers' level under Android's, eighths of a dB; HAKIOS_GUARD_SILENT: off */
+	volatile uint32_t monitor;              /* the monitor's reduction, eighths of a dB */
+	int64_t x1[2], x2[2], y1[2], y2[2];     /* the filter's past, in 1/256 of a sample */
+	uint64_t rms[2], fast[2], slow[2];      /* average powers at each speaker, Q30 of a full-scale square wave at Android's level */
+	uint64_t level;                         /* the power guard's and the monitor's gain at the end of the last block */
+	uint64_t envelope;                      /* the peak limiter's, 1/65536 of a sample */
+	struct hakios_guard_report report;
+} guard = { .hpf = true, .attenuation = HAKIOS_GUARD_SILENT, .gain = ONE, .level = ONE, .report = { .least_gain = ONE, .least_peak_gain = 65536 } };
+
+static int32_t work[2 * MAX_FRAMES];
+
+/* 10^(-n/160) in Q30: n eighths of a dB under, as a factor of amplitude */
+static uint64_t
+amplitude(uint32_t n)
+{
+	uint64_t value = eighths[n % 48];
+
+	for (uint32_t i = 0; i < n / 48 && value != 0; i++) {
+		value = value * SIX_DB >> 30;
+	}
+	return value;
+}
+
+static uint64_t
+isqrt(uint64_t value)
+{
+	uint64_t root = 0, bit = 1ull << 62;
+
+	while (bit > value) {
+		bit >>= 2;
+	}
+	while (bit != 0) {
+		if (value >= root + bit) {
+			value -= root + bit;
+			root = (root >> 1) + bit;
+		} else {
+			root >>= 1;
+		}
+		bit >>= 2;
+	}
+	return root;
+}
+
+/* how much of `limit' a power is, as the square of the gain that would bring it down to it (Q30, at most 1) */
+static uint64_t
+headroom(uint64_t power, uint64_t limit)
+{
+	if (power <= limit) {
+		return ONE;
+	}
+	return (limit << 30) / power;
+}
+
+void
+hakios_guard_configure(bool hpf, uint32_t gain)
+{
+	guard.hpf = hpf;
+	/* 10^(gain/160): one over the attenuation by as much */
+	guard.gain = (1ull << 60) / amplitude(gain > HAKIOS_GUARD_MAX_GAIN ? HAKIOS_GUARD_MAX_GAIN : gain);
+}
+
+void
+hakios_guard_attenuation(uint32_t below)
+{
+	guard.attenuation = below;
+}
+
+void
+hakios_guard_monitor(uint32_t below)
+{
+	guard.monitor = below;
+}
+
+static void
+block(int16_t *frames, uint32_t count)
+{
+	uint32_t attenuation = guard.attenuation;
+	struct hakios_guard_report *r = &guard.report;
+	uint64_t to_speaker = attenuation == HAKIOS_GUARD_SILENT ? 0 : amplitude(2 * attenuation);
+	uint64_t sum[2] = { 0, 0 }, g2 = ONE, g, start = guard.level, ceiling;
+	uint32_t binding = 0;
+
+	/* the high-pass filter, and what comes out of it: its power, per channel */
+	for (uint32_t i = 0; i < 2 * count; i++) {
+		unsigned c = i & 1;
+		int64_t x = (int64_t)frames[i] * (int64_t)guard.gain >> 22, y;    /* (the gain, and 1/256 of a sample) */
+		uint32_t level = frames[i] < 0 ? (uint32_t)-frames[i] : (uint32_t)frames[i];
+
+		if (level > r->peak_in) {
+			r->peak_in = level;
+		}
+		if (guard.hpf) {
+			y = (hpf_b0 * x + hpf_b1 * guard.x1[c] + hpf_b2 * guard.x2[c] - hpf_a1 * guard.y1[c] - hpf_a2 * guard.y2[c]) >> 30;
+			guard.x2[c] = guard.x1[c];
+			guard.x1[c] = x;
+			guard.y2[c] = guard.y1[c];
+			guard.y1[c] = y;
+		} else {
+			y = x;
+		}
+		work[i] = (int32_t)((y + 128) >> 8);
+		sum[c] += (uint64_t)((int64_t)work[i] * work[i]);
+	}
+
+	/* the averages at the speakers, and the gain that keeps all three under their limits */
+	for (unsigned c = 0; c < 2; c++) {
+		/* the block's power, Q30 of full scale (a square wave at 32768), then as it reaches the speaker */
+		uint64_t power = (uint64_t)((unsigned __int128)(sum[c] / count) * to_speaker >> 30), h;
+
+		guard.rms[c] = (uint64_t)((int64_t)guard.rms[c] + ((int64_t)power - (int64_t)guard.rms[c]) * count / RMS_FRAMES);
+		guard.fast[c] = (uint64_t)((int64_t)guard.fast[c] + ((int64_t)power - (int64_t)guard.fast[c]) * count / FAST_FRAMES);
+		guard.slow[c] = (uint64_t)((int64_t)guard.slow[c] + ((int64_t)power - (int64_t)guard.slow[c]) * count / SLOW_FRAMES);
+		if ((h = headroom(guard.rms[c], amplitude(2 * RMS_LIMIT))) < g2) {
+			g2 = h;
+			binding = 1;
+		}
+		if ((h = headroom(guard.fast[c], amplitude(2 * FAST_LIMIT))) < g2) {
+			g2 = h;
+			binding = 2;
+		}
+		if ((h = headroom(guard.slow[c], amplitude(2 * SLOW_LIMIT))) < g2) {
+			g2 = h;
+			binding = 3;
+		}
+	}
+	g = isqrt(g2 << 30) * amplitude(guard.monitor) >> 30;
+	if (g > ONE) {
+		g = ONE;
+	}
+	r->blocks++;
+	if (binding == 1) {
+		r->rms_blocks++;
+	} else if (binding == 2) {
+		r->fast_blocks++;
+	} else if (binding == 3) {
+		r->slow_blocks++;
+	}
+	if (g < r->least_gain) {
+		r->least_gain = g;
+	}
+
+	/* the peaks: no sample over the limit at the speaker (and none over full scale) */
+	ceiling = FULL_SCALE - 1;
+	if (attenuation != HAKIOS_GUARD_SILENT && attenuation < PEAK_LIMIT) {
+		ceiling = (uint64_t)FULL_SCALE * amplitude(PEAK_LIMIT - attenuation) >> 30;
+	}
+	for (uint32_t f = 0; f < count; f++) {
+		/* (the power guard's gain moves from the last block's to this one's across the block) */
+		uint64_t gain = (uint64_t)((int64_t)start + ((int64_t)g - (int64_t)start) * (int64_t)(f + 1) / (int64_t)count);
+		int64_t y[2];
+		uint64_t level, peak_gain = 65536;
+
+		for (unsigned c = 0; c < 2; c++) {
+			y[c] = (int64_t)work[2 * f + c] * (int64_t)gain >> 30;
+		}
+		level = (uint64_t)(y[0] < 0 ? -y[0] : y[0]);
+		if ((uint64_t)(y[1] < 0 ? -y[1] : y[1]) > level) {
+			level = (uint64_t)(y[1] < 0 ? -y[1] : y[1]);
+		}
+		guard.envelope -= guard.envelope >> RELEASE_SHIFT;
+		if (level << 16 > guard.envelope) {
+			guard.envelope = level << 16;
+		}
+		if (guard.envelope > ceiling << 16) {
+			peak_gain = (ceiling << 32) / guard.envelope;
+			r->limited_frames++;
+			if (peak_gain < r->least_peak_gain) {
+				r->least_peak_gain = (uint32_t)peak_gain;
+			}
+		}
+		for (unsigned c = 0; c < 2; c++) {
+			int64_t out = y[c] * (int64_t)peak_gain >> 16;
+			uint32_t magnitude;
+
+			out = out > FULL_SCALE - 1 ? FULL_SCALE - 1 : out < -FULL_SCALE ? -FULL_SCALE : out;
+			frames[2 * f + c] = (int16_t)out;
+			magnitude = (uint32_t)(out < 0 ? -out : out);
+			if (magnitude > r->peak_out) {
+				r->peak_out = magnitude;
+			}
+		}
+	}
+	guard.level = g;
+	r->gain = g;
+	r->rms = guard.rms[0] > guard.rms[1] ? guard.rms[0] : guard.rms[1];
+	r->fast = guard.fast[0] > guard.fast[1] ? guard.fast[0] : guard.fast[1];
+	r->slow = guard.slow[0] > guard.slow[1] ? guard.slow[0] : guard.slow[1];
+}
+
+void
+hakios_guard_process(int16_t *frames, uint32_t count)
+{
+	while (count > 0) {
+		uint32_t n = count < MAX_FRAMES ? count : MAX_FRAMES;
+
+		block(frames, n);
+		frames += 2 * n;
+		count -= n;
+	}
+}
+
+/* What has happened since the last call (and the averages and the gain as they are now). */
+void
+hakios_guard_take_report(struct hakios_guard_report *report)
+{
+	*report = guard.report;
+	guard.report = (struct hakios_guard_report){ .least_gain = ONE, .least_peak_gain = 65536 };
+}
+
+/* 10 log10 of a Q30 ratio, in tenths of a dB (for what is said) */
+int
+hakios_guard_decibels(uint64_t ratio)
+{
+	static const uint16_t fraction[17] = {
+		0, 5732, 11136, 16248, 21098, 25711, 30109, 34312, 38336, 42196, 45904, 49472, 52911, 56229, 59434, 62534, 65535,
+	};
+	int64_t log2;                           /* Q16 */
+	unsigned top = 63;
+
+	if (ratio == 0) {
+		return -999;
+	}
+	while (!(ratio >> top)) {
+		top--;
+	}
+	{
+		/* the 4 bits under the top one choose a segment, the next 12 where in it */
+		uint64_t mantissa = top >= 16 ? ratio >> (top - 16) : ratio << (16 - top);
+		unsigned index = (unsigned)(mantissa >> 12) & 15, within = (unsigned)mantissa & 4095;
+
+		log2 = ((int64_t)top - 30) * 65536 + fraction[index] + (int64_t)(fraction[index + 1] - fraction[index]) * within / 4096;
+	}
+	return (int)(log2 * 30103 / 65536 / 1000);
+}
diff --git a/bsd/dev/hakios.haptic.c b/bsd/dev/hakios.haptic.c
new file mode 100644
index 0000000..944a32b
--- /dev/null
+++ b/bsd/dev/hakios.haptic.c
@@ -0,0 +1,1005 @@
+/*
+ * The vibration motor of the POCO X5 Pro (redwood): a linear resonant actuator driven by an
+ * Awinic AW86927 (chip ID 0x9270), Android's "haptic_hv" (Xiaomi's driver aw8692x, version 1.7.0).
+ * Every address and number below belongs to this phone, from Android's own device tree, its
+ * kernel's log and the chip's registers as Android leaves them (read from sysfs, read-only):
+ *
+ *   I2C        the serial engine 9 (qupv3_se9_i2c at 0xa84000, function qup11 on GPIO 36 data and
+ *              37 clock, internal pull-ups, 400 kHz under Android), address 0x5a; done by hand here
+ *              as for the amplifiers (hakios.speaker.c), the two pins taken for each transaction
+ *              and given back as they were found
+ *   reset      GPIO 35, high = running (Android: low for 5 ms, then high, at its driver's start)
+ *   interrupt  GPIO 18, pulled up, low when the chip has something to say (not used: polled)
+ *   the motor  f0 175.5 Hz as Android calibrated it (f0_pre 170.0 Hz, calibration data 0x0d)
+ *   effects    Android's RAM waveforms, /vendor/firmware/aw8697_haptic.bin of the phone (fw-haptic/
+ *              here, not in the repository; userland/build.sh puts it into /fw of the system image):
+ *              eleven of them, 1..10 short (Android's effects 0..9), 11 the one looped for a
+ *              vibration of some length
+ *
+ * Nothing here is done unless a boot-arg asks for it:
+ *
+ *   haptic=1   a look, reading only: the pins, and whether the chip answers (its ID and registers,
+ *              against what Android leaves in them). Out of Android's bootloader the reset pin is an
+ *              input with a pull-down: the chip is held in reset and does not answer.
+ *   haptic=2   ... and the reset released as Android's driver releases it (low 5 ms, then high; it
+ *              stays released until the run ends), and the chip's registers read as they come out
+ *              of reset, against Android's. Nothing is written to the chip.
+ *   haptic=3   ... and Android's configuration written (every write read back), Android's
+ *              waveforms loaded into its RAM and read back; then standby. Nothing moves.
+ *   haptic=4   ... and one short effect played (haptic_effect=N, default 1: Android's effect 0)
+ *   haptic=5   ... configured and loaded as for 3, and instead of the effect the motor for iOS until
+ *              the run ends: what iOS plays on its "Actuator" device (the HAL plug-in's,
+ *              userland/src/audio_plugin.c: the system's feedbacks and vibrations, CoreHaptics'
+ *              patterns, UIKit's feedbacks) is written to /dev/hakios-haptic as samples of one
+ *              channel, and the motor plays Android's waveforms by it: each waveform of iOS's (a
+ *              stretch of samples after a pause) a short tap (waveform 1), and one that goes on for
+ *              longer than a tap the waveform Android loops for vibrations (11), until it ends -- or
+ *              for HAPTIC_MAX_MS at most, after which the motor rests for as long before it plays
+ *              again. The gain follows how loud iOS's waveform is: Android's own (0x80) from a third
+ *              of full scale up, five eighths of it for the softest, never above it (gain_for()).
+ *
+ * Limits, whatever asks: Android's own values only (its gain 0x80, its boost and drive levels, its
+ * waveforms); no effect longer than HAPTIC_MAX_MS, and the chip is told to stop and put into
+ * standby when that is over whether it has stopped or not; any fault the chip reports (under-
+ * voltage, over-current, over-temperature, the boost's short circuit or over-voltage), a write that
+ * does not read back or a byte nobody acknowledges, and the chip is put into reset and nothing more
+ * is done for the rest of the run. At the run's end (and on a panic's way out) the chip goes back
+ * into reset. Nothing is written anywhere but to the chip's registers and its RAM.
+ */
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <miscfs/devfs/devfs.h>
+#include <sys/conf.h>
+#include <sys/systm.h>
+#include <sys/uio.h>
+#include <sys/hakios.audio.h>
+#include <sys/hakios.input.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t thread_terminate(thread_t thread);
+extern void loader_log_putc(char c);
+
+static vm_offset_t tlmm;
+static uint32_t level;
+static bool broken, released, leaving;
+
+/* every line to the loader's log as well (and to the console when that may be written) */
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[300];
+	va_list list;
+	int length;
+
+	va_start(list, format);
+	length = vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	if (!leaving && ml_get_interrupts_enabled()) {
+		printf("%s", line);
+	}
+	return length;
+}
+
+static inline uint32_t
+rd(vm_offset_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+static inline void
+wr(vm_offset_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+}
+
+static void
+spin_us(uint32_t us)
+{
+	uint64_t until;
+
+	nanoseconds_to_absolutetime((uint64_t)us * NSEC_PER_USEC, &until);
+	until += mach_absolute_time();
+	while (mach_absolute_time() < until) {
+	}
+}
+
+static void
+wait_ms(uint32_t ms)
+{
+	if (leaving) {
+		spin_us(ms * 1000);
+	} else {
+		delay_for_interval(ms, NSEC_PER_MSEC);
+	}
+}
+
+/* ---- pins ------------------------------------------------------------------------------------------ */
+
+#define TLMM_PHYS               0x0f100000UL
+#define TLMM_SIZE               0x100000UL
+#define GPIO_CFG(n)             (tlmm + 0x1000UL * (n))         /* [1:0] pull, [5:2] function, [8:6] drive, [9] output */
+#define GPIO_IO(n)              (tlmm + 0x1000UL * (n) + 4)     /* bit 0 in, bit 1 out */
+#define CFG_PULL_UP             3
+#define CFG_OUTPUT              (1u << 9)
+
+#define PIN_SDA                 36      /* the serial engine's first pin is the data line, the second the clock */
+#define PIN_SCL                 37
+#define PIN_RESET               35
+#define PIN_INT                 18
+
+static void
+show_pins(void)
+{
+	static const struct {
+		unsigned pin;
+		const char *what;
+	} pins[] = { { PIN_SDA, "I2C data" }, { PIN_SCL, "I2C clock" }, { PIN_RESET, "reset" }, { PIN_INT, "interrupt" } };
+
+	for (unsigned i = 0; i < sizeof(pins) / sizeof(pins[0]); i++) {
+		uint32_t cfg = rd(GPIO_CFG(pins[i].pin)), io = rd(GPIO_IO(pins[i].pin));
+
+		say("haptic: gpio%u (%s): function %u, pull %u, %u mA, %s, reads %u\n", pins[i].pin, pins[i].what, (cfg >> 2) & 15,
+		    cfg & 3, (((cfg >> 6) & 7) + 1) * 2, (cfg & CFG_OUTPUT) ? (io & 2 ? "drives high" : "drives low") : "input", io & 1);
+	}
+}
+
+/* the reset pin as an output of the GPIO function, driving `high' (2 mA, no pull, as Android has it) */
+static void
+reset_pin(bool high)
+{
+	wr(GPIO_IO(PIN_RESET), high ? 2 : 0);
+	wr(GPIO_CFG(PIN_RESET), CFG_OUTPUT);
+	released = high;
+}
+
+/* ---- I2C by hand (as in hakios.speaker.c) ---------------------------------------------------------- */
+
+static void
+half_bit(void)
+{
+	spin_us(5);                     /* 100 kHz at most */
+}
+
+static void
+line(unsigned pin, bool high)
+{
+	wr(GPIO_IO(pin), 0);
+	wr(GPIO_CFG(pin), CFG_PULL_UP | (high ? 0 : CFG_OUTPUT));
+}
+
+static bool
+level_of(unsigned pin)
+{
+	return rd(GPIO_IO(pin)) & 1;
+}
+
+static void
+i2c_start(void)
+{
+	line(PIN_SDA, true);
+	line(PIN_SCL, true);
+	half_bit();
+	line(PIN_SDA, false);
+	half_bit();
+	line(PIN_SCL, false);
+	half_bit();
+}
+
+static void
+i2c_stop(void)
+{
+	line(PIN_SDA, false);
+	half_bit();
+	line(PIN_SCL, true);
+	half_bit();
+	line(PIN_SDA, true);
+	half_bit();
+}
+
+static bool
+i2c_bit(bool out)
+{
+	bool in;
+
+	line(PIN_SDA, out);
+	half_bit();
+	line(PIN_SCL, true);
+	for (unsigned stretched = 0; !level_of(PIN_SCL) && stretched < 100; stretched++) {
+		half_bit();
+	}
+	half_bit();
+	in = level_of(PIN_SDA);
+	line(PIN_SCL, false);
+	return in;
+}
+
+static bool
+i2c_write(uint8_t byte)
+{
+	for (int bit = 7; bit >= 0; bit--) {
+		i2c_bit((byte >> bit) & 1);
+	}
+	return !i2c_bit(true);
+}
+
+static uint8_t
+i2c_read(bool more)
+{
+	uint8_t byte = 0;
+
+	for (int bit = 7; bit >= 0; bit--) {
+		byte = (uint8_t)(byte << 1 | i2c_bit(true));
+	}
+	i2c_bit(!more);
+	return byte;
+}
+
+static uint32_t taken_cfg[2], taken_io[2];
+
+static bool
+bus_take(void)
+{
+	taken_cfg[0] = rd(GPIO_CFG(PIN_SDA));
+	taken_cfg[1] = rd(GPIO_CFG(PIN_SCL));
+	taken_io[0] = rd(GPIO_IO(PIN_SDA));
+	taken_io[1] = rd(GPIO_IO(PIN_SCL));
+	line(PIN_SDA, true);
+	line(PIN_SCL, true);
+	half_bit();
+	if (!level_of(PIN_SDA) || !level_of(PIN_SCL)) {
+		wr(GPIO_IO(PIN_SDA), taken_io[0] & 2);
+		wr(GPIO_IO(PIN_SCL), taken_io[1] & 2);
+		wr(GPIO_CFG(PIN_SDA), taken_cfg[0]);
+		wr(GPIO_CFG(PIN_SCL), taken_cfg[1]);
+		say("haptic: the I2C bus is not at rest (gpio%u reads %u, gpio%u reads %u): not touched\n", PIN_SDA,
+		    level_of(PIN_SDA), PIN_SCL, level_of(PIN_SCL));
+		return false;
+	}
+	return true;
+}
+
+static void
+bus_give_back(void)
+{
+	wr(GPIO_IO(PIN_SDA), taken_io[0] & 2);
+	wr(GPIO_IO(PIN_SCL), taken_io[1] & 2);
+	wr(GPIO_CFG(PIN_SDA), taken_cfg[0]);
+	wr(GPIO_CFG(PIN_SCL), taken_cfg[1]);
+}
+
+#define AW_ADDRESS              0x5a
+
+/* `count' 8-bit registers from `reg' on (the chip's address counts up, but for its RAM data port) */
+static bool
+regs_read(uint8_t reg, uint8_t *values, unsigned count)
+{
+	bool answered;
+
+	if (!bus_take()) {
+		return false;
+	}
+	i2c_start();
+	answered = i2c_write(AW_ADDRESS << 1) && i2c_write(reg);
+	if (answered) {
+		i2c_start();
+		answered = i2c_write(AW_ADDRESS << 1 | 1);
+	}
+	for (unsigned i = 0; answered && i < count; i++) {
+		values[i] = i2c_read(i + 1 < count);
+	}
+	i2c_stop();
+	bus_give_back();
+	return answered;
+}
+
+static bool
+regs_write(uint8_t reg, const uint8_t *values, unsigned count)
+{
+	bool answered;
+
+	if (!bus_take()) {
+		return false;
+	}
+	i2c_start();
+	answered = i2c_write(AW_ADDRESS << 1) && i2c_write(reg);
+	for (unsigned i = 0; answered && i < count; i++) {
+		answered = i2c_write(values[i]);
+	}
+	i2c_stop();
+	bus_give_back();
+	return answered;
+}
+
+/* ---- the chip -------------------------------------------------------------------------------------- */
+
+#define AW_RSTCFG               0x00            /* 0xaa: a soft reset */
+#define AW_SYSST                0x01
+#define AW_SYSINT               0x02            /* read: cleared */
+#define AW_SYSINTM              0x03
+#define AW_PLAYCFG1             0x06            /* [7] boost on, [6:0] its voltage */
+#define AW_PLAYCFG2             0x07            /* the gain */
+#define AW_PLAYCFG3             0x08            /* [1:0] the play mode: 0 RAM */
+#define AW_PLAYCFG4             0x09            /* [1] stop, [0] go */
+#define AW_WAVCFG1              0x0a            /* the first waveform to play, 1..127 (0: the end) */
+#define AW_WAVCFG2              0x0b
+#define AW_WAVCFG9              0x12            /* [7:4] how often the first is repeated, 15: until told to stop */
+#define AW_BASEADDRH            0x2d
+#define AW_BASEADDRL            0x2e
+#define AW_GLBRD5               0x3f            /* [3:0] the state: 0 standby */
+#define AW_RAMADDRH             0x40
+#define AW_RAMADDRL             0x41
+#define AW_RAMDATA              0x42
+#define AW_SYSCTRL3             0x45            /* [5] standby, [2] the RAM open for loading */
+#define AW_TMCFG                0x5b            /* 0x7d opens the analog registers 0x70.. for writing, 0 closes them */
+#define AW_TRIM_LRA             0x79            /* the motor's f0 calibration */
+#define AW_CHIPIDH              0x57
+#define AW_CHIPIDL              0x58
+#define AW_CHIPID               0x9270
+
+#define SYSINT_FAULTS           0xe6            /* boost short circuit and over-voltage, under-voltage, over-current, over-temperature */
+#define HAPTIC_MAX_MS           1000
+
+static void
+give_up(const char *why)
+{
+	broken = true;
+	say("haptic: %s: THE CHIP IS PUT INTO RESET (gpio%u low) and nothing more is done\n", why, PIN_RESET);
+	if (tlmm != 0) {
+		reset_pin(false);
+	}
+}
+
+static bool
+get(uint8_t reg, uint8_t *value)
+{
+	if (!regs_read(reg, value, 1)) {
+		say("haptic: %#04x NOT READ\n", reg);
+		return false;
+	}
+	return true;
+}
+
+/* One register written and read back. */
+static bool
+put(uint8_t reg, uint8_t value)
+{
+	uint8_t after = 0;
+
+	if (broken) {
+		return false;
+	}
+	if (!regs_write(reg, &value, 1)) {
+		say("haptic: %#04x <- %#04x NOT ACKNOWLEDGED\n", reg, value);
+		give_up("a write was not acknowledged");
+		return false;
+	}
+	if (!regs_read(reg, &after, 1)) {
+		give_up("a register could not be read back");
+		return false;
+	}
+	say("haptic: %#04x <- %#04x, reads %#04x%s\n", reg, value, after, after == value ? "" : ": NOT AS WRITTEN");
+	if (after != value) {
+		give_up("a register did not read back as written");
+		return false;
+	}
+	return true;
+}
+
+/* The chip's interrupt flags (reading clears them): false, and the chip given up on, if one is a fault. */
+static bool
+healthy(const char *when)
+{
+	uint8_t flags = 0;
+
+	if (!get(AW_SYSINT, &flags)) {
+		give_up("the flags could not be read");
+		return false;
+	}
+	if (flags & SYSINT_FAULTS) {
+		say("haptic: %s: the chip reports %#04x:%s%s%s%s%s\n", when, flags, flags & 0x80 ? " BOOST SHORT CIRCUIT" : "",
+		    flags & 0x40 ? " BOOST OVER-VOLTAGE" : "", flags & 0x20 ? " UNDER-VOLTAGE" : "", flags & 0x04 ? " OVER-CURRENT" : "",
+		    flags & 0x02 ? " OVER-TEMPERATURE" : "");
+		give_up("a fault");
+		return false;
+	}
+	return true;
+}
+
+/* Android's registers as its driver leaves them, read from the phone's sysfs (fw-haptic/android/haptic-sysfs.txt) */
+static const uint8_t android_regs[0x7d] = {
+	[0x00] = 0x82, [0x01] = 0x10, [0x02] = 0x11, [0x03] = 0x59, [0x04] = 0x09, [0x05] = 0x00, [0x06] = 0x47, [0x07] = 0x80,
+	[0x08] = 0x07, [0x09] = 0x00, [0x0a] = 0x0b, [0x12] = 0xf0, [0x18] = 0x1e, [0x19] = 0x8d, [0x1a] = 0x71, [0x1b] = 0x06,
+	[0x1c] = 0x58, [0x1d] = 0xcf, [0x1e] = 0x28, [0x1f] = 0x04, [0x20] = 0x06, [0x21] = 0x08, [0x22] = 0x0c, [0x23] = 0x0c,
+	[0x24] = 0x62, [0x25] = 0x08, [0x26] = 0xa0, [0x27] = 0x08, [0x28] = 0x8c, [0x2d] = 0x08, [0x2f] = 0x46, [0x33] = 0x01,
+	[0x34] = 0x01, [0x35] = 0x01, [0x36] = 0x02, [0x37] = 0x02, [0x38] = 0x02, [0x3b] = 0x05, [0x3c] = 0x08, [0x3e] = 0x1b,
+	[0x40] = 0x08, [0x41] = 0x03, [0x45] = 0x12, [0x46] = 0x09, [0x47] = 0x5a, [0x49] = 0x28, [0x4a] = 0xbf, [0x4b] = 0x32,
+	[0x4d] = 0x24, [0x4e] = 0x04, [0x4f] = 0x0a, [0x51] = 0x07, [0x57] = 0x92, [0x58] = 0x70, [0x59] = 0x04, [0x5a] = 0x98,
+	[0x5d] = 0xf5, [0x5e] = 0x0d, [0x5f] = 0xf5, [0x60] = 0x41, [0x61] = 0xf6, [0x62] = 0x5c, [0x63] = 0x0e, [0x64] = 0xf9,
+	[0x68] = 0x05, [0x69] = 0x21, [0x6b] = 0x02, [0x6c] = 0x15, [0x6d] = 0x89, [0x6e] = 0xc2, [0x6f] = 0x48, [0x70] = 0x0f,
+	[0x71] = 0x93, [0x72] = 0x69, [0x73] = 0xa4, [0x74] = 0x89, [0x75] = 0x88, [0x77] = 0x40, [0x79] = 0x0d,
+};
+
+/* What the chip holds now, against Android's (registers 0x00..0x7c; 0x32 and 0x42 are data ports, not read). */
+static void
+show_registers(void)
+{
+	unsigned differ = 0;
+
+	for (unsigned reg = 0; reg <= 0x7c; reg++) {
+		uint8_t value = 0;
+
+		if (reg == 0x32 || reg == 0x42) {
+			continue;
+		}
+		if (!regs_read((uint8_t)reg, &value, 1)) {
+			say("haptic: %#04x NOT READ\n", reg);
+			return;
+		}
+		if (value != android_regs[reg]) {
+			differ++;
+			say("haptic: %#04x = %#04x (Android leaves %#04x)\n", reg, value, android_regs[reg]);
+		}
+	}
+	say("haptic: %u registers differ from what Android leaves in them\n", differ);
+}
+
+static bool
+chip_answers(void)
+{
+	uint8_t id[2] = { 0, 0 };
+
+	if (!regs_read(AW_CHIPIDH, id, 2)) {
+		say("haptic: nobody answers at %#x on the bus of gpio%u/%u\n", AW_ADDRESS, PIN_SDA, PIN_SCL);
+		return false;
+	}
+	say("haptic: the chip at %#x is %#06x%s\n", AW_ADDRESS, id[0] << 8 | id[1], (id[0] << 8 | id[1]) == AW_CHIPID ? ", an AW86927" :
+	    ": NOT THE AW86927 EXPECTED");
+	return (id[0] << 8 | id[1]) == AW_CHIPID;
+}
+
+/*
+ * Android's configuration: the registers its driver sets (and the mainline Linux driver aw86927.c sets the
+ * same way), with Android's values -- those that differ from the chip's own after a reset, as the phone
+ * showed (haptic=2). Not written: the status and interrupt flags, the RAM's address and data ports, the
+ * results of the chip's measurements (0x25..0x28: they do not take what is written, they are what its f0
+ * tracking found under Android; 0x4f, 0x51, 0x59, 0x5a likewise), and what is set for each playing (0x08 the mode,
+ * 0x0a/0x12 the waveform and its repeats). The values are all read from the chip as Android leaves it.
+ */
+static const uint8_t android_config[][2] = {
+	{ 0x03, 0x59 },         /* the interrupt mask */
+	{ 0x06, 0x47 },         /* PLAYCFG1: the boost in bypass, its voltage setting 0x47 (Android's vmax 7938 mV) */
+	{ 0x1a, 0x71 },         /* CONTCFG3 */
+	{ 0x1d, 0xcf },         /* CONTCFG6: f0 tracking on, the first drive level 0x4f */
+	{ 0x1e, 0x28 },         /* CONTCFG7: the second drive level */
+	{ 0x2f, 0x46 },         /* the FIFO's thresholds */
+	{ 0x36, 0x02 }, { 0x37, 0x02 }, { 0x38, 0x02 },  /* the trigger pins' waveforms (the triggers stay off) */
+	{ 0x39, 0x00 }, { 0x3a, 0x00 },  /* ... and off */
+	{ 0x46, 0x09 },         /* SYSCTRL4: 24 kHz waveforms, the gain applied as it is */
+	{ 0x47, 0x5a },
+};
+/*
+ * ... and the analog ones, behind AW_TMCFG (the boost: skip mode, peak current 3.45 A, peak back, slew).
+ * These too are Android's: what the phone's registers hold under Android (they differ from the chip's
+ * own after a reset, so Android's driver set them); mainline Linux's aw86927.c sets the same values.
+ */
+static const uint8_t android_analog[][2] = {
+	{ 0x70, 0x0f }, { 0x71, 0x93 }, { 0x72, 0x69 }, { 0x74, 0x89 }, { 0x75, 0x88 },
+	{ AW_TRIM_LRA, 0x0d },  /* Android's f0 calibration of this motor (its log: "f0_cali_data = 0x0D") */
+};
+
+/* The analog registers opened or closed for writing (AW_TMCFG reads back as 0 either way: what tells is that the writes stick). */
+static bool
+unlock(bool open)
+{
+	uint8_t value = open ? 0x7d : 0x00;
+
+	if (broken || !regs_write(AW_TMCFG, &value, 1)) {
+		give_up("the analog registers could not be opened");
+		return false;
+	}
+	say("haptic: %#04x <- %#04x (the analog registers %s)\n", AW_TMCFG, value, open ? "opened" : "closed");
+	return true;
+}
+
+static bool
+configure(void)
+{
+	say("haptic: Android's configuration is written\n");
+	for (unsigned i = 0; i < sizeof(android_config) / sizeof(android_config[0]); i++) {
+		if (!put(android_config[i][0], android_config[i][1])) {
+			return false;
+		}
+	}
+	if (!unlock(true)) {
+		return false;
+	}
+	for (unsigned i = 0; i < sizeof(android_analog) / sizeof(android_analog[0]); i++) {
+		if (!put(android_analog[i][0], android_analog[i][1])) {
+			(void)unlock(false);
+			return false;
+		}
+	}
+	return unlock(false) && healthy("after the configuration");
+}
+
+static uint32_t states_seen;           /* the GLBRD5 states seen by the last wait, a bit each */
+
+/* until the chip says it is in standby (GLBRD5 state 0), at most `ms' */
+static bool
+wait_standby(unsigned ms)
+{
+	states_seen = 0;
+	for (unsigned waited = 0; waited <= ms; waited += 2) {
+		uint8_t state = 0xff;
+
+		if (!get(AW_GLBRD5, &state)) {
+			return false;
+		}
+		states_seen |= 1u << (state & 0x0f);
+		if ((state & 0x0f) == 0) {
+			return true;
+		}
+		wait_ms(2);
+	}
+	return false;
+}
+
+/*
+ * Android's waveforms into the chip's RAM: the file is a checksum (16 bits, of all that follows), the
+ * address the RAM's contents begin at (0x0800), and those contents -- a version byte, the start and end
+ * address of each waveform, the waveforms. Written through the data port with the address counting up,
+ * then read back the same way and compared.
+ */
+static bool
+load_waveforms(void)
+{
+	uint64_t size = 0;
+	const uint8_t *file = hakios_wifi_file("aw8697_haptic.bin", &size);
+	uint32_t sum = 0, base, length;
+	uint8_t address[2], back[64];
+
+	if (file == NULL || size < 8) {
+		say("haptic: no aw8697_haptic.bin in fw/ of the small image (fw-haptic/ when it is built)\n");
+		return false;
+	}
+	for (uint64_t i = 2; i < size; i++) {
+		sum += file[i];
+	}
+	if ((sum & 0xffff) != (uint32_t)(file[0] << 8 | file[1])) {
+		say("haptic: aw8697_haptic.bin does not add up (%#x, it says %#x): not loaded\n", sum & 0xffff, file[0] << 8 | file[1]);
+		return false;
+	}
+	base = (uint32_t)(file[2] << 8 | file[3]);
+	length = (uint32_t)size - 4;
+	say("haptic: Android's waveforms: %u bytes from %#x on, %u waveforms\n", length, base, (unsigned)(((file[5] << 8 | file[6]) -
+	    base - 1) / 4));
+	if (!wait_standby(250) || !put(AW_SYSCTRL3, (uint8_t)(android_regs[AW_SYSCTRL3] | 0x04))) {
+		give_up("the RAM could not be opened");
+		return false;
+	}
+	address[0] = (uint8_t)(base >> 8);
+	address[1] = (uint8_t)base;
+	if (!put(AW_BASEADDRH, address[0]) || !put(AW_BASEADDRL, address[1]) || !regs_write(AW_RAMADDRH, address, 2)) {
+		give_up("the RAM's address could not be set");
+		return false;
+	}
+	for (uint32_t at = 0; at < length; at += 32) {
+		unsigned n = length - at < 32 ? length - at : 32;
+
+		if (!regs_write(AW_RAMDATA, file + 4 + at, n)) {
+			give_up("the RAM could not be written");
+			return false;
+		}
+	}
+	if (!regs_write(AW_RAMADDRH, address, 2)) {
+		give_up("the RAM's address could not be set again");
+		return false;
+	}
+	for (uint32_t at = 0; at < length; at += sizeof(back)) {
+		unsigned n = length - at < sizeof(back) ? length - at : sizeof(back);
+
+		if (!regs_read(AW_RAMDATA, back, n) || memcmp(back, file + 4 + at, n) != 0) {
+			say("haptic: the RAM reads back differently at %#x\n", base + at);
+			give_up("the waveforms did not load");
+			return false;
+		}
+	}
+	if (!put(AW_SYSCTRL3, android_regs[AW_SYSCTRL3])) {
+		return false;
+	}
+	say("haptic: Android's waveforms are in the chip's RAM and read back as written\n");
+	return healthy("after the waveforms");
+}
+
+/* One waveform played once (Android's effect `effect' - 1), stopped at HAPTIC_MAX_MS at the latest. */
+static bool
+play_effect(unsigned effect)
+{
+	uint64_t began = mach_absolute_time(), ended;
+	bool done;
+
+	say("haptic: waveform %u is played once, at Android's gain %#x\n", effect, android_regs[AW_PLAYCFG2]);
+	if (!wait_standby(250) || !put(AW_PLAYCFG3, 0x04) || !put(AW_WAVCFG1, (uint8_t)effect) || !put(AW_WAVCFG2, 0x00) ||
+	    !put(AW_WAVCFG9, 0x00) || !put(AW_PLAYCFG2, android_regs[AW_PLAYCFG2]) || !healthy("before playing")) {
+		return false;
+	}
+	{
+		uint8_t go = 0x01;
+
+		if (!regs_write(AW_PLAYCFG4, &go, 1)) {
+			give_up("the start was not acknowledged");
+			return false;
+		}
+	}
+	wait_ms(2);
+	done = wait_standby(HAPTIC_MAX_MS);
+	absolutetime_to_nanoseconds(mach_absolute_time() - began, &ended);
+	if (!done) {
+		uint8_t stop = 0x02;
+
+		say("haptic: STILL PLAYING after %u ms: stopped\n", HAPTIC_MAX_MS);
+		(void)regs_write(AW_PLAYCFG4, &stop, 1);
+		if (!wait_standby(50)) {
+			give_up("it does not stop");
+			return false;
+		}
+	}
+	say("haptic: the waveform has played: back in standby after %llu ms (states seen meanwhile: %#x, a bit each; 0 is "
+	    "standby)\n", ended / NSEC_PER_MSEC, states_seen);
+	return healthy("after playing");
+}
+
+/* ---- haptic=5: the motor for iOS ------------------------------------------------------------------- */
+
+#define ACTIVE_US               30000           /* a write that was not silence counts for this long */
+#define SILENT_BELOW            256             /* of 32768: samples no larger are silence */
+#define TAP_US                  60000           /* longer than this, and it is a vibration, not a tap */
+#define SETTLE_US               8000            /* how long iOS's waveform is listened to before a tap: its loudness */
+#define FOLLOW_US               20000           /* how often a vibration's strength follows iOS's */
+
+#define TOLD_EVENTS             24              /* the first so many taps and vibrations are each said */
+
+static volatile uint64_t heard_us;              /* when the last write that was not silence came */
+static volatile uint64_t quiet_us;              /* when the last write that was silence came */
+static volatile uint64_t onset_us;              /* when iOS's last waveform began: the first write not silence after a pause */
+static volatile uint32_t heard_peak;            /* the largest sample of that waveform, or since the service last looked */
+static uint64_t written_frames;
+static unsigned taps, loops, capped;            /* what has been played, for the run's end */
+
+static uint64_t
+now_us(void)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_USEC;
+}
+
+/* From the audio server's I/O thread: never waits. */
+static int
+haptic_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	int16_t samples[256];
+	int error = 0;
+
+	while (uio_resid(uio) >= 2) {
+		user_ssize_t bytes = uio_resid(uio);
+		uint32_t peak = 0;
+
+		if (bytes > (user_ssize_t)sizeof(samples)) {
+			bytes = sizeof(samples);
+		}
+		bytes &= ~(user_ssize_t)1;
+		if ((error = uiomove((caddr_t)samples, (int)bytes, uio)) != 0) {
+			break;
+		}
+		for (unsigned i = 0; i < bytes / 2; i++) {
+			uint32_t v = samples[i] < 0 ? (uint32_t)-(int32_t)samples[i] : (uint32_t)samples[i];
+
+			peak = v > peak ? v : peak;
+		}
+		written_frames += (uint64_t)bytes / 2;
+		if (peak > SILENT_BELOW) {
+			uint64_t now = now_us();
+
+			if (heard_us == 0 || quiet_us > heard_us || now - heard_us >= ACTIVE_US) {
+				onset_us = now;
+				heard_peak = 0;
+			}
+			heard_us = now;
+			if (peak > heard_peak) {
+				heard_peak = peak;
+			}
+		} else {
+			quiet_us = now_us();
+		}
+	}
+	return error;
+}
+
+/*
+ * A test's stand-in for iOS's waveform (hakios.mic.c, mic_tap=1: the microphone hears the motor): as if
+ * a write of this loudness (of 32767) had just come, or silence for 0. The service plays it with all its
+ * own limits, as it plays iOS's.
+ */
+void
+hakios_haptic_pretend(uint32_t peak)
+{
+	uint64_t now = now_us();
+
+	if (peak <= SILENT_BELOW) {
+		quiet_us = now;
+		return;
+	}
+	if (heard_us == 0 || quiet_us > heard_us || now - heard_us >= ACTIVE_US) {
+		onset_us = now;
+		heard_peak = 0;
+	}
+	heard_us = now;
+	if (peak > heard_peak) {
+		heard_peak = peak;
+	}
+}
+
+static int
+haptic_open(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	return 0;
+}
+
+static const struct cdevsw haptic_cdevsw = {
+	.d_open = haptic_open, .d_close = haptic_open, .d_read = eno_rdwrt, .d_write = haptic_write,
+	.d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+/* Start a waveform without waiting for it: once, or (`forever') until stopped. */
+static bool
+start_waveform(unsigned waveform, bool forever, uint8_t gain)
+{
+	uint8_t go = 0x01;
+
+	if (!put(AW_PLAYCFG3, 0x04) || !put(AW_WAVCFG1, (uint8_t)waveform) || !put(AW_WAVCFG2, 0x00) ||
+	    !put(AW_WAVCFG9, forever ? 0xf0 : 0x00) || !put(AW_PLAYCFG2, gain)) {
+		return false;
+	}
+	if (!regs_write(AW_PLAYCFG4, &go, 1)) {
+		give_up("the start was not acknowledged");
+		return false;
+	}
+	return true;
+}
+
+static bool
+stop_waveform(void)
+{
+	uint8_t stop = 0x02;
+
+	if (!regs_write(AW_PLAYCFG4, &stop, 1) || !wait_standby(50)) {
+		give_up("it does not stop");
+		return false;
+	}
+	return true;
+}
+
+/* the chip's state (GLBRD5: 0 standby, 7 and 11 seen while a waveform plays), 0xff if it cannot be read */
+static unsigned
+chip_state(void)
+{
+	uint8_t state = 0xff;
+
+	return get(AW_GLBRD5, &state) ? state & 0x0f : 0xff;
+}
+
+/*
+ * How strong to play what iOS plays. iOS drives its Taptic Engine with waveforms far under full
+ * scale for most feedbacks (a tap's peak anywhere from 1000 to 33000 of 32768, a vibration's
+ * about 17000), and followed in proportion (gain = Android's * peak / full scale) most of them came
+ * out at a tenth of Android's gain or less: not felt at all. Android plays its own clicks and
+ * vibrations at its gain, 0x80. So: Android's gain from a third of full scale up, and below that
+ * down to five eighths of it for the softest -- never above Android's.
+ */
+static uint8_t
+gain_for(uint32_t peak)
+{
+	uint32_t top = android_regs[AW_PLAYCFG2], low = top * 5 / 8, third = 32767 / 3;
+
+	return (uint8_t)(peak >= third ? top : low + (top - low) * peak / third);
+}
+
+static void
+serve(void)
+{
+	enum { IDLE, TAP, LOOP, REST } state = IDLE;
+	uint64_t since = 0, rest_until = 0, last_look = 0, tap_onset = 0, followed = 0;
+	uint8_t playing_gain = 0;
+	unsigned follows = 0;                   /* how often the vibration playing now has changed strength */
+	int major = cdevsw_add(-1, &haptic_cdevsw);
+
+	if (major < 0 || devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "hakios-haptic") == NULL) {
+		say("haptic: /dev/hakios-haptic cannot be made\n");
+		return;
+	}
+	say("haptic: THE MOTOR PLAYS WHAT IOS PLAYS ON ITS ACTUATOR (/dev/hakios-haptic) from here on, until the run ends\n");
+	while (!broken) {
+		uint64_t now = now_us();
+		bool active = heard_us != 0 && now - heard_us < ACTIVE_US;
+		uint32_t peak = heard_peak;
+		uint8_t gain = gain_for(peak);
+
+		switch (state) {
+		case IDLE:
+		case TAP:
+			/*
+			 * A waveform of iOS's that has begun (after a pause: a tap of a series is a tap of its own) is
+			 * a tap -- once its first milliseconds are heard: a waveform begins softly, and they say how
+			 * loud it is; one that goes on without a pause, a vibration.
+			 */
+			if (active && onset_us != tap_onset && now - onset_us >= SETTLE_US) {
+				uint64_t began = onset_us;
+
+				if (state == TAP && !wait_standby(0) && !stop_waveform()) {
+					break;
+				}
+				if (!start_waveform(1, false, gain ? gain : 1)) {
+					break;
+				}
+				state = TAP;
+				since = now;
+				tap_onset = began;
+				taps++;
+				if (taps + loops <= TOLD_EVENTS) {
+					wait_ms(4);
+					say("haptic: tap %u: iOS's waveform peaks at %u of 32768: Android's waveform 1 at gain %#04x; the "
+					    "chip's state %u\n", taps, peak, gain ? gain : 1, chip_state());
+				}
+				break;
+			}
+			if (state == IDLE) {
+				break;
+			}
+			if (active && quiet_us < tap_onset && now - since > TAP_US) {
+				if (stop_waveform() && start_waveform(11, true, gain ? gain : 1)) {
+					state = LOOP;
+					since = followed = now;
+					playing_gain = gain ? gain : 1;
+					follows = 0;
+					loops++;
+					heard_peak = 0;
+					if (taps + loops <= TOLD_EVENTS) {
+						wait_ms(4);
+						say("haptic: vibration %u: iOS goes on playing (peak %u): Android's waveform 11 over and over at "
+						    "gain %#04x, %u ms at most; the chip's state %u\n", loops, peak, gain ? gain : 1,
+						    HAPTIC_MAX_MS, chip_state());
+					}
+				}
+			} else if (!active && now - since > TAP_US) {
+				state = wait_standby(0) || stop_waveform() ? IDLE : state;
+			}
+			break;
+		case LOOP:
+			/* as strong as iOS's waveform is now (Android's gain at full scale, never more) */
+			if (active && now - followed >= FOLLOW_US) {
+				followed = now;
+				heard_peak = 0;
+				if (peak != 0 && (gain > playing_gain + 8 || gain + 8 < playing_gain)) {
+					if (!put(AW_PLAYCFG2, gain)) {
+						break;
+					}
+					playing_gain = gain;
+					follows++;
+				}
+			}
+			if (!active || now - since > HAPTIC_MAX_MS * 1000ull) {
+				bool cut = now - since > HAPTIC_MAX_MS * 1000ull;
+
+				if (cut) {
+					capped++;
+					rest_until = now + HAPTIC_MAX_MS * 1000ull;
+				}
+				if (stop_waveform()) {
+					state = rest_until > now ? REST : IDLE;
+					if (taps + loops <= TOLD_EVENTS + 1) {
+						say("haptic: vibration %u: %s after %llu ms (its strength changed %u times, last to gain %#04x); "
+						    "the chip is in standby\n", loops, cut ? "CUT at the limit" : "iOS stopped, and so does the motor",
+						    (now - since) / 1000, follows, playing_gain);
+					}
+				}
+			}
+			break;
+		case REST:
+			if (now >= rest_until) {
+				state = IDLE;
+			}
+			break;
+		}
+		if (state != IDLE && state != REST && now - last_look > 50000) {
+			last_look = now;
+			if (!healthy("while playing")) {
+				break;
+			}
+		}
+		wait_ms(4);
+	}
+	say("haptic: the motor is given up on (%u taps and %u vibrations played, %u cut at %u ms)\n", taps, loops, capped,
+	    HAPTIC_MAX_MS);
+}
+
+static void
+haptic_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	tlmm = ml_io_map(TLMM_PHYS, TLMM_SIZE);
+	say("haptic: level %u: %s\n", level, level == 1 ? "a look, reading only" : level == 2 ? "the reset released, registers read" :
+	    level == 3 ? "the chip configured and its waveforms loaded, nothing played" : level == 4 ? "one effect played" :
+	    "the motor for iOS");
+	show_pins();
+	if (level >= 2 && !((rd(GPIO_CFG(PIN_RESET)) & CFG_OUTPUT) && (rd(GPIO_IO(PIN_RESET)) & 2))) {
+		/* (Android's driver: the pin low, 5 ms, high, and the chip ready for I2C 8 ms later) */
+		say("haptic: the reset is released: gpio%u low for 5 ms, then high\n", PIN_RESET);
+		reset_pin(false);
+		wait_ms(5);
+		reset_pin(true);
+		wait_ms(8);
+	}
+	if (!chip_answers()) {
+		say("haptic: (the reset pin %s)\n", (rd(GPIO_CFG(PIN_RESET)) & CFG_OUTPUT) && (rd(GPIO_IO(PIN_RESET)) & 2) ?
+		    "drives high: the chip should answer" : "does not drive high: the chip is held in reset or not powered");
+		if (released) {
+			give_up("the chip does not answer");
+		}
+	} else {
+		show_registers();
+		if (level >= 3 && configure() && load_waveforms() && level == 4) {
+			uint32_t effect = 1;
+
+			PE_parse_boot_argn("haptic_effect", &effect, sizeof(effect));
+			if (effect < 1 || effect > 10) {
+				effect = 1;     /* (the short ones only) */
+			}
+			(void)play_effect(effect);
+		} else if (level == 5 && !broken) {
+			serve();
+		}
+	}
+	say("haptic: done\n");
+	thread_terminate(current_thread());
+}
+
+void
+hakios_haptic_init(void)
+{
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("haptic", &level, sizeof(level)) || level == 0) {
+		return;
+	}
+	if (level > 5) {
+		level = 5;
+	}
+	if (kernel_thread_start(haptic_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+/* At the run's end and on a panic's way out: the chip back into reset, if it was let out. */
+void
+hakios_haptic_quiesce(void)
+{
+	if (released && tlmm != 0) {
+		leaving = true;
+		reset_pin(false);
+		if (level == 5) {
+			say("haptic: at the run's end: %u taps and %u vibrations played (%u cut at %u ms), from %llu frames iOS "
+			    "wrote; the chip is held in reset\n", taps, loops, capped, HAPTIC_MAX_MS, written_frames);
+		}
+	}
+}
diff --git a/bsd/dev/hakios.image.c b/bsd/dev/hakios.image.c
new file mode 100644
index 0000000..c153e5a
--- /dev/null
+++ b/bsd/dev/hakios.image.c
@@ -0,0 +1,187 @@
+/*
+ * A file of one of this port's RAM disks, by path, for the drivers that want one before there is
+ * a root or without asking it: the GPU's firmware (hakios.adreno.c), the Wi-Fi DSP's
+ * (hakios.wifi.c), the audio DSP's (hakios.adsp.c) -- "fw/NAME" of the image that travels with
+ * the kernel (md1; md0 when there is nothing else) or of the resident one (md0).
+ *
+ * The image is an APFS container (tools/apfs/mkapfs.py: what userland/build.sh makes).  A file
+ * stored as it is in one piece is used where it lies in the RAM disk's memory, as the drivers
+ * always did (build.sh has mkapfs.py store fw/ that way: --plain fw).
+ * Any other APFS file is read out once by apfs_lib -- the same code as the volume's when
+ * mounted, compressed or not -- into memory of its own, and kept: firmware is asked for once
+ * or twice a session and its driver keeps it while the phone runs, so nothing gives it back.
+ */
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <sys/errno.h>
+#include <sys/param.h>
+#include <sys/stat.h>
+#include <sys/systm.h>
+#include <miscfs/apfs/apfs_lib.h>
+
+extern dev_t mdevlookup(int devid);
+extern int mdevgetkernelrange(dev_t dev, vm_offset_t *base, uint64_t *size);
+
+const uint8_t *hakios_image_file(const char *dir, const char *name, uint64_t *size, int *disk_out);
+
+/* ---- APFS ---- */
+
+struct mem_dev {
+	const uint8_t *base;
+	uint64_t       length;
+};
+
+static int
+mem_read(void *ctx, uint64_t off, void *buf, size_t len)
+{
+	struct mem_dev *m = ctx;
+
+	if (off > m->length || len > m->length - off) {
+		return EIO;
+	}
+	memcpy(buf, m->base + off, len);
+	return 0;
+}
+
+static LCK_GRP_DECLARE(image_lck_grp, "hakios_image");
+static LCK_MTX_DECLARE(image_lock, &image_lck_grp);    /* kept[]: the drivers start beside each other */
+static struct {
+	int       disk;
+	char      path[96];
+	uint8_t  *data;
+	uint64_t  size;
+} kept[64];
+
+static const uint8_t *
+apfs_file(int disk, const uint8_t *base, uint64_t length, const char *dir, const char *name, uint64_t *size)
+{
+	struct mem_dev m = { .base = base, .length = length };
+	struct apfs_dev dev = { .ctx = &m, .size = length, .read = mem_read, .read_data = mem_read };
+	struct apfs_nx *nx = NULL;
+	struct apfs_vol *vol = NULL;
+	struct apfs_inode ino;
+	struct apfs_cfile cf;
+	char path[96];
+	uint64_t id = 0, fsize = 0, off = 0;
+	uint8_t dt = 0, *data = NULL;
+	uint32_t i;
+	int error;
+
+	if (length < 4096 || memcmp(base + 32, "NXSB", 4) != 0) {
+		return NULL;
+	}
+	snprintf(path, sizeof(path), "/%s/%s", dir, name);
+	lck_mtx_lock(&image_lock);
+	for (i = 0; i < sizeof(kept) / sizeof(kept[0]) && kept[i].data != NULL; i++) {
+		if (kept[i].disk == disk && strcmp(kept[i].path, path) == 0) {
+			*size = kept[i].size;
+			lck_mtx_unlock(&image_lock);
+			return kept[i].data;
+		}
+	}
+	nx = kalloc_type(struct apfs_nx, Z_WAITOK | Z_ZERO);
+	vol = kalloc_type(struct apfs_vol, Z_WAITOK | Z_ZERO);
+	if (nx == NULL || vol == NULL) {
+		goto out;
+	}
+	if (apfs_nx_open(nx, &dev) != 0) {
+		kfree_type(struct apfs_nx, nx);
+		nx = NULL;
+		goto out;
+	}
+	error = ENOENT;
+	for (uint32_t v = 0; v < APFS_NX_MAX_FILE_SYSTEMS && error != 0; v++) {
+		if (nx->fs_oid[v] != 0 && apfs_vol_open(nx, v, vol) == 0) {
+			error = apfs_path_lookup(vol, path, &id, &dt);
+		}
+	}
+	if (error == 0) {
+		error = apfs_inode_get(vol, id, &ino);
+	}
+	if (error == 0 && (ino.mode & APFS_S_IFMT) != APFS_S_IFREG) {
+		error = EISDIR;
+	}
+	if (error == 0) {
+		error = apfs_inode_size(vol, &ino, &fsize);
+	}
+	if (error == 0 && (fsize == 0 || fsize > 256 * 1024 * 1024)) {
+		error = EFBIG;
+	}
+	if (error == 0) {
+		uint64_t addr = 0;
+
+		/* in one piece as it is: where it lies, no copy */
+		if (apfs_file_in_place(vol, &ino, &addr) == 0 && addr <= length / nx->block_size &&
+		    fsize <= length - addr * nx->block_size) {
+			apfs_nx_close(nx);
+			*size = fsize;
+			data = __DECONST(uint8_t *, base) + addr * nx->block_size;
+			goto out;
+		}
+		if (i == sizeof(kept) / sizeof(kept[0])) {
+			printf("hakios_image: %s of /dev/md%d: kept %lu files already, no room for a copy of another\n", path, disk,
+			    (unsigned long)i);
+			error = ENOSPC;
+		}
+	}
+	if (error == 0) {
+		data = kalloc_data((vm_size_t)fsize, Z_WAITOK);
+		error = data == NULL ? ENOMEM : 0;
+	}
+	memset(&cf, 0, sizeof(cf));
+	cf.held = APFS_NO_PIECE;
+	while (error == 0 && off < fsize) {
+		size_t got = 0;
+
+		error = apfs_read_file(vol, &ino, &cf, off, data + off, (size_t)(fsize - off), &got);
+		if (error == 0 && got == 0) {
+			error = EIO;
+		}
+		off += got;
+	}
+	apfs_cfile_fini(&cf);
+	apfs_nx_close(nx);
+	if (error == 0) {
+		kept[i].disk = disk;
+		strlcpy(kept[i].path, path, sizeof(kept[i].path));
+		kept[i].size = fsize;
+		kept[i].data = data;            /* (last: a reader of the table sees all of it or none) */
+		*size = fsize;
+	} else if (data != NULL) {
+		kfree_data(data, (vm_size_t)fsize);
+		data = NULL;
+	}
+out:
+	lck_mtx_unlock(&image_lock);
+	if (vol != NULL) {
+		kfree_type(struct apfs_vol, vol);
+	}
+	if (nx != NULL) {
+		kfree_type(struct apfs_nx, nx);
+	}
+	return data;
+}
+
+const uint8_t *
+hakios_image_file(const char *dir, const char *name, uint64_t *size, int *disk_out)
+{
+	for (int disk = 1; disk >= 0; disk--) {
+		vm_offset_t base = 0;
+		uint64_t length = 0;
+		const uint8_t *data;
+		dev_t dev = mdevlookup(disk);
+
+		if (dev == (dev_t)-1 || mdevgetkernelrange(dev, &base, &length) != 0) {
+			continue;
+		}
+		data = apfs_file(disk, (const uint8_t *)base, length, dir, name, size);
+		if (data != NULL) {
+			if (disk_out != NULL) {
+				*disk_out = disk;
+			}
+			return data;
+		}
+	}
+	return NULL;
+}
diff --git a/bsd/dev/hakios.input.c b/bsd/dev/hakios.input.c
new file mode 100644
index 0000000..74f6fb5
--- /dev/null
+++ b/bsd/dev/hakios.input.c
@@ -0,0 +1,231 @@
+/*
+ * /dev/hakios-touch: a queue of touch samples (see sys/hakios.input.h).
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread_call.h>
+#include <libkern/libkern.h>
+#include <miscfs/devfs/devfs.h>
+#include <sys/conf.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/hakios.input.h>
+#include <sys/systm.h>
+#include <sys/uio.h>
+#include <pexpert/pexpert.h>
+
+#define TOUCH_QUEUE     512             /* records; a power of two */
+
+/*
+ * Boot-arg touch_lat=1: for measuring how long a touch takes to reach the panel, a line for every
+ * sample posted ("tl: p TYPE FINGER X Y at US", the time in microseconds of mach_absolute_time),
+ * to be matched with the window server's lines about reading it (userland/src/inject.c), drawing
+ * (eagl.c) and the display driver's about the frame (MiniIOMobileFramebuffer.cpp): see
+ * tools/latency.py.
+ */
+static uint32_t touch_lat = 2;          /* 2: not yet looked up */
+
+extern void loader_log_line(const char *line);
+
+/*
+ * A "tl:" line, for the kernel's drivers: into the loader's log as it is written -- the kernel's own
+ * log keeps only the last of a run, and a live look at the loader's (XL_FOLLOW) then misses nothing.
+ */
+void hakios_tl(const char *format, ...) __printflike(1, 2);
+
+void
+hakios_tl(const char *format, ...)
+{
+	char line[192];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	loader_log_line(line);
+}
+
+static bool
+latency_lines(void)
+{
+	if (touch_lat == 2) {
+		uint32_t on = 0;
+
+		touch_lat = PE_parse_boot_argn("touch_lat", &on, sizeof(on)) && on != 0;
+	}
+	return touch_lat != 0;
+}
+
+static LCK_GRP_DECLARE(touch_lck_grp, "hakios-touch");
+static LCK_MTX_DECLARE(touch_lock, &touch_lck_grp);
+static struct hakios_touch touch_queue[TOUCH_QUEUE];
+static uint32_t touch_head, touch_tail;        /* read from head, add at tail */
+
+/*
+ * The way out when nothing else is at hand: five fingers held on the screen for a second and a
+ * half end the run -- control goes back to the loader, as when loader_return_after expires.
+ * Only a driver's fingers count, not samples a program writes to the device.
+ */
+#define EXIT_FINGERS    5
+#define EXIT_HOLD_MS    1500
+
+extern void loader_return(void);
+
+static thread_call_t exit_call;
+static uint32_t fingers_down;           /* one bit for each finger a driver says is down */
+
+static void
+exit_hold_elapsed(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	printf("\n--- %d fingers held on the screen for %d ms: back to the loader ---\n", EXIT_FINGERS, EXIT_HOLD_MS);
+	hakios_adreno_stop();
+	loader_return();
+}
+
+/* With touch_lock held. */
+static void
+count_fingers(uint32_t type, uint32_t finger)
+{
+	int before = __builtin_popcount(fingers_down), now;
+	uint64_t deadline;
+
+	if (finger >= 32 || exit_call == NULL || (type != HAKIOS_TOUCH_DOWN && type != HAKIOS_TOUCH_UP)) {
+		return;
+	}
+	if (type == HAKIOS_TOUCH_DOWN) {
+		fingers_down |= 1u << finger;
+	} else {
+		fingers_down &= ~(1u << finger);
+	}
+	now = __builtin_popcount(fingers_down);
+	if (now >= EXIT_FINGERS && before < EXIT_FINGERS) {
+		clock_interval_to_deadline(EXIT_HOLD_MS, NSEC_PER_MSEC, &deadline);
+		thread_call_enter_delayed(exit_call, deadline);
+	} else if (now < EXIT_FINGERS && before >= EXIT_FINGERS) {
+		thread_call_cancel(exit_call);
+	}
+}
+
+static void
+touch_post(uint32_t type, uint32_t finger, uint32_t x, uint32_t y, bool from_driver)
+{
+	struct hakios_touch *t;
+
+	lck_mtx_lock(&touch_lock);
+	if (touch_tail - touch_head == TOUCH_QUEUE) {
+		touch_head++;                   /* nobody reads: drop the oldest */
+	}
+	t = &touch_queue[touch_tail++ % TOUCH_QUEUE];
+	t->time = mach_absolute_time();
+	if (latency_lines()) {
+		uint64_t ns;
+
+		absolutetime_to_nanoseconds(t->time, &ns);
+		hakios_tl("tl: p %u %u %u %u at %llu\n", type, finger, x, y, ns / 1000);
+	}
+	t->type = type;
+	t->finger = finger;
+	t->x = x > 65535 ? 65535 : x;
+	t->y = y > 65535 ? 65535 : y;
+	if (from_driver) {
+		count_fingers(type, finger);
+	}
+	lck_mtx_unlock(&touch_lock);
+	wakeup(&touch_queue);
+}
+
+void
+hakios_touch_post(uint32_t type, uint32_t finger, uint32_t x, uint32_t y)
+{
+	touch_post(type, finger, x, y, true);
+}
+
+static int
+touch_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+touch_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+touch_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	struct hakios_touch t;
+	int error = 0, moved = 0;
+
+	lck_mtx_lock(&touch_lock);
+	while (touch_head == touch_tail) {
+		error = msleep(&touch_queue, &touch_lock, PZERO | PCATCH, "hakios-touch", NULL);
+		if (error) {
+			lck_mtx_unlock(&touch_lock);
+			return error;
+		}
+	}
+	while (touch_head != touch_tail && uio_resid(uio) >= (user_ssize_t)sizeof(t)) {
+		t = touch_queue[touch_head++ % TOUCH_QUEUE];
+		lck_mtx_unlock(&touch_lock);
+		error = uiomove((caddr_t)&t, sizeof(t), uio);
+		lck_mtx_lock(&touch_lock);
+		if (error) {
+			break;
+		}
+		moved++;
+	}
+	lck_mtx_unlock(&touch_lock);
+	return moved ? 0 : error;
+}
+
+static int
+touch_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	struct hakios_touch t;
+	int error = 0;
+
+	while (uio_resid(uio) >= (user_ssize_t)sizeof(t)) {
+		error = uiomove((caddr_t)&t, sizeof(t), uio);
+		if (error) {
+			break;
+		}
+		if (t.type < HAKIOS_TOUCH_DOWN || t.type > HAKIOS_BUTTON_UP) {
+			return EINVAL;
+		}
+		touch_post(t.type, t.finger, t.x, t.y, false);
+	}
+	return error;
+}
+
+static const struct cdevsw touch_cdevsw = {
+	.d_open = touch_open, .d_close = touch_close, .d_read = touch_read, .d_write = touch_write,
+	.d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+void
+hakios_input_init(void)
+{
+	int major = cdevsw_add(-1, &touch_cdevsw);
+
+	if (major < 0 || devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "hakios-touch") == NULL) {
+		printf("hakios-touch: cannot create the device\n");
+	}
+	exit_call = thread_call_allocate(exit_hold_elapsed, NULL);
+	hakios_cpufreq_init();
+	hakios_virtio_input_init();
+	hakios_goodix_init();
+	hakios_tcm_init();       /* boot-arg blazer_touch=1: the Pixel 10 Pro's Synaptics TouchComm touch screen */
+	hakios_buttons_init();
+	hakios_battery_init();
+	hakios_ufs_init();
+	hakios_blazer_ufs_init();
+	hakios_blazer_cpm_init();
+	hakios_net_init();
+	hakios_adreno_init();
+	hakios_wifi_init();
+	hakios_adsp_init();
+	hakios_mpss_init();
+}
diff --git a/bsd/dev/hakios.ipa.c b/bsd/dev/hakios.ipa.c
new file mode 100644
index 0000000..e2d9bf9
--- /dev/null
+++ b/bsd/dev/hakios.ipa.c
@@ -0,0 +1,874 @@
+/*
+ * The IPA's data path for this processor: GSI rings, the IPA's endpoints for the application
+ * processor, and the immediate commands that give the IPA its tables.
+ *
+ * The IPA (Qualcomm's "IP accelerator", here IPA 4.11 with GSI 2.11) moves packets between the
+ * modem and this processor. Each side has "endpoints" (pipes) in the IPA and "channels" in the
+ * GSI (the DMA engine beside it): a channel is a ring of transfer elements (TREs: address, length,
+ * flags; 16 bytes) that this processor fills and the hardware consumes, and an event ring the
+ * hardware fills with one event per finished TRE. Writing a doorbell register tells the hardware
+ * how far the ring is filled; the event ring's write pointer, read from a register, tells us how
+ * far the hardware got. No interrupt is used: the interface's thread polls (hakios.cell.c).
+ *
+ * What this processor needs, as Linux's driver sets them up for IPA 4.11 (drivers/net/ipa,
+ * ipa_data-v4.11.c, gsi.c, ipa_endpoint.c, ipa_cmd.c, ipa_table.c; the register layout from
+ * reg/gsi_reg-v4.11.c and reg/ipa_reg-v4.11.c):
+ *   - the command endpoint (7, channel 5): immediate commands to the IPA itself, which is how it
+ *     is told where its filter and route tables and its header table are;
+ *   - the "LAN" receive endpoint (9, channel 14): the IPA's default route (what matches no rule)
+ *     and its exceptions end here; it is looked at and dropped;
+ *   - the modem transmit endpoint (2, channel 2): IP packets to the modem, each behind a QMAP
+ *     header (4 bytes: pad length, mux id, packet length, big-endian);
+ *   - the modem receive endpoint (16, channel 7): IP packets from the modem, QMAP-framed, several
+ *     per buffer (the IPA aggregates them until 12 KB or 500 us).
+ * No checksum offload, no status packets: the network stack computes its checksums itself and
+ * the modem is told QMAP without checksum (hakios.mpss.c, WDA Set Data Format).
+ *
+ * All of this is done before the modem starts (Linux does the same): the tables the commands
+ * write hold pointers to one "zero rule", and the modem then writes its own rules into its part
+ * of them. The IPA reaches this memory through the SMMU context the modem driver gave it, which
+ * shows DDR as it is (physical addresses). The memory is cached for us, so every buffer is
+ * written back and dropped from the cache (dc civac) before the hardware looks at it and before
+ * we look at what the hardware wrote.
+ *
+ * modem_ipa_data_off=1: none of this. modem_ipa_data_trace=1: a line per packet.
+ */
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+#include <vm/vm_kern.h>
+#include <sys/hakios.ipa.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern uint64_t kvtophys(vm_offset_t va);
+extern void FlushPoC_DcacheRegion(vm_offset_t va, size_t length);
+
+static LCK_GRP_DECLARE(ipa_lock_group, "hakios-ipa");
+static LCK_MTX_DECLARE(ipa_lock, &ipa_lock_group);
+
+/* ---- the registers ---------------------------------------------------------------------------- */
+
+/*
+ * Where the IPA and the GSI are. These are the values of the first phone (POCO X5 Pro, SM7325),
+ * which another Qualcomm phone overrides from its own device tree: the "reg" of the node whose
+ * compatible is "qcom,ipa" (reg-names "ipa-base" and "gsi-base"), passed as boot-args soc_ipa_base
+ * and soc_gsi_base (tools/soc-args.py reads them off the phone's fdt). The IPA driver has one
+ * execution environment's worth of GSI registers mapped, from the inter-EE masks to the scratch.
+ */
+#define IPA_REGS_PHYS_DEFAULT   0x01e40000ull
+#define GSI_PHYS_DEFAULT        0x01e04000ull
+#define IPA_REGS_SIZE           0x1000
+#define GSI_FROM                0xc000          /* what is used of the GSI's registers: from the inter-EE masks (0xc020) to the scratch (0x12400) */
+#define GSI_SIZE                0x7000
+
+static uint64_t ipa_regs_phys = IPA_REGS_PHYS_DEFAULT, gsi_phys = GSI_PHYS_DEFAULT;
+static vm_offset_t ipa_regs, gsi_regs;         /* gsi_regs maps gsi_phys + GSI_FROM */
+
+static inline uint32_t
+ipa_rd(uint32_t offset)
+{
+	return *(volatile uint32_t *)(ipa_regs + offset);
+}
+
+static inline void
+ipa_wr(uint32_t offset, uint32_t value)
+{
+	*(volatile uint32_t *)(ipa_regs + offset) = value;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static inline uint32_t
+gsi_rd(uint32_t offset)
+{
+	return *(volatile uint32_t *)(gsi_regs + (offset - GSI_FROM));
+}
+
+static inline void
+gsi_wr(uint32_t offset, uint32_t value)
+{
+	*(volatile uint32_t *)(gsi_regs + (offset - GSI_FROM)) = value;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* The GSI's registers for our execution environment (EE 0; another EE's are 0x4000 further) */
+#define CH_CNTXT(c, n)          (0xf000 + 0x80 * (c) + 4 * (n))        /* n 0..3: type/dir/event ring/state, length, address */
+#define CH_QOS(c)               (0xf05c + 0x80 * (c))
+#define CH_SCRATCH(c, n)        (0xf060 + 0x80 * (c) + 4 * (n))
+#define EV_CNTXT(e, n)          (0x10000 + 0x80 * (e) + 4 * (n))       /* n 0..13: type/state, length, address, read/write pointers, moderation, MSI */
+#define CH_DOORBELL(c)          (0x11000 + 8 * (c))
+#define EV_DOORBELL(e)          (0x11100 + 8 * (e))
+#define GSI_STATUS              0x12000
+#define CH_CMD                  0x12008
+#define EV_CH_CMD               0x12010
+#define CNTXT_TYPE_IRQ          0x12080
+#define CNTXT_TYPE_IRQ_MSK      0x12088
+#define CNTXT_SRC_CH_IRQ        0x12090
+#define CNTXT_SRC_EV_CH_IRQ     0x12094
+#define CNTXT_SRC_CH_IRQ_MSK    0x12098
+#define CNTXT_SRC_EV_CH_IRQ_MSK 0x1209c
+#define CNTXT_SRC_CH_IRQ_CLR    0x120a0
+#define CNTXT_SRC_EV_CH_IRQ_CLR 0x120a4
+#define CNTXT_SRC_IEOB_IRQ      0x120b0
+#define CNTXT_SRC_IEOB_IRQ_MSK  0x120b8
+#define CNTXT_SRC_IEOB_IRQ_CLR  0x120c0
+#define CNTXT_GLOB_IRQ_STTS     0x12100
+#define CNTXT_GLOB_IRQ_EN       0x12108
+#define CNTXT_GLOB_IRQ_CLR      0x12110
+#define CNTXT_GSI_IRQ_STTS      0x12118
+#define CNTXT_GSI_IRQ_EN        0x12120
+#define CNTXT_GSI_IRQ_CLR       0x12128
+#define CNTXT_INTSET            0x12180
+#define ERROR_LOG               0x12200
+#define ERROR_LOG_CLR           0x12210
+#define INTER_EE_SRC_CH_IRQ_MSK 0xc020
+#define INTER_EE_SRC_EV_CH_IRQ_MSK 0xc024
+
+#define GSI_CH_ALLOCATE         0x0     /* channel commands (CH_CMD bits 31:24; the channel in 7:0) */
+#define GSI_CH_START            0x1
+#define GSI_CH_STOP             0x2
+#define GSI_CH_RESET            0x9
+#define GSI_CH_DE_ALLOC         0xa
+#define GSI_EVT_ALLOCATE        0x0     /* event ring commands (EV_CH_CMD, the same layout) */
+#define GSI_EVT_RESET           0x9
+#define GSI_EVT_DE_ALLOC        0xa
+#define CH_STATE_NOT_ALLOCATED  0       /* CH_CNTXT 0 bits 23:20 */
+#define CH_STATE_ALLOCATED      1
+#define CH_STATE_STARTED        2
+#define CH_STATE_STOPPED        3
+#define EV_STATE_NOT_ALLOCATED  0       /* EV_CNTXT 0 bits 23:20 */
+#define EV_STATE_ALLOCATED      1
+#define GSI_CHANNEL_TYPE_GPI    2
+#define ELEMENT_SIZE            16
+
+/* The IPA's endpoint registers (0x70 apart) */
+#define ENDP_INIT_CFG(ep)       (0x808 + 0x70 * (ep))
+#define ENDP_INIT_NAT(ep)       (0x80c + 0x70 * (ep))
+#define ENDP_INIT_HDR(ep)       (0x810 + 0x70 * (ep))
+#define ENDP_INIT_HDR_EXT(ep)   (0x814 + 0x70 * (ep))
+#define ENDP_INIT_HDR_METADATA_MASK(ep) (0x818 + 0x70 * (ep))
+#define ENDP_INIT_MODE(ep)      (0x820 + 0x70 * (ep))
+#define ENDP_INIT_AGGR(ep)      (0x824 + 0x70 * (ep))
+#define ENDP_INIT_HOL_BLOCK_EN(ep) (0x82c + 0x70 * (ep))
+#define ENDP_INIT_DEAGGR(ep)    (0x834 + 0x70 * (ep))
+#define ENDP_INIT_RSRC_GRP(ep)  (0x838 + 0x70 * (ep))
+#define ENDP_INIT_SEQ(ep)       (0x83c + 0x70 * (ep))
+#define ENDP_STATUS(ep)         (0x840 + 0x70 * (ep))
+#define IPA_SHARED_MEM_SIZE     0x54            /* bits 31:16: the local memory's offset in 8-byte units */
+#define IPA_FILT_ROUT_HASH_FLUSH 0x14c
+
+/* ---- memory the hardware reads and writes ------------------------------------------------------ */
+
+struct dma {
+	vm_offset_t     virt;
+	uint64_t        phys;
+};
+
+/* One page (16 KB), zeroed, written out of the cache; false if there is none. */
+static bool
+dma_page(struct dma *d)
+{
+	vm_offset_t virt = 0;
+
+	if (kmem_alloc(kernel_map, &virt, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	d->virt = virt;
+	d->phys = kvtophys(virt);
+	FlushPoC_DcacheRegion(virt, PAGE_SIZE);
+	return true;
+}
+
+/* Written back and dropped from the cache: before the hardware reads it, and before we read what the hardware wrote. */
+static inline void
+dma_sync(vm_offset_t virt, size_t size)
+{
+	vm_offset_t from = virt & ~63ul;
+
+	FlushPoC_DcacheRegion(from, ((virt + size + 63) & ~63ul) - from);
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* ---- the channels ------------------------------------------------------------------------------ */
+
+struct tre {
+	uint64_t        addr;
+	uint16_t        len_opcode;     /* bytes to transfer, or the immediate command's opcode */
+	uint16_t        reserved;
+	uint32_t        flags;          /* TRE_* */
+};
+#define TRE_CHAIN               (1u << 0)
+#define TRE_IEOT                (1u << 9)       /* an event when done */
+#define TRE_BEI                 (1u << 10)      /* ... but no interrupt for it */
+#define TRE_TYPE_XFER           (2u << 16)
+#define TRE_TYPE_COMMAND        (3u << 16)
+
+struct event {
+	uint64_t        xfer;           /* the address of the TRE that finished */
+	uint16_t        len;            /* bytes moved (what a receive buffer got) */
+	uint8_t         reserved1;
+	uint8_t         code;
+	uint16_t        reserved2;
+	uint8_t         type;
+	uint8_t         chid;
+};
+
+struct channel {
+	const char *    name;
+	uint8_t         id, ring_id, endpoint;  /* the channel, its event ring, the IPA's endpoint */
+	bool            to_ipa, command, qmap, aggregate, close_eof;
+	uint32_t        slots;          /* TREs in the ring, and buffers (a power of two; they fit one page: at most 1024) */
+	uint32_t        tlv;            /* the endpoint's TLV FIFO: how many TREs may be outstanding (ipa_data-v4.11.c tlv_count) */
+	uint32_t        buffer_size;    /* bytes per slot (a divisor or a multiple of the page size) */
+	struct dma      tre_ring, event_ring;
+	struct dma *    pages;          /* the buffers, slot by slot */
+	uint32_t        page_count;
+	uint32_t        next;           /* the next TRE to fill (counts up; the slot is next % slots) */
+	uint32_t        done;           /* the next TRE whose completion is awaited (transmit) */
+	uint32_t        events;         /* the next event to read (counts up) */
+	bool            started;
+	uint64_t        packets, bytes, dropped, errors;
+};
+
+/*
+ * The four: numbers from Linux's ipa_data-v4.11.c (channel, endpoint, TLV counts, which has
+ * QMAP and aggregation). Rings here are smaller than Linux's; the buffers are a page for a receive
+ * slot (the IPA aggregates into it) and 2 KB for a transmit slot (one packet and its header).
+ */
+static struct channel command = { "command", 5, 0, 7, true, true, false, false, false, 16, 20, 64 };
+#define RECEIVE_BUFFER          16384           /* a page: the IPA aggregates into it */
+static struct channel lan_rx = { "lan-rx", 14, 1, 9, false, false, false, true, false, 16, 9, RECEIVE_BUFFER };
+static struct channel modem_tx = { "modem-tx", 2, 2, 2, true, false, true, false, false, 64, 16, 2048 };
+static struct channel modem_rx = { "modem-rx", 7, 3, 16, false, false, true, true, true, 64, 9, RECEIVE_BUFFER };
+static struct channel *channels[] = { &command, &lan_rx, &modem_tx, &modem_rx };
+#define AGGR_LIMIT_KB           12              /* the IPA closes a receive buffer once this much is in it (a page holds another 4 KB packet) */
+#define AGGR_TIME_TICKS         5               /* ... or after 5 ticks of the first pulse generator: 500 us (TIMERS_PULSE_GRAN_CFG gran 0 = 100 us) */
+
+static bool ready, trace;
+static uint32_t mem_offset;                     /* the local memory's offset within the IPA's shared memory */
+static struct dma table, zero;                  /* the tables' page (below) and a page of zeros */
+
+static inline vm_offset_t
+slot_virt(const struct channel *ch, uint32_t slot)
+{
+	uint64_t at = (uint64_t)slot * ch->buffer_size;
+
+	return ch->pages[at / PAGE_SIZE].virt + at % PAGE_SIZE;
+}
+
+static inline uint64_t
+slot_phys(const struct channel *ch, uint32_t slot)
+{
+	uint64_t at = (uint64_t)slot * ch->buffer_size;
+
+	return ch->pages[at / PAGE_SIZE].phys + at % PAGE_SIZE;
+}
+
+static inline struct tre *
+tre_at(const struct channel *ch, uint32_t index)
+{
+	return (struct tre *)(ch->tre_ring.virt + (index % ch->slots) * ELEMENT_SIZE);
+}
+
+static bool
+channel_memory(struct channel *ch)
+{
+	uint64_t bytes = (uint64_t)ch->slots * ch->buffer_size;
+
+	ch->page_count = (uint32_t)((bytes + PAGE_SIZE - 1) / PAGE_SIZE);
+	ch->pages = kalloc_type(struct dma, ch->page_count, Z_WAITOK | Z_ZERO);
+	if (ch->pages == NULL || !dma_page(&ch->tre_ring) || !dma_page(&ch->event_ring)) {
+		return false;
+	}
+	for (uint32_t p = 0; p < ch->page_count; p++) {
+		if (!dma_page(&ch->pages[p])) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static void
+gsi_error(const char *what)
+{
+	uint32_t log = gsi_rd(ERROR_LOG);
+
+	printf("ipa: %s: GSI status %#x, error log %#x (code %u, type %u, EE %u, index %u, args %#x), global %#x, general %#x\n", what,
+	    gsi_rd(GSI_STATUS), log, (log >> 12) & 0xf, (log >> 24) & 0xf, log >> 28, (log >> 19) & 0x1f, log & 0xfff,
+	    gsi_rd(CNTXT_GLOB_IRQ_STTS), gsi_rd(CNTXT_GSI_IRQ_STTS));
+	if (log != 0) {
+		gsi_wr(ERROR_LOG, 0);
+		gsi_wr(ERROR_LOG_CLR, ~0u);
+	}
+}
+
+static inline uint32_t
+channel_state(const struct channel *ch)
+{
+	return (gsi_rd(CH_CNTXT(ch->id, 0)) >> 20) & 0xf;
+}
+
+static inline uint32_t
+event_ring_state(const struct channel *ch)
+{
+	return (gsi_rd(EV_CNTXT(ch->ring_id, 0)) >> 20) & 0xf;
+}
+
+/* A command to the GSI about a channel or an event ring; true once the state is `wanted` (within 50 ms). */
+static bool
+gsi_command(struct channel *ch, bool event, uint32_t opcode, uint32_t wanted)
+{
+	uint32_t state = 0, number = event ? ch->ring_id : ch->id;
+
+	gsi_wr(event ? EV_CH_CMD : CH_CMD, number | opcode << 24);
+	for (unsigned us = 0; us < 50000; us += 100) {
+		state = event ? event_ring_state(ch) : channel_state(ch);
+		if (state == wanted) {
+			break;
+		}
+		delay_for_interval(100, NSEC_PER_USEC);
+	}
+	/* (the completion is also flagged as an interrupt source, masked: cleared) */
+	gsi_wr(event ? CNTXT_SRC_EV_CH_IRQ_CLR : CNTXT_SRC_CH_IRQ_CLR, 1u << number);
+	if (state != wanted) {
+		printf("ipa: %s: command %#x on %s %u leaves it in state %u, not %u\n", ch->name, opcode, event ? "event ring" : "channel", number,
+		    state, wanted);
+		gsi_error(ch->name);
+		return false;
+	}
+	return true;
+}
+
+/* As Linux's gsi_irq_setup(): interrupts, not MSIs; every source masked (nothing is handled here: the rings are polled). */
+static void
+gsi_interrupts_off(void)
+{
+	gsi_wr(CNTXT_INTSET, 1);
+	gsi_wr(CNTXT_TYPE_IRQ_MSK, 0);
+	gsi_wr(CNTXT_SRC_CH_IRQ_MSK, 0);
+	gsi_wr(CNTXT_SRC_EV_CH_IRQ_MSK, 0);
+	gsi_wr(CNTXT_GLOB_IRQ_EN, 0);
+	gsi_wr(CNTXT_SRC_IEOB_IRQ_MSK, 0);
+	gsi_wr(INTER_EE_SRC_CH_IRQ_MSK, 0);
+	gsi_wr(INTER_EE_SRC_EV_CH_IRQ_MSK, 0);
+	gsi_wr(CNTXT_GSI_IRQ_EN, 0);
+}
+
+/* As Linux's gsi_evt_ring_program() and gsi_channel_program(), for the GPI protocol. */
+static bool
+channel_setup(struct channel *ch)
+{
+	uint32_t e = ch->ring_id, c = ch->id, value;
+
+	if (!gsi_command(ch, true, GSI_EVT_ALLOCATE, EV_STATE_ALLOCATED)) {
+		return false;
+	}
+	gsi_wr(EV_CNTXT(e, 0), GSI_CHANNEL_TYPE_GPI | 1u << 16 /* INTYPE: interrupt, not MSI */ | ELEMENT_SIZE << 24);
+	gsi_wr(EV_CNTXT(e, 1), ch->slots * ELEMENT_SIZE);
+	gsi_wr(EV_CNTXT(e, 2), (uint32_t)ch->event_ring.phys);
+	gsi_wr(EV_CNTXT(e, 3), (uint32_t)(ch->event_ring.phys >> 32));
+	gsi_wr(EV_CNTXT(e, 8), 32 /* moderation: 1 ms at 32 kHz */ | 1u << 16 /* MODC */);
+	for (unsigned n = 9; n <= 13; n++) {
+		gsi_wr(EV_CNTXT(e, n), 0);              /* no MSI, no read pointer updates */
+	}
+	/* "the last processed event": the ring's last entry, as nothing has been processed */
+	gsi_wr(EV_DOORBELL(e), (uint32_t)(ch->event_ring.phys + (ch->slots - 1) * ELEMENT_SIZE));
+
+	if (!gsi_command(ch, false, GSI_CH_ALLOCATE, CH_STATE_ALLOCATED)) {
+		return false;
+	}
+	gsi_wr(CH_CNTXT(c, 0), GSI_CHANNEL_TYPE_GPI | (ch->to_ipa ? 1u << 3 : 0) | e << 14 | ELEMENT_SIZE << 24);
+	gsi_wr(CH_CNTXT(c, 1), ch->slots * ELEMENT_SIZE);
+	gsi_wr(CH_CNTXT(c, 2), (uint32_t)ch->tre_ring.phys);
+	gsi_wr(CH_CNTXT(c, 3), (uint32_t)(ch->tre_ring.phys >> 32));
+	/* QOS: the command channel gets the lowest round-robin weight and no escape buffer; the doorbell counts bytes */
+	value = (ch->command ? 0xf : 0) | (ch->command ? 0 : 1u << 10 /* PREFETCH_MODE: escape buffer only */) | 1u << 24;
+	gsi_wr(CH_QOS(c), value);
+	/* the GPI scratch: the most outstanding TREs (in bytes), the threshold 2 TREs */
+	gsi_wr(CH_SCRATCH(c, 0), (ch->tlv * ELEMENT_SIZE) << 16);
+	gsi_wr(CH_SCRATCH(c, 1), (2 * ELEMENT_SIZE) << 16);
+	gsi_wr(CH_SCRATCH(c, 2), 0);
+	gsi_wr(CH_SCRATCH(c, 3), gsi_rd(CH_SCRATCH(c, 3)) & 0xffff);
+	return true;
+}
+
+/* As Linux's ipa_endpoint_program() for IPA 4.11, with no checksum offload and no status. */
+static void
+endpoint_program(const struct channel *ch)
+{
+	uint32_t ep = ch->endpoint, value;
+
+	ipa_wr(ENDP_INIT_CFG(ep), 0);                   /* no fragment or checksum offload */
+	ipa_wr(ENDP_INIT_NAT(ep), 0);                   /* NAT bypassed */
+	value = 0;
+	if (ch->qmap) {
+		value = 4 /* HDR_LEN */ | 1u << 6 /* HDR_OFST_METADATA_VALID, at 0 */;
+		if (!ch->to_ipa) {
+			/* where the IPA writes the mux id (byte 1) and the packet's length (bytes 2-3) of the header it makes */
+			value |= 1u << 7 /* HDR_OFST_METADATA */ | 1u << 19 /* HDR_OFST_PKT_SIZE_VALID */ | 2u << 20 /* HDR_OFST_PKT_SIZE */;
+		}
+	}
+	ipa_wr(ENDP_INIT_HDR(ep), value);
+	value = 0;
+	if (ch->qmap) {
+		value = 1 /* HDR_ENDIANNESS: big */;
+		if (!ch->to_ipa) {
+			value |= 1u << 1 /* HDR_TOTAL_LEN_OR_PAD_VALID (pad) */ | 1u << 3 /* HDR_PAYLOAD_LEN_INC_PADDING */;
+		}
+	}
+	ipa_wr(ENDP_INIT_HDR_EXT(ep), value);
+	if (!ch->to_ipa) {
+		ipa_wr(ENDP_INIT_HDR_METADATA_MASK(ep), ch->qmap ? 0xff000000 : 0);   /* the metadata's low byte, big-endian */
+	} else {
+		/* the command endpoint moves its data to the LAN receive endpoint (DMA mode); the rest is basic */
+		ipa_wr(ENDP_INIT_MODE(ep), ch->command ? 3 | (uint32_t)lan_rx.endpoint << 4 : 0);
+	}
+	if (!ch->to_ipa && ch->aggregate) {
+		value = 1 /* AGGR_EN: aggregate */ | 4u << 2 /* AGGR_TYPE: generic */ | AGGR_LIMIT_KB << 5 | AGGR_TIME_TICKS << 12 |
+		    (ch->close_eof ? 1u << 23 /* SW_EOF_ACTIVE */ : 0);
+	} else if (ch->to_ipa && ch->qmap) {
+		value = 2 /* AGGR_EN: deaggregate */ | 6u << 2 /* AGGR_TYPE: QCMAP */;
+	} else {
+		value = 0;
+	}
+	ipa_wr(ENDP_INIT_AGGR(ep), value);
+	if (!ch->to_ipa) {
+		ipa_wr(ENDP_INIT_HOL_BLOCK_EN(ep), 0);  /* no head-of-line blocking drops */
+	} else {
+		ipa_wr(ENDP_INIT_DEAGGR(ep), 0);
+	}
+	ipa_wr(ENDP_INIT_RSRC_GRP(ep), 0);              /* resource group 0: UL/DL (the only one with limits) */
+	if (ch->to_ipa) {
+		ipa_wr(ENDP_INIT_SEQ(ep), ch->command ? 0 /* DMA */ : 4 /* 2_PASS_SKIP_LAST_UC */);
+	}
+	ipa_wr(ENDP_STATUS(ep), 0);                     /* no status packets */
+}
+
+/* The TRE at `index` of the channel's ring, filled and written out; the doorbell is rung separately. */
+static void
+tre_fill(struct channel *ch, uint32_t index, uint64_t addr, uint16_t len_opcode, uint32_t flags)
+{
+	struct tre *t = tre_at(ch, index);
+
+	t->addr = addr;
+	t->len_opcode = len_opcode;
+	t->reserved = 0;
+	t->flags = flags;
+	dma_sync((vm_offset_t)t, sizeof(*t));
+}
+
+static inline void
+channel_doorbell(struct channel *ch)
+{
+	gsi_wr(CH_DOORBELL(ch->id), (uint32_t)(ch->tre_ring.phys + (ch->next % ch->slots) * ELEMENT_SIZE));
+}
+
+/*
+ * The events the hardware has written since last time, each to `each`. The event ring's write
+ * pointer is in its context register 4; the doorbell afterwards tells the hardware the last event
+ * read, which makes room.
+ */
+static unsigned
+channel_events(struct channel *ch, void (*each)(struct channel *, const struct event *, void *), void *context)
+{
+	uint32_t wp = gsi_rd(EV_CNTXT(ch->ring_id, 4)), base = (uint32_t)ch->event_ring.phys, index;
+	unsigned n = 0;
+
+	if (wp < base || wp >= base + ch->slots * ELEMENT_SIZE) {
+		if (ch->errors++ == 0) {
+			printf("ipa: %s: the event ring's write pointer %#x is outside the ring at %#x\n", ch->name, wp, base);
+		}
+		return 0;
+	}
+	index = (wp - base) / ELEMENT_SIZE;
+	while (ch->events % ch->slots != index) {
+		struct event *e = (struct event *)(ch->event_ring.virt + (ch->events % ch->slots) * ELEMENT_SIZE);
+
+		dma_sync((vm_offset_t)e, sizeof(*e));
+		each(ch, e, context);
+		ch->events++;
+		n++;
+	}
+	if (n != 0) {
+		gsi_wr(EV_DOORBELL(ch->ring_id), (uint32_t)(ch->event_ring.phys + ((ch->events - 1) % ch->slots) * ELEMENT_SIZE));
+	}
+	return n;
+}
+
+/* ---- immediate commands ------------------------------------------------------------------------- */
+
+#define IPA_CMD_IP_V4_FILTER_INIT 0x3
+#define IPA_CMD_IP_V6_FILTER_INIT 0x4
+#define IPA_CMD_IP_V4_ROUTING_INIT 0x7
+#define IPA_CMD_IP_V6_ROUTING_INIT 0x8
+#define IPA_CMD_HDR_INIT_LOCAL  0x9
+#define IPA_CMD_DMA_SHARED_MEM  0x13
+
+struct command_done {
+	uint64_t        tre;
+	bool            done;
+	uint8_t         code;
+};
+
+static void
+command_event(__unused struct channel *ch, const struct event *e, void *context)
+{
+	struct command_done *waiting = context;
+
+	if (e->xfer == waiting->tre) {
+		waiting->done = true;
+		waiting->code = e->code;
+	}
+	command.done++;
+}
+
+/* One immediate command, waited for (up to 200 ms). The payload is copied into the slot's buffer. */
+static bool
+ipa_command(const char *what, uint8_t opcode, const void *payload, size_t size)
+{
+	uint32_t slot = command.next % command.slots;
+	struct command_done waiting = { .tre = command.tre_ring.phys + slot * ELEMENT_SIZE };
+
+	if (size > command.buffer_size || command.next - command.done >= command.slots - 1) {
+		return false;
+	}
+	memcpy((void *)slot_virt(&command, slot), payload, size);
+	dma_sync(slot_virt(&command, slot), size);
+	tre_fill(&command, command.next, slot_phys(&command, slot), opcode, TRE_TYPE_COMMAND | TRE_IEOT);
+	command.next++;
+	channel_doorbell(&command);
+	for (unsigned us = 0; us < 200000 && !waiting.done; us += 200) {
+		channel_events(&command, command_event, &waiting);
+		if (!waiting.done) {
+			delay_for_interval(200, NSEC_PER_USEC);
+		}
+	}
+	if (!waiting.done) {
+		printf("ipa: the command %s (opcode %#x) is not answered in 200 ms; channel state %u\n", what, opcode, channel_state(&command));
+		gsi_error(what);
+		return false;
+	}
+	if (trace) {
+		printf("ipa: the command %s (opcode %#x) done, code %u\n", what, opcode, waiting.code);
+	}
+	return true;
+}
+
+/*
+ * The tables, as Linux's ipa_table_init() lays them out in one buffer: a "zero rule" (8 bytes of
+ * zero, which every table entry points at until somebody installs a rule), then the filter
+ * table's bitmap of the endpoints that filter (bit n+1 for endpoint n: 2, 5 and 8 -- our modem
+ * transmit endpoint and two of the modem's), then as many entries as the longest table (15: the
+ * route tables' size, 0x78 bytes), each the zero rule's address. The filter table is the bitmap
+ * and 3 entries from offset 8; a route table the 15 entries from offset 16.
+ *
+ * The IPA's local memory, in the layout the modem driver zeroed (Android's ipa_4_11_mem_part,
+ * the same offsets as Linux's ipa_mem_local_data for these): IPv4 filter hashed 0x288, not
+ * hashed 0x308, IPv6 0x388/0x408; IPv4 route 0x488/0x508, IPv6 0x588/0x608; the modem's and our
+ * headers 0x688, 0x440 bytes in all.
+ */
+#define FILTERED_ENDPOINTS      ((1ull << 2) | (1ull << 5) | (1ull << 8))
+#define FILTER_ENTRIES          4               /* the bitmap and one per filtering endpoint */
+#define ROUTE_ENTRIES           15
+
+static bool
+table_init(const char *what, uint8_t opcode, bool filter, uint32_t hashed_offset, uint32_t offset)
+{
+	struct {
+		uint64_t hash_rules_addr, flags, nhash_rules_addr;
+	} payload;
+	uint32_t entries = filter ? FILTER_ENTRIES : ROUTE_ENTRIES, size = entries * 8;
+	uint64_t source = table.phys + (filter ? 8 : 16);
+
+	payload.hash_rules_addr = source;
+	payload.nhash_rules_addr = source;
+	payload.flags = (uint64_t)size | (uint64_t)(mem_offset + hashed_offset) << 12 | (uint64_t)size << 28 |
+	    (uint64_t)(mem_offset + offset) << 40;
+	return ipa_command(what, opcode, &payload, sizeof(payload));
+}
+
+static bool
+tables_setup(void)
+{
+	uint64_t *t = (uint64_t *)table.virt;
+	struct {
+		uint64_t hdr_table_addr;
+		uint32_t flags, reserved;
+	} headers;
+
+	t[0] = 0;                                       /* the zero rule */
+	t[1] = FILTERED_ENDPOINTS << 1;                 /* the filter bitmap */
+	for (unsigned n = 0; n < ROUTE_ENTRIES; n++) {
+		t[2 + n] = table.phys;
+	}
+	dma_sync(table.virt, (2 + ROUTE_ENTRIES) * 8);
+	if (!table_init("IPv4 route table init", IPA_CMD_IP_V4_ROUTING_INIT, false, 0x488, 0x508) ||
+	    !table_init("IPv6 route table init", IPA_CMD_IP_V6_ROUTING_INIT, false, 0x588, 0x608) ||
+	    !table_init("IPv4 filter table init", IPA_CMD_IP_V4_FILTER_INIT, true, 0x288, 0x308) ||
+	    !table_init("IPv6 filter table init", IPA_CMD_IP_V6_FILTER_INIT, true, 0x388, 0x408)) {
+		return false;
+	}
+	headers.hdr_table_addr = zero.phys;
+	headers.flags = 0x440 | (mem_offset + 0x688) << 12;
+	headers.reserved = 0;
+	if (!ipa_command("header table init", IPA_CMD_HDR_INIT_LOCAL, &headers, sizeof(headers))) {
+		return false;
+	}
+	ipa_wr(IPA_FILT_ROUT_HASH_FLUSH, 0x1111);      /* the hashed tables' caches, flushed */
+	return true;
+}
+
+/* ---- receiving and sending ---------------------------------------------------------------------- */
+
+/* A receive slot handed to the hardware (one TRE for the whole buffer). */
+static void
+receive_post(struct channel *ch, uint32_t slot)
+{
+	tre_fill(ch, ch->next, slot_phys(ch, slot), (uint16_t)(ch->buffer_size > 0xffff ? 0xffff : ch->buffer_size), TRE_TYPE_XFER | TRE_IEOT);
+	ch->next++;
+}
+
+struct receive_context {
+	void            (*receive)(uint8_t mux, const uint8_t *packet, size_t length);
+	unsigned        packets;
+};
+
+/* A receive buffer is full (or closed): the QMAP packets in it, one by one; then the slot is posted again. */
+static void
+receive_event(struct channel *ch, const struct event *e, void *context)
+{
+	struct receive_context *rc = context;
+	uint32_t slot = (uint32_t)((e->xfer - ch->tre_ring.phys) / ELEMENT_SIZE), length = e->len;
+	const uint8_t *buffer;
+
+	if (slot >= ch->slots || e->xfer < ch->tre_ring.phys) {
+		if (ch->errors++ < 4) {
+			printf("ipa: %s: an event for TRE %#llx, outside the ring at %#llx\n", ch->name, e->xfer, ch->tre_ring.phys);
+		}
+		return;
+	}
+	/* receives complete in order; ch->done is the next expected slot, ch->next the next to post (slots-1 ahead) */
+	if (slot != ch->done % ch->slots) {
+		if (ch->errors++ < 4) {
+			printf("ipa: %s: slot %u finished while slot %u was expected\n", ch->name, slot, ch->done % ch->slots);
+		}
+	}
+	ch->done++;
+	buffer = (const uint8_t *)slot_virt(ch, slot);
+	if (length > ch->buffer_size) {
+		length = ch->buffer_size;
+	}
+	dma_sync((vm_offset_t)buffer, length);
+	ch->bytes += length;
+	if (trace) {
+		printf("ipa: %s: slot %u: %u bytes (code %u): %02x %02x %02x %02x %02x %02x %02x %02x ...\n", ch->name, slot, length, e->code,
+		    buffer[0], buffer[1], buffer[2], buffer[3], buffer[4], buffer[5], buffer[6], buffer[7]);
+	}
+	if (ch->qmap) {
+		for (uint32_t at = 0; at + 4 <= length;) {
+			uint32_t pad = buffer[at] & 0x3f, cmd = buffer[at] & 0x80, mux = buffer[at + 1];
+			uint32_t packet = (uint32_t)buffer[at + 2] << 8 | buffer[at + 3];
+
+			if (packet == 0 || at + 4 + packet > length || pad > packet) {
+				break;
+			}
+			if (cmd == 0) {
+				ch->packets++;
+				rc->packets++;
+				if (rc->receive != NULL) {
+					rc->receive((uint8_t)mux, buffer + at + 4, packet - pad);
+				}
+			} else if (trace) {
+				printf("ipa: %s: a QMAP command (%u bytes) on mux %u\n", ch->name, packet, mux);
+			}
+			at += 4 + packet;
+		}
+	} else {
+		ch->packets++;                          /* the LAN endpoint: looked at, dropped */
+	}
+	/* the slot posted again -- the one at the ring's next TRE, which is this one while the hardware finishes in order */
+	receive_post(ch, ch->next % ch->slots);
+	channel_doorbell(ch);
+}
+
+static void
+transmit_event(struct channel *ch, const struct event *e, __unused void *context)
+{
+	uint32_t slot = (uint32_t)((e->xfer - ch->tre_ring.phys) / ELEMENT_SIZE);
+
+	if (slot != ch->done % ch->slots && ch->errors++ < 4) {
+		printf("ipa: %s: slot %u finished while slot %u was expected (code %u)\n", ch->name, slot, ch->done % ch->slots, e->code);
+	}
+	ch->done++;
+}
+
+bool
+hakios_ipa_transmit(uint8_t mux, const void *packet, size_t length)
+{
+	struct channel *ch = &modem_tx;
+	uint32_t slot;
+	uint8_t *buffer;
+
+	if (!ready || length == 0 || length + 4 > ch->buffer_size) {
+		return false;
+	}
+	lck_mtx_lock(&ipa_lock);
+	channel_events(ch, transmit_event, NULL);
+	if (ch->next - ch->done >= ch->slots - 1) {     /* one slot always left free: write==read means empty */
+		ch->dropped++;
+		lck_mtx_unlock(&ipa_lock);
+		return false;
+	}
+	slot = ch->next % ch->slots;
+	buffer = (uint8_t *)slot_virt(ch, slot);
+	buffer[0] = 0;                                  /* no pad, not a command */
+	buffer[1] = mux;
+	buffer[2] = (uint8_t)(length >> 8);
+	buffer[3] = (uint8_t)length;
+	memcpy(buffer + 4, packet, length);
+	dma_sync((vm_offset_t)buffer, length + 4);
+	tre_fill(ch, ch->next, slot_phys(ch, slot), (uint16_t)(length + 4), TRE_TYPE_XFER | TRE_IEOT | TRE_BEI);
+	ch->next++;
+	channel_doorbell(ch);
+	ch->packets++;
+	ch->bytes += length;
+	if (trace) {
+		printf("ipa: %s: slot %u: %zu bytes on mux %u\n", ch->name, slot, length, mux);
+	}
+	lck_mtx_unlock(&ipa_lock);
+	return true;
+}
+
+unsigned
+hakios_ipa_poll(void (*receive)(uint8_t mux, const uint8_t *packet, size_t length))
+{
+	struct receive_context rc = { receive, 0 };
+
+	if (!ready) {
+		return 0;
+	}
+	lck_mtx_lock(&ipa_lock);
+	channel_events(&modem_rx, receive_event, &rc);
+	channel_events(&lan_rx, receive_event, &rc);
+	channel_events(&modem_tx, transmit_event, NULL);
+	lck_mtx_unlock(&ipa_lock);
+	return rc.packets;
+}
+
+void
+hakios_ipa_modem_endpoints(uint32_t *to_modem, uint32_t *from_modem)
+{
+	*to_modem = modem_tx.endpoint;          /* 2: what Linux exports as modem/tx_endpoint_id */
+	*from_modem = modem_rx.endpoint;        /* 16: modem/rx_endpoint_id */
+}
+
+bool
+hakios_ipa_data_ready(void)
+{
+	return ready;
+}
+
+void
+hakios_ipa_status(char *to, size_t size)
+{
+	snprintf(to, size, "to the modem %llu packets (%llu bytes, %llu dropped), from it %llu (%llu bytes), %llu to the LAN endpoint; "
+	    "errors %llu/%llu/%llu; channels %u/%u/%u/%u", modem_tx.packets, modem_tx.bytes, modem_tx.dropped, modem_rx.packets, modem_rx.bytes,
+	    lan_rx.packets, modem_tx.errors, modem_rx.errors, lan_rx.errors, channel_state(&command), channel_state(&lan_rx),
+	    channel_state(&modem_tx), channel_state(&modem_rx));
+}
+
+/* ---- setting up ---------------------------------------------------------------------------------- */
+
+bool
+hakios_ipa_data_setup(void)
+{
+	uint32_t status, shared;
+	char line[256];
+
+	if (ready) {
+		return true;
+	}
+	{
+		uint32_t off = 0;
+
+		if (PE_parse_boot_argn("modem_ipa_data_off", &off, sizeof(off)) && off != 0) {
+			printf("ipa: no data path (modem_ipa_data_off)\n");
+			return false;
+		}
+		PE_parse_boot_argn("modem_ipa_data_trace", &off, sizeof(off));
+		trace = off != 0;
+	}
+	if (PAGE_SIZE != RECEIVE_BUFFER) {
+		printf("ipa: pages of %lu bytes, not %u: no data path\n", (unsigned long)PAGE_SIZE, RECEIVE_BUFFER);
+		return false;
+	}
+	if (ipa_regs == 0) {
+		PE_parse_boot_argn("soc_ipa_base", &ipa_regs_phys, sizeof(ipa_regs_phys));
+		PE_parse_boot_argn("soc_gsi_base", &gsi_phys, sizeof(gsi_phys));
+		ipa_regs = ml_io_map(ipa_regs_phys, IPA_REGS_SIZE);
+		gsi_regs = ml_io_map(gsi_phys + GSI_FROM, GSI_SIZE);
+	}
+	if (ipa_regs == 0 || gsi_regs == 0) {
+		printf("ipa: the registers cannot be mapped: no data path\n");
+		return false;
+	}
+	status = gsi_rd(GSI_STATUS);
+	shared = ipa_rd(IPA_SHARED_MEM_SIZE);
+	mem_offset = 8 * (shared >> 16);
+	if ((status & 1) == 0) {
+		printf("ipa: the GSI is not enabled (status %#x): no data path\n", status);
+		return false;
+	}
+	if (!dma_page(&table) || !dma_page(&zero)) {
+		printf("ipa: no memory for the tables: no data path\n");
+		return false;
+	}
+	for (unsigned n = 0; n < 4; n++) {
+		if (!channel_memory(channels[n])) {
+			printf("ipa: no memory for the %s channel: no data path\n", channels[n]->name);
+			return false;
+		}
+	}
+	printf("ipa: setting up this processor's data path: GSI status %#x, local memory at %#x; rings and buffers in DDR from %#llx "
+	    "(the tables at %#llx)\n", status, mem_offset, modem_rx.pages[0].phys, table.phys);
+	gsi_interrupts_off();
+	for (unsigned n = 0; n < 4; n++) {
+		struct channel *ch = channels[n];
+
+		if (!channel_setup(ch)) {
+			printf("ipa: the %s channel (%u, event ring %u) cannot be set up: no data path\n", ch->name, ch->id, ch->ring_id);
+			return false;
+		}
+		endpoint_program(ch);
+	}
+	for (unsigned n = 0; n < 4; n++) {
+		struct channel *ch = channels[n];
+
+		if (!gsi_command(ch, false, GSI_CH_START, CH_STATE_STARTED)) {
+			printf("ipa: the %s channel does not start: no data path\n", ch->name);
+			return false;
+		}
+		ch->started = true;
+		if (!ch->to_ipa) {
+			/* one short of the ring: the doorbell is the write pointer, and writing it level with
+			 * the read pointer (base) would mean "empty", not "full" */
+			for (uint32_t slot = 0; slot + 1 < ch->slots; slot++) {
+				receive_post(ch, slot);
+			}
+			channel_doorbell(ch);
+		}
+	}
+	if (!tables_setup()) {
+		printf("ipa: the IPA does not take its tables: no data path (the channels stay)\n");
+		return false;
+	}
+	ready = true;
+	hakios_ipa_status(line, sizeof(line));
+	printf("ipa: THE DATA PATH IS UP: endpoints %u (commands), %u (LAN in), %u (to the modem), %u (from the modem); the tables set; %s\n",
+	    command.endpoint, lan_rx.endpoint, modem_tx.endpoint, modem_rx.endpoint, line);
+	return true;
+}
diff --git a/bsd/dev/hakios.lx.c b/bsd/dev/hakios.lx.c
new file mode 100644
index 0000000..8203bef
--- /dev/null
+++ b/bsd/dev/hakios.lx.c
@@ -0,0 +1,582 @@
+/*
+ * Darwin-on-hakios: the kernel's side of the Wi-Fi driver's object.
+ *
+ * The driver of the phone's radio is Linux's ath11k, compiled unmodified outside this tree on a
+ * layer that gives it the kernel interfaces it expects, and tied into one object that the
+ * kernel links when it is there (tools/mk-ath11k.sh and wifi/lx in the repository; the kernel
+ * is built with that object when xnu-build.sh finds it). The object shows one name, lx_start(),
+ * and asks for the calls of sys/hakios.lx.h, which are here: memory, time, threads, one lock
+ * to sleep under, the kernel's options. What it asks of the radio itself -- its firmware's
+ * files, its view of memory, the processor its firmware runs on -- is hakios.wifi.c's to
+ * answer, which knows the phone.
+ *
+ * A kernel built without the object has the lx_start() at the end of this file, which says so.
+ */
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>
+#include <kern/thread.h>
+#include <os/atomic_private.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+#include <sys/random.h>
+#include <sys/hakios.input.h>
+#include <sys/hakios.lx.h>
+#include <sys/hakios.net.h>
+#include <sys/systm.h>
+#include <vm/memory_types.h>
+#include <vm/vm_kern.h>
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, unsigned int flags);
+extern uint64_t kvtophys(vm_offset_t va);       /* pmap_paddr_t */
+extern kern_return_t thread_terminate(thread_t thread);
+extern void thread_set_thread_name(thread_t thread, const char *name);
+
+#define say hakios_wifi_say
+
+static LCK_GRP_DECLARE(lx_lock_group, "hakios-lx");
+static LCK_MTX_DECLARE(lx_lock, &lx_lock_group);
+
+/* ---- memory ------------------------------------------------------------------------------------------ */
+
+void *
+lx_os_alloc(unsigned long size)
+{
+	return kalloc_data(size, Z_WAITOK | Z_ZERO);
+}
+
+void
+lx_os_free(void *memory, unsigned long size)
+{
+	kfree_data(memory, size);
+}
+
+/*
+ * In one physical piece, so that it can be mapped a second time without this processor's cache
+ * in between (as hakios.adreno.c does with what it shares with the GPU); the first, cached
+ * view is written out and never used again.
+ */
+void *
+lx_os_radio_memory(unsigned long size, unsigned long long *address)
+{
+	vm_offset_t cached = 0, uncached;
+	uint64_t physical;
+
+	size = round_page(size);
+	if (kmem_alloc_contig(kernel_map, &cached, size, 0, 0, 0, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) !=
+	    KERN_SUCCESS) {
+		say("lx: no %lu bytes of memory in one piece\n", size);
+		return NULL;
+	}
+	physical = kvtophys(cached);
+	bzero((void *)cached, size);
+	for (vm_offset_t line = cached; line < cached + size; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line));
+	}
+	__asm__ volatile ("dsb sy");
+	uncached = ml_io_map_unmappable(physical, size, VM_WIMG_WCOMB);
+	if (uncached == 0 || !hakios_wifi_radio_map(physical, size, address)) {
+		return NULL;
+	}
+	return (void *)uncached;
+}
+
+void *
+lx_os_map_registers(unsigned long long physical, unsigned long size)
+{
+	unsigned long long page = trunc_page(physical);
+	vm_offset_t mapped = ml_io_map_unmappable(page, round_page(physical + size) - page, VM_WIMG_IO);
+
+	return mapped == 0 ? NULL : (void *)(mapped + (physical - page));
+}
+
+/* ---- saying things ----------------------------------------------------------------------------------- */
+
+void
+lx_os_print(const char *text)
+{
+	say("%s", text);
+}
+
+void
+lx_os_tell(const char *text)
+{
+	hakios_wifi_tell("%s", text);
+}
+
+void
+lx_os_panic(const char *text)
+{
+	panic("%s", text);
+}
+
+/* ---- time, threads, sleeping --------------------------------------------------------------------------- */
+
+unsigned long long
+lx_os_nanoseconds(void)
+{
+	uint64_t nanoseconds;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &nanoseconds);
+	return nanoseconds;
+}
+
+void *
+lx_os_thread_self(void)
+{
+	return current_thread();
+}
+
+struct lx_thread {
+	void (*function)(void *);
+	void *argument;
+};
+
+static void
+lx_thread_runs(void *parameter, __unused wait_result_t result)
+{
+	struct lx_thread start = *(struct lx_thread *)parameter;
+
+	kfree_type(struct lx_thread, parameter);
+	start.function(start.argument);
+	thread_terminate(current_thread());
+}
+
+int
+lx_os_thread(const char *name, void (*function)(void *), void *argument)
+{
+	struct lx_thread *start = kalloc_type(struct lx_thread, Z_WAITOK | Z_ZERO);
+	thread_t thread;
+
+	if (start == NULL) {
+		return ENOMEM;
+	}
+	start->function = function;
+	start->argument = argument;
+	if (kernel_thread_start(lx_thread_runs, start, &thread) != KERN_SUCCESS) {
+		kfree_type(struct lx_thread, start);
+		return EAGAIN;
+	}
+	thread_set_thread_name(thread, name);
+	thread_deallocate(thread);
+	return 0;
+}
+
+void
+lx_os_lock(void)
+{
+	lck_mtx_lock(&lx_lock);
+}
+
+void
+lx_os_unlock(void)
+{
+	lck_mtx_unlock(&lx_lock);
+}
+
+int
+lx_os_sleep(const void *address, unsigned long long nanoseconds)
+{
+	uint64_t deadline;
+
+	if (nanoseconds == 0) {
+		return lck_mtx_sleep(&lx_lock, LCK_SLEEP_DEFAULT, (event_t)address, THREAD_UNINT) == THREAD_TIMED_OUT;
+	}
+	nanoseconds_to_absolutetime(nanoseconds, &deadline);
+	deadline += mach_absolute_time();
+	return lck_mtx_sleep_deadline(&lx_lock, LCK_SLEEP_DEFAULT, (event_t)address, THREAD_UNINT, deadline) == THREAD_TIMED_OUT;
+}
+
+void
+lx_os_wakeup(const void *address)
+{
+	thread_wakeup((event_t)address);
+}
+
+/* ---- the rest of the machine ------------------------------------------------------------------------- */
+
+void
+lx_os_random(void *buffer, unsigned long size)
+{
+	read_random(buffer, (u_int)size);
+}
+
+unsigned
+lx_os_option(const char *name)
+{
+	return hakios_wifi_option(name);
+}
+
+int
+lx_os_firmware(const char *name, const void **data, unsigned long *size)
+{
+	uint64_t length = 0;
+	const uint8_t *file = hakios_wifi_driver_file(name, &length);
+
+	if (file == NULL) {
+		return ENOENT;
