+#define APFS_INODE_SNAPSHOT_COW_EXEMPTION 0x00400000
+
+/* directory entry.  iOS uses the hashed key; the hash is of the name, case-folded. */
+struct apfs_j_drec_key {
+	struct apfs_j_key hdr;
