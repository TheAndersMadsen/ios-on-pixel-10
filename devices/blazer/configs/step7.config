# Ladder step 7 (owner's order: haptic, torch/camera PMIC, BT, modem, NFC): step 6 + all of them. Booted one driver at a time
# in the order HAPTIC -> TORCH -> NFC (requires HAPTIC) -> MODEM -> BT (requires WIFI); this file is the end state.
#include step6.config
CONFIG_HAKIOS_HAPTIC=y
CONFIG_HAKIOS_TORCH=y
CONFIG_HAKIOS_NFC=y
CONFIG_HAKIOS_MODEM=y
CONFIG_HAKIOS_BT=y
