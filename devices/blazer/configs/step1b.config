# Ladder step 1b: step 1 + the platform services RTC, CLKMON, WDT, HALT. One question per boot: do they build and run in a
# kernel that has nothing else of the phone's? Gates on the port-2 line: blazer_rtc=1 blazer_rtc_bounds=1 (+ the image's
# epoch floor), hk_clk=30. WDT and HALT are built in but NOT turned on: blazer_wdt/blazer_halt are not on the image tool's
# phone allow-list (never seen running on the phone; arming the 30 s reset watchdog needs a reviewed line).
#include step1.config
CONFIG_HAKIOS_RTC=y
CONFIG_HAKIOS_CLKMON=y
CONFIG_HAKIOS_WDT=y
CONFIG_HAKIOS_HALT=y
