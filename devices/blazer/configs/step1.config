# Ladder step 1 (owner's order: CPUFREQ / THERMAL / SOCINFO): the minimal kernel plus the SoC's identity, the Tj guard and
# the clock votes. Each still needs its boot-argument: blazer_smp_report=1, blazer_thermal=2 (+ blazer_thermal_fast=1),
# blazer_gov=1 ... (or hk_pw=). CPUFREQ requires THERMAL.
#include minimal.config
CONFIG_HAKIOS_SOCINFO=y
CONFIG_HAKIOS_THERMAL=y
CONFIG_HAKIOS_CPUFREQ=y
