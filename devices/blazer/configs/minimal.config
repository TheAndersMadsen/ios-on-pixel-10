# Ladder step 0: the first boot "with nothing of the phone's". Only what this phone's boot path cannot do without:
#   UFS      the root file system is ios_system on UFS (read only; no ramdisk root on this port), so no UFS = no launchd
#   DISPLAY  AppleCLCD on the panel buffer the shim leaves scanning: backboardd/SpringBoard need an IOMobileFramebuffer,
#            and the screen is the only proof of Home a host-only boot has besides the console
#   USBCON   the live USB console: the boot's only log while it runs, and (blazer_usbcon=2) how the host ends it early
# Everything else is out: no CPU clock votes (firmware's clocks), no thermal guard (60 s at firmware clocks), no touch/keys,
# no RTC (calendar from epoch=), no watchdog/halt (the host ends the boot), no Wi-Fi/BT/modem/GPU/audio/sensors.
CONFIG_HAKIOS_USBCON=y
CONFIG_HAKIOS_UFS=y
CONFIG_HAKIOS_DISPLAY=y
# CONFIG_HAKIOS_USBNET is not set
# CONFIG_HAKIOS_SOCINFO is not set
# CONFIG_HAKIOS_THERMAL is not set
# CONFIG_HAKIOS_CPUFREQ is not set
# CONFIG_HAKIOS_CLKMON is not set
# CONFIG_HAKIOS_RTC is not set
# CONFIG_HAKIOS_WDT is not set
# CONFIG_HAKIOS_HALT is not set
# CONFIG_HAKIOS_BUTTONS is not set
# CONFIG_HAKIOS_TOUCH is not set
# CONFIG_HAKIOS_SLEEP is not set
# CONFIG_HAKIOS_GPU is not set
# CONFIG_HAKIOS_AUDIO is not set
# CONFIG_HAKIOS_AOC is not set
# CONFIG_HAKIOS_AOC_FW is not set
# CONFIG_HAKIOS_BATTERY is not set
# CONFIG_HAKIOS_POWERMON is not set
# CONFIG_HAKIOS_SENSORS is not set
# CONFIG_HAKIOS_WIFI is not set
# CONFIG_HAKIOS_HAPTIC is not set
# CONFIG_HAKIOS_TORCH is not set
# CONFIG_HAKIOS_NFC is not set
# CONFIG_HAKIOS_MODEM is not set
# CONFIG_HAKIOS_BT is not set
# CONFIG_HAKIOS_SWEET_LEGACY is not set
