+/* The curve's nits for a DBV, in tenths, for the log only (the inverse of hkb_dbv_q16 between the same points). */
+static inline uint32_t hkb_dbv_nits_x10(uint32_t dbv)
+{
+	if (dbv <= hkb_curve[0].dbv) return (uint32_t)hkb_curve[0].nits * 10u;
+	for (unsigned i = 1; i < HKB_N; i++) {
+		uint32_t a = hkb_curve[i - 1].dbv, b = hkb_curve[i].dbv;
+		if (dbv <= b) return hkb_curve[i - 1].nits * 10u + (dbv - a) * (uint32_t)(hkb_curve[i].nits - hkb_curve[i - 1].nits) * 10u / (b - a);
+	}
+	return (uint32_t)hkb_curve[HKB_N - 1].nits * 10u;
+}
+/*
+ * Transport log policy. Every failure; the first HKB_LOG_FIRST sends (the boot ramp); after that, a send HKB_LOG_STEP DBV or more
+ * away from the last one logged, up to HKB_LOG_MAX lines. A full slider sweep (10..140 nits, DBV 1397..4636) is about 25 lines,
+ * so a user's slider shows in the ramdump instead of vanishing after the boot ramp, as it did on r4-bl..r9 (64 lines, all boot ramp).
+ */
+#define HKB_LOG_FIRST 64u
+#define HKB_LOG_MAX   1024u
+#define HKB_LOG_STEP  128u
+static inline int hkb_log_due(uint32_t logs, uint32_t last_logged, uint32_t sent, int rc)
+{
+	uint32_t d = sent > last_logged ? sent - last_logged : last_logged - sent;
+	if (rc != 0 || logs < HKB_LOG_FIRST) return 1;
+	return logs < HKB_LOG_MAX && d >= HKB_LOG_STEP;
+}
 /* 1: a result to log in *rc. 0: nothing happened. */
