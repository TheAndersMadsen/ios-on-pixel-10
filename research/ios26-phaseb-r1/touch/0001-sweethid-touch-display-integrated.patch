diff --git c/iokit/Kernel/arm/hid/sweet_touch_event.h i/iokit/Kernel/arm/hid/sweet_touch_event.h
new file mode 100644
index 0000000..39b3459
--- /dev/null
+++ i/iokit/Kernel/arm/hid/sweet_touch_event.h
@@ -0,0 +1,48 @@
+/*
+ * The per-event fields of a touch-screen digitizer event: one place for SweetHIDTouch::touch() (the panel),
+ * sweet_live_touch_event() (hk_live_hid.inc, scripted taps) and the host test
+ * (research/ios26-phaseb-r1/touch/test). E is IOHIDEvent in the kernel and a recording fake on the host;
+ * the caller provides the kIOHIDEventField* constants (IOHIDEventFieldDefs.h).
+ *
+ * Why IsDisplayIntegrated: UIKitCore (iOS 26 cache 0f1ee332) picks the touch handler of a digitizer collection from
+ * kIOHIDEventFieldDigitizerIsDisplayIntegrated (0xb0019): 0 = an indirect touch (trackpad-like), 1 = a direct finger,
+ * 1 with a stylus child = pencil (code at 0x18923b208). UIKit's own synthesized digitizer events set it to
+ * !supportsIndirectInputEvents (0x18a761c18), and a focus-system recognizer claims taps that are not display
+ * integrated (0x18ac69b78). The SweetHIDTouch service property DisplayIntegrated does not set the event field, and
+ * IOHIDEvent::digitizerEvent() leaves options.displayIntegrated 0, so every tap reached apps as an indirect touch.
+ *
+ * direct=false keeps the pre-fix shape (boot-arg sweet_touch_indirect=1) for an A/B boot.
+ */
+#ifndef SWEET_TOUCH_EVENT_H
+#define SWEET_TOUCH_EVENT_H
+
+template <class E>
+static inline void
+sweet_touch_child_fields(E *child, int index, int identity, bool touch, uint32_t mask, bool direct)
+{
+	child->setIntegerValue(kIOHIDEventFieldDigitizerIndex, index);
+	child->setIntegerValue(kIOHIDEventFieldDigitizerIdentity, identity);
+	child->setIntegerValue(kIOHIDEventFieldDigitizerTouch, touch);
+	child->setIntegerValue(kIOHIDEventFieldDigitizerEventMask, mask);
+	if (direct) {
+		child->setIntegerValue(kIOHIDEventFieldDigitizerIsDisplayIntegrated, 1);
+	}
+}
+
+template <class E>
+static inline void
+sweet_touch_collection_fields(E *collection, IOFixed x, IOFixed y, bool any, uint32_t mask, bool direct)
+{
+	collection->setIntegerValue(kIOHIDEventFieldDigitizerCollection, 1);
+	collection->setFixedValue(kIOHIDEventFieldDigitizerX, x);
+	collection->setFixedValue(kIOHIDEventFieldDigitizerY, y);
+	collection->setIntegerValue(kIOHIDEventFieldDigitizerRange, any);
+	collection->setIntegerValue(kIOHIDEventFieldDigitizerTouch, any);
+	collection->setIntegerValue(kIOHIDEventFieldDigitizerEventMask, mask);
+	collection->setIntegerValue(kIOHIDEventFieldDigitizerButtonMask, any ? 1 : 0);
+	if (direct) {
+		collection->setIntegerValue(kIOHIDEventFieldDigitizerIsDisplayIntegrated, 1);
+	}
+}
+
+#endif /* SWEET_TOUCH_EVENT_H */
