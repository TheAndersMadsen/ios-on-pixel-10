+		uint32_t stage = HH_STAGE_ID, service = 1;
+		if ((PE_parse_boot_argn("blazer_haptic", &stage, sizeof(stage)) && stage != HH_STAGE_ID) ||
+		    (PE_parse_boot_argn("blazer_haptic_service", &service, sizeof(service)) && service != 1)) {
+			printf("blazer-haptic: tap needs stage 1 and service 1, off\n");
+			return;
+		}
+		boot_cfg.stage = HH_STAGE_ID;
+		service_on = 1;
+	} else {
+		tap_on = 0;
+	}
+#endif
+	if (boot_cfg.stage == 0 && (!PE_parse_boot_argn("blazer_haptic", &boot_cfg.stage, sizeof(boot_cfg.stage)) || boot_cfg.stage == 0)) {
 		return;
 	}
 #if BLAZER_HAPTIC_SERVICE
-	(void)PE_parse_boot_argn("blazer_haptic_service", &service_on, sizeof(service_on));
+	if (tap_on != 1) {
+		(void)PE_parse_boot_argn("blazer_haptic_service", &service_on, sizeof(service_on));
+	}
 	/* Service activation never creates a boot buzz. Explicit ID-only stage required. */
 	if (service_on != 0 && (service_on != 1 || boot_cfg.stage != HH_STAGE_ID)) return;
 #endif
diff --git a/bsd/dev/blazer_haptic_tap.h b/bsd/dev/blazer_haptic_tap.h
new file mode 100644
index 0000000..a747272
--- /dev/null
+++ b/bsd/dev/blazer_haptic_tap.h
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: MIT
+ * Tap feedback policy for blazer_haptic_tap=1, no XNU types: the host test runs this exact logic.
+ * A new touch contact asks for one ROM effect. The worker plays it through blazer_haptic_play_rom() (0832), at most one
+ * per HH_TAP_GAP_MS and HH_TAP_MAX per boot. EBUSY skips that tap; any other error turns tap feedback off for the boot. */
+#ifndef BLAZER_HAPTIC_TAP_H
+#define BLAZER_HAPTIC_TAP_H
+#include <stdbool.h>
+#include <stdint.h>
+
+#define HH_TAP_GAP_MS   250u    /* a fast double tap gives one buzz, not two overlapping 100 ms effects */
+#define HH_TAP_MAX      300u    /* bound for one attended boot */
+#define HH_TAP_EBUSY    16      /* errno values, as sys/errno.h */
+
+struct hh_tap {
+	uint64_t last_ms;
+	uint32_t sent, skipped, refused;
+	int last_rc;
+	bool played, off;
+};
+
+/* 1: play now. 0: drop this request (too soon after the last one, budget used, or off). */
+static inline int
+hh_tap_due(struct hh_tap *t, uint64_t now_ms)
+{
+	if (t->off || t->sent >= HH_TAP_MAX) {
+		t->skipped++;
+		return 0;
+	}
+	if (t->played && now_ms - t->last_ms < HH_TAP_GAP_MS) {
+		t->skipped++;
+		return 0;
+	}
+	return 1;
+}
+
+/* After blazer_haptic_play_rom(): rc 0 played, EBUSY skipped, anything else ends tap feedback. */
+static inline void
+hh_tap_done(struct hh_tap *t, uint64_t now_ms, int rc)
+{
+	t->last_rc = rc;
+	if (rc == 0) {
+		t->sent++;
+		t->played = true;
+		t->last_ms = now_ms;
+	} else if (rc == HH_TAP_EBUSY) {
+		t->skipped++;
+	} else {
+		t->refused++;
+		t->off = true;
+	}
+	if (t->sent >= HH_TAP_MAX) {
+		t->off = true;
+	}
+}
+#endif
