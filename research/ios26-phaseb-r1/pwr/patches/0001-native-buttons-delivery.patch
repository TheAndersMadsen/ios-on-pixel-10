+/* SPDX-License-Identifier: MIT
+ * Native GPIO -> existing SweetHID consumer events. No new user-client ABI.
+ * All state/callbacks run on the existing HID workloop. The real user client
+ * inherits this provider's workloop (IOService::getWorkLoop) and gates open,
+ * close and event enqueue there. Never hold sweet_live_lock across runAction.
+ */
+static SweetHIDButtons *gPhysicalButtons;
+static uint64_t gPhysicalEpoch;
+static uint64_t
+sweet_physical_next_epoch(void)
+{
+ /* A recreated service must not alias a generation the polling source still
+  * remembers. The same lock protects endpoint publication and this counter. */
+ lck_mtx_lock(&sweet_live_lock);
+ uint64_t epoch = gPhysicalEpoch == UINT64_MAX ? 0 : ++gPhysicalEpoch;
+ lck_mtx_unlock(&sweet_live_lock);
+ return epoch;
+}
+struct sweet_physical_request {
+ int key, down;                 /* -1 query, -2 stop; 0..2 physical edges only */
+ uint64_t epoch, result;
+ IOService *client;
+ IOOptionBits options;
+ void *argument;
+};
+
+void
+SweetHIDButtons::physicalReset(void)
+{
+ /* UPs were reserved before DOWN. Old clients get them before membership
+  * changes; a newly opened client never receives an orphan old UP. */
+ for (unsigned i = 0; i < 3; i++) {
+  if (fPhysicalUp[i]) {
+   fPhysicalUp[i]->setTimeStamp(mach_absolute_time());
+   dispatchEvent(fPhysicalUp[i]);
+   IOLog("SWEET PHYSICAL: epoch=%llu key=%u up reset callback\n", fPhysicalEpoch, i);
+   OSSafeReleaseNULL(fPhysicalUp[i]);
+  }
+ }
+ fPhysicalEpoch = sweet_physical_next_epoch();
+ if (!fPhysicalEpoch) fPhysicalStopping = true; /* refuse epoch wrap */
+}
+
+IOReturn
+SweetHIDButtons::physicalGated(OSObject *owner, void *arg, void *, void *, void *)
+{
+ SweetHIDButtons *self = (SweetHIDButtons *)owner;
+ sweet_physical_request *r = (sweet_physical_request *)arg;
+ if (r->key == -2) {
+  self->fPhysicalStopping = true;
+  self->physicalReset();
+  return kIOReturnSuccess;
+ }
+ if (r->key == -3 || r->key == -4) {
+  /* The actual IOHIDEventServiceUserClient callbacks are on this same gate.
+   * Failed/duplicate opens also invalidate the physical generation safely. */
+  self->physicalReset();
+  if (r->key == -3)
+   r->result = self->IOHIDEventService::handleOpen(r->client, r->options, r->argument);
+  else self->IOHIDEventService::handleClose(r->client, r->options);
+  return kIOReturnSuccess;
+ }
+ if (!self->fPhysicalEnabled || self->fPhysicalStopping || self->fUi || self->fTest ||
+     !self->liveHasClients()) return kIOReturnSuccess;
+ if (r->key == -1) {
+  /* The source lost readiness (including gate refusal): clear any old admitted
+   * DOWN before returning a fresh release-to-arm generation. No DOWN replay. */
+  if (r->down) self->physicalReset();
+  r->result = self->fPhysicalEpoch;
+  return kIOReturnSuccess;
+ }
+ if (r->key < 0 || r->key >= 3 || r->epoch != self->fPhysicalEpoch) return kIOReturnSuccess;
+ static const UInt32 usages[] = {
+  kHIDUsage_Csmr_Power, kHIDUsage_Csmr_VolumeIncrement, kHIDUsage_Csmr_VolumeDecrement
+ };
+ if (r->down) {
+  if (self->fPhysicalUp[r->key]) return kIOReturnSuccess; /* no repeat */
+  IOHIDEvent *down = IOHIDEvent::keyboardEvent(mach_absolute_time(), kHIDPage_Consumer, usages[r->key], true);
+  IOHIDEvent *up = IOHIDEvent::keyboardEvent(mach_absolute_time(), kHIDPage_Consumer, usages[r->key], false);
+  if (!down || !up) {
+   OSSafeReleaseNULL(down);
+   OSSafeReleaseNULL(up);
+   self->physicalReset(); /* other keys also require release after allocation loss */
+   return kIOReturnSuccess;
+  }
+  self->fPhysicalUp[r->key] = up;
+  self->dispatchEvent(down);
+  down->release();
+ } else {
+  IOHIDEvent *up = self->fPhysicalUp[r->key];
+  if (!up) return kIOReturnSuccess;
+  self->fPhysicalUp[r->key] = NULL;
+  up->setTimeStamp(mach_absolute_time());
+  self->dispatchEvent(up);
+  up->release();
+ }
+ r->result = 1; /* callback invocation, NOT queue/UI acknowledgement */
+ IOLog("SWEET PHYSICAL: epoch=%llu key=%d usage=0x%x %s clients=%u callback\n", r->epoch, r->key,
+     (unsigned)usages[r->key], r->down ? "down" : "up", self->_clients->getCount());
+ return kIOReturnSuccess;
+}
+
+bool
+SweetHIDButtons::handleOpen(IOService *client, IOOptionBits options, void *argument)
+{
+ if (!fPhysicalEnabled) return IOHIDEventService::handleOpen(client, options, argument);
+ sweet_physical_request r = { .key = -3, .client = client, .options = options, .argument = argument };
+ if (_hidGate->runAction(&SweetHIDButtons::physicalGated, &r) != kIOReturnSuccess) return false;
+ return r.result != 0;
+}
+
+void
+SweetHIDButtons::handleClose(IOService *client, IOOptionBits options)
+{
+ if (!fPhysicalEnabled) { IOHIDEventService::handleClose(client, options); return; }
+ sweet_physical_request r = { .key = -4, .client = client, .options = options };
+ _hidGate->runAction(&SweetHIDButtons::physicalGated, &r);
+}
+
+void
+SweetHIDButtons::physicalStart(void)
+{
+ uint32_t on = 0;
+ fPhysicalEnabled = PE_parse_boot_argn("blazer_key_delivery", &on, sizeof(on)) && on == 1;
+ if (!fPhysicalEnabled) return;
+ fPhysicalEpoch = sweet_physical_next_epoch();
+ if (!fPhysicalEpoch) fPhysicalStopping = true;
+ lck_mtx_lock(&sweet_live_lock);
+ if (!gPhysicalButtons) gPhysicalButtons = this;
+ else fPhysicalStopping = true;
+ lck_mtx_unlock(&sweet_live_lock);
+ IOLog("SWEET PHYSICAL: delivery enabled; release required after client change\n");
+}
+
+void
+SweetHIDButtons::physicalStop(void)
+{
+ if (!fPhysicalEnabled) return;
+ lck_mtx_lock(&sweet_live_lock);
+ if (gPhysicalButtons == this) gPhysicalButtons = NULL;
+ lck_mtx_unlock(&sweet_live_lock);
+ sweet_physical_request r = { .key = -2 };
+ _hidGate->runAction(&SweetHIDButtons::physicalGated, &r);
+}
+
+uint64_t
+SweetHIDButtons::physicalRequest(int key, int down, uint64_t epoch)
+{
+ sweet_physical_request r = { .key = key, .down = down, .epoch = epoch };
+ if (_hidGate->runAction(&SweetHIDButtons::physicalGated, &r) != kIOReturnSuccess) return 0;
+ return r.result;
+}
+
+static uint64_t
+sweet_physical_request(int key, int down, uint64_t epoch)
+{
+ lck_mtx_lock(&sweet_live_lock);
+ SweetHIDButtons *self = gPhysicalButtons;
+ if (self) self->retain();
+ lck_mtx_unlock(&sweet_live_lock);
+ uint64_t result = self ? self->physicalRequest(key, down, epoch) : 0;
+ if (self) self->release();
+ return result;
+}
+
+extern "C" uint64_t
+sweet_hid_keys_epoch(bool rearm)
+{
+ return sweet_physical_request(-1, rearm, 0);
+}
+
+extern "C" bool
+sweet_hid_key_checked(int key, int down, uint64_t epoch)
+{
+ if (key < 0 || key >= 3) return false; /* HOME is owned by its existing path */
+ return sweet_physical_request(key, down != 0, epoch) != 0;
+}
