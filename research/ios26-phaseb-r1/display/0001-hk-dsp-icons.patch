From 1726b6414cd4976b47af8eed45440c325cbc0792 Mon Sep 17 00:00:00 2001
From: Anders Madsen <madsenanders97@gmail.com>
Date: Tue, 3 Nov 2026 16:27:00 +0100
Subject: [PATCH] hk-dsp-icons: refuse RGhA IOSurfaces by default (hk_fmt=3),
 log non-BGRA surface imports by process

---
 iokit/Kernel/arm/SweetSurface.cpp       | 24 +++++++++++++++++++++---
 iokit/Kernel/arm/sweet_surface_format.h |  8 ++++++++
 2 files changed, 29 insertions(+), 3 deletions(-)

diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
index 6323671..ea2bf99 100644
--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -106,6 +106,17 @@ sweet_surf_mode(void)
 	return __atomic_load_n(&mode, __ATOMIC_RELAXED);
 }
 
+/* hk-dsp-icons: the first 48 imports (lookup by id or port) of a surface that is not BGRA, by process. Always on, bounded. */
+static uint32_t sweet_surf_imports_logged;
+static void
+sweet_surf_import_log(SweetSurface *s, uint32_t selector, IOReturn ret)
+{
+	if (s->pixelFormat == SWEET_FMT_BGRA || __atomic_fetch_add(&sweet_surf_imports_logged, 1, __ATOMIC_RELAXED) >= 48) return;
+	char who[32];
+	proc_selfname(who, sizeof(who));
+	IOLog("SWEET SURF: %s imports id %u fmt %x %ux%u by sel %u -> 0x%x\n", who, s->id, s->pixelFormat, s->width, s->height, selector, ret);
+}
+
 /* Called only for owned aligned buffers, with CPU/GPU access externally fenced. */
 static void
 sweet_surface_cache_op(uintptr_t va, size_t len, bool toCPU)
@@ -448,15 +459,20 @@ sweet_surface_layout(SweetSurface *s, OSDictionary *props)
 	s->elementWidth = (uint8_t)sweet_dict_u32(props, "IOSurfaceElementWidth", 1);
 	s->elementHeight = (uint8_t)sweet_dict_u32(props, "IOSurfaceElementHeight", 1);
 	s->pixelFormat = sweet_dict_u32(props, "IOSurfacePixelFormat", 0);
-	static uint32_t fmt_mode, fmt_read, fmt_logged;
+	static uint32_t fmt_mode = SWEET_FMT_DEFAULT_MODE, fmt_read, fmt_logged, fmt_refused;
 	if (!fmt_read) {
 		PE_parse_boot_argn("hk_fmt", &fmt_mode, sizeof(fmt_mode));
 		fmt_read = 1;
+		IOLog("SWEET SURF: hk_fmt %u%s\n", fmt_mode, fmt_mode == 3 ? ": RGhA refused" : "");
 	}
 	int fmt_action = sweet_surface_format_action(s->pixelFormat, fmt_mode);
-	if (fmt_action != SWEET_FMT_KEEP && fmt_logged < 16) {
+	if (fmt_action == SWEET_FMT_REFUSE) fmt_refused++;
+	if (fmt_action != SWEET_FMT_KEEP && (fmt_logged < 16 || (fmt_action == SWEET_FMT_REFUSE && (fmt_refused % 64) == 0))) {
+		char who[32];
+		proc_selfname(who, sizeof(who));
 		fmt_logged++;
-		IOLog("SWEET SURF: format %x %ux%u %s\n", s->pixelFormat, s->width, s->height, fmt_action == SWEET_FMT_PLAIN ? "served as BGRA" : "refused");
+		IOLog("SWEET SURF: %s format %x %ux%u %s (refused %u)\n", who, s->pixelFormat, s->width, s->height,
+		    fmt_action == SWEET_FMT_PLAIN ? "served as BGRA" : "refused", fmt_refused);
 	}
 	if (fmt_action == SWEET_FMT_REFUSE) {
 		return kIOReturnUnsupported;
@@ -1373,6 +1389,7 @@ IOSurfaceRootUserClient::externalMethod(uint32_t selector, IOExternalMethodArgum
 		IOReturn ret = kIOReturnNotFound;
 		if (s != NULL) {
 			ret = sweet_surface_get(s) ? returnSurface(s, args) : kIOReturnNotFound;
+			sweet_surf_import_log(s, selector, ret);
 			s->release();
 		}
 		sweet_surf_log_once("sel", selector);
@@ -1384,6 +1401,7 @@ IOSurfaceRootUserClient::externalMethod(uint32_t selector, IOExternalMethodArgum
 		SweetSurface *s = OSDynamicCast(SweetSurface, obj);
 		if (ret == kIOReturnSuccess) {
 			ret = (s != NULL && sweet_surface_get(s)) ? returnSurface(s, args) : kIOReturnBadArgument;
+			if (s != NULL) sweet_surf_import_log(s, selector, ret);
 		}
 		OSSafeReleaseNULL(obj);
 		sweet_surf_log_once("sel", selector);
diff --git a/iokit/Kernel/arm/sweet_surface_format.h b/iokit/Kernel/arm/sweet_surface_format.h
index 1e37203..af39411 100644
--- a/iokit/Kernel/arm/sweet_surface_format.h
+++ b/iokit/Kernel/arm/sweet_surface_format.h
@@ -4,6 +4,13 @@
 #include <stdint.h>
 #define SWEET_FOURCC(a, b, c, d) (((uint32_t)(a) << 24) | ((uint32_t)(b) << 16) | ((uint32_t)(c) << 8) | (uint32_t)(d))
 #define SWEET_FMT_BGRA SWEET_FOURCC('B', 'G', 'R', 'A')
+#define SWEET_FMT_RGHA SWEET_FOURCC('R', 'G', 'h', 'A')   /* 64-bit RGBA half float: iconservicesagent's icon surfaces on iOS 26 */
+/*
+ * hk_fmt=3, the default of this kernel (hk-dsp-icons; research/ios26-phaseb-r1/display/PLAN.md): refuse RGhA and keep every other format.
+ * The CPU compositor never shows the icons drawn into these surfaces (owner: missing logos/icons; ios-tegu: they never reach backboardd).
+ * A refused IOSurface makes the producer fall back to plain memory, which CoreAnimation ships to backboardd as image data. hk_fmt=0 restores the old answer.
+ */
+#define SWEET_FMT_DEFAULT_MODE 3u
 enum { SWEET_FMT_KEEP = 0, SWEET_FMT_PLAIN = 1, SWEET_FMT_REFUSE = 2 };
 /*
  * hk_fmt: 0 keep the client's format (series); 1 serve wide and compressed formats as plain BGRA; 2 as 1 for the wide ones, but refuse every '&' format.
@@ -18,6 +25,7 @@ sweet_surface_format_action(uint32_t format, unsigned mode)
 	if (mode == 1 && (wide || compressed)) return SWEET_FMT_PLAIN;
 	if (mode == 2 && wide) return SWEET_FMT_PLAIN;
 	if (mode == 2 && compressed) return SWEET_FMT_REFUSE;
+	if (mode == 3 && format == SWEET_FMT_RGHA) return SWEET_FMT_REFUSE;
 	return SWEET_FMT_KEEP;
 }
 #endif
-- 
