swipe 562 2000 562 700 ms=120 expect=any settle=0.3 verify=0
swipe 562 700 562 2000 ms=120 expect=any settle=0.3 verify=0
mark fps-scroll-end
# 3) Slow drag: 10 x 900 ms drags (motion without momentum: the frame rate CoreAnimation sustains while the finger moves)
mark fps-drag-start
swipe 562 1900 562 900 ms=900 expect=any settle=0.2 verify=0
swipe 562 900 562 1900 ms=900 expect=any settle=0.2 verify=0
swipe 562 1900 562 900 ms=900 expect=any settle=0.2 verify=0
swipe 562 900 562 1900 ms=900 expect=any settle=0.2 verify=0
swipe 562 1900 562 900 ms=900 expect=any settle=0.2 verify=0
