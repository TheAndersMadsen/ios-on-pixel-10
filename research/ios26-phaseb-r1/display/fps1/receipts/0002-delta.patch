+/* Lock held. hk_fb_fast=2: the waiting swap presents the panel's own surface (CoreAnimation drew in fPixels itself). */
+bool
+AppleCLCD::pendingUsesPanel(void)
+{
+	if (!fDirty || fSurface == NULL) return false;
+	uint32_t mask = get32(fPending, 0x104);
