+/*
+ * hk_fb_fast=2: map the second panel buffer, the flip pool's first slot (unmanaged low DRAM, as the panel's own buffer; r1d fetched from there), as device
+ * memory like fPixels. Refused, with a reason, unless 120 runs by copy on a scaled scanout. The mapping is kept for the boot: hk_screen may read it lock free.
+ */
+/* Lock held. hk_fb_fast=2: the waiting swap presents the panel's own surface (CoreAnimation drew in fPixels itself). */
+bool
+AppleCLCD::pendingUsesPanel(void)
+{
+	if (!fDirty || fSurface == NULL) return false;
+	uint32_t mask = get32(fPending, 0x104);
+	for (uint32_t l = 0; l < SWEET_FB_LAYERS; l++)
+		if ((mask & (1u << l)) && get32(fPending, 0x54 + 4 * l) == fSurface->id) return true;
+	return false;
+}
+
+void
+AppleCLCD::dbufStart(void)
+{
+	if (sweet_fb_fast != SWEET_FB_FAST_DBUF) return;
+	uint64_t bytes = round_page((uint64_t)fRowBytes * fHeight);
+	const char *why = sweet_fb_dbuf_refusal(sweet_fb_fast, fRefresh, fFlip, fDirtyMode, fVrr.on, sweet_scanout_can_flip() != 0);
+	if (why == NULL && fMinKickUS != 0) why = "sweetfb_hz below 60";
+	if (why == NULL && bytes > SWEET_FB_POOL_SLOT) why = "buffer larger than a pool slot";
+	if (why == NULL) {
+		IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(SWEET_FB_POOL_PA, bytes, kIODirectionInOut);
+		fBackMap = md != NULL ? md->map(kIOMapWriteCombineCache) : NULL;
+		OSSafeReleaseNULL(md);  /* the map holds it */
+		fBackPixels = fBackMap != NULL ? (uintptr_t)fBackMap->getVirtualAddress() : 0;
+		if (fBackPixels == 0) why = "no mapping";
+	}
+	if (why == NULL) {
+		sweet_fb_device_fill(fBackPixels, fRowBytes, fWidth, fHeight, 0xff000000u);
+		if (!sweet_scanout_back_attach(SWEET_FB_POOL_PA, fBackPixels)) why = "scanout refused it";
+	}
+	if (why != NULL) {
+		IOLog("SWEET FB: dbuf off: %s; one buffer\n", why);
+		OSSafeReleaseNULL(fBackMap);
+		fBackPixels = 0;
+		return;
+	}
+	fDbuf = true;
+	IOLog("SWEET FB: dbuf on: second buffer at 0x%llx, %llu bytes; copy while the last frame is sent\n", SWEET_FB_POOL_PA, bytes);
+}
