From 508218953db46f984859f7e57ad08048fc5faed0 Mon Sep 17 00:00:00 2001
From: Anders Madsen <madsenanders97@gmail.com>
Date: Tue, 3 Nov 2026 22:30:25 +0100
Subject: [PATCH] sweet sandbox: generalize profile self-check result semantics

Build on ABOUT's op-2 result path. libsystem_sandbox initializes sandbox_check's result to zero and returns result != 0 after a
successful syscall. A real operation check therefore means allowed with result zero, while the op NULL, type 0, own-pid query uses
the same word to ask whether the process is sandboxed. The old stand-in never wrote it, so BlastDoor's Sandbox.swift fatalError fired.

Generalize ABOUT's profile-prefix exception to its underlying declaration: every process with a nonempty
com.apple.private.sandbox.profile:embedded entitlement gets result 1 for its own self-query. Processes without a profile remain
unsandboxed. Cross-pid and real operation checks retain the permissive zero answer; this is not a blanket deny or a new allow stub.
Every successful op-2 call now writes an explicit 0/1 result, a null result pointer returns EINVAL, and copyin/copyout errors
propagate instead of silently looking allowed. Op 5 still returns libsandbox's no-op "invalid" token and op 6 behavior is unchanged.

Also make op 0x43's documented boolean outputs one byte each rather than overwriting eight bytes per pointer. Log successful
profiled self-checks with a bounded 64-line receipt. No boot argument is added.

Co-Authored-By: Kimi K3.1 Pro Highspeed <noreply@moonshot.ai>
---
 bsd/kern/sweet_amfi.c          | 47 +++++++++++++++++++---------------
 bsd/kern/sweet_sandbox_check.h | 32 +++++++----------------
 2 files changed, 36 insertions(+), 43 deletions(-)

diff --git a/bsd/kern/sweet_amfi.c b/bsd/kern/sweet_amfi.c
index 3c955f4..8244f8a 100644
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -309,36 +309,44 @@ static uint64_t sweet_sandbox_seen;
 int sweet_sandbox_container_path(user_addr_t arg);   /* sweet_sandbox_container.c */
 
 /*
- * Op 2, sandbox_check: "is this process sandboxed?" (op NULL, type 0, its own pid) from a process whose embedded profile
- * names blastdoor answers yes, so BlastDoor's launch check passes (sweet_sandbox_check.h). Everything else stays 0.
+ * Op 2 has two meanings in libsystem_sandbox. A real operation check writes an explicit zero (allowed). The op NULL,
+ * type 0, own-pid query instead asks "am I sandboxed?": write one when the main binary declares any nonempty embedded
+ * sandbox profile, zero otherwise. This is the ABI distinction, not a BlastDoor filename exception. Cross-pid queries
+ * retain the permissive zero answer. Every successful call writes its result; bad user pointers are errors, never allow.
  */
 static unsigned int sweet_sandbox_self_logged;
 
-static void
+static int
 sweet_sandbox_check_self(struct proc *p, user_addr_t arg)
 {
-	unsigned long long a[SSC_ARG_WORDS], dst = 0, one = 1;
-	char *profile;
-	int yes;
+	unsigned long long a[SSC_ARG_WORDS], dst = 0, answer = 0;
+	int error, self;
 
-	if (copyin(arg, a, sizeof(a)) != 0 || ssc_self_query(a, (long long)proc_pid(p), &dst) != 0) {
-		return;
+	error = copyin(arg, a, sizeof(a));
+	if (error != 0) {
+		return error;
+	}
+	if (a[0] == 0) {
+		return EINVAL;
 	}
-	profile = IOCurrentTaskGetEntitlement(SSC_PROFILE_ENT);
-	yes = ssc_profile_wants_sandbox(profile);
-	if (yes && copyout(&one, (user_addr_t)dst, sizeof(one)) != 0) {
-		yes = 0;
+	self = ssc_self_query(a, (long long)proc_pid(p), &dst) == 0;
+	if (self) {
+		char *profile = IOCurrentTaskGetEntitlement(SSC_PROFILE_ENT);
+
+		answer = ssc_profile_wants_sandbox(profile) ? 1 : 0;
+		if (profile != NULL) {
+			kfree_data(profile, strlen(profile) + 1);
+		}
 	}
-	if (yes && sweet_sandbox_self_logged < 16) {
+	error = copyout(&answer, (user_addr_t)a[0], sizeof(answer));
+	if (error == 0 && self && answer != 0 && sweet_sandbox_self_logged < 64) {
 		char name[32];
 
 		sweet_sandbox_self_logged++;
 		proc_name(proc_pid(p), name, sizeof(name));
-		printf("SWEET Sandbox: %s[%d] self-check: sandboxed (profile %s)\n", name, proc_pid(p), profile);
-	}
-	if (profile != NULL) {
-		kfree_data(profile, strlen(profile) + 1);
+		printf("SWEET Sandbox: %s[%d] self-check: sandboxed\n", name, proc_pid(p));
 	}
+	return error;
 }
 
 static int
@@ -352,8 +360,7 @@ sweet_sandbox_syscall(struct proc *p, int call, user_addr_t arg)
 	}
 	switch (call) {
 	case SSC_OP_CHECK:
-		sweet_sandbox_check_self(p, arg);
-		return 0;
+		return sweet_sandbox_check_self(p, arg);
 	case 4:         /* container path (audit token / pid) */
 		return sweet_sandbox_container_path(arg);
 	case SSI_OP_ISSUE: /* extension issue: libsandbox's own no-op token */
@@ -377,7 +384,7 @@ sweet_sandbox_syscall(struct proc *p, int call, user_addr_t arg)
 		 */
 		{
 			user_addr_t out[2];
-			uint64_t zero = 0;
+			uint8_t zero = 0;
 			int error = copyin(arg, out, sizeof(out));
 			for (int i = 0; error == 0 && i < 2; i++) {
 				if (out[i] != 0) {
diff --git a/bsd/kern/sweet_sandbox_check.h b/bsd/kern/sweet_sandbox_check.h
index 441a3ca..fbc9a5f 100644
--- a/bsd/kern/sweet_sandbox_check.h
+++ b/bsd/kern/sweet_sandbox_check.h
@@ -1,18 +1,14 @@
 /*
  * hackios: the Sandbox stand-in's answer to "is this process sandboxed?" (MIT, original). No XNU types: the host test includes it.
  *
- * libsystem_sandbox (iOS 26 23G90, dsc-r6): sandbox_check(pid, op, type, ...) (0x2a4413b70) fills a struct and calls the
- * shared helper 0x2a44138e8, which does
- *   u64 result = 0;  args[0] = &result;  args[1] = (s64)pid;  args[2] = op (NULL stays NULL);  args[3] = filter type;
- *   if (__sandbox_ms("Sandbox", 2, args) != 0) return -1;
- *   return result != 0;
- * So a check reports "denied" (or, with op NULL and type 0, "this pid is sandboxed") only if the kernel writes a nonzero
- * u64 through args[0]. The stand-in never did, so every process looked unsandboxed.
+ * libsystem_sandbox (iOS 26 23G90, dsc-r6): sandbox_check(pid, op, type, ...) fills a struct and calls __sandbox_ms("Sandbox", 2).
+ * Its helper initializes a u64 result to zero, passes { &result, (s64)pid, op, filter_type, ... }, and returns result != 0 after a
+ * successful syscall. Thus a real operation check is allowed when the kernel leaves result zero. The special op == NULL, type == 0
+ * self-query uses the same result to mean "this process is sandboxed"; leaving it zero makes BlastDoor's Sandbox.swift fatalError.
  *
- * BlastDoor/Sandbox.swift (BlastDoor 0x218a63fb4) traps on that at launch: sandbox_check(getpid(), NULL, 0) != 1 ->
- * fatalError("BlastDoor cannot run unsandboxed.") -> brk #1 -> SIGTRAP (MessagesBlastDoorService, int1 boots).
- * Only self-queries with op NULL and type 0, from a process whose embedded profile names blastdoor, get "sandboxed":
- * every other check keeps the old answer.
+ * A process with a nonempty com.apple.private.sandbox.profile:embedded entitlement has declared a sandbox profile. Answer 1 for its
+ * self-query regardless of the profile's name. Owner code without that entitlement remains truthfully unsandboxed. Real operation
+ * checks and cross-pid queries keep the permissive stand-in's existing zero result.
  */
 #ifndef SWEET_SANDBOX_CHECK_H
 #define SWEET_SANDBOX_CHECK_H
@@ -20,8 +16,6 @@
 #define SSC_OP_CHECK            2
 #define SSC_ARG_WORDS           4               /* result pointer, pid, operation, filter type */
 #define SSC_PROFILE_ENT         "com.apple.private.sandbox.profile:embedded"
-#define SSC_PROFILE_PREFIX      "blastdoor"     /* blastdoor-messages, blastdoor-... */
-#define SSC_PROFILE_PREFIX_LEN  9
 
 /* 0 and *dst = where to write a u64 1, for a self "am I sandboxed" query; -1 for anything else. */
 static inline int
@@ -34,19 +28,11 @@ ssc_self_query(const unsigned long long args[SSC_ARG_WORDS], long long self_pid,
 	return 0;
 }
 
-/* Does this embedded profile name a BlastDoor sandbox? NULL is no. */
+/* A nonempty embedded profile declares a sandbox; NULL and the empty string do not. */
 static inline int
 ssc_profile_wants_sandbox(const char *profile)
 {
-	if (profile == 0) {
-		return 0;
-	}
-	for (unsigned i = 0; i < SSC_PROFILE_PREFIX_LEN; i++) {
-		if (profile[i] != SSC_PROFILE_PREFIX[i]) {
-			return 0;
-		}
-	}
-	return 1;
+	return profile != 0 && profile[0] != 0;
 }
 
 #endif /* SWEET_SANDBOX_CHECK_H */
