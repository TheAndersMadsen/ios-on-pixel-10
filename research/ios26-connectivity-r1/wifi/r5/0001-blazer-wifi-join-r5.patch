From 2b7de9e165c542f6a0dd17a1ab19e73124700e2f Mon Sep 17 00:00:00 2001
From: Anders Madsen <madsenanders97@gmail.com>
Date: Tue, 3 Nov 2026 23:41:54 +0100
Subject: [PATCH 2/2] blazer wifi join r5: say whether M1 reached the
 supplicant (PSK_SUP state) and whether the posted RX buffers exceed the MAC
 fill (538)

---
 bsd/dev/blazer_bcm4390_join.c | 9 +++++++++
 bsd/dev/blazer_bcm4390_scan.c | 2 ++
 bsd/dev/blazer_pcie1.h        | 1 +
 3 files changed, 12 insertions(+)

diff --git a/bsd/dev/blazer_bcm4390_join.c b/bsd/dev/blazer_bcm4390_join.c
index e5c9f2e..7f83326 100644
--- a/bsd/dev/blazer_bcm4390_join.c
+++ b/bsd/dev/blazer_bcm4390_join.c
@@ -763,6 +763,15 @@ b4_join_event(struct p1 *p, uint32_t type, uint32_t status, uint32_t reason, uin
 	}
 	/* Numbers only. An event's data can hold the name */
 	p->ops.log(p->ops.ctx, "join: %s: status %u, reason %u\n", name, status, reason);
+	if (type == E_PSK_SUP) {
+		/* r5: sup_auth_status_t (wlioctl_defs.h). 4 is WAIT_M1: no M1 reached the supplicant. 5 (PREP_M2), 6 (KEYED), 8 and on (WAIT_M3 .. PREP_G2) all come after it */
+		static const char *const st[] = { "disconnected", "connecting", "id required", "authenticating", "waiting for M1", "preparing M2", "keyed", "timeout",
+		    "waiting for M3", "preparing M4", "waiting for G1", "preparing G2" };
+		bool m1 = status == 5u || status == SUP_KEYED || (status >= 8u && status <= 11u);
+
+		p->ops.log(p->ops.ctx, "join: M1 received: %s (supplicant %s)\n", m1 ? "yes" : status == SUP_WAIT_M1 ? "no" : "unknown",
+		    status < sizeof(st) / sizeof(st[0]) ? st[status] : "in a state past this table");
+	}
 	return true;
 }
 
diff --git a/bsd/dev/blazer_bcm4390_scan.c b/bsd/dev/blazer_bcm4390_scan.c
index e9432f7..74842d1 100644
--- a/bsd/dev/blazer_bcm4390_scan.c
+++ b/bsd/dev/blazer_bcm4390_scan.c
@@ -919,6 +919,8 @@ b4_scan(struct p1 *p)
 		return (int)p->stop;
 	}
 	p->ops.log(p->ops.ctx, "rx: %u buffers posted. The firmware takes up to %u (max_host_rxbufs); r1-r4 posted 64\n", p->rx_posted, p->max_rxbufs);
+	/* r5: what the two MAC units' RX fill holds (console: nrxbufpost 384 on unit 0, 154 on unit 1). At or under it, a packet for the host has no buffer left */
+	p->ops.log(p->ops.ctx, "rx: posted %u, above the %u the MAC fill holds: %s\n", p->rx_posted, B4_MAC_RX_FILL, p->rx_posted > B4_MAC_RX_FILL ? "yes" : "NO");
 	if (b4_rx_witness(p, "after the posting")) {
 		return (int)p->stop;
 	}
diff --git a/bsd/dev/blazer_pcie1.h b/bsd/dev/blazer_pcie1.h
index 0db544c..0573af1 100644
--- a/bsd/dev/blazer_pcie1.h
+++ b/bsd/dev/blazer_pcie1.h
@@ -268,6 +268,7 @@ int b4_ioctl(struct p1 *p, uint32_t cmd, uint8_t *buf, uint16_t len);   /* 0 mea
 int b4_poll(struct p1 *p);      /* All three completion rings, then the firmware's trap and mailbox state, once */
 int b4_rx_post_all(struct p1 *p);
 uint32_t b4_rx_bufs_wanted(const struct p1 *p);
+#define B4_MAC_RX_FILL 538u     /* r5: nrxbufpost 384 (MAC unit 0) + 154 (unit 1), the firmware console at boot */
 void b4_console_note(struct p1 *p, const char *line);
 int b4_rx_witness(struct p1 *p, const char *when);   /* r4: the RX rings' indices, read only. blazer_bcm4390_ring.c */
 bool b4_ioctl_allowed(uint32_t cmd, const uint8_t *buf, uint32_t len, int level);
-- 
