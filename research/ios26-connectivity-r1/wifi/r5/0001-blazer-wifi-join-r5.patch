--- a/bsd/dev/blazer_pcie1.h
+++ b/bsd/dev/blazer_pcie1.h
@@ -191,6 +191,7 @@ struct p1 {
 	char fw_ver[120];
 	/* Stage SCAN. rx_*, tx_items: what came back on the RX and TX completion rings */
 	uint32_t rx_posted, rx_items, rx_bytes, tx_items;
+	uint32_t fw_rx_nobuf;    /* r5: console lines "EL: 30 b8c8": pciedev_process_d2h_rxpyld dropped a packet for the host, no host RX buffer queued */
 	uint32_t preinit_status, axierror_addr, rxpost_size, scan_ver, up_ms;
 	int32_t preinit_err;
 	bool clm_loaded, txcap_loaded, wl_up, scan_running, scan_done;
@@ -266,6 +267,8 @@ int b4_scan(struct p1 *p);      /* stage SCAN, called from inside stage RINGS's
 int b4_ioctl(struct p1 *p, uint32_t cmd, uint8_t *buf, uint16_t len);   /* 0 means answered: the answer's in buf, the firmware's status in p->ioc_status. Refuses what b4_ioctl_allowed refuses */
 int b4_poll(struct p1 *p);      /* All three completion rings, then the firmware's trap and mailbox state, once */
 int b4_rx_post_all(struct p1 *p);
+uint32_t b4_rx_bufs_wanted(const struct p1 *p);
+void b4_console_note(struct p1 *p, const char *line);
 int b4_rx_witness(struct p1 *p, const char *when);   /* r4: the RX rings' indices, read only. blazer_bcm4390_ring.c */
 bool b4_ioctl_allowed(uint32_t cmd, const uint8_t *buf, uint32_t len, int level);
 int b4_gate_level(const struct p1 *p);
diff --git a/bsd/dev/blazer_wifi.c b/bsd/dev/blazer_wifi.c
index a3c8337..19d000e 100644
--- a/bsd/dev/blazer_wifi.c
+++ b/bsd/dev/blazer_wifi.c
@@ -55,7 +55,7 @@ extern void blazer_wifi_net_addr(void *ctx, uint32_t ip, uint32_t mask, uint32_t
 extern void blazer_wifi_net_mode(uint32_t mode);
 static struct b4_network wifi_network;
 static uint8_t nvram_buf[0x8000];
-#define WIFI_DMA_BYTES  0x60000u        /* blazer_bcm4390_ring.c's B4_DMA_NEEDED. 384 KiB, once, never freed: a one-shot probe, and the chip must never hold an address of freed memory */
+#define WIFI_DMA_BYTES  0x280000u       /* blazer_bcm4390_ring.c's B4_DMA_NEEDED. 2.5 MiB (r5: 1024 RX buffers; was 384 KiB), once, never freed: a one-shot probe, and the chip must never hold an address of freed memory */
 
 static struct {
 	uint64_t pa;
