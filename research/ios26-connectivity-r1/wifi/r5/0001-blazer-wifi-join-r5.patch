@@ -918,7 +918,7 @@ b4_scan(struct p1 *p)
 	if (b4_rx_post_all(p)) {
 		return (int)p->stop;
 	}
-	p->ops.log(p->ops.ctx, "rx: %u buffers posted\n", p->rx_posted);
+	p->ops.log(p->ops.ctx, "rx: %u buffers posted. The firmware takes up to %u (max_host_rxbufs); r1-r4 posted 64\n", p->rx_posted, p->max_rxbufs);
