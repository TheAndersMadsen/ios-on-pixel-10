+	}
+	return false;
+}
+
+static int
+i2c_write_to(struct sns *s, uint32_t addr, uint32_t reg, uint32_t value)
+{
+	if (!write_allowed_i2c(s, addr, reg, value)) {
 		return halt(s, SNS_STOP_REFUSED_I2C, reg << 8 | value);
 	}
 	s->i2c_frames++;
-	if (!i2c_start(s) && !i2c_byte_out(s, IMU_ADDR << 1, SNS_STOP_NO_ACK_ADDR) && !i2c_byte_out(s, reg, SNS_STOP_NO_ACK_REG)) {
+	if (!i2c_start(s) && !i2c_byte_out(s, addr << 1, SNS_STOP_NO_ACK_ADDR) && !i2c_byte_out(s, reg, SNS_STOP_NO_ACK_REG)) {
 		(void)i2c_byte_out(s, value, SNS_STOP_NO_ACK_REG);
 	}
 	i2c_stop(s);
 	return (int)s->stop;
 }
 
+static int i2c_write_reg(struct sns *s, uint32_t reg, uint32_t value) { return i2c_write_to(s, IMU_ADDR, reg, value); }
+
+int
+sns_bus_read(struct sns *s, uint32_t addr, uint32_t reg, uint8_t *out, uint32_t len)
+{
+	if (s->stop != SNS_OK) {
+		return (int)s->stop;
+	}
+	return i2c_read(s, addr, reg, out, len);
+}
+
+int
+sns_bus_write(struct sns *s, uint32_t addr, uint32_t reg, uint32_t value)
+{
+	if (s->stop != SNS_OK) {
+		return (int)s->stop;
+	}
+	return i2c_write_to(s, addr, reg, value);
+}
