From eb2d19ba821b77c2d4153d9216cf4491cf83fd27 Mon Sep 17 00:00:00 2001
From: Anders Madsen <madsenanders97@gmail.com>
Date: Tue, 3 Nov 2026 17:47:21 +0100
Subject: [PATCH 1/2] SweetKeyStore: gated AKS user-session selectors
 (blazer_aks_usersession=1); persona alloc log (blazer_persona_log=1)

Software answers for aks_create_bag/save_bag/load_bag (an opaque 16-byte user record, no keys), keybag persona
create/list/delete and set_keybag_for_volume_with_cookie_persona, so usermanagerd can set up the local user's
personas. Off unless both BLAZER_AKS_USERSESSION and the boot-arg are set. No identity or attestation selectors.
Host test: research/ios26-apps-r1/usersession/tests. Plan: research/ios26-apps-r1/usersession/PLAN.md.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 bsd/kern/sys_persona.c                      |  45 ++++++
 iokit/Kernel/arm/SweetKeyStore.cpp          |  92 ++++++++++++
 iokit/Kernel/arm/blazer_aks_usersession.inc | 158 ++++++++++++++++++++
 makedefs/MakeInc.def                        |   2 +-
 4 files changed, 296 insertions(+), 1 deletion(-)
 create mode 100644 iokit/Kernel/arm/blazer_aks_usersession.inc

diff --git a/bsd/kern/sys_persona.c b/bsd/kern/sys_persona.c
index 8807526..d730910 100644
--- a/bsd/kern/sys_persona.c
+++ b/bsd/kern/sys_persona.c
@@ -461,6 +461,46 @@ out:
 	return error;
 }
 
+#if defined(BLAZER)
+/*
+ * hackios: boot-arg blazer_persona_log=1 logs every persona allocation and deallocation (caller, op, type, uid,
+ * id, name, result) so a run can count the personas usermanagerd creates (research/ios26-apps-r1/usersession/).
+ * Lookups are not logged. Off by default; nothing else changes.
+ */
+#include <pexpert/pexpert.h>
+static int blazer_persona_log = -1;
+
+static void
+blazer_persona_log_op(uint32_t op, user_addr_t infop, user_addr_t idp, int error)
+{
+	struct kpersona_info ki;
+	char name[32];
+	uid_t id = PERSONA_ID_NONE;
+
+	if (blazer_persona_log < 0) {
+		uint32_t on = 0;
+		blazer_persona_log = (PE_parse_boot_argn("blazer_persona_log", &on, sizeof(on)) && on == 1) ? 1 : 0;
+	}
+	if (!blazer_persona_log) {
+		return;
+	}
+	proc_selfname(name, sizeof(name));
+	if (op == PERSONA_OP_DEALLOC) {
+		(void)copyin(idp, &id, sizeof(id));
+		printf("hk_persona: %s dealloc id %d -> %d\n", name, (int)id, error);
+		return;
+	}
+	memset(&ki, 0, sizeof(ki));
+	if (kpersona_copyin(infop, &ki) != 0) {
+		printf("hk_persona: %s alloc (info unreadable) -> %d\n", name, error);
+		return;
+	}
+	ki.persona_name[sizeof(ki.persona_name) - 1] = 0;
+	printf("hk_persona: %s alloc id %d type %d uid %d name %s -> %d\n", name, (int)ki.persona_id,
+	    (int)ki.persona_type, (int)ki.persona_uid, ki.persona_name, error);
+}
+#endif
+
 /*
  * Syscall entry point / demux.
  */
@@ -504,6 +544,11 @@ persona(__unused proc_t p, struct persona_args *pargs, __unused int32_t *retval)
 		error = ENOSYS;
 		break;
 	}
+#if defined(BLAZER)
+	if (op == PERSONA_OP_ALLOC || op == PERSONA_OP_PALLOC || op == PERSONA_OP_DEALLOC) {
+		blazer_persona_log_op(op, infop, idp, error);
+	}
+#endif
 
 	return error;
 }
diff --git a/iokit/Kernel/arm/SweetKeyStore.cpp b/iokit/Kernel/arm/SweetKeyStore.cpp
index a17b3bd..5ad8cf8 100644
--- a/iokit/Kernel/arm/SweetKeyStore.cpp
+++ b/iokit/Kernel/arm/SweetKeyStore.cpp
@@ -207,6 +207,87 @@ sweet_aks_wrap_call(uint32_t selector, IOExternalMethodArguments *args)
 }
 #endif /* BLAZER && BLAZER_AKS_WRAP */
 
+#ifndef BLAZER_AKS_USERSESSION
+#define BLAZER_AKS_USERSESSION 0
+#endif
+#if defined(BLAZER) && BLAZER_AKS_USERSESSION
+#if !BLAZER_AKS_WRAP
+#error "BLAZER_AKS_USERSESSION uses the aks-wrap output helper: build it with BLAZER_AKS_WRAP=1"
+#endif
+/*
+ * hackios: the AKS user-session keybag path (MKBUserSession*, keybagd's persona keys) in software, so usermanagerd
+ * can set up the local user's personas (research/ios26-apps-r1/usersession/PLAN.md). Compile gate
+ * BLAZER_AKS_USERSESSION and boot-arg blazer_aks_usersession=1, both needed; otherwise these selectors stay
+ * kIOReturnUnsupported. No keys are held: there is no data protection on this device.
+ */
+#include <pexpert/pexpert.h>
+#include "blazer_aks_usersession.inc"
+
+static bool sweet_aks_usersession;
+
+static void
+sweet_aks_usersession_init(void)
+{
+	uint32_t on = 0;
+
+	if (PE_parse_boot_argn("blazer_aks_usersession", &on, sizeof(on)) && on == 1) {
+		sweet_aks_usersession = true;
+		IOLog("SWEET AKS: user session on (software, no keys, user bag handle %u)\n", AUS_USER_HANDLE);
+	}
+}
+
+/* True if the call was a user-session selector; *ret is then its answer. */
+static bool
+sweet_aks_usersession_call(uint32_t selector, IOExternalMethodArguments *args, IOReturn *ret)
+{
+	uint8_t in[AUS_BAG_LEN];
+	uint32_t in_len = 0;
+	struct aus_result r;
+	struct aus_call c;
+	int st;
+
+	if (!sweet_aks_usersession || !aus_is_selector(selector)) {
+		return false;
+	}
+	c.selector = selector;
+	c.scalars_in = args->scalarInputCount;
+	c.scalar_in = args->scalarInput;
+	c.struct_in_len = args->structureInputDescriptor != NULL ?
+	    (uint32_t)args->structureInputDescriptor->getLength() : args->structureInputSize;
+	c.scalars_out_cap = args->scalarOutputCount;
+	c.struct_out_cap = args->structureOutputDescriptor != NULL ?
+	    (uint32_t)args->structureOutputDescriptor->getLength() : args->structureOutputSize;
+	if (selector == 6 && c.struct_in_len == AUS_BAG_LEN) {
+		if (args->structureInputDescriptor != NULL) {
+			in_len = (uint32_t)args->structureInputDescriptor->readBytes(0, in, AUS_BAG_LEN);
+		} else if (args->structureInput != NULL) {
+			memcpy(in, args->structureInput, AUS_BAG_LEN);
+			in_len = AUS_BAG_LEN;
+		}
+	}
+	st = aus_call(&c, in_len == AUS_BAG_LEN ? in : NULL, &r);
+	args->scalarOutputCount = 0;
+	if (st == AUS_OK) {
+		if (r.scalars_out) {
+			args->scalarOutput[0] = r.scalar_out[0];
+			args->scalarOutputCount = 1;
+		}
+		*ret = kIOReturnSuccess;
+		if (r.struct_out_len) {
+			*ret = sweet_aks_struct_out_quiet(args, r.struct_out, r.struct_out_len);
+		} else if (args->structureOutputDescriptor == NULL) {
+			args->structureOutputSize = 0;
+		} else {
+			args->structureOutputDescriptorSize = 0;
+		}
+	} else {
+		*ret = st == AUS_NO_SPACE ? kIOReturnNoSpace : kIOReturnBadArgument;
+		IOLog("SWEET AKS: user session sel %u refused: %s\n", selector, aus_status_name(st));
+	}
+	return true;
+}
+#endif /* BLAZER && BLAZER_AKS_USERSESSION */
+
 class AppleKeyStore : public IOService {
 	OSDeclareDefaultStructors(AppleKeyStore);
 
@@ -230,6 +311,9 @@ AppleKeyStore::start(IOService *provider)
 #endif
 #if defined(BLAZER) && BLAZER_AKS_WRAP
 	sweet_aks_wrap_init();
+#endif
+#if defined(BLAZER) && BLAZER_AKS_USERSESSION
+	sweet_aks_usersession_init();
 #endif
 	setProperty(kIOUserClientClassKey, "AppleKeyStoreUserClient");
 	registerService();
@@ -371,6 +455,11 @@ AppleKeyStoreUserClient::externalMethod(uint32_t selector, IOExternalMethodArgum
 	uint32_t out_struct = sweet_aks_struct_out_size(args);
 	uint64_t arg0 = in_scalars > 0 ? args->scalarInput[0] : 0;
 
+#if defined(BLAZER) && BLAZER_AKS_USERSESSION
+	if (sweet_aks_usersession_call(selector, args, &ret)) {
+		goto logged;
+	}
+#endif
 	switch (selector) {
 	case kAKSOpen:
 	case kAKSUnloadBag:
@@ -430,6 +519,9 @@ AppleKeyStoreUserClient::externalMethod(uint32_t selector, IOExternalMethodArgum
 		break;
 	}
 
+#if defined(BLAZER) && BLAZER_AKS_USERSESSION
+logged:
+#endif
 	char name[32];
 	proc_selfname(name, sizeof(name));
 #if defined(BLAZER) && BLAZER_AKS_LOG
diff --git a/iokit/Kernel/arm/blazer_aks_usersession.inc b/iokit/Kernel/arm/blazer_aks_usersession.inc
new file mode 100644
index 0000000..2936b26
--- /dev/null
+++ b/iokit/Kernel/arm/blazer_aks_usersession.inc
@@ -0,0 +1,158 @@
+/*
+ * hackios: software AKS user-session answers for SweetKeyStore (MIT, original).
+ *
+ * Gate: compile BLAZER_AKS_USERSESSION and boot-arg blazer_aks_usersession=1. Off: every selector below stays
+ * kIOReturnUnsupported, as before. No XNU types here; the host test includes this file as C.
+ *
+ * Scope: the local user session only (MobileKeyBag MKBUserSession*, usermanagerd's per-user persona setup through
+ * keybagd). There is no SEP and no data protection on this device (/private/var is a RAM varfs mounted without
+ * cprotect), so the "user keybag" holds no keys: it is a 16-byte opaque record. Handles are not secrets. Nothing here
+ * creates, emulates or answers for an Apple identity, attestation or escrow; those selectors stay unsupported.
+ *
+ * Selectors and shapes (iOS 26 AppleKeyStore.framework, dyld cache dsc-r6; IOConnectCallMethod(conn, sel, scalars_in,
+ * n, struct_in, len, scalars_out, &n, struct_out, &len)):
+ *   2   aks_create_bag          scalars in (type...), struct in (passcode, may be empty) -> scalar out handle
+ *   3   aks_save_bag            scalar in handle -> struct out bag bytes (cap 0x8000)
+ *   6   aks_load_bag            struct in bag bytes -> scalar out handle          (_aks_load_bag 0x1e4b35044)
+ *   65  aks_set_keybag_for_volume_with_cookie_persona  scalars in, struct in -> nothing
+ *   96  aks_keybag_persona_create         3 scalars {handle, ...}, struct in (DER) -> nothing (0x1e4b365f4)
+ *   117 aks_keybag_persona_create_with_flags  as 96 plus flags -> nothing
+ *   97  aks_keybag_persona_list   scalar in handle -> struct out (cap 0x2000)       (0x1e4b36808)
+ *   98  aks_keybag_persona_delete scalars in, struct in -> nothing
+ * aks_get_system (14), aks_set_system (5), aks_unload_bag (4), aks_unload_session_bags (55) are already answered by
+ * the base stub (handle 0, success).
+ */
+#ifndef BLAZER_AKS_USERSESSION_INC
+#define BLAZER_AKS_USERSESSION_INC
+
+#define AUS_OK          0
+#define AUS_UNHANDLED   1   /* not a user-session selector: the caller keeps its own answer */
+#define AUS_BAD_ARG     2
+#define AUS_NO_SPACE    3
+
+#define AUS_USER_HANDLE 1u  /* the one user bag handle this stub hands out (the system bag is 0) */
+#define AUS_BAG_LEN     16u
+
+struct aus_call {
+	unsigned int selector;
+	unsigned int scalars_in;        /* count */
+	const unsigned long long *scalar_in;
+	unsigned int struct_in_len;
+	unsigned int scalars_out_cap;   /* count the caller can take */
+	unsigned int struct_out_cap;    /* bytes the caller can take */
+};
+
+struct aus_result {
+	unsigned long long scalar_out[1];
+	unsigned int scalars_out;
+	unsigned char struct_out[AUS_BAG_LEN];
+	unsigned int struct_out_len;
+};
+
+/* The opaque "user bag": magic, version, handle. Loading accepts only this format, so a real Apple bag is refused. */
+static const unsigned char aus_bag_magic[8] = { 'H', 'K', 'U', 'S', 'B', 'A', 'G', '1' };
+
+static void
+aus_bag_bytes(unsigned char out[AUS_BAG_LEN])
+{
+	unsigned int i;
+	for (i = 0; i < 8; i++) {
+		out[i] = aus_bag_magic[i];
+	}
+	for (i = 8; i < AUS_BAG_LEN; i++) {
+		out[i] = 0;
+	}
+	out[8] = (unsigned char)AUS_USER_HANDLE;
+}
+
+static int
+aus_is_selector(unsigned int sel)
+{
+	return sel == 2 || sel == 3 || sel == 6 || sel == 65 || sel == 96 || sel == 97 || sel == 98 || sel == 117;
+}
+
+/*
+ * Decide one call. bag_in is the struct input (only read for selector 6). On AUS_OK, r holds the outputs; on any
+ * other status r->scalars_out and r->struct_out_len are 0.
+ */
+static int
+aus_call(const struct aus_call *c, const unsigned char *bag_in, struct aus_result *r)
+{
+	unsigned int i;
+
+	r->scalars_out = 0;
+	r->struct_out_len = 0;
+	if (!aus_is_selector(c->selector)) {
+		return AUS_UNHANDLED;
+	}
+	switch (c->selector) {
+	case 2:     /* create_bag: a handle */
+		if (c->scalars_out_cap < 1) {
+			return AUS_BAD_ARG;
+		}
+		r->scalar_out[0] = AUS_USER_HANDLE;
+		r->scalars_out = 1;
+		return AUS_OK;
+	case 3:     /* save_bag: the opaque record for our handle only */
+		if (c->scalars_in < 1 || c->scalar_in[0] != AUS_USER_HANDLE) {
+			return AUS_BAD_ARG;
+		}
+		if (c->struct_out_cap < AUS_BAG_LEN) {
+			return AUS_NO_SPACE;
+		}
+		aus_bag_bytes(r->struct_out);
+		r->struct_out_len = AUS_BAG_LEN;
+		return AUS_OK;
+	case 6: {   /* load_bag: only our own record */
+		unsigned char want[AUS_BAG_LEN];
+		if (c->scalars_out_cap < 1 || bag_in == 0 || c->struct_in_len != AUS_BAG_LEN) {
+			return AUS_BAD_ARG;
+		}
+		aus_bag_bytes(want);
+		for (i = 0; i < AUS_BAG_LEN; i++) {
+			if (bag_in[i] != want[i]) {
+				return AUS_BAD_ARG;
+			}
+		}
+		r->scalar_out[0] = AUS_USER_HANDLE;
+		r->scalars_out = 1;
+		return AUS_OK;
+	}
+	case 97:    /* persona_list: an empty DER SEQUENCE (no persona keys are held) */
+		if (c->scalars_in < 1) {
+			return AUS_BAD_ARG;
+		}
+		if (c->struct_out_cap < 2) {
+			return AUS_NO_SPACE;
+		}
+		r->struct_out[0] = 0x30;
+		r->struct_out[1] = 0x00;
+		r->struct_out_len = 2;
+		return AUS_OK;
+	case 96:
+	case 117:   /* persona key create: needs the bag handle and the DER request */
+		if (c->scalars_in < 1 || c->struct_in_len == 0) {
+			return AUS_BAD_ARG;
+		}
+		return AUS_OK;
+	default:    /* 65 set_keybag_for_volume_with_cookie_persona, 98 persona_delete: accepted, nothing kept */
+		if (c->scalars_in < 1) {
+			return AUS_BAD_ARG;
+		}
+		return AUS_OK;
+	}
+}
+
+static const char *
+aus_status_name(int st)
+{
+	switch (st) {
+	case AUS_OK: return "ok";
+	case AUS_UNHANDLED: return "unhandled";
+	case AUS_BAD_ARG: return "bad argument";
+	case AUS_NO_SPACE: return "no space";
+	default: return "?";
+	}
+}
+
+#endif /* BLAZER_AKS_USERSESSION_INC */
