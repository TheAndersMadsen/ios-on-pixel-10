-MACHINE_FLAGS_ARM64_BLAZER = -DARM64_BOARD_CONFIG_SWEET -DTEGU=1 -DBLAZER=1 -mcpu=cortex-a55 -march=armv8.2-a+crypto -DBLAZER_GPU_FW_DIAGNOSTIC=1 -DBLAZER_AKS_TRACE=1 -DBLAZER_AKS_LOG=1 -DBLAZER_AKS_WRAP=1
+MACHINE_FLAGS_ARM64_BLAZER = -DARM64_BOARD_CONFIG_SWEET -DTEGU=1 -DBLAZER=1 -mcpu=cortex-a55 -march=armv8.2-a+crypto -DBLAZER_GPU_FW_DIAGNOSTIC=1 -DBLAZER_AKS_TRACE=1 -DBLAZER_AKS_LOG=1 -DBLAZER_AKS_WRAP=1 -DBLAZER_AKS_USERSESSION=1
 
 
