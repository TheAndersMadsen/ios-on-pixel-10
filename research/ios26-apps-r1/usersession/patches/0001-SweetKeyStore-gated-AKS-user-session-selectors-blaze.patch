@@ -97,7 +97,7 @@ MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -march=arm
 # Reuse generic non-Apple GIC/PSCI support; keep tegu hardware paths explicit.
